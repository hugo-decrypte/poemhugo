<Controls:MetroWindow x:Class="PoemClientWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:WindowsInput="clr-namespace:System.Windows.Input;assembly=PresentationCore"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoemClientWPF.View"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        UseLayoutRounding="True"
        mc:Ignorable="d"
        Name="windowmain"
        Background="White"
        ResizeMode="CanResize"
        WindowState="Maximized"
        Closing="Window_Closing"
        TitleBarHeight="25"
        GlowBrush="{DynamicResource BackgroundTitleBrush}"
        WindowTitleBrush="{DynamicResource BackgroundTitleBrush}"
        NonActiveWindowTitleBrush="{DynamicResource BackgroundTitleBrush}"
        Title=""
        TitleCharacterCasing="Normal"
        AllowsTransparency="False"
        Loaded="Window_Loaded"
        FontFamily="DFKai-SB">

    <Controls:MetroWindow.IconTemplate>
        <DataTemplate>
            <Grid Width="16"
                 Height="16"
                 Margin="4"
                 Background="Transparent"
                 RenderOptions.EdgeMode="Aliased"
                 RenderOptions.BitmapScalingMode="HighQuality">
                <Image Source="{Binding logo}"></Image>
            </Grid>
        </DataTemplate>
    </Controls:MetroWindow.IconTemplate>
    <Controls:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontFamily="{DynamicResource WindowTitleFont}" 
                       FontSize="{DynamicResource WindowTitleSize}" 
                       Foreground="{DynamicResource WindowTitleColorBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="120,0,0,0"/>
        </DataTemplate>
    </Controls:MetroWindow.TitleTemplate>
    <Controls:MetroWindow.Resources>
        <FontFamily x:Key="WindowTitleFont">Segoe UI</FontFamily>
        <sys:Double x:Key="WindowTitleSize">14</sys:Double>
        <Style x:Key="CustomToolBarStyle" TargetType="ToolBar">
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Margin" Value="0,0,0,0"/>
                        <Setter Property="FontSize" Value="{Binding MenuFontSize}"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                            <DockPanel>
                                <Border Background="#c8c8c8" Height="4" DockPanel.Dock="Bottom"/>

                                <Grid>
                                    <Border Background="Transparent"
                                    Height="20"
                                    VerticalAlignment="Top"/>

                                    <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" Height="{Binding ToolBarHeight}"/>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>
        <Style TargetType="TreeViewItem">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="LightBlue"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="LightBlue"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="LightBlue"/>
            </Style.Resources>
        </Style>
        <Style x:Key="CustomToolBarStyleReversed" TargetType="ToolBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolBar">
                        <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                            <DockPanel>
                                <Border Background="#c8c8c8" Height="4" DockPanel.Dock="Bottom" />
                                <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" 
                                      HorizontalAlignment="Right"
                                              Margin="0,0,-7,0">
                                    <ToolBarPanel.LayoutTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </ToolBarPanel.LayoutTransform>
                                </ToolBarPanel>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Height" Value="1500"/>
            <Setter Property="Background" Value="#858585"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Width="{TemplateBinding Width}" Height="{TemplateBinding Height}" Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollViewerCustom" TargetType="{x:Type ScrollViewer}">
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" BorderThickness="0,1,1,0">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{DynamicResource BorderMediumColor}" />
                                </Border.BorderBrush>
                                <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                            </Border>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                        Grid.Column="1"
                        Value="{TemplateBinding VerticalOffset}"
                        Maximum="{TemplateBinding ScrollableHeight}"
                        ViewportSize="{TemplateBinding ViewportHeight}"
                        Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="true">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{DynamicResource ScrollBarThumb}" Margin="0,10,0,10" Width="7.5"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                        Orientation="Horizontal"
                        Grid.Row="1"
                        Grid.Column="0"
                        Value="{TemplateBinding HorizontalOffset}"
                        Maximum="{TemplateBinding ScrollableWidth}"
                        ViewportSize="{TemplateBinding ViewportWidth}"
                        Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}">
                                <ScrollBar.Template>
                                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                                        <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                                            <Track x:Name="PART_Track">
                                                <Track.DecreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0"/>
                                                </Track.DecreaseRepeatButton>
                                                <Track.IncreaseRepeatButton>
                                                    <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0"/>
                                                </Track.IncreaseRepeatButton>
                                                <Track.Thumb>
                                                    <Thumb Style="{DynamicResource ScrollBarThumb}" Margin="10,0,10,0" Height="6"/>
                                                </Track.Thumb>
                                            </Track>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollBar.Template>
                            </ScrollBar>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Controls:MetroWindow.Resources>

    <Grid>
        <DockPanel LastChildFill="True" Name="mainDock">
            <!-- Top zone -->
            <Grid DockPanel.Dock="Top">
                <Grid  Height="{Binding ToolBarHeight}">
                    <!-- Toolbar -->
                    <Grid Name="gridtoolbar" Background="#f5f5f5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left logo -->
                        <Grid Grid.Column="0">
                            <ToolBar Name="toolBarText" Style="{StaticResource CustomToolBarStyle}" Background="#f5f5f5">
                            </ToolBar>
                        </Grid>

                        <!-- Separator -->
                        <Border Name="menuSeparator1" Grid.Column="1" Background="White" BorderBrush="#c8c8c8" BorderThickness="0,0,0,4" VerticalAlignment="Stretch"/>

                        <!-- Center zone -->
                        <Grid Grid.Column="2">
                            <ToolBar Name="toolBarIcon"
                                 Style="{StaticResource CustomToolBarStyle}"
                                 Background="#f5f5f5"/>

                        </Grid>
                        <!-- Separator -->
                        <Border Name="menuSeparator2" Grid.Column="3" Background="White" BorderBrush="#c8c8c8" BorderThickness="0,0,0,4" VerticalAlignment="Stretch"/>

                        <Border Name="menuMiddle" Grid.Column="4" BorderBrush="#c8c8c8" BorderThickness="0,0,0,4" Background="Transparent" VerticalAlignment="Stretch"/>

                        <!-- Right buttons -->
                        <Border Name="BarCloseView" Grid.Column="5" Background="#f5f5f5" HorizontalAlignment="Right" BorderThickness="0,0,0,4" BorderBrush="#FFc8c8c8" Padding="0,0,19,0">
                        </Border>
                        <!--ToolBar Name="toolBarClose" Style="{StaticResource CustomToolBarStyleReversed}" Grid.Column="5" Background="#f5f5f5" HorizontalAlignment="Right">
                        </ToolBar-->
                    </Grid>
                </Grid>
            </Grid>
            <Grid x:Name="mainGrid" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5*"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#c8c8c8" Grid.Column="0" BorderThickness="5,1,0,0">
                    <Grid Name="gridTree" Background="Transparent" Margin="0,-0.5,0,0" HorizontalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- retract button  0 -->
                            <RowDefinition Name="ViewTree"  Height="*"/>
                            <!-- treeview        1 -->
                            <RowDefinition Name="SplitRow1" Height="4"/>
                            <!-- splitter        2 -->
                            <RowDefinition Name="ViewRow1" Height="*"/>
                            <!-- view1           3 -->
                            <RowDefinition Name="SplitRow2" Height="4"/>
                            <!-- splitter        4 -->
                            <RowDefinition Name="ViewRow2" Height="auto"/>
                            <!-- view2           5 -->
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="9"/>
                            <!-- left border  0 -->
                            <ColumnDefinition Width="*"/>
                            <!-- views        1 -->
                            <ColumnDefinition Width="*"/>
                            <!-- scrollbar    2 -->
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="6" Grid.ColumnSpan="3" BorderBrush="{DynamicResource FrameColorBrush}" BorderThickness="1,1,0,0" Margin="2,1,0,0" Background="White" Name="TreeWrapper"/>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="3" BorderBrush="{DynamicResource FrameColorBrush}" BorderThickness="1,1,0,1" Margin="5,4,0,0" Background="White" Name="TreePadding">
                            <ScrollViewer  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" Name="scrollTree">
                                <TreeView Name="treeView" SelectedItemChanged="TreeView_SelectedItemChanged" BorderThickness="0" PreviewMouseWheel="TreeView_PreviewMouseWheel" Padding="0" Background="White">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem">
                                            <EventSetter Event="RequestBringIntoView" Handler="TreeViewItem_RequestBringIntoView"/>
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                </TreeView>
                            </ScrollViewer>
                        </Border>

                        <Button Name="btn_retract_tree" Background="White" BorderThickness="0" HorizontalAlignment="Right" Grid.Row="0" Grid.Column="2" Height="16.5" Width="16.5"/>

                        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Name="BorderView1" BorderBrush="{DynamicResource FrameColorBrush}" BorderThickness="1,1,0,1" Margin="5,0,0,0" Background="White"/>

                        <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Name="BorderView2" BorderBrush="{DynamicResource FrameColorBrush}" BorderThickness="1,1,0,1" Margin="5,0,0,0" Background="White"/>

                        <local:UserControlLogin Height="0" Visibility="Hidden" x:Name="login"/>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="Auto" HorizontalAlignment="Stretch" Name="splitter" DragStarted="SplitterDragStartedHandler" DragDelta="MainSplitter_DragDelta" DragCompleted="MainSplitter_DragCompleted" Background="#c8c8c8"/>

                <Border Grid.Column="2" BorderBrush="{DynamicResource FrameColorBrush}" BorderThickness="1,1,0,0" Margin="2,1,2,2" Background="White">
                    <Border BorderBrush="{DynamicResource FrameColorBrush}" BorderThickness="1,1,0,0" Margin="2,2,0,0" Background="White">
                        <Grid x:Name="gridView" Margin="3,0,0,0">
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </DockPanel>
        <Grid x:Name="InteractionBlocker" Background="#40FFFFFF" Visibility="Collapsed">
            <TextBlock Text="Processing..." 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   FontSize="20" 
                   Foreground="Black" />
        </Grid>
    </Grid>
</Controls:MetroWindow>
