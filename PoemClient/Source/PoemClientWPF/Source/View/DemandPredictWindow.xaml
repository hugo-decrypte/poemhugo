<Window x:Class="PoemClient.View.DemandPredictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding CFGDemandPredict}" Width="500" SizeToContent="Height" Closing="Window_Closing"
        WindowStartupLocation="CenterScreen" Background="#F4F4F9">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,10,20,10"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D3D3D3"/>
                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="Auto" MinHeight="60"/> </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0 0 0 15">
            <ListBox x:Name="lbProducts" Height="Auto" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="LightGray">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                  Click="OnItemChecked" 
                                  Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0 0 0 15">
            <ListBox x:Name="lbCountries" Height="Auto" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="LightGray">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                  Click="OnItemChecked" 
                                  Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0 0 0 15">
            <ListBox x:Name="lbPeriods" Height="Auto" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" BorderBrush="LightGray">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Name}" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                  Click="OnItemChecked" 
                                  Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0 0 0 20">
            <ComboBox x:Name="cmbAiModel" Height="35" VerticalContentAlignment="Center"
                      ItemsSource="{Binding LanguagesAI}"
                      SelectionChanged="AISelectionChanged"
                      SelectedItem="{Binding SelectedFrom, Mode=OneWay}">
            </ComboBox>
        </StackPanel>

        <Grid Grid.Row="4">
            <Button x:Name="PredictButton" 
                    Content="{Binding CFGPredictButton}" 
                    Click="Predict_Click" 
                    Height="40" 
                    Width="100" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom" 
                    Margin="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightBlue" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <TextBlock x:Name="Loading" 
                       VerticalAlignment="Bottom" 
                       HorizontalAlignment="Right" 
                       Margin="0 0 0 10"
                       Foreground="#555"/>
        </Grid>
    </Grid>
</Window>