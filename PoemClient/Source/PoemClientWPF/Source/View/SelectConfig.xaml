<Window x:Class="PoemClient.View.SelectConfig"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoemClient.View"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="180" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Margin="0,10,0,0">
            <ComboBox TabIndex="0" Name="listConfigs" Width="310">
                <ComboBox.Resources>
                    <Style TargetType="ComboBox">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="Opacity" Value="1" />
                    </Style>
                </ComboBox.Resources>
            </ComboBox>
            <Button TabIndex="1" Content="..." Margin="20 0 0 0" Padding="5" Click="BrowseButton_Click" Height="25" Width="25" Background="White" FontWeight="DemiBold"></Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="-5,0,0,0" Grid.Row="1" VerticalAlignment="Center">
            <Label Content="{Binding Check_Save}" VerticalAlignment="Center"></Label>
            <CheckBox Margin="5,0,0,0" TabIndex="2" x:Name="chk_ask" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,-10,0,0" Grid.Column="1" Grid.Row="2" VerticalAlignment="Center">
            <Button TabIndex="2" Content="{Binding btn_Ok}" Click="OkButton_Click" Margin="150 0 0 0" Padding="5" Background="White" Width="100" Height="30" FontWeight="DemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightBlue" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button TabIndex="3" Content="{Binding btn_Cancel}" Click="CancelButton_Click" Margin="10 0 0 0"  Padding="5" Background="White" Width="100" Height="30" FontWeight="DemiBold">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightBlue" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
