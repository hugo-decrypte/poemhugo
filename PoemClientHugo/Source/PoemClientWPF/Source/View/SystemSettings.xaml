<Window x:Class="PoemClient.Source.View.SystemSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="280" Width="450" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <TabControl>
            <TabControl.Resources>
                <!-- Remove Metro styles by overriding with default WPF -->
                <Style TargetType="TabControl" BasedOn="{x:Null}" />
                <Style TargetType="TabItem" BasedOn="{x:Null}" />
            </TabControl.Resources>
            <TabItem Header="{Binding FolderView}" FontSize="14" Width="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="10*"/>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Row="1" Margin="20,-20,0,0" Padding="10,0,0,0" FontSize="12" VerticalAlignment="Center" Name="OptionalWindow1" Content="{Binding OptionalWindow1Label}"/>
                    <CheckBox Grid.Row="2" Margin="20,20,0,0" Padding="10,0,0,0" FontSize="12" VerticalAlignment="Center" Name="OptionalWindow2" Content="{Binding OptionalWindow2Label}"/>

                    <StackPanel Orientation="Horizontal" Grid.Row="5" VerticalAlignment="Center" Height="30">
                        <Button Content="Ok" Click="SaveSettings" Name="SaveOptionalWindows" Margin="212 0 0 0" Padding="5" Background="White" Width="80" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{Binding Cancel}" Click="CloseSystemSettings" Margin="10 0 0 0"  Padding="5" Background="White" Width="80" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding TreeView}" FontSize="14" Width="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="10*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124*"/>
                        <ColumnDefinition Width="24*"/>
                        <ColumnDefinition Width="231*"/>
                        <ColumnDefinition Width="65*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal" Grid.Row="1" VerticalAlignment="Top" Height="20" Grid.ColumnSpan="2">
                        <Label Content="{Binding TopMargin}" Width="110" FontSize="12"  Margin="10,0,0,0" Padding="10,0,0,0" ></Label>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" Height="20" FontSize="12" Name="TreeViewTopMargin" Width="40"  Margin="0,-5,0,0" Padding="0,3,0,0" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>


                    <StackPanel Margin="70,3,0,0" Orientation="Horizontal" Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" Height="20" Grid.ColumnSpan="2">
                        <Label Content="{Binding BottomMargin}" Width="110" FontSize="12"  Margin="10,0,0,0" Padding="10,0,0,0" ></Label>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" Height="20" FontSize="12" Name="TreeViewBottomMargin" Width="40"  Margin="0,-5,0,0" Padding="0,3,0,0" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>

                    <StackPanel Margin="0,9,0,0" Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Top" Height="20" Grid.ColumnSpan="2">
                        <Label Content="{Binding LeftMargin}" Width="110" FontSize="12"  Margin="10,0,0,0" Padding="10,0,0,0" ></Label>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" Height="20" FontSize="12" Name="TreeViewLeftMargin" Width="40"  Margin="0,-5,0,0" Padding="0,3,0,0" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>

                    <StackPanel Margin="70,9,0,0" Orientation="Horizontal" Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Height="20" Grid.ColumnSpan="2">
                        <Label Content="{Binding Spacing}" Width="110" FontSize="12"  Margin="10,0,0,0" Padding="10,0,0,0" ></Label>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" Height="20" FontSize="12" Name="TreeViewSpacing" Width="40"  Margin="0,-5,0,0" Padding="0,3,0,0" VerticalContentAlignment="Center" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD"  PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>

                    <CheckBox Grid.Row="3" Margin="20,19,0,0" Padding="10,0,0,0" FontSize="12" VerticalAlignment="Top" Name="OpenTreeView" Content="{Binding OpenTreeViewLabel}" Grid.ColumnSpan="2"/>

                    <StackPanel Grid.ColumnSpan="4" Orientation="Horizontal" Grid.Row="5" VerticalAlignment="Center" Height="30">
                        <Button Content="Ok" Click="SaveSettings" Name="SaveTreeView" Margin="212 0 0 0" Padding="5" Background="White" Width="80" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{Binding Cancel}" Click="CloseSystemSettings" Margin="10 0 0 0"  Padding="5" Background="White" Width="80" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{Binding Colors}" FontSize="14" Width="140">
                <Grid Margin="10, 10, 0, 0">
                    <Grid.RowDefinitions>
                        <!--RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="10*"/-->
                        <RowDefinition Height="40*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="10*"/>
                    </Grid.RowDefinitions>

                    <!--Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="6*"/>
                    </Grid.ColumnDefinitions-->

                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Left" Margin="10,0,0,0">
                        <StackPanel Name="RGBStackPanel" HorizontalAlignment="Center" Margin="0,0,30,15">

                        </StackPanel>
                    </ScrollViewer>
                    <!--TextBlock Padding="10,0,0,0" FontSize="12" Text="{Binding MenuBackground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Background="Red" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="55, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="MenuBackgroundR" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Green" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>1
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="MenuBackgroundG" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Blue" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="MenuBackgroundB" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>
                    
                    <TextBlock Padding="10,0,0,0" Grid.Row="1" FontSize="12" Text="{Binding FolderBackground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Background="Red" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="55, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="FolderBackgroundR" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Green" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="FolderBackgroundG" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Blue" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="FolderBackgroundB" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>

                    <TextBlock Padding="10,0,0,0" Grid.Row="2" FontSize="12" Text="{Binding BottomBackground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Background="Red" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="55, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="BottomBackgroundR" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Green" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="BottomBackgroundG" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Blue" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="BottomBackgroundB" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel>

                    <TextBlock  Padding="10,0,0,0" Grid.Row="3" FontSize="12" Text="{Binding HighlightBackground}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
                        <TextBlock Background="Red" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="55, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="FolderHighlightR" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Green" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="FolderHighlightG" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                        <TextBlock Background="Blue" Text=" " VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10, 0, 0, 0"/>
                        <TextBox MouseRightButtonUp="DisablePastePopUp" GotFocus="GotFocusHandler" BorderThickness="0,0,0,1" BorderBrush="#FFC6BDBD" Name="FolderHighlightB" Width="40" Margin="5, 0" TextAlignment="Center" PreviewTextInput="NumberValidationTextBox" CommandManager.PreviewExecuted="DisablePaste"/>
                    </StackPanel-->

                    <StackPanel Orientation="Horizontal" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Height="30" Margin="0,1,48,5">
                        <Button Content="Ok" Click="SaveSettings" Name="SaveColors" Padding="5" Background="White" Width="80" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="{Binding Cancel}" Click="CloseSystemSettings" Margin="10 0 0 0"  Padding="5" Background="White" Width="80" Height="25">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="Transparent" BorderBrush="Gray" BorderThickness="1" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="LightBlue" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
