<Window x:Class="PoemClient.View.TranslateDBWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoemClient.View"
        mc:Ignorable="d"
        Title="Translate SQL" Height="239" Width="550" Closing="TranslateDBClosing" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="23*" MinWidth="300"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="210"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Name="To_Path" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="298,40,0,0" Width="16" Height="20" Text="{Binding To}" />
        <TextBlock Name="From_Path" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,40,0,0" Width="60" Height="20" Text="{Binding Text_File}" />

        <TextBox VerticalContentAlignment="Center" x:Name="path_from" Margin="85,36,303,158" RenderTransformOrigin="0.49,0.517" TextChanged="path_from_TextChanged"/>
        <Button Content="..." Name="btn_path_from" Margin="252,36,259,158" Padding="5" Background="White" Click="OnClickSelectFileFrom"></Button>

        <TextBox VerticalContentAlignment="Center" x:Name="path_to" Margin="324,36,64,158" RenderTransformOrigin="0.49,0.517" TextChanged="path_to_TextChanged"/>
        <Button Content="..." Name="btn_path_to" Margin="491,36,20,158" Padding="5" Background="White" Click="OnClickSelectFileTo"></Button>

        <TextBlock Name="From" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20,0,0,0" Width="60" Height="20" Text="{Binding From}" />
        <TextBlock Name="To" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="298,102,0,0" Width="16" Height="20" Text="{Binding To}" />
        <!-- DropDown List -->
        <ComboBox x:Name="FromList" Width="162" Height="28" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" VerticalContentAlignment="Center" Background="Transparent" Foreground="Black" IsEditable="True" Margin="85,0,0,0" SelectionChanged="ActualLang_changed" ItemsSource="{Binding Languages}"/>
        <ComboBox x:Name="ToList" SelectionChanged="ToList_TextChanged" Width="162" Height="28" FontSize="12" HorizontalAlignment="Left" VerticalAlignment="Center" BorderThickness="1" VerticalContentAlignment="Center" Background="Transparent" Foreground="Black" IsEditable="True" Margin="324,0,0,0" ItemsSource="{Binding Languages}"/>
        <!-- Buttons -->
        <Button HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="100,0,0,48" Width="100" Height="24" Content="{Binding Ok_btn}" Click="Ok_button" Background="White"/>
        <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,100,48" Width="100" Height="24" Content="{Binding Cancel_btn}" Click="Cancel_button" Background="White"/>
        <TextBlock Name="Loading" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,152,0,0" Width="98" Height="20" Text="" />
    </Grid>
</Window>
