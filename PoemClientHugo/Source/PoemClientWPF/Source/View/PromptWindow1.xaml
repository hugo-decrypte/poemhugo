<Window x:Class="PoemClient.Source.View.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoemClient.Source.View"
        mc:Ignorable="d"
        Title="PromptWindow" Width="450" SizeToContent="Height"
        Closing="PromptClosing"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4F4F9">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="Gray" 
                                BorderThickness="1" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightBlue"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="60"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox Name="Prompt"
                     Grid.Row="0"
                     Grid.Column="0"
                     Height="45"
                     VerticalContentAlignment="Center"
                     Padding="10"
                     HorizontalAlignment="Stretch"
                     Width="Auto"
                     Background="White"
                     BorderBrush="LightGray"
                     BorderThickness="1"/>
            <Button Name="Speech" Width="25" Height="25" Cursor="Hand" Grid.Row="0" Grid.Column="1" Margin="10,10,0,10" Click="MonBoutonImage_Click" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Image Name="Image" Source="{Binding Voice1Icon}" Stretch="Uniform" />
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <ComboBox x:Name="AiModelSelector" 
                      Grid.Row="1"
                      Grid.Column="0"
                      ItemsSource="{Binding LanguagesAI}"
                      Margin="0,0,0,0" 
                      Height="35" 
                      Width="Auto"
                      VerticalContentAlignment="Center"
                      SelectionChanged="AISelectionChanged"
                      SelectedItem="{Binding SelectedFrom, Mode=OneWay}">
            </ComboBox>
        <Button Name="Confirm"
                Content="{Binding OkButton}"
                Click="ConfirmPrompt"
                Height="23"
                Width="23"
                Background="#F4F4F9"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="10,5,0,5"
                Grid.Column="1" Grid.Row="1" FontSize="10"
                >
        </Button>
        <TextBlock Name="Loading"
                       Text="{Binding loading}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="0"
                       Foreground="Gray" 
                       FontStyle="Italic" 
                       FontSize="13"
                       Grid.Column="2"/>
    </Grid>
</Window>