<Window x:Class="PoemClient.Source.View.SelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PoemClient.Source.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="90" Width="300"
        WindowStyle="None">


    <Border BorderBrush="#808080" 
            BorderThickness="1" 
            Background="White" 
            CornerRadius="0">

        <Grid VerticalAlignment="Center" Height="90">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Click="BtnClose_Click"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Width="30" 
                    Height="30" 
                    Background="Transparent" 
                    BorderThickness="0"
                    Foreground="Black">
                <Viewbox Width="10" Height="10">
                    <TextBlock Text="&#xE8BB;" 
                       FontFamily="Segoe MDL2 Assets" 
                       Foreground="Black" />
                </Viewbox>
            </Button>

            <ComboBox x:Name="ComboSelection" Width="182" Height="22" VerticalAlignment="Center" 
                      HorizontalAlignment="Left" Margin="15,10,0,0">
                <ComboBoxItem Content="Fichier" IsSelected="True"/>
                <ComboBoxItem Content="Répertoire"/>
            </ComboBox>
            <Button Content="{Binding okButton}" FontWeight="Normal" IsDefault="True" Click="BtnValidate_Click"
                    Width="65" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,10,15,0"/>
        </Grid>

    </Border>

</Window>
