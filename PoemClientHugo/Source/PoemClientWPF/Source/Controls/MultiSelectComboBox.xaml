<UserControl x:Class="PoemClient.Source.Controls.MultiSelectComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="200">

    <Grid>
        <ToggleButton x:Name="PART_Toggle"
                      Click="Toggle_Click"
                      Padding="6"
                      HorizontalContentAlignment="Left"
                      Background="Transparent"
                      BorderBrush="Gray"
                      FocusVisualStyle="{x:Null}">
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Gray"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="2,0"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ToggleButton.Style>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="PART_DisplayText"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </ToggleButton>

        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding ElementName=PART_Toggle}"
               StaysOpen="False"
               Placement="Bottom"
               AllowsTransparency="False">
            <Border Background="White"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Padding="6"
                    MinWidth="{Binding ElementName=PART_Toggle, Path=ActualWidth}"
                    Effect="{x:Null}">
                <StackPanel>
                    <CheckBox x:Name="CbAll"
                              Content="Tous"
                              Margin="0,0,0,6"
                              Checked="CbAll_Checked"
                              Unchecked="CbAll_Unchecked"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="200">
                        <StackPanel x:Name="ItemsPanel"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
