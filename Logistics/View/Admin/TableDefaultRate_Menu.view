View ViewTableDEFAULTRATE 'Tableau de bord taux de défaut' 'Tableau de bord taux de défaut'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableDEFAULTRATE _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Tableau de bord taux de défaut;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Right,Right,Right}]"\
"[DATAOBJ=DEFAULTRATE;FILLCOLOR=LINERGB]"

Data DEFAULTRATE 'Tableau de bord taux de défaut' DEFAULTRATE HTTPSQL 0 '[FIND={NAMEMONTH,COST,WEIGHT,QUANTITY}]'   [DOUBLECLICK=] \
"[4;(string,NAMEMONTH,Mois,,10,,);(string,COST,CA,,10,,);(int,WEIGHT,Poids,,10,,);(int,QUANTITY,Quantité,,10,,);(string,ID,No Mois,,10,0);\
(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT  (format(max(LP.DateCreate),'YYYY')+format(M.NoMonth,'0')) as ID,\
		 (format(max(LP.DateCreate),'YYYY')+'  '+M.NameFR) as NAMEMONTH,\
		 format(sum(LP.QuantityDefective)*100/(sum(LP.QuantityReal)+1), '0.00') as QUANTITY,\
		 format(sum(LP.QuantityDefective*a.PriceUnit)*100/(sum(LP.QuantityReal*a.PriceUnit)+1), '0.00') as COST,\
		 format(sum(LP.QuantityDefective*a.Weight)*100/(sum(LP.QuantityReal*a.Weight)+1),'0.00') as WEIGHT,\
		 '(255 255 255 )' as LINERGB \
		 FROM PRODUCT a, PALLET_PRODUCT LP, MONTHLABEL M \
		 WHERE LP.IdProduct=a.ID and a.TypeProduct<>'F'\
	 AND LP.DateCreate>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and LP.DateCreate<format(Date(),'YYYY-MM-DD')\
	 AND M.NoMonth=format(LP.DateCreate,'MM')+0 \
		 GROUP BY M.NoMonth, M.NameFR \
		 UNION SELECT\
		 (format(max(LP.DateCreate),'YYYY')+'99') as ID, 'TOTAL' as NAMEMONTH,\
		 format(sum(LP.QuantityDefective)*100/(sum(LP.QuantityReal)+1), '0.00') as QUANTITY,\
		 format(sum(LP.QuantityDefective*a.PriceUnit)*100/(sum(LP.QuantityReal*a.PriceUnit)+1), '0.00') as COST,\
		 format(sum(LP.QuantityDefective*a.Weight)*100/(sum(LP.QuantityReal*a.Weight)+1),'0.00') as WEIGHT,\
		 '(255 255 255 )' as LINERGB \
	 FROM PRODUCT a, PALLET_PRODUCT LP,MONTHLABEL M \
	 WHERE LP.IdProduct=a.ID and a.TypeProduct<>'F'\
	 AND LP.DateCreate>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and LP.DateCreate<format(Date(),'YYYY-MM-DD')\
	 AND M.NoMonth=format(LP.DateCreate,'MM')+0 \
	 ORDER by ID "

