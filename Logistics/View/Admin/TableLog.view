View ViewTableLOG 'Journal du travail' 'Journal du travail'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableLOG _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Journal du travail;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Center,Center,Left,Left}]"\
"[DATAOBJ=LOG;FILLCOLOR=LINERGB]"

Data LOG 'Journal du travail' LOG HTTPSQL 0 '[FIND={IDUSERLOG,NAMEUSERLOG,NAMECLUBLOG,PERMISSIONLOG,T1LOG,T2LOG,OPERATIONLOG,MESSAGELOG}]'   [DOUBLECLICK=EditLog] \
"[8;(string,IDUSERLOG,ID Utilisateur,,15,,);(string,NAMEUSERLOG,Nom Utilisateur,,15,,);(string,NAMECLUBLOG,Division,,10,,);(string,PERMISSIONLOG,Catégorie,,15,,);(string,T1LOG,début,,20,,);(string,T2LOG,fin,,20,,);(string,OPERATIONLOG,Opération,,25,,);(string,MESSAGELOG,Message,,25,,);(color,LINERGB,,,13.0.0);(string,IDCLUBLOG,Division,,10,0)]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT l.idClub	AS IDCLUBLOG,\
			 c.name			AS NAMECLUBLOG,\
			 l.idUser		AS IDUSERLOG,\
			 u.name			AS NAMEUSERLOG,\
			 l.ip			AS IPLOG,\
			 l.t1			AS T1LOG,\
			 l.t2			AS T2LOG,\
			 l.operation		AS OPERATIONLOG,\
			 l.comments		AS MESSAGELOG, \
			 (SELECT al.name FROM ALIAS al WHERE al.category='PERMISSION' AND al.id=l.permission) AS PERMISSIONLOG, \
			 IIF(l.t2 IS NULL AND (l.idUser=u.id OR l.permission>'0'),'(255 140 0)','(255 255 255)') AS LINERGB \
		  FROM   LOG l,CLUB c,USER u \
		  WHERE l.idClub=c.id AND l.idUser=u.id AND  EXISTS (SELECT 1 FROM USER usr,CLUB_CLUB cc WHERE '(/*USERID*/)'=usr.id AND cc.idClub=usr.idClub AND cc.idClubRelated=u.idClub AND ( usr.permission>='1' OR usr.id=u.id))\
ORDER BY 11,1,6 DESC,7 DESC,3 "

Script EditLog 'Editer' _ 1 'Editer' _ 'tableLOG' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE LOG&idUser in ({/*selected(tableLOG;1;(string,IDUSERLOG))*/}) AND t1 in ({/*selected(tableLOG;1;(string,T1LOG))*/}) "\
Reload _ _ _ _ 


