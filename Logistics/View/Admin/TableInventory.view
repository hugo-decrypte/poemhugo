"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);IDCOLOR=(200 200 200);IDTOUR='XXX';TITLEOBJ=Commandes pour produit {/*Selected(tableINVENTORY;1;(string,IDPRODUCT))*/};OWNEROBJ=IdClient;IDOBJ='XXX';OWNERSUBOBJ=IdProduct;IDSUBOBJ={/*Selected(tableINVENTORY;1;(string,IDPRODUCT))*/}]"

