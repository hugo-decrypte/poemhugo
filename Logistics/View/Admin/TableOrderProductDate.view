View ViewTableORDERPRODUCTDATE 'Détail commande par date' 'Détail commande par date'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableORDERPRODUCTDATE _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Détail commande par date;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Center,Right,Right,Right,Right,Right,Right,Left}]"\
"[DATAOBJ=ORDERPRODUCTDATE;FILLCOLOR=LINERGB]"

Data ORDERPRODUCTDATE 'Détail commande par date' ORDERPRODUCTDATE HTTPSQL 0 '[FIND={ID,NAMECLIENT,IDPRODUCT,DESIGNATION,DATEDELIVERY,PRICE,QUANTITY,QUANTITYDELIVERY,QUANTITYREST,QUANTITYSTOCK,WEIGHT,STATE}]'   [DOUBLECLICK=] \
"[12;(string,ID,ID commande,,20,,);(string,NAMECLIENT,Client,,30,,);(string,IDPRODUCT,Produit,,15,,);(string,DESIGNATION,Désignation,,30,,);(date,DATEDELIVERY,Date livraison,,15,,YYYY-MM-DD|DD/MM/YYYY);(float,PRICE,Prix unitaire,,13,,);(float,QUANTITY,Quantité,,13,,);(float,QUANTITYDELIVERY,Qté en livraison,,13,,);(float,QUANTITYREST,Qté reste,,13,,);(float,QUANTITYSTOCK,Qté stock,,13,,);(float,WEIGHT,Poids,,13,,);(string,STATE,Etat,,8,,);(string,IDCLIENT,ID client,,20.0.50,0);\
(color,LINERGB,(255 255 255),,13.0.0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT\
		 O.Id AS ID, O.idClient AS IDCLIENT, cl.Name as NAMECLIENT,\
		 PR.Id as IDPRODUCT,\
		 PR.Designation as DESIGNATION,\
		 OP.Quantity as QUANTITY,\
		 OP.QuantityRest as QUANTITYREST,\
		 OP.QuantityDelivered as QUANTITYDELIVERY,\
		 PR.QuantityStock as QUANTITYSTOCK,\
		 PR.PriceUnit as PRICE,\
		 OP.DateDelivery as DATEDELIVERY,\
		 PR.Weight*OP.Quantity as WEIGHT,\
		 IIF(OP.QuantityRest>PR.QuantityStock and OP.QuantityRest>0,'Stock insuffisant',\
		 IIF(OP.QuantityRest<OP.Quantity and OP.QuantityRest>0,'Livrée partielle',\
		  IIF(OP.QuantityRest=0,'Livrée',\
		   'A livrer') )) AS STATE, \
		 IIF(OP.QuantityRest>PR.QuantityStock and OP.QuantityRest>0,'(255 160 160)',\
		  IIF(OP.QuantityRest<OP.Quantity and OP.QuantityRest>0,'(255 255 160)',\
		  IIF(OP.QuantityRest=0,'(120 255 160)',\
		   '(255 250 250)' ) ) ) AS LINERGB \
	 FROM CLIENTORDER O, CLIENT CL, ORDER_PRODUCT_DATE OP, PRODUCT PR \
	 WHERE O.IdClient=CL.Id and O.Id=OP.IdOrder and PR.Id=OP.IdProduct\
	 AND (O.Id in ((/*IDORDER*/)) or 'XXX' in ((/*IDORDER*/)) )\
	 AND ( (OP.QuantityRest>0 and O.IdState<>'9' and OP.IdProduct in ((/*IDPRODUCT*/)) ) or 'XXX' in ((/*IDPRODUCT*/)) )\
	 ORDER BY  PR.Id, OP.DateDelivery, O.Id"

Script EditOrderProduct 'Editer' _ 1 'Editer' _ 'tableORDERPRODUCTDATE' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE ORDER_PRODUCT_DATE&idOrder in ({/*selected(ORDERPRODUCTDATE;1;(string,ID))*/}) and idProduct in ({/*selected(tableORDER;1;(string,IDPRODUCT))*/})"
Reload _ _ _ _ 


