View ViewTableALIAS 'Légende' 'Légende'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableALIAS _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Légende;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left}]"\
"[DATAOBJ=ALIAS;FILLCOLOR=LINERGB]"

Data ALIAS 'Légende' ALIAS HTTPSQL 0 '[FIND={CATEGORY,FIELD,ID,NAME,COMMENTS}]'   [DOUBLECLICK=EditAlias] \
"[5;(string,CATEGORY,Catégorie,,10,,);(string,FIELD,Champ,,10,,);(string,ID,ID,,10,,);(string,NAME,Nom,,20,,);(string,COMMENTS,Commentaire,,30,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT a.id AS ID,\
			a.name AS NAME,\
			a.category AS CATEGORY,\
			a.field AS FIELD,\
			a.comments AS COMMENTS,\
			IIF(a.color IS NOT NULL ,a.color,'(255 255 255)') AS COLOR,\
			IIF(a.color IS NOT NULL ,a.color,'(255 255 255)') AS LINERGB\
	 	FROM ALIAS a\
	 	ORDER BY a.category,a.field,a.id"


Script EditAlias 'Editer Alias' _ 1 'Editer' _ 'tableALIAS' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE ALIAS&id in ({/*selected(tableALIAS;1;(string,ID))*/})&field in ({/*selected(tableALIAS;1;(string,FIELD))*/})&category in ({/*selected(tableALIAS;1;(string,CATEGORY))*/})"\
Reload _ _ _ _ 


