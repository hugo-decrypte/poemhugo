View ViewTablePRODUCT_PRICE 'Prévision évolution prix' 'Prévision évolution prix'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tablePRODUCT_PRICE _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Prévision évolution prix;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Center,Center,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right}]"\
"[DATAOBJ=PRODUCT_PRICE;FILLCOLOR=LINERGB]"

Data PRODUCT_PRICE 'Prévision évolution prix' PRODUCT_PRICE HTTPSQL 0 '[FIND={NAMECLUB,ID,DATEDTART,DATEEND,MINPRICE,PRODUCERSMINPRICE,QUANTITYMINPRICE,WEIGHTMINPRICE,VOLUMEMINPRICE,MAXPRICE,PRODUCERSMAXPRICE,QUANTITYMAXPRICE,WEIGHTMAXPRICE,VOLUMEMAXPRICE,PROBABILITY}]'   [DOUBLECLICK=] \
"[15;(string,NAMECLUB,Division,,10,,);(string,ID,ID,,15,,);(date,DATEDTART,Date début,,15,,YYYY-MM-DD|DD/MM/YYYY);(date,DATEEND,Date fin,,15,,YYYY-MM-DD|DD/MM/YYYY);(float,MINPRICE,Prix minimum,,15,,);(string,PRODUCERSMINPRICE,Producteurs,,15,,);(int,QUANTITYMINPRICE,Quantité unitaire,,15,,);(float,WEIGHTMINPRICE,Poids unitaire,,15,,);(float,VOLUMEMINPRICE,Volume unitaire,,15,,);(float,MAXPRICE,Prix maximum,,15,,);(string,PRODUCERSMAXPRICE,Producteurs,,15,,);(int,QUANTITYMAXPRICE,Quantité unitaire,,15,,);(float,WEIGHTMAXPRICE,Poids unitaire,,15,,);(float,VOLUMEMAXPRICE,Volume unitaire,,15,,);(float,PROBABILITY,Probabilité,,15,,);(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT  pp.ID 				as ID,\
		 pp.minPrice 			as MINPRICE,\
		  pp.producersMinPrice 	as PRODUCERSMINPRICE, \
		  pp.quantityMinPrice 	as QUANTITYMINPRICE, \
		  pp.weightMinPrice 	as WEIGHTMINPRICE, \
		  pp.volumeMinPrice 	as VOLUMEMINPRICE, \
		  pp.maxPrice 			as MAXPRICE,\
		  pp.producersMaxPrice 	as PRODUCERSMAXPRICE, \
		  pp.quantityMaxPrice 	as QUANTITYMAXPRICE, \
		  pp.weightMaxPrice 	as WEIGHTMAXPRICE, \
		  pp.volumeMaxPrice 	as VOLUMEMAXPRICE, \
		  pp.probability		as PROBABILITY, \
		  '(255 255 255 )' 		as LINERGB \
	 FROM  PRODUCT_PRICE pp\
	 WHERE pp.idClub='(/*CLUBID*/)' \
	 ORDER BY pp.ID"


Script EditPRODUCTPRICE 'Editer' _ 1 'Editer' _ 'tablePRODUCT_PRICE' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE PRODUCT_PRICE&Id in ({/*selected(tablePRODUCT_PRICE;1;(string,ID))*/})"\
Reload _ _ _ _ 


