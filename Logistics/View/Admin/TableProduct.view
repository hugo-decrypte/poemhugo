 '(/*SERVERPORT*/) (/*USERID*/) \
{/*Input(CPRD;Créer produit;4;\
(string,IDNEW,Nouveau ID,,20.0.580,0);\
(string,FAMILY,Famille,,50.0.580,0,1,[/*FAMILYPRODUCT.LABELFAMILY*/],1);\
(string,DESIGNATION,Désignation,,100.0.580,1);\
(string,TYPEPRODUCT,Type produit,,100.0.580,0,0,[/*TYPEPRODUCT.LABELTYPE*/]);\
)*/}\
'\
Reload _ _ _

