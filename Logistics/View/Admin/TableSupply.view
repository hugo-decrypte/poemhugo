SUPPLIER 'Supplier' SUPPLIER HTTPSQL 0 _ _ \
"[2;(string,IDSUPPLIER,Fournisseur ID,,15.0.80,0);(string,LABELSUPPLIER,Identit  Fournisseur,,100.0.100,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT sp.Id AS IDSUPPLIER,\
 (trim(sp.Name) + ' (' + trim(sp.City) + ')') as LABELSUPPLIER \
 FROM SUPPLIER sp \
 ORDER BY sp.Id"

Data STATE 'State' STATE HTTPSQL 0 _ _ \
"[2;(string,IDSTATE,Statut ID,,15.0.80,0);(string,LABELSTATE,Libellé,,50.0.300,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=select s.Id AS IDSTATE, \
	(trim(LABEL) + '(' + trim(ID) + ')') as LABELSTATE \
	FROM STATE s \
WHERE s.Category='SUPPLY' \
ORDER BY s.Id "

