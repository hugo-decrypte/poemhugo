View ViewTableSUPPLY 'Provision' 'Provision'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableSUPPLY _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Provision;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Center,Center,Center,Right,Right,Left,Left,Left,Left,Left,Left,Left}]"\
"[DATAOBJ=SUPPLY;FILLCOLOR=LINERGB]"

Data SUPPLY 'Provision' SUPPLY HTTPSQL 0 '[FIND={ID,IDSUPPLIER,NAMESUPPLIER,DATESUPPLY,DATEDELIVERY,DATELIMIT,QUANTITY,AMOUNTHT,REFERENCE,PRODUCTCONDITION,PAYCONDITION,PACKAGING,CUSTOMSINFO,INCOTERM,COMMENTS}]'   [DOUBLECLICK=TableSupplier] \
"[15;(string,ID,ID,,20,,);(string,IDSUPPLIER,ID fournisseur,,25,,);(string,NAMESUPPLIER,Nom fournisseur,,30,,);(date,DATESUPPLY,Date devis,,20,,YYYY-MM-DD|DD/MM/YYYY);(date,DATEDELIVERY,Date livraison,,30,,YYYY-MM-DD|DD/MM/YYYY);(date,DATELIMIT,Date limite,,20,,YYYY-MM-DD|DD/MM/YYYY);(int,QUANTITY,Quantité,,15,,);(float,AMOUNTHT,Montant HT(€),,25,,);(string,REFERENCE,Référence,,25,,);(string,PRODUCTCONDITION,Réalisation,,25,,);(string,PAYCONDITION,Mode règlement,,25,,);(string,PACKAGING,Conditionnement,,25,,);(string,CUSTOMSINFO,Info client,,20,,);(string,INCOTERM,Incoterm,,20,,);(string,COMMENTS,Commentaire,,25,,);(string,IDAGENCY,ID agence,,15,0);(string,NAMEAGENCY,Nom agence,,50,0);\
(color,LINERGB,(255 255 255),,13.0.0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT s.id AS ID, s.id AS IDSUPPLIER,\
 (select Name from SUPPLIER sr where sr.Id=s.Id) as NAMESUPPLIER,\
 s.DateSupply as DATESUPPLY,\
 s.DateDelivery as DATEDELIVERY,\
 s.DateLimit as DATELIMIT,\
 s.Quantity   AS QUANTITY, s.AmountHT   AS AMOUNTHT, s.Reference  AS REFERENCE,\
 s.ProductCondition AS PRODUCTCONDITION,\
 s.PayCondition  AS PAYCONDITION, s.Packaging AS PACKAGING,\
 s.CustomsInfo  AS CUSTOMSINFO, s.Incoterm  AS INCOTERM,\
 s.Comments AS COMMENTS,\
 s.idAgency AS IDAGENCY, ay.Name as NAMEAGENCY,\
 '(255 255 255)' AS LINERGB \
FROM SUPPLY s, AGENCY ay \
WHERE s.IdAgency=ay.Id \
and (s.IdState is NULL or s.IdState not in ('9') )\
ORDER BY s.Id"


Script TableSupplier 'Table Supplier' _ 21 'Fournisseurs' _ 'tableSUPPLY' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TableSupplier.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);IDSUPPLY={/*Selected(tableSUPPLY;1;(string,ID))*/};IDPRODUCT='XXX']"

