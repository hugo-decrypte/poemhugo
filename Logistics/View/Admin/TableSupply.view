Script PrintSupply 'Print Supply' _ 80 'Imprimer' _ 'tableSUPPLY' '( 0 0 0 0 )' _ _ _  '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' \
	 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Script\ScriptPrint.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
	 '(/*SERVERPORT*/) (/*USERID*/)  PrintSupply.ini  SupplyOrder \
	 {/*selected(tableSUPPLY;1;(string,ID))*/}' \
	 WinExec "[WAITTIME=600S;CONSOLE=0;;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]"\
	 'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe' '(/*POEMPRINTAPPPATH*/)SupplyOrder{/*selected(tableSUPPLY;1;(string,ID))*/}.pdf' _ _ _ _ _ 

Script CreateSupply 'Créer provision' _ 61 'Créer' _ 'tableSUPPLY' '( 0 0 0 0 )' _ _ _  '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \
Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Supply\CreateSupply.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
 '(/*SERVERPORT*/) (/*USERID*/)  \
{/*Input(Créer provision;3;\
(string,LABELSUPPLIER,Fournisseur,,100.0.580,0,,[/*SUPPLIER.LABELSUPPLIER*/]);\
(date,DATEDELIVERY,Date livraison,,10.0.580,1,YYYY-MM-DD);\
(date,DATELIMIT,Date Limite,,10.0.580,1,YYYY-MM-DD);\
)*/}\
'\
Reload _ _ _

