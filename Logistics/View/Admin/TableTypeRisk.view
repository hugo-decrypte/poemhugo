View ViewTableTYPERISK 'Type risque' 'Type risque'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableTYPERISK _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Type risque;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Right,left}]"\
"[DATAOBJ=TYPERISK;FILLCOLOR=LINERGB]"

Data TYPERISK 'Type risque' TYPERISK HTTPSQL 0 '[FIND={ID,NAME,COST,COMMENTS}]'   [DOUBLECLICK=EditTypeRisk] \
"[4;(string,ID,ID,,10,,);(string,NAME,Nom,,20,,);(float,COST,Coût,,20,,);(string,COMMENTS,Commentaire,,20,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT t.id 			AS ID, \
			t.name 				AS NAME,\
			t.cost				AS COST,\
			t.comments 			AS COMMENTS,\
			(SELECT al.name FROM ALIAS al WHERE al.category='STATE' AND al.id=t.state) AS NAMESTATE,\
			(SELECT al.color FROM ALIAS al WHERE al.category='STATE' AND al.id=t.state) AS LINERGB \
	 		FROM TYPERISK t \
	 		ORDER BY t.state DESC,t.id"


Script EditTypeRisk 'Editer Type Risk' _ 1 'Editer' _ 'tableTYPERISK' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE TYPERISK&id IN ({/*selected(tableTYPERISK;1;(string,ID))*/})"\
Reload _ _ _ _ 


