View ViewTableTYPETRIP 'Type déplacements' 'Type déplacements'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableTYPETRIP _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Type déplacements;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left,Right,Right,Right,Right,Left}]"\
"[DATAOBJ=TYPETRIP;FILLCOLOR=LINERGB]"

Data TYPETRIP 'Type déplacements' TYPETRIP HTTPSQL 0 '[FIND={ID,NAME,CATEGORY,TITLE,NAMETRANSPORTSUBSIDY,NBLUNCH,NBNIGHT,COSTLUNCH,COSTNIGHT,COMMENTS}]'   [DOUBLECLICK=EditTypeTrip] \
"[10;(string,ID,ID,,20,,);(string,NAME,Nom,,20,,);(string,CATEGORY,Catégorie,,20,,);(string,TITLE,Titre,,25,,);(string,NAMETRANSPORTSUBSIDY,Véhicule personnel,,15,,);(int,NBLUNCH,#Déjeuner,,15,,);(int,NBNIGHT,#Nuit,,15,,);(float,COSTLUNCH,Déjeuner (€),,15,,);(float,COSTNIGHT,Coût nuit (€),,15,,);(string,COMMENTS,Commentaire,,20,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT t.id 					AS ID, \
			t.name 						AS NAME,\
			t.idx						AS IDX,\
			(SELECT al.name FROM ALIAS al WHERE al.category='TRIP' AND al.field='category' AND al.id=t.category)	AS CATEGORY,\
			t.title 					AS TITLE,\
			t.transportSubsidy				AS NAMETRANSPORTSUBSIDY, \
			t.nbTrip					AS NBTRIP,\
			t.nbLunch					AS NBLUNCH,\
			t.nbNight					AS NBNIGHT,\
			t.costLunch					AS COSTLUNCH,\
			t.costNight 					AS COSTNIGHT,\
			t.comments 					AS COMMENTS,\
			(SELECT al.name FROM ALIAS al WHERE al.category='STATE' AND al.id=t.state) AS NAMESTATE,\
			(SELECT al.color FROM ALIAS al WHERE al.category='STATE' AND al.id=t.state) AS LINERGB \
	 		FROM TYPETRIP t \
	 		ORDER BY t.state DESC,t.id"


Script EditTypeTrip 'Editer Type Trip' _ 1 'Editer' _ 'tableTYPETRIP' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE TYPETRIP&id IN ({/*selected(tableTYPETRIP;1;(string,ID))*/})"\
Reload _ _ _ _ 


