View ViewChartPRODUCT 'Diagramme produit' 'Diagramme produit'255 255 255 _ 0 0 0 0  5 5 5 5 '[TRACELEVEL=0;TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=1;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(192 192 255);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;]'

Script EditProduct 'Editer produit' _ 16 'Editer' _ '[OBJECTIDS={DIAGRAM}; SUBOBJTYPE={PRODUCT}]' '( 0 0 0 0 )' _ _ _  '[COUNT=1; NETNCL=HTTP; SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/); MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' \
 WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE PRODUCT&idProcess in ({/*selected(PRODUCT;1;(string,IDPROCESS))*/})" _ _ _ _ _ _ _ 


Script EditTask 'Editer tâche' _ 17 'Editer' _ '[OBJECTIDS={DIAGRAM}; SUBOBJTYPE={TASK}]' '( 0 0 0 0 )' _ _ _  '[COUNT=1; NETNCL=HTTP; SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/); MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' \
 WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE PROCESS&id in ({/*selected(TASK;1;(string,IDPROCESS))*/})" _ _ _ _ _ _ _ 


Data  'PRODUCT'  'Diagramme produit'  'PRODUCT' HTTPSQL 0 '[FIND={IDPROCESS,NAMEPROCESS}]; [TIPINFO=[/*NAMEPROCESS*/]     [/*IDPROCESS*/]]'  '_' \
"[4;(string,ID,ID,,255,0);(string,ParentID,ID parent,,255,0);(string,IDPROCESS,ID,,255,0);(string,NAMEPROCESS,Nom,,255,0);(int,SERIALNO,Numéro de série,,255,0);(string,TEXT,TEXT,,255,0);(string,COLOR,COLOR,,,);(string,IDCLUB,Division,,255,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	DISTINCT p.idClub	AS IDCLUB, \
				p.idProcess		AS IDPROCESS, \
				p.name			AS NAMEPROCESS, \
				0			AS SERIALNO, \
				NULL	 		AS ParentID, \
				p.id+p.idProcess AS ID, \
				' '+p.name AS [TEXT], \
				'(235 235 255)' AS COLOR \
			FROM	APS_PRODUCT p,(SELECT parent.idProcess2 AS id, parent.idProcess1 AS idParent, pn.idProcess1 AS idRoot FROM PROCESS_PROCESS parent,PROCESS_PROCESS pn WHERE parent.idProcess1=pn.idProcess2 AND pn.type='99' AND parent.type='00') pp \
			WHERE	pp.idRoot=p.idProcess AND p.idClub IN ('03')\
UNION SELECT	DISTINCT p.idClub	AS IDCLUB, \
				n.id			AS IDPROCESS, \
				n.name			AS NAMEPROCESS, \
				n.idxParent		AS SERIALNO, \
				p.id+pp.idParent AS ParentID, \
				p.id+pp.id AS ID, \
				' '+n.name AS [TEXT], \
				'(235 235 255)' AS COLOR \
			FROM	APS_PRODUCT p,(SELECT parent.idProcess2 AS id, parent.idProcess1 AS idParent, pn.idProcess1 AS idRoot FROM PROCESS_PROCESS parent,PROCESS_PROCESS pn WHERE parent.idProcess1=pn.idProcess2 AND pn.type='99' AND parent.type='00') pp,PROCESS n \
			WHERE	pp.idRoot=p.idProcess AND n.id=pp.id AND n.id<>pp.idRoot AND n.category<>'3' AND p.idClub IN ('03')\
ORDER BY 1,4,2"

Data  'TASK'  'TASK'  'TASK' HTTPSQL 0 '[FIND={IDPROCESS,NAMEPROCESS,NAMEJOB}; TIPINFO=[/*NAMEPROCESS*/]     [/*IDPROCESS*/]]'  '_' \
"[6;(string,ID,ID tâche,,255,0);(string,IDPROCESS,ID,,255,0);(string,NAMEPROCESS,Nom,,255,0);(string,IDSUCCESSOR,Successeur,,255,0);(string,ItemID,ID parent,,255,0);(string,NAMEJOB,ID parent,,255,0);(string,CAPTION,Caption,,255,0);(string,TEXT,Text,,255,0);(string,SERIALNO,Numéro de série,,255,0);(string,IDCLUB,Division,,20,0);(string,COLOR,COLOR,,,);(date,DateBegin,DateBegin,,,,YYYY-MM-DD|DD/MM/YYYY);(date,DateEnd,DateEnd,,,,YYYY-MM-DD|DD/MM/YYYY);(time,TimeBegin,TimeBegin,,,,HH:MM);(time,TimeEnd,TimeEnd,,,,HH:MM);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	DISTINCT p.idClub	AS IDCLUB, \
				n.idxParent		AS SERIALNO, \
				n.id			AS IDPROCESS, \
				n.name			AS NAMEPROCESS, \
				(SELECT p2.name FROM PROCESS p2 WHERE p2.id=pp.idParent) AS NAMEJOB, \
				'2000-01-01' AS DateBegin, \
				'2000-01-01' AS DateEnd, \
				'00:00' AS TimeBegin, \
				'23:59' AS TimeEnd, \
				p.id+pp.idParent AS ItemID, \
				p.id+pp.idParent+pp.id AS ID, \
				' '+IIF(n.idxParent IS NULL,'',CSTR(n.idxParent))+'  '+n.name AS [TEXT], \
				'(128 168 198)' AS COLOR \
			FROM	APS_PRODUCT p,(SELECT parent.idProcess2 AS id, parent.idProcess1 AS idParent, pn.idProcess1 AS idRoot FROM PROCESS_PROCESS parent,PROCESS_PROCESS pn WHERE parent.idProcess1=pn.idProcess2 AND pn.type='99' AND parent.type='00') pp,PROCESS n \
			WHERE	pp.idRoot=p.idProcess AND n.id=pp.id AND n.category='3' AND p.idClub IN ('03')\
ORDER BY 1,2,3"

