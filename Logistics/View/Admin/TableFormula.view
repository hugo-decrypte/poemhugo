View ViewTableFORMULA '' ''  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableFORMULA _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left}]"\
"[DATAOBJ=FORMULA;FILLCOLOR=LINERGB]"

Data FORMULA '' FORMULA HTTPSQL 0 '[FIND={CATEGORY,ID,NAME,PROGRAM,COMMENTS}]'   [DOUBLECLICK=EditFormula] \
"[5;(string,CATEGORY,Catégorie,,10,,);(string,ID,ID,,8,,);(string,NAME,Nom,,20,,);(string,PROGRAM,Formule,,100,,);(string,COMMENTS,Excel,,15,,);(color,LINERGB,,,13.0.0)]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	(SELECT clb.name FROM CLUB clb WHERE clb.id=f.idClub)	AS NAMECLUB,\
				(SELECT al.name FROM ALIAS al WHERE al.category='SHEET' AND al.field='formula' AND al.id=f.category)	AS CATEGORY,\
				f.id									AS ID,\
				f.name									AS NAME,\
				f.program								AS PROGRAM,\
				f.comments								AS COMMENTS,\
				f.color									AS LINERGB\
			FROM FORMULA f\
			ORDER BY f.idClub,f.category,f.id "

Script EditFormula 'Edit Formula' _ 1 'Editer' _ 'tableFORMULA' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE FORMULA&idClub IN ('03') AND id in ({/*selected(tableFORMULA;1;(string,ID))*/})"\
Reload _ _ _ _ 


