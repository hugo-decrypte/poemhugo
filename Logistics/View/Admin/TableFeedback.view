COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Center,Right,Right,Right,Left}]"\
"[DATAOBJ=FEEDBACK;FILLCOLOR=LINERGB]"

Data FEEDBACK 'Suivi véhicule' FEEDBACK HTTPSQL 0 '[FIND={IDRESOURCE,IDFEEDBACK,T0,LATITUDE,LONGITUDE,KM,NAMESTATE}]'   [DOUBLECLICK=] \
"[7;(string,IDRESOURCE,Véhicule,,10,,);(string,IDFEEDBACK,Tournée,,10,,);(datetime,T0,Temps,,20,,YYYY-MM-DD HH:MM|DD/MM/YYYY HH:MM);(string,LATITUDE,Latitude,,10,,);(string,LONGITUDE,Longitude,,10,,);(int,KM,KM,,10,,);(string,NAMESTATE,Etat,,15,,);(color,LINERGB,(255 255 255),,13.0.0)]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT f.idClub						AS NAMECLUB, \
			f.id							AS IDFEEDBACK, \
			f.idResource						AS IDRESOURCE, \
			f.datetime						AS T0, \
			f.latitude						AS LATITUDE, \
			f.longitude						AS LONGITUDE, \
			f.KM							AS KM, \
			f.state							AS STATE, \
			(SELECT al.name FROM ALIAS al WHERE al.category='EVENT' AND al.id=f.state)	AS NAMESTATE,\
			(SELECT al.color FROM ALIAS al WHERE al.category='EVENT' AND al.id=f.state)	AS LINERGB \
		FROM	FEEDBACK f \
		ORDER BY f.idResource,f.datetime "

