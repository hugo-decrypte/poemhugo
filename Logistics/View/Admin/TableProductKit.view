// 10.1  for all component (sub article) , compute their quantity from quantitative measures
// 10.2  for all component semi-finished having components, compute their price from their components sum(quntity*price)
// 10.3  the total price of the product is the sum(quantity*price) of all comenents not being component of prd semi-finished component
Script ModifyMeasuresForQty 'Modifier mesure quantitative' _ 65 'Modifier mesure quantitative' _ 'tablePRODUCTKIT' '( 0 0 0 0 )' '[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' _ _  '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \
'{/*Input(MMQTY;Modifier mesure quantitative;10;\
(float,LENGTH,Length,[/*PRODUCTKIT.LENGTH*/],10.3.580,1);\
(float,WIDTH,Width,[/*PRODUCTKIT.WIDTH*/],10.3.580,1);\
(float,HEIGHT,Height,[/*PRODUCTKIT.HEIGHT*/],10.3.580,1);\
(float,DEPTH,Depth,[/*PRODUCTKIT.DEPTH*/],10.3.580,1);\
(float,VOLUME,Volume,[/*PRODUCTKIT.VOLUME*/],12.3.580,1);\
(float,WEIGHT,Weight,[/*PRODUCTKIT.WEIGHT*/],10.3.580,1);\
(float,PARAMETER1,Parameter1,[/*PRODUCTKIT.PARAMETER1*/],10.3.580,1);\
(float,PARAMETER2,Parameter2,[/*PRODUCTKIT.PARAMETER2*/],10.3.580,1);\
(string,FORMULA1,Formula 1,[/*PRODUCTKIT.FORMULA1*/],200.0.580,1);\
(string,FORMULA2,Formula 2,[/*PRODUCTKIT.FORMULA2*/],200.0.580,1);\
)*/}'\
"Update PRODUCT SET\
   Length=[/*LENGTH*/],\
   Height=[/*HEIGHT*/],\
   Width= [/*WIDTH*/],\
   Depth= [/*DEPTH*/],\
   Volume=[/*VOLUME*/],\
   Weight=[/*WEIGHT*/],\
   Parameter1=[/*PARAMETER1*/],\
   Parameter2=[/*PARAMETER2*/],\
   Formula1='[/*FORMULA1*/]',\
   Formula2='[/*FORMULA2*/]' \
  WHERE Id ='[/*PRODUCTKIT.ID*/]'"\
"Update PRODUCT_COMPONENT SET\
   Quantity=1\
  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
   and (\
     (LengthByPiece is not NULL and LengthByPiece>0) or \
     (WidthByPiece is not NULL and WidthByPiece>0) or \
     (DepthByPiece is not NULL and DepthByPiece>0) or \
     (HeightByPiece is not NULL and HeightByPiece>0) or \
     (VolumeByPiece is not NULL and VolumeByPiece>0)\
   ) "\
"Update PRODUCT_COMPONENT pc inner join PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Length+pc.LengthByPiece-0.001)/pc.LengthByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Length is not NULL and prd.Length>0\
	   and pc.LengthByPiece is not NULL and pc.LengthByPiece>0"\
\
"Update PRODUCT_COMPONENT pc inner join PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Height+pc.HeightByPiece-0.001)/pc.HeightByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Height is not NULL and prd.Height>0\
	   and pc.HeightByPiece is not NULL and pc.HeightByPiece>0"\
\
"Update PRODUCT_COMPONENT pc inner join PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Width+pc.WidthByPiece-0.001)/pc.WidthByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Width is not NULL and prd.Width>0\
	   and pc.WidthByPiece is not NULL and pc.WidthByPiece>0"\
\
"Update PRODUCT_COMPONENT pc inner join PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Depth+pc.DepthByPiece-0.001)/pc.DepthByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Depth is not NULL and prd.Depth>0\
	   and pc.DepthByPiece is not NULL and pc.DepthByPiece>0"\
\
"Update PRODUCT_COMPONENT pc inner join PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Volume+pc.VolumeByPiece-0.001)/pc.VolumeByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Volume is not NULL and prd.Volume>0\
	   and pc.VolumeByPiece is not NULL and pc.VolumeByPiece>0 "\
\
"Update PRODUCT set\
		PriceUnit=0,\
		PurchasePrice=0,\
		Weight=0\
	  WHERE Id ='[/*PRODUCTKIT.ID*/]'"\
"Update (PRODUCT prd inner join PRODUCT_COMPONENT pc on prd.Id=pc.IdProduct)\
			inner join PRODUCT sub on sub.Id=pc.IdSubProduct set\
		prd.PriceUnit	 =prd.PriceUnit+pc.Quantity*sub.PriceUnit, \
		prd.PurchasePrice=prd.PurchasePrice+pc.Quantity*sub.PurchasePrice, \
		prd.Weight		 =prd.Weight+pc.Quantity*sub.Weight \
	  WHERE prd.Id ='[/*PRODUCTKIT.ID*/]' and pc.Quantity>0 "\
"Update PRODUCT SET Weight=0 WHERE Id ='[/*PRODUCTKIT.ID*/]' and Weight is NULL"\
"Update PRODUCT SET PurchasePrice=0 WHERE Id ='[/*PRODUCTKIT.ID*/]' and PurchasePrice is NULL"


Data FAMILYPRODUCT 'Famille Produit' FAMILYPRODUCT HTTPSQL 0 _ _ \
"[2;(string,IDFAMILY,Statut ID,,15.0.80,0);(string,LABELFAMILY,Libellé,,50.0.300,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT f.Id AS IDFAMILY,\
	 (trim(f.DESIGNATION) + '(' + trim(f.ID) + ')') as LABELFAMILY \
	 FROM FAMILYPRODUCT f \
	 ORDER BY f.Designation,f.Id"

Data TYPEPRODUCT 'Type Produit' TYPEPRODUCT HTTPSQL 0 _ _ \
"[2;(string,IDTYPE,Statut ID,,15.0.80,0);(string,LABELTYPE,Libellé,,50.0.300,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT tp.Id AS IDTYPE,\
 (trim(name) + '(' + trim(ID) + ')') as LABELTYPE \
	 FROM TYPEPRODUCT tp \
	 ORDER BY tp.Id"

