View ViewTablePRODUCTKIT 'Kit produit' 'Kit produit'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tablePRODUCTKIT _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Kit produit;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Right,Right,Right,Right,Right,Right,Right,LeftCenter,Left}]"\
"[DATAOBJ=PRODUCTKIT;FILLCOLOR=LINERGB]"

Data PRODUCTKIT 'Kit produit' PRODUCTKIT HTTPSQL 0 '[FIND={ID,DESIGNATION,DESIGNATIONTECH,PRICE,PURCHASEPRICE,LENGTH,HEIGHT,WIDTH,DEPTH,VOLUME,WEIGHT,STATE}]'   [DOUBLECLICK=TableProductComponent] \
"[12;(string,ID,ID,,10,,);(string,DESIGNATION,Désignation,,20,,);(string,DESIGNATIONTECH,Matière,,20,,);(string,PRICE,Prix unitaire,,15,,);(float,PURCHASEPRICE,Prix achat,,15,,);(float,LENGTH,Longueur,,10,,);(float,HEIGHT,Hauteur,,10,,);(float,WIDTH,Largeur,,10,,);(float,DEPTH,Profondeur,,15,,);(float,VOLUME,Volume,,10,,);(float,WEIGHT,Référence,,10,,);(string,STATE,Etat,,15,,);(color,LINERGB,(255 255 255),,13.0.0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT prd.id AS ID, \
		 prd.Designation AS DESIGNATION,prd.DesignationTech AS DESIGNATIONTECH,\
		 prd.TypeProduct as TYPEPRODUCT,\
		 format(prd.PriceUnit,'0.0000') AS PRICE,\
		 format(prd.PurchasePrice,'0.0000') AS PURCHASEPRICE,\
		 format(prd.Length,'0') AS LENGTH,\
		 format(prd.Height,'0') AS HEIGHT,\
		 format(prd.Width,'0') AS WIDTH,\
		 format(prd.Depth,'0') AS DEPTH,\
		 format(prd.Volume,'0') AS VOLUME,\
		 format(prd.Weight,'0.0') AS WEIGHT,\
		 (select (trim(LABEL) + '(' + ID + ')') from STATE s where s.ID=prd.idState and s.CATEGORY='PRODUCT') as STATE,\
		 IIF(prd.idState in (select s.Id from STATE s where s.CATEGORY='PRODUCT') , (select Color from STATE s where s.Id=prd.idState and s.CATEGORY='PRODUCT'),\
		 '(255 255 255)') AS LINERGB \
 FROM PRODUCT prd \
 WHERE prd.TypeProduct in ('KIT') \
 ORDER BY prd.ID"




///////////////////// table component
Script TableProductComponent 'Kit produit' _ 334 'Composants' _ 'tablePRODUCTKIT' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TableProductProduct.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);FAMILY='XXX';IDPRODUCT={/*Selected(tablePRODUCTKIT;1;(string,ID))*/};TITLEOBJ={/*Selected(tablePRODUCTKIT;1;(string,DESIGNATION))*/}]"

