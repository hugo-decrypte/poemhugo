View ViewTablePRODUCTFORSUPPLY 'Produits à ajouter pour provision' 'Produits à ajouter pour provision'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tablePRODUCTFORSUPPLY _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Produits à ajouter pour provision;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Right,Right,Right,Right,Right,Right,Right,Center,Left}]"\
"[DATAOBJ=PRODUCTFORSUPPLY;FILLCOLOR=LINERGB]"

Data PRODUCTFORSUPPLY 'Produits à ajouter pour provision' PRODUCTFORSUPPLY HTTPSQL 0 '[FIND={IDPRODUCT,FAMILY,DESIGNATION,QUANTITYSTOCK,QUANTITYORDERED,QUANTITYSUPPLIED,PURCHASEPRICE,SALEPRICE,QUANTITY,PRICE,DATEDELIVERY,COMMENTS}]'   [DOUBLECLICK=] \
"[12;(string,IDPRODUCT,Produit,,15,,);(string,FAMILY,Famille,,10,,);(string,DESIGNATION,Désignation,,20,,);(float,QUANTITYSTOCK,Qté stock,,20,,);(float,QUANTITYORDERED,Qté commande,,20,,);(float,QUANTITYSUPPLIED,Qté provision,,25,,);(float,PURCHASEPRICE,Prix achat,,15,,);(float,SALEPRICE,Prix vente,,15,,);(float,QUANTITY,Quantité,,15,,);(float,PRICE,Prix unitaire,,15,,);(date,DATEDELIVERY,Date livraison,,20,,YYYY-MM-DD|DD/MM/YYYY);(string,COMMENTS,Commentaire,,30,,);(float,WEIGHT,Poids,,8.2.50,0);\
(float,WEIGHTPACKAGE,Poids/Paquet,,8.2.50,0);\
(date,DATESUPPLY, Date Appro,,10.0.80,1,YYYY-MM-DD);\
(color,LINERGB,(255 255 255),,13.0.0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT P.Id as IDPRODUCT,\
		 P.Designation as DESIGNATION,\
		 P.Family as FAMILY,\
		 P.QuantityPackaging as QUANTITYPACKAGE,\
		 P.QuantityStock as QUANTITYSTOCK,\
		  IIF(P.QuantitySupplied is NULL,0,P.QuantitySupplied) as QUANTITYSUPPLIED,\
		  P.QuantityOrdered as QUANTITYORDERED,\
		  P.PriceUnit as SALEPRICE,\
		  P.PurchasePrice as PURCHASEPRICE,\
		  P.Weight as WEIGHTUNIT,\
		  format(P.Weight*P.QuantityPackaging,'0.0') as WEIGHTPACKAGE,\
		  ' ' as NBPACKAGE,\
		  ' ' as QUANTITY,\
		  ' ' as PRICE,\
		  ' ' as DATESUPPLY,\
		  ' ' as DATEDELIVERY,\
		  ' ' as COMMENTS,\
		  0 as INORDER,\
		  ' ' AS STATE,\
		  '(255 255 255)' AS LINERGB \
	 FROM PRODUCT P \
	 WHERE ( P.Family in ((/*FAMILY*/)) or 'XXX' in ((/*FAMILY*/)) )\
	 AND P.TypeProduct<>'F'\
	 AND P.Id not in (select ls.Idproduct from SUPPLY_PRODUCT ls where ls.IdSupply in ((/*IDSUPPLY*/)))\
	 UNION ALL \
	 SELECT \
		  P.Id as IDPRODUCT,\
		  P.Designation as DESIGNATION,\
		  P.Family as FAMILY,\
		  P.QuantityPackaging as QUANTITYPACKAGE,\
		  P.QuantityStock as QUANTITYSTOCK,\
		  IIF(P.QuantitySupplied is NULL, 0, P.QuantitySupplied) as QUANTITYSUPPLIED,\
		  P.QuantityOrdered as QUANTITYORDERED,\
		  P.PriceUnit as SALEPRICE,\
		  P.PurchasePrice as PURCHASEPRICE,\
		  P.Weight as WEIGHTUNIT,\
		  format(P.Weight*P.QuantityPackaging,'0.0') as WEIGHTPACKAGE,\
		  IIF((ls.Quantity/P.QuantityPackaging)=format(ls.Quantity/P.QuantityPackaging,'0'), format(ls.Quantity/P.QuantityPackaging,'0'), format(ls.Quantity/P.QuantityPackaging,'0.#')) as NBPACKAGE,\
		  format(ls.Quantity,'0') as QUANTITY,\
		  ls.PriceUnit as PRICE,\
		  ls.DateSupply as DATESUPPLY,\
		  ls.DateDelivery as DATEDELIVERY,\
		  ls.Comments as COMMENTS,\
		  1 as INORDER,\
		  IIF((ls.Quantity/P.QuantityPackaging)>format(ls.Quantity/P.QuantityPackaging,'0'),  'Paquet incomplet', '' ) AS STATE,\
		  IIF((ls.Quantity/P.QuantityPackaging)>format(ls.Quantity/P.QuantityPackaging,'0'), '(255 255 160)',\
		   IIF(ls.Quantity=0 , '(200 200 200)',\
		    '(150 150 255)')) AS LINERGB \
	 FROM PRODUCT P \
		  inner join SUPPLY_PRODUCT ls on ls.Idproduct=P.Id \
	 WHERE ( P.Family in ((/*FAMILY*/)) or 'XXX' in ((/*FAMILY*/)) )\
	 AND (ls.IdSupply in ((/*IDSUPPLY*/)) ) \
	 ORDER BY INORDER desc, Family, DESIGNATION, IDPRODUCT "

Script TableOfferSupplier 'Détail commande pour produit' _ 21 'Détail commande pour produit' _ 'tablePRODUCTFORSUPPLY' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
