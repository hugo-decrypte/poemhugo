View ViewTableBALANCEWEIGHT 'Poids mensuels' 'Poids mensuels'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableBALANCEWEIGHT _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Poids mensuels;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right}]"\
"[DATAOBJ=BALANCEWEIGHT;FILLCOLOR=LINERGB]"

Data BALANCEWEIGHT 'Poids mensuels' BALANCEWEIGHT HTTPSQL 0 '[FIND={ID,DESIGNATION,PRICE,QUANTITY,COST,WEIGHT,WEIGHT1,WEIGHT2,WEIGHT3,WEIGHT4,WEIGHT5,WEIGHT6,WEIGHT7,WEIGHT8,WEIGHT9,WEIGHT10,WEIGHT11,WEIGHT12}]'   [DOUBLECLICK=] \
"[18;(string,ID,Produit,,10,,);(string,DESIGNATION,Désignation,,15,,);(float,PRICE,Prix unitaire,,10,,);(int,QUANTITY,Quantité,,10,,);(int,COST,Revenue,,10,,);(int,WEIGHT,Poids,,10,,);(int,WEIGHT1,Jan,,10,,);(int,WEIGHT2,Fév,,10,,);(int,WEIGHT3,Mar,,10,,);(int,WEIGHT4,Avr,,10,,);(int,WEIGHT5,Mai,,10,,);(int,WEIGHT6,Jun,,10,,);(int,WEIGHT7,Jul,,10,,);(int,WEIGHT8,Aoû,,10,,);(int,WEIGHT9,Sep,,13,,);(int,WEIGHT10,Oct,,13,,);(int,WEIGHT11,Nov,,13,,);(int,WEIGHT12,Déc,,13,,);(string,REFERENCE,Référence,,20,0);\
(string,LEVELTECH,Niveau Tech,,20,0);\
(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT  P.ID as ID, P.Reference as REFERENCE, P.LevelTech as LEVELTECH,\
		 P.PriceUnit as PRICE,\
		 sum(DP.QuantityReal) as QUANTITY,\
		 format(sum(DP.QuantityReal*DP.PriceUnit), '0.00') as COST,\
		 int(sum(DP.QuantityReal)*P.Weight+0.5) as WEIGHT,\
		 sum(IIF(M.NoMonth=1, DP.QuantityReal, 0)) as QTY1, format(sum(IIF(M.NoMonth=1, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST1, sum(IIF(M.NoMonth=1,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT1,\
		 sum(IIF(M.NoMonth=2, DP.QuantityReal, 0)) as QTY2, format(sum(IIF(M.NoMonth=2, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST2, sum(IIF(M.NoMonth=2,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT2,\
		 sum(IIF(M.NoMonth=3, DP.QuantityReal, 0)) as QTY3, format(sum(IIF(M.NoMonth=3, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST3, sum(IIF(M.NoMonth=3,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT3,\
		 sum(IIF(M.NoMonth=4, DP.QuantityReal, 0)) as QTY4, format(sum(IIF(M.NoMonth=4, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST4, sum(IIF(M.NoMonth=4,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT4,\
		 sum(IIF(M.NoMonth=5, DP.QuantityReal, 0)) as QTY5, format(sum(IIF(M.NoMonth=5, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST5, sum(IIF(M.NoMonth=5,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT5,\
		 sum(IIF(M.NoMonth=6, DP.QuantityReal, 0)) as QTY6, format(sum(IIF(M.NoMonth=6, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST6, sum(IIF(M.NoMonth=6,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT6,\
		 sum(IIF(M.NoMonth=7, DP.QuantityReal, 0)) as QTY7, format(sum(IIF(M.NoMonth=7, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST7, sum(IIF(M.NoMonth=7,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT7,\
		 sum(IIF(M.NoMonth=8, DP.QuantityReal, 0)) as QTY8, format(sum(IIF(M.NoMonth=8, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST8, sum(IIF(M.NoMonth=8,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT8,\
		 sum(IIF(M.NoMonth=9, DP.QuantityReal, 0)) as QTY9, format(sum(IIF(M.NoMonth=9, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST9, sum(IIF(M.NoMonth=9,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT9,\
		 sum(IIF(M.NoMonth=10,DP.QuantityReal, 0)) as QTY10,format(sum(IIF(M.NoMonth=10,DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST10,sum(IIF(M.NoMonth=10, int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT10,\
		 sum(IIF(M.NoMonth=11,DP.QuantityReal, 0)) as QTY11,format(sum(IIF(M.NoMonth=11,DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST11,sum(IIF(M.NoMonth=11, int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT11,\
		 sum(IIF(M.NoMonth=12,DP.QuantityReal, 0)) as QTY12,format(sum(IIF(M.NoMonth=12,DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST12,sum(IIF(M.NoMonth=12, int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT12,\
		 P.designation as DESIGNATION,\
		 '(255 255 255 )' as LINERGB \
	 FROM PRODUCT P, DELIVERY_PRODUCT DP, DELIVERY D , MONTHLABEL M  \
	 WHERE DP.IdDelivery=D.id and DP.IdProduct=P.ID and P.TypeProduct<>'F'\
	 AND D.DateDelivery>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and D.DateDelivery<format(Date(),'YYYY-MM-DD')\
	 AND M.NoMonth=format(D.DateDelivery,'MM')+0 \
	 GROUP BY P.ID, P.Reference, P.LevelTech, P.designation, P.PriceUnit, P.Weight \
	 UNION SELECT 'TOTAL' as ID, 'TOTAL' as REFERENCE, ' ' as LEVELTECH,\
		 0 as PRICE,\
		 sum(DP.QuantityReal) as QUANTITY,\
		 format(sum(DP.QuantityReal*P.PriceUnit), '0.00') as COST,\
		 sum(int(DP.QuantityReal*P.Weight+0.5)) as WEIGHT,\
		 sum(IIF(M.NoMonth=1, DP.QuantityReal, 0)) as QTY1, format(sum(IIF(M.NoMonth=1, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST1, sum(IIF(M.NoMonth=1,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT1,\
		 sum(IIF(M.NoMonth=2, DP.QuantityReal, 0)) as QTY2, format(sum(IIF(M.NoMonth=2, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST2, sum(IIF(M.NoMonth=2,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT2,\
		 sum(IIF(M.NoMonth=3, DP.QuantityReal, 0)) as QTY3, format(sum(IIF(M.NoMonth=3, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST3, sum(IIF(M.NoMonth=3,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT3,\
		 sum(IIF(M.NoMonth=4, DP.QuantityReal, 0)) as QTY4, format(sum(IIF(M.NoMonth=4, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST4, sum(IIF(M.NoMonth=4,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT4,\
		 sum(IIF(M.NoMonth=5, DP.QuantityReal, 0)) as QTY5, format(sum(IIF(M.NoMonth=5, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST5, sum(IIF(M.NoMonth=5,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT5,\
		 sum(IIF(M.NoMonth=6, DP.QuantityReal, 0)) as QTY6, format(sum(IIF(M.NoMonth=6, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST6, sum(IIF(M.NoMonth=6,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT6,\
		 sum(IIF(M.NoMonth=7, DP.QuantityReal, 0)) as QTY7, format(sum(IIF(M.NoMonth=7, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST7, sum(IIF(M.NoMonth=7,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT7,\
		 sum(IIF(M.NoMonth=8, DP.QuantityReal, 0)) as QTY8, format(sum(IIF(M.NoMonth=8, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST8, sum(IIF(M.NoMonth=8,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT8,\
		 sum(IIF(M.NoMonth=9, DP.QuantityReal, 0)) as QTY9, format(sum(IIF(M.NoMonth=9, DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST9, sum(IIF(M.NoMonth=9,  int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT9,\
		 sum(IIF(M.NoMonth=10,DP.QuantityReal, 0)) as QTY10,format(sum(IIF(M.NoMonth=10,DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST10,sum(IIF(M.NoMonth=10, int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT10,\
		 sum(IIF(M.NoMonth=11,DP.QuantityReal, 0)) as QTY11,format(sum(IIF(M.NoMonth=11,DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST11,sum(IIF(M.NoMonth=11, int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT11,\
		 sum(IIF(M.NoMonth=12,DP.QuantityReal, 0)) as QTY12,format(sum(IIF(M.NoMonth=12,DP.QuantityReal*P.PriceUnit, 0)),'0.00') as COST12,sum(IIF(M.NoMonth=12, int(DP.QuantityReal*P.Weight+0.5), 0)) as WEIGHT12,\
		 ' ' as DESIGNATION,\
		 '(255 255 255 )' as LINERGB \
	 FROM PRODUCT P, DELIVERY_PRODUCT DP, DELIVERY D , MONTHLABEL M  \
	 WHERE DP.IdDelivery=D.id and DP.IdProduct=P.ID and P.TypeProduct<>'F'\
	 AND D.DateDelivery>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and D.DateDelivery<format(Date(),'YYYY-MM-DD')\
	 AND M.NoMonth=format(D.DateDelivery,'MM')+0 \
	 ORDER BY REFERENCE, LEVELTECH "

