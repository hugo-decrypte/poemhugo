View ViewTableTOURORDER 'Feuille de route' 'Feuille de route'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableTOURORDER _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Feuille de route;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Right,Left,Left,Center,Right,Right,Right,Right,Right,Right,Right,Right}]"\
"[DATAOBJ=TOURORDER;FILLCOLOR=LINERGB]"

Data TOURORDER 'Feuille de route' TOURORDER HTTPSQL 0 '[FIND={IDTOUR,IDX,IDORDER,NAMESITE,T1PLAN,TIMESERVICE,TIMEROUTE,MILEAGE,QUANTITY,WEIGHT,VOLUME,COST,RECEIPTS}]'   [DOUBLECLICK=EditTourOrder] \
"[13;(string,IDTOUR,Tournée,,20,,);(int,IDX,No.,,10,,);(string,IDORDER,Commande,,25,,);(string,NAMESITE,Lieu,,40,,);(datetime,T1PLAN,début,,25,,YYYY-MM-DD HH:MM|DD/MM/YYYY HH:MM);(duration,TIMESERVICE,Temps de service,,30,,);(duration,TIMEROUTE,Temps de route,,30,,);(int,MILEAGE,KM,,15,,);(int,QUANTITY,Quantité,,15,,);(float,WEIGHT,Poids,,15,,);(float,VOLUME,Volume,,15,,);(float,COST,Coût,,15,,);(float,RECEIPTS,Recette,,15,,);(color,LINERGB,,,13.0.0)]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT p.idTour 										AS IDTOUR,	\
			p.idResource										AS IDVEHICLE,	\
			p.tourResource										AS TOURVEHICLE,	\
			p.idx-1											AS IDX,		\
			p.idOrder										AS IDORDER,	\
			p.idSite1		 								AS IDSITE,	\
			(SELECT IIF(s.name=NULL,s.city,s.name) FROM SITE s WHERE s.id=p.idSite1) 		AS NAMESITE,	\
			p.t1Service  											AS T1PLAN,	\
			p.timeService 										AS TIMESERVICE,	\
			p.timeRoute 										AS TIMEROUTE,	\
			(SELECT o.t1Service0+' - '+o.t2Service0 FROM OPT_ORDER o WHERE p.idOrder=o.id)	AS TIMEWINDOW,	\
			(SELECT o.quantity FROM OPT_ORDER o WHERE p.idOrder=o.id)			AS QUANTITY,	\
			(SELECT o.weight FROM OPT_ORDER o WHERE p.idOrder=o.id) 			AS WEIGHT,	\
			(SELECT o.volume FROM OPT_ORDER o WHERE p.idOrder=o.id)			AS VOLUME,	\
			p.mileage 										AS MILEAGE,	\
			p.receipts 										AS RECEIPTS,	\
			p.cost  										AS COST,	\
			IIF(p.idx=1,'(255 140 0)','(255 255 255)') AS LINERGB	\
		FROM 	OPT_PLAN p \
		WHERE 	 EXISTS (SELECT 1 FROM USER usr,CLUB_CLUB cc WHERE '(/*USERID*/)'=usr.id AND cc.idClub=usr.idClub AND cc.idClubRelated=p.idClub) ORDER BY p.idTour,p.t1Service"


Script EditTourOrder 'Editer' _ 1 'Editer' _ 'tableTOURORDER' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE OPT_PLAN&idTour in ({/*selected(tableTOURORDER;1;(string,IDTOUR))*/}) AND idOrder in ({/*selected(tableTOURORDER;1;(string,IDORDER))*/}) "\
Reload _ _ _ _ 


