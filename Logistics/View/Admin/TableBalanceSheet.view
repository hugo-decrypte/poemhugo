COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Right,Right,Right}]"\
"[DATAOBJ=BALANCESHEET;FILLCOLOR=LINERGB]"

Data BALANCESHEET 'Bilan général' BALANCESHEET HTTPSQL 0 '[FIND={NAMEMONTH,COST,WEIGHT,QUANTITY}]'   [DOUBLECLICK=] \
"[4;(string,NAMEMONTH,Mois,,10,,);(int,COST,CA,,10,,);(int,WEIGHT,Poids,,10,,);(int,QUANTITY,Quantité,,10,,);(string,ID,No Mois,,10,0);\
(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT  (format(max(DP.DateDelivery),'YYYY')+format(M.NoMonth,'0')) as ID,\
		 (format(max(DP.DateDelivery),'YYYY')+'  '+M.NameFR) as NAMEMONTH,\
		 sum(DP.QuantityReal) as QUANTITY,\
		 format(sum(DP.QuantityReal*DP.PriceUnit), '0.00') as COST,\
		 format(sum(DP.QuantityReal*P.Weight)+0.5,'0') as WEIGHT,\
		 '(255 255 255 )' as LINERGB \
	 FROM PRODUCT P, DELIVERY_PRODUCT DP, DELIVERY D , MONTHLABEL M \
	 WHERE DP.IdDelivery=D.id and DP.IdProduct=P.ID and P.TypeProduct<>'F'\
	 AND D.DateDelivery>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and D.DateDelivery<format(Date(),'YYYY-MM-DD')\
	 AND M.NoMonth=format(D.DateDelivery,'MM')+0 \
	 GROUP BY M.NoMonth, M.NameFR \
	 UNION SELECT\
		 (format(max(DP.DateDelivery),'YYYY')+'99') as ID, 'TOTAL' as NAMEMONTH,\
		 sum(DP.QuantityReal) as QUANTITY,\
		 format(sum(DP.QuantityReal*DP.PriceUnit), '0.00') as COST,\
		 format(sum(DP.QuantityReal*P.Weight)+0.5,'0') as WEIGHT,\
		 '(255 255 255 )' as LINERGB \
	 FROM PRODUCT P, DELIVERY_PRODUCT DP, DELIVERY D , MONTHLABEL M  \
	 WHERE DP.IdDelivery=D.id and DP.IdProduct=P.ID and P.TypeProduct<>'F'\
	 AND D.DateDelivery>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and D.DateDelivery<format(Date(),'YYYY-MM-DD')\
	 AND M.NoMonth=format(D.DateDelivery,'MM')+0 \
	 ORDER BY ID "

