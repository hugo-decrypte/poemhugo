View ViewTablePRODUCT_DEMAND 'Prévision évolution besoins' 'Prévision évolution besoins'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tablePRODUCT_DEMAND _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Prévision évolution besoins;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Center,Center,Right,Right,Right,Right,Right,Right,Right}]"\
"[DATAOBJ=PRODUCT_DEMAND;FILLCOLOR=LINERGB]"

Data PRODUCT_DEMAND 'Prévision évolution besoins' PRODUCT_DEMAND HTTPSQL 0 '[FIND={ID,DATEDTART,DATEEND,MINQUANTITY,MINWEIGHT,MINVOLUME,MAXQUANTITY,MAXWEIGHT,MAXVOLUME,PROBABILITY}]'   [DOUBLECLICK=] \
"[10;(string,ID,ID,,15,,);(date,DATEDTART,Date début,,15,,YYYY-MM-DD|DD/MM/YYYY);(date,DATEEND,Date fin,,15,,YYYY-MM-DD|DD/MM/YYYY);(int,MINQUANTITY,Min quantité,,15,,);(float,MINWEIGHT,Min poids,,15,,);(float,MINVOLUME,Min volume,,15,,);(float,MAXQUANTITY,Max quantité,,15,,);(float,MAXWEIGHT,Max poids,,15,,);(float,MAXVOLUME,Max volume,,15,,);(float,PROBABILITY,Probabilité,,15,,);(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT  pd.ID 		as ID,\
		  pd.minQuantity	as MINQUANTITY, \
		  pd.minWeight 		as MINWEIGHT, \
		  pd.minVolume 		as MINVOLUME, \
		  pd.maxQuantity 	as MAXQUANTITY, \
		  pd.maxWeight 		as MAXWEIGHT, \
		  pd.maxVolume 		as MAXVOLUME, \
		  pd.probability	as PROBABILITY, \
		  '(255 255 255 )' 	as LINERGB \
	 FROM  PRODUCT_DEMAND pd\
	 WHERE pd.idClub='(/*CLUBID*/)' \
	 ORDER BY pd.ID"


Script EditPRODUCTDEMAND 'Editer' _ 1 'Editer' _ 'tablePRODUCT_DEMAND' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE PRODUCT_DEMAND&Id in ({/*selected(tablePRODUCT_DEMAND;1;(string,ID))*/})"\
Reload _ _ _ _ 


