View ViewTableTYPERESOURCE 'Type camion' 'Type camion'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableTYPERESOURCE _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Type camion;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right,Right}]"\
"[DATAOBJ=TYPERESOURCE;FILLCOLOR=LINERGB]"

Data TYPERESOURCE 'Type camion' TYPERESOURCE HTTPSQL 0 '[FIND={IDTYPEVEHICLE,COSTDAY,COSTNIGHT,COSTUNIT,COSTKILOMETER,TIMEFIXED,TIMELOADINGUNIT,TIMEUNLOADINGUNIT,MAXVEHICLE,MAXTOUR,MAXQUANTITY,MAXWEIGHT,MAXVOLUME}]'   [DOUBLECLICK=EditTypeResource] \
"[13;(string,IDTYPEVEHICLE,ID,,10,,);(float,COSTDAY,Coût jour (€),,10,,);(float,COSTNIGHT,Coût nuit (€),,10,,);(float,COSTUNIT,Coût palette,,15,,);(float,COSTKILOMETER,Coût unité KM,,15,,);(float,TIMEFIXED,Temps fixé,,10,,);(float,TIMELOADINGUNIT,Unité temps chargement,,18,,);(float,TIMEUNLOADINGUNIT,Unité temps déchargement,,20,,);(int,MAXVEHICLE,Max #véhicule,,15,,);(int,MAXTOUR,Max #tournée,,15,,);(int,MAXQUANTITY,Max quantité,,15,,);(float,MAXWEIGHT,Max poids,,15,,);(float,MAXVOLUME,Max volume,,15,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	t.idClub						AS IDCLUB, \
				t.id 							AS IDTYPEVEHICLE, \
				IIF(t.minQuantity IS NULL,0,t.minQuantity)		AS MINQUANTITY, \
				IIF(t.maxQuantity IS NULL,0,t.maxQuantity)		AS MAXQUANTITY, \
				IIF(t.timeLoadingUnit IS NULL,0,t.timeLoadingUnit)	AS TIMELOADINGUNIT, \
				IIF(t.timeUnloadingUnit IS NULL,0,t.timeUnloadingUnit)	AS TIMEUNLOADINGUNIT, \
				IIF(t.costDay IS NULL,0,t.costDay)			AS COSTDAY, \
				IIF(t.costNight IS NULL,0,t.costNight)			AS COSTNIGHT, \
				IIF(t.costUnit IS NULL,0,t.costUnit)			AS COSTUNIT, \
				IIF(t.costKilometer IS NULL,0,t.costKilometer)		AS COSTKILOMETER, \
				IIF(t.timeFixed IS NULL,0,t.timeFixed)			AS TIMEFIXED, \
				IIF(t.minResource IS NULL,0,t.minResource)		AS MINVEHICLE, \
				IIF(t.maxResource IS NULL,0,t.maxResource)		AS MAXVEHICLE, \
				IIF(t.maxTour IS NULL,0,t.maxTour)			AS MAXTOUR, \
				IIF(t.maxWeight IS NULL,0,t.maxWeight)			AS MAXWEIGHT, \
				IIF(t.maxVolume IS NULL,0,t.maxVolume)			AS MAXVOLUME, \
				'(255 255 255)' 		AS LINERGB \
			FROM 	TYPERESOURCE t \
			WHERE idClub='(/*CLUBID*/)' \
			ORDER BY t.id


Script EditTypeResource  'Editer' _ 1 'Editer' _ 'tableTYPERESOURCE' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'  WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=(/*USERID*/),PWD=(/*PASSWORD*/),PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE TYPERESOURCE&Id in ({/*selected(tableTYPERESOURCE;1;(string,ID))*/})"\
Reload _ _ _ _ 


