"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);TITLEOBJ=Produits à ajouter pour devis {/*Selected(tableQUOTE;1;(string,ID))*/}; FAMILY='XXX'; NAMECLIENT={/*Selected(tableQUOTE;1;(string,NAMECLIENT))*/};IDQUOTE={/*Selected(tableQUOTE;1;(string,ID))*/}]"

Script PrintQuote  'Imprimer devis' _ 80 'Imprimer' _ 'tableQUOTE' '( 0 0 0 0 )' _ _ _  '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' \
	 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Script\ScriptPrint.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
	 '(/*SERVERPORT*/) (/*USERID*/)  PrintQuote.ini  Devis \
	 {/*selected(tableQUOTE;1;(string,ID))*/}' \
	 WinExec "[WAITTIME=600S;CONSOLE=0;;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]"\
	 'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe' '(/*POEMPRINTAPPPATH*/)Devis{/*selected(tableQUOTE;1;(string,ID))*/}.pdf' _ _ _ _ _ 

