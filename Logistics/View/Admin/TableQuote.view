Data CLIENT 'Client' CLIENT HTTPSQL 0 _ _ \
"[2;(string,IDCLIENT,ID client,,15.0.80,0);(string,LABELCLIENT,Identité Client,,100.0.100,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT cl.id AS IDCLIENT,\
  (trim(cl.Name) + ' (' + trim(p.City) + ')') as LABELCLIENT \
 FROM CLIENT cl, POINTDELIVERY p \
 WHERE p.IdClient=cl.Id \
 ORDER BY cl.Id"


Data STATE 'State' STATE HTTPSQL 0 _ _ \
"[2;(string,IDSTATE,Statut ID,,15.0.80,0);(string,LABELSTATE,Libellé,,50.0.300,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=select s.Id AS IDSTATE, \
	(trim(LABEL) + '(' + trim(ID) + ')') as LABELSTATE \
	FROM STATE s \
WHERE s.Category='QUOTE' \
ORDER BY s.Id "

