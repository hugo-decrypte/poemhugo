View ViewTableSHIFT 'Tableau tranches horaires' 'Tableau tranches horaires'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableSHIFT _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Tableau tranches horaires;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(165 165 255),(235 255 235),(235 255 235),(235 255 235),(235 255 235),(235 255 235)};\
ALIGNTEXT={Left,Left,Left,Left,Left,Left,Left,Left}]"\
"[DATAOBJ=SHIFT;FILLCOLOR=LINERGB]"

Data SHIFT 'Tableau tranches horaires' SHIFT HTTPSQL 0 '[FIND={IDSHIFT,NAMESHIFT,HORIZON,BREAK1,BREAK2,BREAK3,NIGHT1,NIGHT2}]'   [DOUBLECLICK=EditShift] \
"[8;(string,IDSHIFT,ID,,20,,);(string,NAMESHIFT,Nom,,25,,);(string,HORIZON,Durée,,25,,);(string,BREAK1,Pause créneau 1,,25,,);(string,BREAK2,Pause créneau 2,,25,,);(string,BREAK3,Pause créneau 3,,25,,);(string,NIGHT1,Nuit créneau 1,,30,,);(string,NIGHT2,Nuit créneau 2,,25,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT DISTINCT s.id as IDSHIFT, \
 s.name AS NAMESHIFT,\
(SELECT al.name FROM ALIAS al WHERE al.category='SHIFT' AND al.id=s.type) AS TYPESHIFT,\
 s.timeStart	AS TIMESTART,\
 s.timeEnd		AS TIMEEND,\
 s.night1Start	AS NIGHT1START,\
 s.night1End	AS NIGHT1END,\
 s.night2Start	AS NIGHT2START,\
 s.night2End	AS NIGHT2END,\
 s.break1Start	AS BREAK1START,\
 s.break1End	AS BREAK1END,\
 s.break2Start	AS BREAK2START,\
 s.break2End	AS BREAK2END,\
 s.break3Start	AS BREAK3START,\
 s.break3End	AS BREAK3END,\
 s.timeStart+' - '+s.timeEnd	AS HORIZON,\
 s.night1Start+' - '+s.night1End	AS NIGHT1,\
 s.night2Start+' - '+s.night2End	AS NIGHT2,\
 s.break1Start+' - '+s.break1End	AS BREAK1,\
 s.break2Start+' - '+s.break2End	AS BREAK2,\
 s.break3Start+' - '+s.break3End	AS BREAK3,\
 '(255 255 255)' 	AS LINERGB\
	 FROM SHIFT s "


Script EditShift 'Editer Shift' _ 1 'Editer' _ 'tableSHIFT' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE SHIFT&Id in ({/*selected(tableSHIFT;1;(string,IDSHIFT))*/})"\
Reload _ _ _ _ 


