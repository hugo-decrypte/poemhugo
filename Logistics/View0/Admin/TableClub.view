View ViewTableCLUB 'Tableau divisions' 'Tableau divisions'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableCLUB _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Tableau divisions;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left,Left,Center}]"\
"[DATAOBJ=CLUB;FILLCOLOR=LINERGB]"

Data CLUB 'Tableau divisions' CLUB HTTPSQL 0 '[FIND={ID,NAME,DIRECTORY,IP,PORT,COMMENTS,COLOR}]'   [DOUBLECLICK=EditClub] \
"[7;(string,ID,ID,,10,,);(string,NAME,Nom,,10,,);(string,DIRECTORY,Répertoire,,10,,);(string,IP,IP,,10,,);(string,PORT,Port,,10,,);(string,COMMENTS,Commentaire,,20,,);(string,COLOR,Couleur,,10,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	c.id		AS ID, \
				c.name		AS NAME,\
				c.directory	AS DIRECTORY,\
				c.ip		AS IP,\
				c.port		AS PORT,\
				c.comments	AS COMMENTS,\
				IIF(c.color IS NOT NULL, c.color , '(255 255 255)') AS COLOR,\
				IIF(c.color IS NOT NULL, c.color , '(255 255 255)') AS LINERGB\
	 		FROM CLUB c \
	 		ORDER BY c.id"


Script EditClub 'Editer Club' _ 1 'Editer' _ 'tableCLUB' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE CLUB&id in ({/*selected(tableCLUB;1;(string,ID))*/})"\
Reload _ _ _ _ 


