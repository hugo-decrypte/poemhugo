View ViewTableSUPPLIER 'Fournisseur' 'Fournisseur'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableSUPPLIER _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Fournisseur;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left,Left,Left,Left}]"\
"[DATAOBJ=SUPPLIER;FILLCOLOR=LINERGB]"

Data SUPPLIER 'Fournisseur' SUPPLIER HTTPSQL 0 '[FIND={ID,NAME,ADDRESS,CITY,COUNTRY,PHONE,MOBILE,MAIL}]'   [DOUBLECLICK=EditSupplier] \
"[8;(string,ID,ID,,15,,);(string,NAME,Nom,,15,,);(string,ADDRESS,Adresse,,15,,);(string,CITY,Ville,,15,,);(string,COUNTRY,Pays,,15,,);(string,PHONE,Téléphone,,15,,);(string,MOBILE,Portable,,15,,);(string,MAIL,Mail,,15,,);(string,POSTCODE,Code postal,,10.0.50,0);\
(string,ADDRESSSUP,Adresse2,,10.0.100,0);\
(int,TODAY,Aujourd''hui,,8.0.100,1);\
(color,LINERGB,(255 255 255),,13.0.0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT s.id AS ID,\
		 s.name AS NAME,\
		 (trim(s.PostCode)+' '+s.City) AS CITY,\
		 s.Country AS COUNTRY,\
		 s.PhoneFix AS PHONE,\
		 s.PhoneMobile AS MOBILE,\
		 s.EMAIL AS MAIL,\
		 (trim(s.Address) + IIF(s.AddressSup is not NULL and s.AddressSup>' ', (', '+s.AddressSup),  '')) AS ADDRESS,\
		 s.PostCode AS POSTCODE,\
		 s.AddressSup AS ADDRESSSUP,\
		 format(Date(), 'YYYYMMDD') as TODAY,\
		 '(255 255 255)' AS LINERGB \
	 FROM SUPPLIER s \
	 WHERE s.idClub='(/*CLUBID*/)' \
	 ORDER BY s.Name"


Script TableOfferSupplier 'Offres fournisseur' _ 21 'Offres' _ 'tableSUPPLIER' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TableOfferSupplier.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);TITLEOBJ=du fournisseur {/*Selected(tableSUPPLIER;1;(string,ID))*/};OWNEROBJ=IdSupplier;IDOBJ={/*Selected(tableSUPPLIER;1;(string,ID))*/}]"

Script EditSupplier 'Editer' _ 1 'Editer' _ 'tableSUPPLIER' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE SUPPLIER&Id in ({/*selected(tableSUPPLIER;1;(string,ID))*/})" \
Reload _ _ _ _ 


