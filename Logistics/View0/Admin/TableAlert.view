View ViewTableALERT 'Alerte stock' 'Alerte stock'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableALERT _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Alerte stock;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Right,Right}]"\
"[DATAOBJ=ALERT;FILLCOLOR=LINERGB]"

Data ALERT 'Alerte stock' ALERT HTTPSQL 0 '[FIND={ID,QTYTODAY,QTY2M}]'   [DOUBLECLICK=] \
"[3;(string,ID,Produit,,15,,);(int,QTYTODAY,Retard,,10,,);(int,QTY2M,2 mois,,10,,);(color,LINERGB,(255 255 255),,13.0.0);(string,IDCLUB,,,20,0)]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT a.ID as ID, a.Reference as REFERENCE, a.LevelTech as LEVELTECH,\
		 a.QuantityStock as QUANTITYSTOCK, a.QuantityOrdered as QUANTITYORDER,\
		 a.MinQuantityStock as MINQUANTITYSTOCK,\
		 tabCO.QTYTODAY as QTYTODAY,\
		 tabCO.QTY2M-a.QuantityStock as QTY2M,\
		 format(a.PriceUnit*(tabCO.QTY2M-a.QuantityStock),'0') as COST,\
		 a.Designation as DESIGNATION,\
		 IIF(tabCO.QTYTODAY>0, 'Retard livraison',\
		 IIF(tabCO.QTY2M>a.QuantityStock, 'Rupture 2 mois',\
		 IIF(a.QuantityOrdered>a.QuantityStock, 'Stock insuffisant',\
		 ' '))) as STATE,\
		 IIF(tabCO.QTYTODAY>0, '(255 140 0)',\
		 IIF(tabCO.QTY2M>a.QuantityStock, '(255 172 0)',\
		 IIF(a.QuantityOrdered>a.QuantityStock, '(255 255 0)',\
		 '(255 255 255)'))) as LINERGB \
	 FROM PRODUCT a left join \
		 (select LnO.idProduct as IdA, \
		 sum(IIF(format(CO.DateDelivery,'0')<=format(Date(), 'YYYYMMDD'), LnO.QuantityRest, 0)) as QTYTODAY,\
		 sum(IIF(format(CO.DateDelivery,'0')<=format(Date()+60, 'YYYYMMDD'), LnO.QuantityRest, 0)) as QTY2M\
		 from ORDER_PRODUCT LnO INNER JOIN CLIENTORDER CO ON CO.id = LnO.idOrder\
		 where LnO.QuantityRest>0\
		 and CO.idState<>'9'\
		 group by LnO.IdProduct \
		 ) tabCO on tabCO.IdA=a.ID \
	 WHERE tabCO.QTY2M>a.QuantityStock and a.TypeProduct<>'F'\
	 ORDER BY tabCO.QTYTODAY desc, tabCO.QTY2M desc, a.Reference, a.LevelTech"

