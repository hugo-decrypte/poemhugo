View ViewTableINVOICEPRODUCT 'Détail de Facture (/*IDINVOICE*/) Livraison (/*IDDELIVERY*/)' 'Détail de Facture (/*IDINVOICE*/) Livraison (/*IDDELIVERY*/)'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableINVOICEPRODUCT _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Détail de Facture (/*IDINVOICE*/) Livraison (/*IDDELIVERY*/);FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left,Center,Right,Right,Right,Right}]"\
"[DATAOBJ=INVOICEPRODUCT;FILLCOLOR=LINERGB]"

Data INVOICEPRODUCT 'Détail de Facture (/*IDINVOICE*/) Livraison (/*IDDELIVERY*/)' INVOICEPRODUCT HTTPSQL 0 '[FIND={ID,IDCLIENT,NAMECLIENT,IDPRODUCT,DESIGNATION,DATEDELIVERY,QUANTITYREAL,PRICE,AMOUNTHT,WEIGHT}]'   [DOUBLECLICK=] \
"[10;(string,ID,No livraison,,0,,);(string,IDCLIENT,ID client,,10,,);(string,NAMECLIENT,Nom client,,10,,);(string,IDPRODUCT,Produit,,10,,);(string,DESIGNATION,Désignation,,10,,);(date,DATEDELIVERY,Date livraison,,15,,YYYY-MM-DD|DD/MM/YYYY);(int,QUANTITYREAL,Qté livrée,,10,,);(float,PRICE,Prix unitaire,,10,,);(string,AMOUNTHT,Montant HT(€),,10,,);(string,WEIGHT,Poids,,10,,);(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT \
		 d.id AS ID, d.idClient AS IDCLIENT, cl.Name as NAMECLIENT,\
		  a.Id as IDPRODUCT,\
		  a.Designation as DESIGNATION,\
		  ld.QuantityReal AS QUANTITYREAL,\
		  ld.PriceUnit as PRICE,\
		  format(ld.QuantityReal*ld.PriceUnit, '0.00') as AMOUNTHT,\
		  format(ld.DateDelivery, '####/##/##') as DATEDELIV,\
		  format(a.Weight*ld.Quantity,'0.0') as WEIGHT,\
		  '(255 255 255)' AS LINERGB \
	 FROM (/*DBOWNER*/)DELIVERY d, (/*DBOWNER*/)CLIENT cl, (/*DBOWNER*/)DELIVERY_PRODUCT ld, (/*DBOWNER*/)PRODUCT a \
	 WHERE d.IdClient=cl.Id and d.Id=ld.IdDelivery\
	 AND a.Id=ld.IdProduct\
	 AND d.Id in ((/*IDDELIVERY*/)) \
	 ORDER BY d.Id"


Script EditInvoiceProduct 'Editer détail facture' _ 1'Editer détail facture' _ 'tableINVOICEPRODUCT' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE DELIVERY_PRODUCT&idDelivery in ({/*selected(tableINVOICEPRODUCT;1;(string,ID))*/})"\
Reload _ _ _ _ 


