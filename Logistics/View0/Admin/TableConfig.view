View ViewTableCONFIG 'Paramètres calcul' 'Paramètres calcul'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableCONFIG _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Paramètres calcul;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Left,Center}]"\
"[DATAOBJ=CONFIG;FILLCOLOR=LINERGB]"

Data CONFIG 'Paramètres calcul' CONFIG HTTPSQL 0 '[FIND={NAMECLUB,NAME,PARAMETER,PRIORITY,COMMENT,NAMESELECTED}]'   [DOUBLECLICK=EditConfig] \
"[6;(string,NAMECLUB,Division,,10,,);(string,NAME,ID,,20,,);(string,PARAMETER,Paramètre,,20,,);(int,PRIORITY,Priorité,,10,,);(string,COMMENT,Commentaire,,20,,);(string,NAMESELECTED,Sélectionné,,10,,);(color,LINERGB,,,13.0.0);(string,ID,,,);(string,IDCLUB,,,);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	c.idClub						AS IDCLUB, \
				(SELECT clb.name FROM CLUB clb WHERE clb.id=c.idClub)				AS NAMECLUB, \
				c.idx        	 					AS IDX, \
				IIF(c.idx>500 AND c.idx<600,(508-c.idx),NULL) 						AS PRIORITY, \
				c.id        	 					AS ID, \
				c.name		  					AS NAME, \
				c.type							AS TYPECONFIG, \
				c.comments	  					AS COMMENT, \
				c.parameter  						AS PARAMETER, \
				c.selected						AS SELECTED,\
				(SELECT al.name FROM ALIAS al WHERE al.category='BOOL' AND al.id=c.selected) 	AS NAMESELECTED,\
				IIF(c.selected='1','(255 140 0)','(192 192 255)')					AS LINERGB \
			FROM    CONFIG c \
			WHERE	 '(/*CLUBID*/)'=c.idClub AND c.editable='1' \
			ORDER BY c.idClub,c.idx,c.name"


Script EditConfig 'Editer' _ 1 'Editer' _ 'tableCONFIG' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE CONFIG&Id in ({/*selected(tableCONFIG;1;(string,ID))*/}) AND Name in ({/*selected(tableCONFIG;1;(string,NAME))*/}) AND IdClub in ({/*selected(tableCONFIG;1;(string,IDCLUB))*/})"\
Reload _ _ _ _ 


Script SelectDeselect  'Sélectionnéer/Désélectionnéer' _ 61 'Sélectionnéer/Désélectionnéer' _ 'tableCONFIG' '( 0 0 0 0 )' '[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' _ _  '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \
Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Common\Interaction\Table\SelectDeselectConfig.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
 '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableCONFIG;1;(string,ID))*/}  \
'\
Reload _ _ _

