Data MAP_ICON 'Icône' MAP_ICON HTTPSQL 0 "[TYPE=ICON;GLOBAL=1]" _ \
"[2;(string,ID,ID,,100,0);(File,ICON,ICON,,200,0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT id,hexadecimal AS ICON FROM ICON"


Data VRP_SITE 'Lieu' VRP_SITE HTTPSQL 1 '[TYPE=SITE;MAP=VRP;WIDTH=-30;FIND={IDSITE,IDTOUR,IDVEHICLE,T0,KM,LATITUDE,LONGITUDE};TIPINFO=]''_' \
"[12;(string,ID,Lieu,,,);(string,IDTOUR,Tournée,,,);(string,IDVEHICLE,Véhicule);(string,T0,Temps);(int,KM,KM);(float,LATITUDE,Latitude);(float,LONGITUDE,Longitude);(int,X,X);(int,Y,Y);(int,WIDTH,WIDTH,,,0);(string,ICON,ICON,,,0);(string,COLOR,COLOR,,,)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT DISTINCT	f.idResource & ' ' & f.datetime	AS ID, \
				f.id		AS IDTOUR, \
				f.idResource 	AS IDVEHICLE, \
				f.datetime 	AS T0, \
				f.KM 		AS KM, \
				f.latitude 	AS LATITUDE, \
				f.longitude 	AS LONGITUDE, \
				NULL	 	AS X, \
				NULL	 	AS Y, \
				v.idIcon 	AS ICON, \
				v.sizeIcon 	AS WIDTH, \
				v.color  	AS COLOR \
			FROM 	FEEDBACK f, RESOURCE v \
			WHERE v.id=f.idResource "

Data VRP_TASK 'Tâche' VRP_TASK HTTPSQL 0 "[TYPE=TASK;MAP=VRP; SITEDATA=VRP_SITE;PATHDATA=VRP_PATH; SITEID=IDSITE;PATHID=IDTOUR; FIND={IDTOUR,IDVEHICLE};WIDTH=-35;]" _ \
"[9;(string,ID,Lieu,,10,0);(string,IDSITE,Lieu,,10,0);(string,IDTOUR,Tournée,,10,0);\
(date,DateBegin,Date début,,,,YYYY-MM-DD|DD/MM/YYYY);\
(time,TimeBegin,Temps début,,,,HH:MM);(int,KM,KM);\
(string,IDVEHICLE,Véhicule,,10,0);(string,ICON,ICON,,50,0);(int,WIDTH,WIDTH,,,0);(color,COLOR,COLOR);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	f.id & ' ' & f.datetime			AS ID, \
				f.idResource & ' ' & f.datetime		AS IDSITE, \
				f.id 					AS IDTOUR, \
				LEFT(f.datetime,10)			AS DateBegin, \
				RIGHT(f.datetime,5)  			AS TimeBegin,  \
				f.KM 					AS KM, \
				f.idResource 				AS IDVEHICLE, \
				v.idIcon 				AS ICON, \
				v.sizeIcon 				AS WIDTH, \
				v.color  				AS COLOR \
			FROM 	FEEDBACK f,RESOURCE v \
			WHERE 	v.id=f.idResource "

Data VRP_PATH 'Tournée' VRP_PATH HTTPSQL 1 '[TYPE=PATH;MAP=VRP; TASKDATA=VRP_TASK;SITEDATA=VRP_SITE; PATHID=IDTOUR;SITEID=IDSITE; SPEED=0;FIND={ID,IDVEHICLE};TIPINFO=]' '_' \
"[8;(string,ID,Tournée);(int,LINEWIDTH,LINEWIDTH);(color,LINECOLOR,LINECOLOR);(color,FILLCOLOR,FILLCOLOR);(int,ARROWWIDTH,ARROWWIDTH);(color,ARROWCOLOR,ARROWCOLOR);(string,ICON,ICON,,,0);(int,WIDTH,WIDTH,,,0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT DISTINCT f.id AS ID, \
				v.widthLine AS LINEWIDTH, \
				v.colorLine AS LINECOLOR, \
				v.colorFill AS FILLCOLOR, \
				v.widthArrow AS ARROWWIDTH, \
				v.colorArrow AS ARROWCOLOR, \
				v.idIcon AS ICON, \
				v.sizeIcon AS WIDTH \
			FROM FEEDBACK f,RESOURCE v \
			WHERE f.idResource=v.id "

