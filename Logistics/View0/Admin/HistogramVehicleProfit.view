Data 'VEHICLEPROFIT'  'VEHICLEPROFIT'  'VEHICLEPROFIT' HTTPSQL 0 '[TIPINFO=[/*X*/] :  [/*Y*/]]'  '_' \
"[3;(string,X,,,,);(float,Y,,,,,,'0');(color,C_1,,,,,RGB);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT DISTINCT v.id AS X, IIF(ISNULL(v.receipts) OR ISNULL(v.cost),0,v.receipts-v.cost) AS Y, IIF(Y>0,'(128 168 198)','(148 188 218)') AS C_1  FROM RESOURCE v  WHERE  EXISTS (SELECT 1 FROM USER usr,CLUB_CLUB cc WHERE '(/*USERID*/)'=usr.id AND cc.idClub=usr.idClub AND cc.idClubRelated=v.idClub)"

