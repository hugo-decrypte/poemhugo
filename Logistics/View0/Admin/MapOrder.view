Data MAP_ICON 'Icône' MAP_ICON HTTPSQL 0 "[TYPE=ICON;GLOBAL=1]" _ \
"[2;(string,ID,ID,,100,0);(File,ICON,ICON,,200,0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT id,hexadecimal AS ICON FROM ICON"


Script AddToTour 'Ajouter commande à tournée' _ 2 'Ajouter commande à tournée' _ 'ORDER' '( 0 0 0 0 )' _ _ _  '[COUNT=2; NETNCL=HTTP; SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/); MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' \
	Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Solver\Order\AddToTour.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
	'(/*SERVERPORT*/) (/*USERID*/) \
	{/*selected(ORDER;1;(string,ID))*/} \
	{/*Input(Ajouter commande à tournée;2;(string,IDVEHICLE,iD véhicule,[/*VEHICLE2.IDVEHICLE*/],10.0.580,,,[/*VEHICLE2.IDVEHICLE*/]);\
		(int,TOURVEHICLE,No. tournée,1,10.0.580,,,{1,2}))*/}'\
	Reload _ _ _ _

Data ORDER 'Carte sites' ORDER HTTPSQL 1 '[TYPE=SITE;MAP=VRP;WIDTH=-30;FIND={ID,IDCLIENT,NAMECLIENT,IDSITE,NAMESITE,IDVEHICLE};TIPINFO=Commande [/*ID*/]    [/*NAMECLIENT*/]    [/*NAMESITE*/]    ([/*LATITUDE*/], [/*LONGITUDE*/])]' _ \
"[12;(string,ID,ID);(string,IDCLIENT,ID client);(string,NAMECLIENT,Nom client);(string,IDSITE,ID du site);(string,NAMESITE,Nom du site);(string,POSTCODE,Code postal);(float,LATITUDE,Latitude);(float,LONGITUDE,Longitude);(int,X,X);(int,Y,Y);(string,IDVEHICLE,Véhicule planifié);(string,TOURVEHICLE,Tournée planifiée);(int,WIDTH,WIDTH,,,0);(string,ICON,ICON,,,0);(string,COLOR,COLOR,,,)]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT DISTINCT	o.id AS ID, \
						c.id AS IDCLIENT, \
						c.name AS NAMECLIENT, \
						s.id as IDSITE, \
						s.name as NAMESITE, \
		 				s.longitude AS LONGITUDE, \
						s.latitude AS LATITUDE, \
		 				o.idResource AS IDVEHICLE, \
						o.tourResource AS TOURVEHICLE, \
						NULL AS X, \
						NULL AS Y, \
						o.idIcon as ICON, \
                				o.sizeIcon AS WIDTH \
                			FROM  OPT_ORDER o,OPT_CLIENT c,SITE s \
					WHERE o.idClient=c.id AND o.idSite2=s.id AND o.state>='1' AND  EXISTS (SELECT 1 FROM USER usr,CLUB_CLUB cc WHERE '(/*USERID*/)'=usr.id AND cc.idClub=usr.idClub AND cc.idClubRelated=s.idClub) "


Data VEHICLE2 'Véhicule' VEHICLE2 HTTPSQL 0 _ _ \
"[2;(string,IDVEHICLE,IDVEHICLE,,255,0);(string,NAMEVEHICLE,NAMEVEHICLE,,255,0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT id AS IDVEHICLE,name AS NAMEVEHICLE FROM RESOURCE WHERE idClub='(/*CLUBID*/)' ORDER BY id"

