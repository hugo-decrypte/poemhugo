View ModifyPassword _ ModifyPassword 255 255 255 _ 0 0 40 40 5 5 5 5 '[TRACELEVEL=0;TRACEFILE=;DEBUGLEVEL=0;SCROLLBAR=0;NATURESCALE=0;BESTFIT=1]'\

Script ModifyPassword 'Modifier mot de passe' _ 2 'Modifier mot de passe' _ _ '0 0 40 40' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
  Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Common\Interface\ModifyPassword.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 '(/*SERVERPORT*/) (/*USERID*/) {/*Input(Modifier mot de passe;3;(password,OLDPASSWORD,Mot de passe actuel,,30.0.580,,);(password,NEWPASSWORD,Nouveau mot de passe,,30.0.580,,);(password,NEWPASSWORD,Confirmer mot de passe,,30.0.580,,)*/}' 

