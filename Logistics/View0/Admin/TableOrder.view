View ViewTableORDER 'Commande' 'Commande'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableORDER _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Commande;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Center,Center,Center,Right,Right,Left,Left,Left,Right,Left,Left}]"\
"[DATAOBJ=ORDER;FILLCOLOR=LINERGB]"

Data ORDER 'Commande' ORDER HTTPSQL 0 '[FIND={ID,NAMECLIENT,ADDRESSDELIVERY,CITYDELIVERY,DATEORDER,DATEDELIVERY,NBPRODUCT,NBPALLET,QUANTITY,INCOTERM,IDPROFORMA,REFERENCE,PRICE,COMMENTS,IDSTATE}]'   [DOUBLECLICK=TableOrderProduct] \
"[15;(string,ID,Commande,,16,,);(string,NAMECLIENT,Client,,10,,);(string,ADDRESSDELIVERY,Adresse,,15,,);(string,CITYDELIVERY,Ville,,10,,);(date,DATEORDER,Date commande,,23,,YYYY-MM-DD|DD/MM/YYYY);(date,DATEDELIVERY,Date livraison,,20,,YYYY-MM-DD|DD/MM/YYYY);(int,NBPRODUCT,#Produit,,13,,);(float,NBPALLET,#Palette,,13,,);(int,QUANTITY,Quantit�,,13,,);(string,INCOTERM,Incoterm,,13,,);(string,IDPROFORMA,Proforma,,13,,);(string,REFERENCE,R�f�rence,,15,,);(float,PRICE,Montant HT(�),,20,,);(string,COMMENTS,Commentaire,,19,,);(string,IDSTATE,Etat,,15,,);(string,IDAGENCY,ID agence,,15,0);(string,NAMEAGENCY,Nom agence,,50,0);\
(string,IDCLIENT,ID client,,15.0.80,0);\
(color,LINERGB,(255 255 255),,13.0.0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT cm.id AS ID, cm.idClient AS IDCLIENT, cl.name as NAMECLIENT,\
		 cm.idAgency AS IDAGENCY,\
		 (select ay.Name from AGENCY ay where ay.id=cm.idAgency) as NAMEAGENCY,\
		 (select (trim(Address)+IIF(AddressSup is not NULL and AddressSup>' ', ', '+trim(AddressSup) , ' ')) from (/*DBOWNER*/)POINTDELIVERY p where p.IdClient=cm.IdClient and p.IdPoint=cm.IdPointDelivery) as ADDRESSDELIVERY,\
		 (select (trim(PostCode) + '-' + City ) from POINTDELIVERY p where p.IdClient=cm.IdClient and p.IdPoint=cm.IdPointDelivery) as CITYDELIVERY,\
		 cm.dateOrder as DATEORDER,\
		 cm.dateDelivery as DATEDELIVERY,\
		 (select (trim(LABEL) + '(' + ID + ')') from STATE s where s.ID=cm.idState and s.CATEGORY='ORDER') as IDSTATE,\
		 (select count(1) from ORDER_PRODUCT lc where lc.idOrder=cm.id) as NBPRODUCT,\
		 format(cm.quantity,'0')      AS QUANTITY,\
		 format(cm.quantityRest,'0')  AS QUANTITYREST,\
		 format(cm.AmountHT,'0.00')      AS PRICE,\
		 format(cm.NbPallet,'0.0')      AS NBPALLET,\
		 (select format(sum(lc.QuantityRest*a.Weight),'0') from ORDER_PRODUCT lc inner join PRODUCT a on a.Id=lc.IdProduct where lc.idOrder=cm.id) as WEIGHTREST,\
		 cm.Incoterm as INCOTERM,\
		 cm.IdInvoice as IDINVOICE,\
		 cm.IdProforma as IDPROFORMA,\
		 cm.Reference as REFERENCE,\
		 cm.Comments as COMMENTS,\
		 IIF(cm.idState in (select s.Id from STATE s where s.CATEGORY='ORDER'),\
		    (select Color from STATE s where s.Id=cm.idState and s.CATEGORY='ORDER'),\
		 '(255 255 255)') AS LINERGB \
	 FROM CLIENTORDER cm, CLIENT cl \
	 WHERE cm.idClient=cl.id \
	 AND (cm.idState is NULL or cm.idState<>'9')\
	 ORDER BY cm.dateOrder desc, cm.id"


