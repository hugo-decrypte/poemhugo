 Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TableDelivery_Menu.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);NBDAY=7;OWNEROBJ=IdClient;IDOBJ={/*Selected(tableCLIENT;1;(string,ID))*/};TITLEOBJ=pour client {/*Selected(tableCLIENT;1;(string,ID))*/};OWNERSUBOBJ=IdProduct;IDSUBOBJ='XXX';IDTOUR='XXX';NBDAY=30]"

Script TableBalanceSheetRevenueProduct  'CA' _ 34 'CA' _ 'tableCLIENT' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TableBalanceSheetRevenueProduct_Menu.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);IDCOLOR=(250 250 250);OWNEROBJ=IdClient;IDOBJ={/*Selected(tableCLIENT;1;(string,ID))*/};FAMILY='XXX';TITLEOBJ=pour client {/*Selected(tableCLIENT;1;(string,ID))*/};OWNERSUBOBJ=IdProduct;IDSUBOBJ='XXX']"

Script CreateOrder 'Create Order' _ 15 'Créer commande' _ 'tableCLIENT' '( 0 0 0 0 )' '[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Script\ScriptClientCreateOrder.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 '(/*SERVERPORT*/) (/*USERID*/) {/*Input(Créer commande;5;\
(string,IDORDER,ID commande,,50.0.580,0,,);\
(string,REFERENCE,Référence,,50.0.580,1,,);\
(date,DATEDELIVERY,Date livraison,[/*CLIENT.TOMORROW*/],10.0.580,1,YYYY-MM-DD);\
(string,CLIENT,Client,[/*CLIENT.ID*/],50.0.580,0,0,[/*CLIENT.ID*/]);\
(string,POINTDELIVERY,Point livraison,[/*CLIENT.IDPOINTDELIVERY*/],50.0.580,0,0,[/*CLIENT.IDPOINTDELIVERY*/]);\
)*/}' 

Script EditClient 'Editer' _ 1 'Editer' _ 'tableCLIENT' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE CLIENT&IdClient in ({/*selected(tableCLIENT;1;(string,ID))*/})"\
Reload _ _ _ _ 


/// POINTDELIVERY /////////////// 
Data POINTDELIVERY 'PointDelivery' POINTDELIVERY HTTPSQL 0 _ _ \
"[5;(string,IDCLIENT,ID client,,15.0.80,0);(string,NAMECLIENT,Nom client Client,,15.0.80,0);(string,IDPOINT,Point ID,,15.0.80,0);(string,CITY,Ville,,15.0.80,0);(string,LABELCLIENT,Identit  Client,,100.0.100,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT \
		 cl.id AS IDCLIENT, \
		 cl.Name as NAMECLIENT,\
		 p.City as CITY,\
		 p.IdPoint as IDPOINT, \
		 (trim(cl.Name) + ' (' + trim(p.City) + ')') as LABELCLIENT \
	 FROM CLIENT cl, POINTDELIVERY p \
	 WHERE p.IdClient=cl.Id"


/// AGENCY /////////////// 
Data AGENCY 'Agency' AGENCY HTTPSQL 0 _ _ \
"[3;(string,IDAGENCY,ID agence,,15.0.80,0);(string,NAMEAGENCY,Nom agence,,100.0.100,0);(string,CITYAGENCY,Ville,,15.0.80,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT id AS IDAGENCY, \
		 Name as NAMEAGENCY, \
		 City as CITYAGENCY \
	 FROM AGENCY"


/// BANKACCOUNT /////////////// 
Data BANKACCOUNT 'BankAccount' BANKACCOUNT HTTPSQL 0 _ _ \
"[3;(string,IDBANK,ID banque,,15.0.80,0);(string,NAMEBANK,Nom banque,,100.0.100,0);(string,CITYBANK,Domiciliation,,15.0.80,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT id AS IDBANK, \
		 Name as NAMEBANK, \
		 Domiciliation as CITYBANK \
	 FROM BANKACCOUNT"


