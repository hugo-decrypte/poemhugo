"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);]"


Script OptimizeTour 'Optimiser par tournée' _ 8 'Optimiser par tournée'  _ 'tableOptTOUR' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=1;CANCEL=1;SKIP=0;WAITCURSOR=0;;AUTOCLOSE=1]'\
 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Script\ScriptTSP.n'\
 '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableOptTOUR;1;(string,IDTOUR))*/}' \
Reload _ _ _ _




/// PLAN DATE/////////////// 
Data DATESTART2 'DateStart' DATESTART2 HTTPSQL 0 _ _ \
"[1;(string,DateStart2,H dÃ©part,,15,,)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT distinct Left(t1,10) as DateStart2 FROM OPT_TOUR WHERE idClub='(/*CLUBID*/)'"


Data DATEEND2 'DateEnd' DATEEND2 HTTPSQL 0 _ _ \
"[1;(string,DateEnd2,H retour,,15,,)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT distinct Left(t2,10) as DateEnd2 FROM OPT_TOUR WHERE idClub='(/*CLUBID*/)'"


