View ViewTableOPTTOUR 'Tournée' 'Tournée'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableOPTTOUR _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Tournée;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Right,Left,Left,Left,Right,Right,Right,Right,Right}]"\
"[DATAOBJ=OPTTOUR;FILLCOLOR=LINERGB]"

Data OPTTOUR 'Tournée' OPTTOUR HTTPSQL 0 '[FIND={IDTOUR,IDVEHICLE,TOURVEHICLE,IDTYPEVEHICLE,IDSITE1,IDSITE2,T1,T2,NBORDER,MILEAGE,QUANTITY}]'   [DOUBLECLICK=MapTour] \
"[11;(string,IDTOUR,ID,,10,,);(string,IDVEHICLE,Véhicule,,15,,);(int,TOURVEHICLE,No. tournée,,10,,);(string,IDTYPEVEHICLE,Type,,10,,);(string,IDSITE1,Départ,,10,,);(string,IDSITE2,Retour,,10,,);(string,T1,H départ,,15,,);(string,T2,H retour,,15,,);(int,NBORDER,#Commande,,15,,);(int,MILEAGE,KM,,12,,);(int,QUANTITY,Quantité,,13,,);(color,LINERGB,color,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	t.id AS IDTOUR, \
				t.idResource AS IDVEHICLE, \
				t.tourResource AS TOURVEHICLE, \
				v.idTypeResource AS IDTYPEVEHICLE, \
				t.idSite1 AS IDSITE1, \
				t.idSite2 AS IDSITE2, \
				t.t1 AS T1, \
				t.t2 AS T2, \
				t.nbOrder AS NBORDER, \
				t.mileage AS MILEAGE, \
				t.timeService AS TIMESERVICE, \
				t.timeRoute AS TIMEROUTE, \
				t.timeService+t.timeRoute AS WORKTIME, \
				t.makespan AS MAKESPAN, \
				t.cost AS COST,  \
				t.receipts AS RECEIPTS,  \
				t.quantity AS QUANTITY,  \
				t.weight AS WEIGHT,  \
				t.volume AS VOLUME,  \
				t.rateQuantity AS QUANTITYRATE,  \
				t.rateWeight AS WEIGHTRATE,  \
				t.rateVolume AS VOLUMERATE,  \
				'(255 255 255)'  AS LINERGB  \
			FROM OPT_TOUR t,RESOURCE v \
			WHERE t.idResource=v.id AND  EXISTS (SELECT 1 FROM USER usr,CLUB_CLUB cc WHERE '(/*USERID*/)'=usr.id AND cc.idClub=usr.idClub AND cc.idClubRelated=t.idClub) \
			ORDER BY t.idResource,t.tourResource"

Script TourOrder  'Feuille de route' _ 20 'Feuille de route' _ 'tableOPTTOUR' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\View\Map\GenerateTableTourOrder.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 '(/*SERVERPORT*/) (/*USERID*/) {/*selected(tableOPTTOUR;2;(string,IDTOUR);(string,IDVEHICLE))*/}' \
Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TableTourOrderMenu.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);]"


Script MapTour 'Carte' _ 41 'Carte' _ 'tableOPTTOUR' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\View\Map\GenerateMapVehicleTour.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 '(/*SERVERPORT*/) (/*USERID*/) {/*selected(tableOPTTOUR;2;(string,IDTOUR);(string,IDVEHICLE))*/}' \
Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)MapVehicle(/*USERID*/).view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);]"


Script MapTourByDate 'Carte par date' _ 42 'Carte par date' _ 'tableOPTTOUR' '( 0 0 0 0 )' _ _ _ '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\View\Map\GenerateMapVehicleTourByDate.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 '(/*SERVERPORT*/) (/*USERID*/)  (/*CLUBID*/) \
{/*Input(MCM;Selectionnez;2;\
(string,DATESTART,Date dÃ©part,[/*DATESTART2.DateStart2*/],50.0.580,0,,[/*DATESTART2.DateStart2*/]);\
(string,DATEEND,Date retour,[/*DATEEND2.DateEnd2*/],50.0.580,0,,[/*DATEEND2.DateEnd2*/]);*/}'\
