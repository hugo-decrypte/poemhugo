 Open '[DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE);FILE=(/*HTTPVIEW*/)TablePalletProduct.view]' _ _ \
"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);TITLEOBJ=Produits en palette {/*selected(tablePALLET;1;(int,NOPALLET))*/};IDPACKING={/*Selected(tablePALLET;1;(string,IDPACKING))*/};NOPALLET={/*selected(tablePALLET;1;(int,NOPALLET))*/};IDPRODUCT='XXX']"

Script TableProductForPallet  'Produits pour palette' _ 22 'Produits pour palette' _ 'tablePALLET' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
