ALIGNTEXT={Left,Left,Left,Left}]"\
"[DATAOBJ=TYPEPRODUCT;FILLCOLOR=LINERGB]"

Data TYPEPRODUCT 'Type produit' TYPEPRODUCT HTTPSQL 0 '[FIND={ID,NAME,IDTYPEPROCESS,COMMENTS}]'   [DOUBLECLICK=] \
"[4;(string,ID,ID,,15,,);(string,NAME,Nom,,20,,);(string,IDTYPEPROCESS,Type tâche,,20,,);(string,COMMENTS,Commentaire,,30,,);(color,LINERGB,(255 255 255),,13.0.0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT tp.id AS ID, \
	 tp.Name AS NAME,\
	 tp.idTypeProcess as IDTYPEPROCESS,\
	 '(255 255 255)' as LINERGB \
 FROM TYPEPRODUCT tp \
 ORDER BY tp.id"



