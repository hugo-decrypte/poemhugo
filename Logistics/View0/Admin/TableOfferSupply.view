View ViewTableOFFERPRODUCT 'Produits offre' 'Produits offre'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableOFFERPRODUCT _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Produits offre;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,Left,Right,Left}]"\
"[DATAOBJ=OFFERPRODUCT;FILLCOLOR=LINERGB]"

Data OFFERPRODUCT 'Produits offre' OFFERPRODUCT HTTPSQL 0 '[FIND={IDSUPPLIER,NAMESIPPLIER,IDPRODUCT,DESIGNATION,PRICE,COMMENTS}]'   [DOUBLECLICK=] \
"[6;(string,IDSUPPLIER,ID fournisseur,,15,,);(string,NAMESIPPLIER,Nom fournisseur,,20,,);(string,IDPRODUCT,Produit,,15,,);(string,DESIGNATION,Désignation,,20,,);(float,PRICE,Prix unitaire,,15,,);(string,COMMENTS,Commentaire,,30,,);(color,LINERGB,(255 255 255),,13.0.0)]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT os.idSupplier AS IDSUPPLIER,\
		 (select Name from SUPPLIER sr where sr.Id=s.IdSupplier) as NAMESUPPLIER,\
		 os.idProduct AS IDPRODUCT,\
		 a.Designation as DESIGNATION,\
		 os.PriceUnit AS PRICE,\
		 os.Comments AS COMMENTS,\
		 '(255 255 255)' AS LINERGB \
	 FROM OFFERSUPPLIER os, SUPPLIER s, PRODUCT a \
	 WHERE s.Id=os.IdSupplier and os.IdProduct=a.Id\
	 AND (os.IdSupplier in ((/*IDSUPPLIER*/)) or 'XXX' in ((/*IDSUPPLIER*/)))\
	 AND (os.IdProduct in ((/*IDPRODUCT*/)) or 'XXX' in ((/*IDPRODUCT*/))) \
	 ORDER BY os.IdSupplier, os.IdProduct"


Script EditOfferSupply 'Editer fffres du fournisseur' _ 1 'Editer' _ 'tableOFFERPRODUCT' '( 0 0 0 0 )' _ _ _  '[COUNT=1; NETNCL=HTTP; SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/); MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \
	WinExec "[WAITTIME=0S;CONSOLE=1;WORKDIR=(/*CLIENTDIRECTORY*/);DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]"\
	 '(/*POEMDATAEXE*/)'\
	 "(/*POEMDATAPATH*/)/(/*POEMDATADEP*/) ?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=1)]? OPEN TABLE (/*DBOWNER*/)OFFERSUPPLIER&IdSupplier in ({/*selected(tableOFFERPRODUCT;1;(string,IDSUPPLIER))*/}) and IdProduct in ({/*selected(tableOFFER;1;(string,IDPRODUCT))*/})" _ _ _ _ _ _ _ 

