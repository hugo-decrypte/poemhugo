Histogram HISTOGRAM 'Quantités mensuelles' _  0 0 0 400 \
"[BQUANTITYWIDTH=1; BQUANTITYCOLOR=(0 128 192); FILLCOLOR=(238 238 238); LINEWIDTH=1; LINECOLOR=(128 128 128);]" \
"[TEXTS={4};]" \
"[TITLE=Quantités mensuelles;FONTSIZE=9; FONTNAME=Courier New; FONTCOLOR=(0 0 0); LINESEPARATOR=\n]" \
"[AUTOCREATE=0; FONTSIZE=7; WIDTH=60; LABELS={}; COLORS={};POSITION=Top;]" \
