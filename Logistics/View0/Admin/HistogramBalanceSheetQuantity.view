Data 'MONTHLYQUANTITY'  'MONTHLYQUANTITY'  'MONTHLYQUANTITY' HTTPSQL 0 '[TIPINFO=[/*X*/] :  [/*Y*/]]'  '_' \
"[3;(string,X,,,,);(float,Y,,,,,,'0');(color,C_1,,,,,RGB);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT format(max(DP.DateDelivery),'YYYY-MM') AS X, int(sum(DP.QuantityReal)/1000) AS Y, IIF(Y>0,'(128 168 198)','(148 188 218)') AS C_1 FROM PRODUCT P, DELIVERY_PRODUCT DP, DELIVERY D , MONTHLABEL M  \
			WHERE 	DP.IdDelivery=D.id and DP.IdProduct=P.ID and P.TypeProduct<>'F'\
				AND D.DateDelivery>=format(DateAdd('yyyy', -1, Date()),'YYYY-MM-DD') and D.DateDelivery<format(Date(),'YYYY-MM-DD')\
				AND M.NoMonth=format(D.DateDelivery,'MM')+0 \
			GROUP BY M.NoMonth, M.NameFR \
			ORDER BY format(max(DP.DateDelivery),'YYYY-MM')"

