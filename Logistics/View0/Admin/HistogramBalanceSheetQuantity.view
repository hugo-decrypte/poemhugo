"[CORRELATION=1;LABELPOSITION=T; LABELFONTSIZE=7; LABEL=Pièces (1000);BQUANTITYWIDTH=0; FONTSIZE=7; FONTNAME=Courier New; FONTCOLOR=(0 0 0); LINEWIDTH=1; LINECOLOR=(0 0 0); WIDTH=-5;]" \
