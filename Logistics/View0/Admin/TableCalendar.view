View ViewTableCALENDAR 'Tableau calendrier' 'Tableau calendrier'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableCALENDAR _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Tableau calendrier;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Center,Left,Left}]"\
"[DATAOBJ=CALENDAR;FILLCOLOR=LINERGB]"

Data CALENDAR 'Tableau calendrier' CALENDAR HTTPSQL 0 '[FIND={IDDATE,WEEKDAY,COMMENTS}]'   [DOUBLECLICK=EditCalendar] \
"[3;(date,IDDATE,Date,,10,,YYYY-MM-DD|DD/MM/YYYY);(string,WEEKDAY,Jour,,10,,);(string,COMMENTS,Commentaire,,10,,);(color,LINERGB,,,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT DISTINCT c.id AS IDDATE,\
			(SELECT al.name FROM ALIAS al WHERE al.category='CALENDAR' AND al.field='weekday' AND al.id=c.weekday) AS WEEKDAY,\
			c.comments AS COMMENTS,\
			IIF(c.id>=format(Date(),'DD/MM/YYYY'),(SELECT al.color FROM ALIAS al WHERE al.category='STATE' AND al.id='2'),(SELECT al.color FROM ALIAS al WHERE al.category='STATE' AND al.id='1')) AS LINERGB\
			FROM CALENDAR c\
			ORDER BY c.id DESC "


Script EditCalendar 'Editer Calendar' _ 1 'Editer' _ 'tableCALENDAR' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE CALENDAR&id in ({/*selected(tableCALENDAR;1;(date,IDDATE,Date,,10,,'YYYY-MM-DD'))*/})"\
Reload _ _ _ _ 


