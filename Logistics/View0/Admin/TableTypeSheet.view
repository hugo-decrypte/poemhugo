View ViewTableTYPESHEET 'Type de feuille' 'Type de feuille'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableTYPESHEET _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Type de feuille;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Right,Left,Center,Left,Left,Left,Center}]"\
"[DATAOBJ=TYPESHEET;FILLCOLOR=LINERGB]"

Data TYPESHEET 'Type de feuille' TYPESHEET HTTPSQL 0 '[FIND={NAMECATEGORY,COLUMN,NAME,NAMECOLOR,NAMETYPE,NAMEALIGNMENT,COMMENTS,NAMESTATE}]'   [DOUBLECLICK=EditTypeSheet] \
"[8;(string,NAMECATEGORY,Catégorie,,10,,);(int,COLUMN,Colonne,,10,,);(string,NAME,Nom,,20,,);(string,NAMECOLOR,Couleur,,20,,);(string,NAMETYPE,Type,,10,,);(string,NAMEALIGNMENT,Alignment,,10,,);(string,COMMENTS,Commentaire,,30,,);(string,NAMESTATE,Etat,,10,,);(color,LINERGB,,,13.0.0);(string,CATEGORY,Category,,10,,0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT t.category 					AS CATEGORY,\
			(SELECT al.name FROM ALIAS al WHERE al.category='SHEET' AND al.field='category' AND al.id=t.category) AS NAMECATEGORY,\
			t.column 						AS COLUMN,\
			t.id 							AS ID,\
			t.name 							AS NAME,\
			t.type 							AS TYPE,\
			(SELECT al.name FROM ALIAS al WHERE al.category='TYPE' AND al.id=t.type) AS NAMETYPE,\
			t.alignment 						AS ALIGNMENT,\
			(SELECT al.name FROM ALIAS al WHERE al.category='ALIGNMENT' AND al.field='alignment' AND al.id=t.alignment) AS NAMEALIGNMENT,\
			t.comments 						AS COMMENTS,\
			t.color							AS NAMECOLOR,\
			(SELECT al.name FROM ALIAS al WHERE al.category='STATE' AND al.id=t.state) AS NAMESTATE,\
			t.color 						AS LINERGB \
			FROM TYPESHEET t\
			ORDER BY t.state DESC,t.category,t.column"


Script EditTypeSheet 'Editer' _ 1 'Editer' _ 'tableTYPESHEET' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE TYPESHEET&category IN ({/*selected(tableTYPESHEET;1;(string,CATEGORY))*/})&column IN ({/*selected(tableTYPESHEET;1;(int,COLUMN))*/})"\
Reload _ _ _ _ 


