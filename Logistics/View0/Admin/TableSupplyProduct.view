 '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableSUPPLY;2;(string,IDSUPPLY);(string,IDPRODUCT))*/} \
{/*Input(Mettre produits à packing;3;\
(string,IDPACKING,ID Packing*,,10.0.580,0);\
(string,NOPALLET,No. palette,0,5.0.580,1);\
(string,QUANTITY,Quantité,[/*SUPPLY.QUANTITYREST*/],5.0.580,1);\
)*/}\
'\
