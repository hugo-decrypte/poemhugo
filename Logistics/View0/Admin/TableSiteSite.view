View ViewTableSITE_SITE 'Matrice de distances' 'Matrice de distances'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableSITE_SITE _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Matrice de distances;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,left,Left,Left,Left,Left,Right,Right}]"\
"[DATAOBJ=SITE_SITE;FILLCOLOR=LINERGB]"

Data SITE_SITE 'Matrice de distances' SITE_SITE HTTPSQL 0 '[FIND={NAMECLUB,IDTYPERESOURCE,IDTYPERISK,NAMESITE1,NAMESITE2,IDSITE1,IDSITE2,MILEAGE,DURATION}]'   [DOUBLECLICK=EditSiteSite] \
"[9;(string,NAMECLUB,Division,,10,,);(string,IDTYPERESOURCE,Type camion,,10,,);(string,IDTYPERISK,Type risque,,10,,);(string,NAMESITE1,Site 1,,20,,);(string,NAMESITE2,Site 2,,20,,);(string,IDSITE1,ID 1,,10,,);(string,IDSITE2,ID 2,,10,,);(int,MILEAGE,Distance (mètre),,10,,);(int,DURATION,Temps (second),,10,,);(color,LINERGB,color,,13.0.0);(string,IDCLUB,,,);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	s1.idClub 					AS IDCLUB, \
				(SELECT clb.name FROM CLUB clb WHERE clb.id=s1.idClub)		AS NAMECLUB,\
				ss.idTypeResource 			AS IDTYPERESOURCE,\
				ss.idTypeRisk 				AS IDTYPERISK,\
				ss.idSite1 				as IDSITE1, \
				ss.idSite2 				as IDSITE2, \
				ss.distance 				AS MILEAGE, \
				ss.duration 				AS DURATION, \
				s1.name 				AS NAMESITE1, \
				s2.name 				AS NAMESITE2, \
				'(255 255 255)' 			AS LINERGB \
			FROM SITE s1,SITE s2,SITE_SITE ss \
			WHERE s1.id=ss.idSite1 AND s2.id=ss.idSite2 AND EXISTS (SELECT 1 FROM USER usr,CLUB_CLUB cc WHERE '(/*USERID*/)'=usr.id AND cc.idClub=usr.idClub AND cc.idClubRelated=ss.idClub)
			ORDER BY ss.idSite1,ss.idSite2"

Script EditSiteSite 'Editer distance' _ 1 'Editer' _ 'tableSITE_SITE' '( 0 0 0 0 )' _ _ _ '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' WinExec "[WAITTIME=600S;CONSOLE=0;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F);WORKDIR=(/*CLIENTDIRECTORY*/)]" '(/*POEMDATAEXEPATH*/)PoemData.exe' "(/*POEMDATACONFIG*/)?[PROFILE=(UID=(/*USERID*/),PWD=(/*PASSWORD*/),ACCESS=(/*PERMISSION*/));DSN=(DSN=(/*DBNAME*/),UID=(/*DBUSER*/),PWD=(/*DBPWD*/),OWNER=(/*DBOWNER*/));SERVER=(SERVER=(/*SERVERIP*/),PORT=(/*SERVERPORT*/),TIMEOUT=100000,UID=,PWD=,PROXYNAME=,PROXYBYPASS=);]?OPEN TABLE SITE_SITE&idSite1 in ({/*selected(tableSITE_SITE;1;(string,IDSITE1))*/}) and idSite2 in ({/*selected(tableSITE_SITE;1;(string,IDSITE2))*/}) and idClub in ({/*selected(tableSITE_SITE;1;(string,IDCLUB))*/})"\
Reload _ _ _ _ 


