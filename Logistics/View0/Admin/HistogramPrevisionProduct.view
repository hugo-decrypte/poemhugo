Data 'SALESPREVISION'  'SALESPREVISION'  'SALESPREVISION' HTTPSQL 0 '[TIPINFO=[/*X_1*/] : [/*Y_1*/]   [/*X_2*/] : [/*Y_2*/]]'  '_' \
"[6;(string,X_1,,,,);(string,X_2,,,,);\
(int,Y_1,,,,,,'0');(int,Y_2,,,,,,'0');\
(color,C_1,,,,,RGB);(color,C_2,,,,,RGB);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT	format(DateAdd('m',-M.NoMonth,Date()),'YYYY-MM')	AS X_1,\
				format(DateAdd('m', 12-M.NoMonth, Date()),'YYYY-MM') 					AS X_2,\
				int(sum(DP.QuantityReal*DP.PriceUnit)/1000)		AS Y_1,\
				int(sum(DP.QuantityReal* P.PriceUnit)/1000)		AS Y_2,\
				'(128 168 198)' 					AS C_1,\
				'(81 165 225)' 					AS C_2,\
				'(255 255 255)' 					AS LINERGB \
		  	FROM PRODUCT P,DELIVERY_PRODUCT DP,DELIVERY D, MONTHLABEL M,MONTHLABEL M0 \
 			WHERE 	DP.IdDelivery=D.id and DP.IdProduct=P.ID and P.TypeProduct not in ('F','S')\
				AND D.DateDelivery>=(format(DateAdd('m', -M.NoMonth, Date()),'YYYY-MM')+'-01') \
				AND D.DateDelivery<(format(DateAdd('m', -M.NoMonth, Date()),'YYYY-MM')+'-31') \
				AND M.NoMonth<=11 \
				AND M0.NoMonth=format(D.DateDelivery,'MM')+0 \
			GROUP BY M.NoMonth,M0.NoMonth, M0.NameFR \
			ORDER BY (format(max(DP.DateDelivery),'YYYY-MM'))"

