Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\UpdateProductToProductQuantity.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
 '(/*SERVERPORT*/) (/*USERID*/) (/*IDPRODUCT*/) {/*Selected(tablePRODUCTPRODUCT;1;(string,IDSUBPRODUCT))*/} \
{/*Input(MQTY;Modifier quantité;1;\
(int,QTY,Quantité,[/*PRODUCTPRODUCT.QUANTITY*/],10.0.580,1);\
)*/}\
'\
Reload _ _ _

// 3. Romove all products selected from components if it is in the product
// update quantity in Product, Product
Script RemoveProduct  'Enlever produit' _ 63  'Enlever produit' _ 'tablePRODUCTPRODUCT' '( 0 0 0 0 )' '[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' _ "Attention, Vous devez d'abord enlever ses composants et qu'il n'est composant d'autre produit."\
 '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \
Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\RemoveProductFromProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
 '(/*SERVERPORT*/) (/*USERID*/) (/*IDPRODUCT*/) {/*Selected(tablePRODUCTPRODUCT;1;(string,IDSUBPRODUCT))*/} \
'\
Reload _ _ _

