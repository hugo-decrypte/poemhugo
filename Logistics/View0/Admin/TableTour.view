View ViewTableTOUR 'Tournée' 'Tournée'  255 255 255 _ 0 0 0 0 5 5 5 5 '[TRACELEVEL=(/*TRACELEVEL*/);TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=0;FLIPHORIZONTALLY=0;NATURESCALE=0;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;CLOSEEVENT=0;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);POEMSERVER=;MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;GLOBALVARIABLE=0]'

Table tableTOUR _ _ 0 0 2000 500 \
"[]" - \
"[TITLE=Tournée;FONTCOLOR=(0 0 0);FONTSIZE=10;FONTNAME=Times New Roman;LINESEPARATOR=\n;HEIGHT=30;BORDER=0;]"\
"[FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;]" \
"[FONTCOLOR=(0 0 0);FONTSIZE=8;FONTNAME=Times New Roman;]" \
"[MARGIN=(10 0 10 0);FONTCOLOR=(0 0 0);FONTSIZE=9;FONTNAME=Times New Roman;] \
COLUMNFILL={(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255)};\
ALIGNTEXT={Left,Left,Left,center,Right,Right,Right,Right,Right,Right,Right,Right,Right,Left}]"\
"[DATAOBJ=TOUR;FILLCOLOR=LINERGB]"

Data TOUR 'Tournée' TOUR HTTPSQL 0 '[FIND={ID,NAMEDRIVER,IDVEHICLE,DATETOUR,T1,T2,NBCLIENT,NBPALLET,WEIGHT,VOLUME,KM,ROUTETIME,WORKTIME,STATE}]'   [DOUBLECLICK=TableDelivery] \
"[14;(string,ID,ID,,15,,);(string,NAMEDRIVER,Chauffeur,,25,,);(string,IDVEHICLE,Véhicule,,20,,);(date,DATETOUR,Date tournée,,20,,YYYY-MM-DD|DD/MM/YYYY);(time,T1,H départ,,20,,HH:MM);(time,T2,H retour,,20,,HH:MM);(int,NBCLIENT,#Client,,20,,);(int,NBPALLET,#Palette,,20,,);(float,WEIGHT,Poids,,20,,);(float,VOLUME,Volume,,20,,);(int,KM,KM,,20,,);(duration,ROUTETIME,Temps de route,,20,,);(duration,WORKTIME,Temps travail,,20,,);(string,STATE,Etat,,15,,);(color,LINERGB,(255 255 255),,13.0.0);]" \
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT t.Id AS ID,\
		 (select dr.LastName from DRIVER dr where dr.ID=t.idDriver) as NAMEDRIVER,\
		 t.idVehicle AS IDVEHICLE,\
		  format(t.T1,'YYYY-MM-DD')  as DATETOUR,\
		  mid(t.T1, 12,5) as T1,\
		  mid(t.T2, 12,6) as T2,\
		  (select count(1) from DELIVERY d where d.IdTour=t.Id) as NBCLIENT,\
		  format(t.Weight,'0.0') as WEIGHT,\
		  format(t.Volume,'0.0') as VOLUME,\
		 (select sum(NbPallet) from DELIVERY d where d.IdTour=t.Id) as NBPALLET,\
		 format(t.KM/1000.0,'0.0') as KM,\
		 t.worktime as WORKTIME,\
		 t.routeTime as ROUTETIME,\
		  IIF(t.IdState in (select s.Id from STATE s where s.CATEGORY='TOUR'),\
		    (select Label from STATE s where s.Id=t.IdState and s.CATEGORY='TOUR'),\
		    t.IdState) as STATE,\
		  IIF(t.IdState in (select s.Id from STATE s where s.CATEGORY='TOUR'),\
		    (select Color from STATE s where s.Id=t.IdState and s.CATEGORY='TOUR'),\
		   '(255 255 255)') AS LINERGB \
	 FROM TOUR t\
	 WHERE (t.IdState is NULL or t.IdState<>'9')\
	 ORDER BY t.Id desc"


