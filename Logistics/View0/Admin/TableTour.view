Data DRIVER 'Driver' DRIVER HTTPSQL 0 _ _ \
"[3;(string,IDDRIVER,ID chauffeur,,15.0.80,0);(string,NAMEDRIVER,Nom chauffeur,,50.0.300,0);\
(date,TOMORROW,Demain,,8.0.100,1,YYYYMMDD);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT dr.id AS IDDRIVER,\
 (trim(dr.LastName) + ', ' + dr.FirstName) as NAMEDRIVER,\
 format(Date()+1, 'YYYYMMDD') as TOMORROW \
 FROM DRIVER dr \
 ORDER BY dr.Id"


Data VEHICLE 'Vehicle' VEHICLE HTTPSQL 0 _ _ \
"[2;(string,IDVEHICLE,Camion ID,,15.0.80,0);(string,IMMATRIC,Immatriculation,,50.0.300,0);]"\
"SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);QUERY=SELECT v.id AS IDVEHICLE, \
	      v.Immatric as IMMATRIC \
	FROM VEHICLE v \
	ORDER BY v.Id"


