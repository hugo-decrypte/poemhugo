Script PrintDeliveryPreparation  'Imrpimer fiche de préparation' _ 80 'Imrpimer fiche de préparation' _ 'tableTOUR' '( 0 0 0 0 )' _ _ _  '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]' \
	 Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Script\ScriptPrint.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
	 '(/*SERVERPORT*/) (/*USERID*/)  PrintTourDeliveryPreparation.ini  PreparationDeliveryTour \
	 {/*selected(tableTOUR;1;(string,ID))*/}' \
	 WinExec "[WAITTIME=300S;CONSOLE=0;;DATAFMT=(SEP=',',RET=',',FMT=T,QUOT=SQUOT,HEADER=F,COUNT=F)]"\
	 'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe' '(/*POEMPRINTAPPPATH*/)PreparationDeliveryTour{/*selected(tableTOUR;1;(string,ID))*/}.pdf' _ _ _ _ _ 

