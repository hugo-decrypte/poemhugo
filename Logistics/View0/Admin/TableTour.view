"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);CLUBID=(/*CLUBID*/);NBDAY=0;OWNEROBJ=IdTour;IDOBJ={/*Selected(tableTOUR;1;(string,ID))*/};TITLEOBJ=de la tournée {/*Selected(tableTOUR;1;(string,ID))*/};OWNERSUBOBJ=IdProduct;IDSUBOBJ='XXX';IDTOUR='XXX']"

