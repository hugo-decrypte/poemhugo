// 0	Cré 	
// 1	Validée	
// 2	Livrée	
// 3	Facturée
// 4	Quantité erronée	quantité  prévue et quantité  réelle sont difé rentes ou quantité défecteuse positive
// 6	Refacturée	Factueré la partie trop livrée ou faire un avoir
// 9	Terminée
Script CreateTour  'Créer tournée' _ 61 'Créer' _ 'tableTOUR' '( 0 0 0 0 )' '[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' _ _  '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \
Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Tour\CreateTour.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
 '(/*SERVERPORT*/) (/*USERID*/)  \
{/*Input(Créer tournée;3;\
(string,NAMEDRIVER,Chauffeur,,50.0.580,0,,[/*DRIVER.NAMEDRIVER*/]);\
(string,IMMATRIC,Véhicule,,50.0.580,0,,[/*VEHICLE.IMMATRIC*/]);\
(date,DATETOUR,Date tournée,[/*DRIVER.TOMORROW*/],10.0.580,1,YYYY-MM-DD);\
)*/}\
'\
Reload _ _ _

Script ModifyTour  'Modifier tournée' _ 62 'Modifier' _ 'tableTOUR' '( 0 0 0 0 )' '[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' _ _  '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \
Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Tour\UpdateTour.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \
 '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableTOUR;1;(string,ID))*/}  \
{/*Input(Modifier tournée;2;\
(date,DATETOUR,Date tournée,[/*TOUR.DATETOUR*/],10.0.580,1,YYYY-MM-DD);\
(time,TIMESTART,Le plus tôt,[/*TOUR.T1*/],8.0.580,1,HHMM);\
)*/}\
'\
Reload _ _ _

Script TableState  'Etat tournée' _ 23 'Tableau état' _ 'tableTOUR' '( 0 0 0 0 )' _ _ _ '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=86400000;MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=1;]'\
