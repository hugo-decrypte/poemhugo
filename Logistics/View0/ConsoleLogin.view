View LoginView _ LoginView 255 255 255 _ 0 0 40 40 5 5 5 5 '[TRACELEVEL=0;TRACEFILE=;GLOBALVARIABLE=1;DEBUGLEVEL=0;SCROLLBAR=0;NATURESCALE=0;BESTFIT=1]''{/*(GLOBALPARAMETERS;5;\
