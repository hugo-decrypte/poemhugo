['Work Directory' "Model\Common\Config\ReadUserLogin.n"],



'()' => (
	% Input buffer
	strPrintIniFile 	:: "",
        strPrintOutputFile 	:: "",
        strPrintOutputFile0 	:: "",
	
	strPrintIniFile 	= (),
        strPrintOutputFile0 	= (),

	nbIdObjet = (),
	nbParam = (),
	
	\forall i \in [1, nbIdObjet] (
		strIdObjet0_{i} :: "",
		strIdObjet_{i}  :: "",
		
		strIdObjet0_{i} = (),

		i < nbIdObjet =>(
			strIdObjet_{i} = ("'" strIdObjet0_{i} "',"),
			;
			strIdObjet_{i} = ("'" strIdObjet0_{i} "'"),
		),
	),

	strConcatObjet :: "",
        strConcatObjet = [\forall i \in [1,nbIdObjet] strIdObjet_{i}],

	strPrintOutputFile = ( strPrintOutputFile0 strConcatObjet ".PDF"),


	%strPrintOutExtension>"" => (
	%	strPrintOutputFile = ( strPrintOutputFile0 strConcatObjet "." strPrintOutExtension ),
	%	;
	%	strPrintOutputFile = ( strPrintOutputFile0 strConcatObjet ),
	%),

	("PoemClientDirectory=" PoemClientDirectory : ),
	("poemPrintDirectory=" poemPrintDirectory : ),
	("poemPrintExe=" poemPrintExe : ),
	("poemPrintDirectory=" poemPrintDirectory : ),


	% build the cmd string now....
	strWinExe :: "",
	strWinExe = (PoemClientDirectory poemPrintDirectory poemPrintExe " " serverDirectory poemPrintDirectory strPrintIniFile
   		      " \"[DSN=" databaseName ";USR=" databaseUser ";DBPWD="  ";OWNER=" databaseOwner 
		     ";DEVICENAME=" poemPrintDevice ";OUTPUT="serverDirectory poemPrintDirectory strPrintOutputFile "]\"  " 
                     " \"" serverDirectory poemPrintDirectory "\" \"" strConcatObjet "\" \""  idUserLogin "\" \"" databasePassword "\""),

	("CmdPrint=" strWinExe : ),

	strOpenFile = ("\"" poemPrintBrowser "\" \"" poemPrintDirectory strPrintOutputFile "\" "),

	(OS: strWinExe),
	
	%% (OS: strOpenFile),
)

.

