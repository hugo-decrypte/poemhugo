['Work Directory' "Model\Common\Config\ReadUserLogin.n"],
['Work Directory' "Model\Common\Config\ReadConfigLogin.n"],

['Work Directory' "Model\Common\Config\ReadConfigDate.n"],
['Work Directory' "Model\Common\Config\ReadDateTime.n"],

['Work Directory' "Model\Common\Config\ReadMacro.n"],
['Work Directory' "Model\Common\Config\ReadMacroView.n"],

['Work Directory' "Model\Common\Config\CheckLog.n"],

['Work Directory' "Model\Common\Function\FuncConcatSet.n"],


['Work Directory' "Model\Input\Vehicle\ReadVehicle.n"],
['Work Directory' "Model\Input\Vehicle\ReadResource.n"],

['Work Directory' "Model\Input\Depot\ReadDepot.n"],
['Work Directory' "Model\Input\Product\ReadProduct.n"],


'()' => (
	sqlOperationLog = (),


	ruleOptimizeCandidate		== (sqlOperationLog = TAG_OPTIMIZE_CANDIDATE),
	ruleOptimizePlannedCandidate	== (sqlOperationLog = TAG_OPTIMIZE_PLANNED_CANDIDATE),

	ruleRelaxation			== !(ruleOptimizeCandidate || ruleOptimizePlannedCandidate),


	RefRule = \{
		`ruleOptimizeCandidate`,
		`ruleOptimizePlannedCandidate`,
		`ruleRelaxation`
	\},


	\bigoplus{RefRule},


	%ruleOptimizeCandidate \oplus ruleOptimizePlannedCandidate,


	result :: "",
	result = [['Work Directory' "Model\Solver\GenerateSolution.n"], ['Work Directory' "ncl.cfg"], 'Trace Level'],



	(TAG_SEPARATION_LINE : '()' ),

	% Attention: failure may occur at parsing. PostSolving may be not reached
	? result (
	'all solutions found',
	'optimal solution proved',
	'approximate solution found',
	'stopped with solution' :
		(TAG_TASK_ACCOMPLISHED : '()'),
		;

	'stopped without solution':
		(TAG_STOPPED_NO_SOLUTION : false),
		;

	'no solution exists':
		(TAG_NO_SOLUTION : false),
		;

	TAG_RELAXATION_TERMINATED :
		(TAG_TASK_ACCOMPLISHED : '.'),
		;

	:

		result[1..8] = "failure:" => (
			(TAG_FAILURE result[10..#result] : false),
			;

			(result : false),
		),
	),
),
