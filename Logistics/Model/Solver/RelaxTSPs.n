'()' => (
	['Work Directory'  "Model\Relaxation\ReadRelaxation.n"],


	\forall t \in TourRelaxed (
		OrderRelaxedTour_{t} = (t = tour_o ? Swap_o : Swap_i),

		OrderRejectedTour_{t} = OrderRelaxedTour_{t},
		OrderAcceptedTour_{t} = OrderRelaxedTour_{(t = tour_o ? tour_i : tour_o)},
	),

	OrderTour1Relaxed = OrderRelaxedTour_{tour_o},


	% For debug
	IdSite_o = \{ \forall o \in Swap_o idSiteOrderBuffer_{o} \},
	IdSite_i = \{ \forall i \in Swap_i idSiteOrderBuffer_{i} \},

	OrderTour2Relaxed = OrderRelaxedTour_{tour_i},
	IdOrderTour1Relaxed = \{ \forall o \in OrderTour1Relaxed idOrderBuffer_{o} \},
	IdOrderTour2Relaxed = \{ \forall o \in OrderTour2Relaxed idOrderBuffer_{o} \},

	('hh:mm:ss' TAG_TAB_1 loop " "
		TAG_TOUR_TO_RELAX " : "
		Tour1Relaxed " " Tour2Relaxed "  "

		TAG_KEY_ORDER " : "
		OrderTour1Relaxed " " OrderTour2Relaxed "  "
		IdOrderTour1Relaxed " " IdOrderTour2Relaxed "  "

		TAG_KEY_SITE " : "
		IdSite_o " " IdSite_i
		: '()'
	),


	% Plan buffer
	\forall t \in TourActiveBuffer (
		OrderTourPlan_{t}	\subset ORDER,
		SourceOrderTourPlan_{t}	\subset SourceActiveOrderBuffer,

		quantityTourPlan_{t}	:: 0,
		weightTourPlan_{t}	:: 0.0,
		volumeTourPlan_{t}	:: 0.0,

		receiptsTourPlan_{t}	:: 0.0,

		costTourPlan_{t}	:: 0.0,
	
		mileageTourPlan_{t}	:: 0,

		t1TourPlan_{t}		:: defaultDateTime,
		t2TourPlan_{t}		:: defaultDateTime,

		timeServiceTourPlan_{t}	:: 0,
		timeRouteTourPlan_{t}	:: 0,

		worktimeTourPlan_{t} 	:: defaultTime,
		makespanTourPlan_{t} 	:: defaultTime,

		worktimeTourBuffer_{t}	= timeServiceTourBuffer_{t} + timeRouteTourBuffer_{t},
		makespanTourBuffer_{t} 	= t2TourBuffer_{t} - t1TourBuffer_{t} + 1,
	),


	\forall o \in SourceActiveOrderBuffer (
		timeServiceOrderPlan_{o}	:: defaultTime,
		timeToNextOrderPlan_{o}		:: defaultTime,

		nextOrderPlan_{o}		:: 0,
	
		t1OrderPlan_{o}			:: defaultDateTime,
		t2OrderPlan_{o}			:: defaultDateTime,

		timeServiceOrderPlan_{o}	:: defaultTime,
		timeToNextOrderPlan_{o}		:: defaultTime,

		mileageOrderPlan_{o}		:: 0,
		receiptsOrderPlan_{o}		:: 0.0,
	),

	\forall t \in TourRelaxed (
		OrderTourPlan_{t} = OrderTourBuffer_{t} \setminus OrderRejectedTour_{t} \cup OrderAcceptedTour_{t},
		SourceOrderTourPlan_{t} = OrderTourPlan_{t} \cup \{ sourceTour_{t} \},
	),


	% By default, assign buffered values to those not re-optimized tours
	\forall t \in TourActiveBuffer \setminus TourRelaxed (
		OrderTourPlan_{t}	= OrderTourBuffer_{t},
		SourceOrderTourPlan_{t}	= SourceOrderTourBuffer_{t},

		quantityTourPlan_{t} 	= quantityTourBuffer_{t},
		weightTourPlan_{t} 	= weightTourBuffer_{t},
		volumeTourPlan_{t} 	= volumeTourBuffer_{t},

		receiptsTourPlan_{t} 	= receiptsTourBuffer_{t},

		costTourPlan_{t} 	= costTourBuffer_{t},

		mileageTourPlan_{t}	= mileageTourBuffer_{t},

		t1TourPlan_{t}		= t1TourBuffer_{t},
		t2TourPlan_{t}		= t2TourBuffer_{t},

		timeServiceTourPlan_{t}	= timeServiceTourBuffer_{t},
		timeRouteTourPlan_{t}	= timeRouteTourBuffer_{t},

		worktimeTourPlan_{t}	= worktimeTourBuffer_{t},
		makespanTourPlan_{t}	= makespanTourBuffer_{t},

		\forall o \in SourceOrderTourPlan_{t} (
			timeServiceOrderPlan_{o}	= timeServiceOrderBuffer_{o},
			timeToNextOrderPlan_{o}		= timeToNextOrderBuffer_{o},

			nextOrderPlan_{o}		= nextOrderBuffer_{o},
	
			t1OrderPlan_{o}			= t1OrderBuffer_{o},
			t2OrderPlan_{o}			= t2OrderBuffer_{o},

			timeServiceOrderPlan_{o}	= timeServiceOrderBuffer_{o},
			timeToNextOrderPlan_{o}		= timeToNextOrderBuffer_{o},

			mileageOrderPlan_{o}		= mileageOrderBuffer_{o},
			receiptsOrderPlan_{o}		= receiptsOrderBuffer_{o},
		),
	),

	TSP = [1, #TourRelaxed],
	\forall tsp \in TSP (
		idTourTsp_{tsp} :: "",
		idTourTsp_{tsp} = idTour_{TourRelaxed[tsp]},
	),
),


'@' => (	% ????????

%loop = 1 => !!,

	\forall tsp \in TSP (
		resultTsp_{tsp} := [['Work Directory' "Model\Solver\SolveRelaxTSP.n"], ['Work Directory' "parallel.cfg"], 'Trace Level'],

		resultTsp_{tsp} \not\in ResultWithSolution => (
			\forall t \in TSP : t >= tsp
				mileageTour_{tourId_{idTourTsp_{t}}} = mileageBuffer,

			('hh:mm:ss' TAG_TAB_2 TAG_NO_BETTER_SOLUTION " : " idTourTsp_{tsp} : ),

			(resultTsp_{tsp} : false),
		),
	),
),

