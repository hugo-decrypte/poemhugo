'()' => (
	['Work Directory'  "Model\Relaxation\ReadRelaxation.n"],


	idTourTSP	= idTour_{tourTSP},

	vehicleTSP	= vehicleTour_{tourTSP},
	typeVehicleTSP	= typeVehicleVehicle_{vehicleTSP},

	idVehicleTSP		= idResource_{vehicleTSP},
	idxTourVehicleTSP	= idxTourVehicleTour_{tourTSP},



	source	= -tourTSP,
	sink	= -tourTSP - nbTour,


	SourceTSP	= \{ source \},
	SinkTSP		= \{ sink \},


	maxTour0Vehicle_{vehicleTSP} > 0 => (
		TAG_VEHICLE " " idVehicleTSP " : " TAG_MAX_TOUR " = " maxTour0Vehicle_{vehicleTSP} :
		idxTourVehicleTSP \in [1, maxTour0Vehicle_{vehicleTSP}],
	),


	% Tour sites
	idSite10Vehicle_{vehicleTSP} <> "" => (
		idSite1Vehicle = idSite10Vehicle_{vehicleTSP},

		idSite20Vehicle_{vehicleTSP} <> "" => (
			idSite2Vehicle = idSite20Vehicle_{vehicleTSP},
			;
			idSite2Vehicle = idSite10Vehicle_{vehicleTSP},
		),
		;

		idSite1Vehicle = idSite20Vehicle_{vehicleTSP},
		idSite2Vehicle = idSite20Vehicle_{vehicleTSP},
	),



	OrderTSP		= OrderTourBuffer_{tourTSP},

	SourceOrderTSP		= SourceTSP \cup OrderTSP,
	OrderSinkTSP		= OrderTSP  \cup SinkTSP,
	SourceOrderSinkTSP	= SourceOrderTSP \cup SinkTSP,


%	SourceOrderTSP		= SourceOrderTourBuffer_{tourTSP},	% ????????
%	OrderSinkTSP		= OrderSinkTourBuffer_{tourTSP},
%	SourceOrderSinkTSP	= SourceOrderSinkTourBuffer_{tourTSP},



	idSite1TSP		= idSite1TourBuffer_{tourTSP},
	idSite2TSP		= idSite2TourBuffer_{tourTSP},


	% Tour horizon
	t10ResourceTSP = (t100Vehicle_{vehicleTSP} = defaultDateTime ? t1 : t100Vehicle_{vehicleTSP}),
	t20ResourceTSP = (t200Vehicle_{vehicleTSP} = defaultDateTime ? t2 : t200Vehicle_{vehicleTSP}),


	t10TSP			= t1TourBuffer_{tourTSP},

	tourTSP < tour2ActiveVehicleBuffer_{vehicleTSP} => (
		t20TSP	= t1TourBuffer_{tourTSP+1} - 1,
		;

		t20TSP	= t20ResourceTSP,
	),

	Horizon0TSP = [
		(t10TSP = defaultDateTime ? t10ResourceTSP : t10TSP),
		(t20TSP = defaultDateTime ? t20ResourceTSP : t20TSP)
	],

	HorizonTSP = (ruleDailyTour ? Horizon0TSP \cap HorizonDate_{t10TSP["yyyy-mm-dd"]} : Horizon0TSP),



	% Bound
	boundMileage0TSP	= mileageTourBuffer_{tourTSP},

	boundTimeService0TSP	= timeServiceTourBuffer_{tourTSP},
	boundTimeRoute0TSP	= timeRouteTourBuffer_{tourTSP},

	boundMakespan0TSP	= t20TSP - t10TSP + 1,



	% Other tours
	sumMileageVehilce_1	= \sum_{t \in TourVehicle_{vehicleTSP} \cap TourActiveBuffer \setminus tourTSP}{mileageTourBuffer_{t}},
	sumTimeServiceVehilce_1	= \sum_{t \in TourVehicle_{vehicleTSP} \cap TourActiveBuffer \setminus tourTSP}{timeServiceTourBuffer_{t}},
	sumTimeRouteVehilce_1	= \sum_{t \in TourVehicle_{vehicleTSP} \cap TourActiveBuffer \setminus tourTSP}{timeRouteTourBuffer_{t}},
	sumMakespanVehilce_1	= \sum_{t \in TourVehicle_{vehicleTSP} \cap TourActiveBuffer \setminus tourTSP}{t2TourBuffer_{t}-t1TourBuffer_{t}+1},




	% Tour max worktime / max makespan
	maxMakespanConfig = (maxMakespanDay = 0 ? timeDay : maxMakespanDay),
	maxWorktimeConfig = (maxWorktimeDay = 0 ? timeDay : maxWorktimeDay),

	maxMakespanDayTypeVehicle = (maxMakespanDay0TypeVehicle_{typeVehicleTSP} = 0 ? maxMakespanConfig : maxMakespanDay0TypeVehicle_{typeVehicleTSP}),
	maxWorktimeDayTypeVehicle = (maxWorktimeDay0TypeVehicle_{typeVehicleTSP} = 0 ? maxWorktimeConfig : maxWorktimeDay0TypeVehicle_{typeVehicleTSP}),

	maxWorktimeDayVehicle = (maxWorktimeDay0Vehicle_{vehicleTSP} = 0 ? maxWorktimeDayTypeVehicle : maxWorktimeDay0Vehicle_{vehicleTSP}),
	maxMakespanDayVehicle = (maxMakespanDay0Vehicle_{vehicleTSP} = 0 ? maxMakespanDayTypeVehicle : maxMakespanDay0Vehicle_{vehicleTSP}),




	% Bounds
	boundWorktime0TSP = boundTimeService0TSP + boundTimeRoute0TSP,	% ????????
	boundWorktimeTSP = (boundWorktime0TSP = 0 ? maxWorktimeDayVehicle : boundWorktime0TSP),

	boundMakespanTSP = (boundMakespan0TSP = 0 ? maxMakespanDayVehicle : boundMakespan0TSP),

	boundMileageTSP = (boundMileage0TSP = 0 ? +\infty : boundMileage0TSP),



	receiptsTSP = \sum_{o \in OrderTSP}{receiptsOrder_{o}},

	costUnitTSP	= costUnitTypeVehicle_{typeVehicleTSP},



	% Capacity
	maxQuantityTypeVehicle 	= (maxQuantity0TypeVehicle_{typeVehicleTSP} = 0 ? +\infty : maxQuantity0TypeVehicle_{typeVehicleTSP}),
	maxWeightTypeVehicle 	= \overline{(maxWeight0TypeVehicle_{typeVehicleTSP} = 0.0 ? +\infty : maxWeight0TypeVehicle_{typeVehicleTSP})},
	maxVolumeTypeVehicle 	= \overline{(maxVolume0TypeVehicle_{typeVehicleTSP} = 0.0 ? +\infty : maxVolume0TypeVehicle_{typeVehicleTSP})},

	maxQuantityTSP	= (maxQuantityTour0Vehicle_{vehicleTSP} = 0 ? maxQuantityTypeVehicle	: maxQuantityTour0Vehicle_{vehicleTSP}),
	maxWeightTSP	= (maxWeightTour0Vehicle_{vehicleTSP} 	= 0.0 ? maxWeightTypeVehicle	: maxWeightTour0Vehicle_{vehicleTSP}),
	maxVolumeTSP	= (maxVolumeTour0Vehicle_{vehicleTSP} 	= 0.0 ? maxVolumeTypeVehicle	: maxVolumeTour0Vehicle_{vehicleTSP}),



	% Schedule
	Schedule = Schedule0Resource_{vehicleTSP} \cap HorizonTSP,
	ScheduleRest = HorizonTSP \setminus Schedule,



	% Site
	\forall o \in SourceOrderSinkTSP
		siteOrder_{o} \in SITE,

	\forall o \in OrderTSP
		siteOrder_{o} = siteId_{idSite2Order_{o}},

	siteOrder_{source}	= (idSite1TSP <> "" ? siteId_{idSite1TSP} : siteId_{idSite1Vehicle}),
	siteOrder_{sink}	= (idSite2TSP <> "" ? siteId_{idSite2TSP} : siteId_{idSite2Vehicle}),



	% dOrderOrder/tOrderOrder
	\forall o,i \in SourceOrderSinkTSP (
		tOrderOrder_{o,i} :: defaultTime,
		tOrderOrder_{o,i} >= 0,

		dOrderOrder_{o,i} = dSiteSite_{siteOrder_{o},siteOrder_{i}},
		tOrderOrder_{o,i} = tSiteSite_{siteOrder_{o},siteOrder_{i}},
	),


	costUnitKilometer = costKilometerTypeVehicle_{typeVehicleTSP},





	\forall t \in TourActiveBuffer (
		OrderTourPlan_{t}	\subset ORDER,
		SourceOrderTourPlan_{t}	\subset SourceActiveOrderBuffer,

		quantityTourPlan_{t}	:: 0,
		weightTourPlan_{t}	:: 0.0,
		volumeTourPlan_{t}	:: 0.0,

		receiptsTourPlan_{t}	:: 0.0,

		costTourPlan_{t}	:: 0.0,
	
		mileageTourPlan_{t}	:: 0,

		t1TourPlan_{t}		:: defaultDateTime,
		t2TourPlan_{t}		:: defaultDateTime,

		timeServiceTourPlan_{t}	:: 0,
		timeRouteTourPlan_{t}	:: 0,

		worktimeTourPlan_{t} 	:: defaultTime,
		makespanTourPlan_{t} 	:: defaultTime,

		worktimeTourBuffer_{t}	= timeServiceTourBuffer_{t} + timeRouteTourBuffer_{t},
		makespanTourBuffer_{t} 	= t2TourBuffer_{t} - t1TourBuffer_{t} + 1,
	),


	\forall o \in SourceActiveOrderBuffer (
		timeServiceOrderPlan_{o}	:: defaultTime,
		timeToNextOrderPlan_{o}		:: defaultTime,

		nextOrderPlan_{o}		:: 0,
	
		t1OrderPlan_{o}			:: defaultDateTime,
		t2OrderPlan_{o}			:: defaultDateTime,

		timeServiceOrderPlan_{o}	:: defaultTime,
		timeToNextOrderPlan_{o}		:: defaultTime,

		mileageOrderPlan_{o}		:: 0,
		receiptsOrderPlan_{o}		:: 0.0,
	),





	% By default, assign buffered values to those not re-optimized tours
	\forall t \in TourActiveBuffer \setminus tourTSP (
		OrderTourPlan_{t}	= OrderTourBuffer_{t},
		SourceOrderTourPlan_{t}	= SourceOrderTourBuffer_{t},


		quantityTourPlan_{t} 	= quantityTourBuffer_{t},
		weightTourPlan_{t} 	= weightTourBuffer_{t},
		volumeTourPlan_{t} 	= volumeTourBuffer_{t},

		receiptsTourPlan_{t} 	= receiptsTourBuffer_{t},

		costTourPlan_{t} 	= costTourBuffer_{t},

	
		mileageTourPlan_{t}	= mileageTourBuffer_{t},

		t1TourPlan_{t}		= t1TourBuffer_{t},
		t2TourPlan_{t}		= t2TourBuffer_{t},

		timeServiceTourPlan_{t}	= timeServiceTourBuffer_{t},
		timeRouteTourPlan_{t}	= timeRouteTourBuffer_{t},

		worktimeTourPlan_{t}	= worktimeTourBuffer_{t},
		makespanTourPlan_{t}	= makespanTourBuffer_{t},


		\forall o \in SourceOrderTourPlan_{t} (
			timeServiceOrderPlan_{o}	= timeServiceOrderBuffer_{o},
			timeToNextOrderPlan_{o}		= timeToNextOrderBuffer_{o},

			nextOrderPlan_{o}		= nextOrderBuffer_{o},
	
			t1OrderPlan_{o}			= t1OrderBuffer_{o},
			t2OrderPlan_{o}			= t2OrderBuffer_{o},

			timeServiceOrderPlan_{o}	= timeServiceOrderBuffer_{o},
			timeToNextOrderPlan_{o}		= timeToNextOrderBuffer_{o},

			mileageOrderPlan_{o}		= mileageOrderBuffer_{o},
			receiptsOrderPlan_{o}		= receiptsOrderBuffer_{o},
		),
	),


	IdOrderTSP = [\forall o \in OrderTSP (o " " idOrder_{o} "  ")],

	('hh:mm:ss' TAG_TAB_2 TAG_TOUR " " tourTSP " : " idTourTSP "    " TAG_ORDER_NB " : " #OrderTSP "    " IdOrderTSP "    " TAG_OBJECTIVE " : " nameObjectiveTop "    " TAG_HORIZON " : " \inf HorizonTSP " .. " \sup HorizonTSP : ),
	%('hh:mm:ss' TAG_TAB_2 TAG_TOUR " : " idTourTSP "    " TAG_ORDER_NB " : " #OrderTSP "    " IdOrderTSP "    " TAG_OBJECTIVE " : " nameObjectiveTop "    " TAG_HORIZON " : " \inf HorizonTSP " .. " \sup HorizonTSP : true ),


),

<TSP>(	loop, solutionBuf, maxBacktrack, maxTime, stepCost,stepTime,stepDistance,
	tourTSP, nameObjectiveTop,
	boundWorktime, boundMakespan, boundMileage,
	mileage)
(

	['Work Directory' "Model\Solver\TSP.n"],

	'@' => (
		['Work Directory' "Model\Output\WriteBufferTSP.n"],
	),


	['Work Directory' "Model\Solver\TerminateSolving.n"],
),


% Global variables : mileageTour_{t}

'@' => (

	resultTSP = TSP(
		loop, solutionBuf, maxBacktrack*3, maxTime, stepCost,stepTime,stepDistance,
		tourTSP, TAG_MILEAGE,
		maxWorktimeDayVehicle, maxMakespanDayVehicle, boundMileageTSP,
		%boundWorktimeTSP, boundMakespanTSP, boundMileageTSP,
		mileageTour_{tourTSP}
	),

	resultTSP = 'optimal solution proved' =>
		('hh:mm:ss' TAG_TAB_2 idTourTSP " : " TAG_VEHICLE " " idVehicleTSP  " " TAG_TOUR " " idxTourVehicleTSP " " TAG_OPTIMIZED : ),


	resultTSP \not\in ResultWithSolution => (
		('hh:mm:ss' TAG_TAB_2 TAG_NO_BETTER_SOLUTION " : " idTourTSP : ),
		%('hh:mm:ss' TAG_TAB_2 TAG_NO_BETTER_SOLUTION " : " idTourTSP : false),

		mileageTour_{tourTSP} = boundMileageTSP,


	),

	%(resultTSP : '.'),
),
