	%activeTour_{t} == dateOrder_{sourceTour_{t}} <> dateInactive,
	%activeTour_{t} == dateOrder_{sinkTour_{t}} <> dateInactive,
),


SourceActive = \bigcup_{t \in TourActive}{SourceTour_{t}},	% ??????
SinkActive = \bigcup_{t \in TourActive}{SinkTour_{t}},		% ??????

SourceActiveOrder = SourceActive \cup ORDER,

OrderSinkActive = ORDER \cup SinkActive,
SourceSinkActiveOrder = SourceActiveOrder \cup SinkActive,


OrderSinkActive = \{ \forall o \in SourceActiveOrder nextOrder_{o} \},
SourceActiveOrder = \{ \forall o \in OrderSinkActive prevOrder_{o} \},


