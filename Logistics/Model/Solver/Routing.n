/*                        OBJECTIVE                     */
/********************************************************/

% profit
cost	= \sum_{v \in VehicleActive}{costVehicle_{v}},
profit	= receipts - cost,




% nbVehicleActive
nbVehicleActive = #{VehicleActive},

% nbTourActive
nbTourActive = #{TourActive},




? nameObjectiveTop (
TAG_RESOURCE_NB:
	\min	nbVehicleActive,
	\min	mileage : stepDistance,
	;
TAG_TOUR_NB:
	\min	nbTourActive,
	\min	mileage : stepDistance,
	;
TAG_PROFIT:
	\max	profit : stepCost,
	;
TAG_COST:
	\min	cost : stepCost,
	;
TAG_MILEAGE:
	\min	mileage : stepDistance,
	;
TAG_WORKTIME:
	\min	worktime : stepTime,
	;
TAG_MAKESPAN:
	\min	makespan : stepTime,
),




