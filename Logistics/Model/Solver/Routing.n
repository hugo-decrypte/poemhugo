/******************************************************/

VehicleActive \subset RESOURCE,
#VehicleActive =< maxVehicleConfig,



TourActive \subset TOUR,
#TourActive =< maxTourConfig,

/******************************************************/
/*                     ORDER                          */
/******************************************************/

\forall o \in SOURCEORDERSINK (
	vehicleOrder_{o} = vehicleTour_{tourOrder_{o}},
	typeVehicleOrder_{o} = typeVehicleTour_{tourOrder_{o}},


	costKilometerTourOrder_{o} = costKilometerTour_{tourOrder_{o}},


/*
	tourOrder_{o} \in TOUR,
	t1Order_{o} :: defaultDateTime,
	t2Order_{o} :: defaultDateTime,			% special for inactive tours

	t1Order_{o} >= t1,
	t2Order_{o} >= t1,

	
	TimeOrder_{o} \subset HORIZON_sink,
	TimeOrder_{o} = [t1Order_{o},t2Order_{o}],	% time from o to next
				

	dateOrder_{o} \in Date \cup \{ dateInactive \},

	siteOrder_{o} \in SITE,
*/
),


%?? `nbTourActive`,



\forall o \in SINK
	#TimeOrder_{o} =< 1,

\forall o \in ORDER
	dateOrder_{o} = t1Order_{o}["yyyy-mm-dd"],


% Coupling and precedence
\forall o,i \in SOURCEORDERSINK (
	sameTourOrderOrder_{o,i} \equiv tourOrder_{o} = tourOrder_{i},
	precOrderOrder_{o,i} \equiv TimeOrder_{o} \prec TimeOrder_{i},
	chainedOrderOrder_{o,i} \equiv sameTourOrderOrder_{o,i} \wedge precOrderOrder_{o,i},
),


\forall t \in TOUR (
	OrderTour_{t} \subset ORDER,
	#OrderTour_{t} =< maxOrderByTour_{t},


	\forall o \in ORDER
		coupledOrderTour_{t,o} == t = tourOrder_{o},

	\forall o,i \in ORDER
		sameTourOrderOrderTour_{t,o,i} \equiv coupledOrderTour_{t,o} \wedge coupledOrderTour_{t,i},
		%sameTourOrderOrderTour_{t,o,i} \equiv inTourOrder_{o,t} \wedge inTourOrder_{i,t},
		%sameTourOrderOrderTour_{t,o,i} \equiv coupledOrderTour_{t,o} \wedge sameTourOrderOrder_{o,i},


	\forall o \in ORDER (
		cardIfOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{sameTourOrderOrderTour_{t,o,i}},
		%cardIfOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{sameTourOrderOrder_{o,i}},


		quantityIfOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{quantityOrder_{i} * sameTourOrderOrderTour_{t,o,i}},

		weightCapacitated =>
		weightIfOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{weightOrder_{i} * sameTourOrderOrderTour_{t,o,i}},

		volumeCapacitated =>
		volumeIfOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{volumeOrder_{i} * sameTourOrderOrderTour_{t,o,i}},



		cardIfNotOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{! sameTourOrderOrderTour_{t,o,i}},


		quantityIfNotOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{quantityOrder_{i} * ! sameTourOrderOrderTour_{t,o,i}},

		weightCapacitated =>
		weightIfNotOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{weightOrder_{i} * ! sameTourOrderOrderTour_{t,o,i}},


		volumeCapacitated =>
		volumeIfNotOrderTour_{t,o} = \sum_{i \in OrderTour_{t}}{volumeOrder_{i} * ! sameTourOrderOrderTour_{t,o,i}},


		%cardIfChainedOrderTour_{t,o} =
		%\sum_{i \in OrderTour_{t}}{chainedOrderOrder_{o,i}} + 
		%\sum_{i \in OrderTour_{t}}{chainedOrderOrder_{i,o}} + 1,

		%cardIfChainedOrderTour_{t,o} =< #OrderTour_{t},
	),
),



% site1Tour/site2Tour
\forall t \in TOUR (
	site1Tour_{t} :: 0,
	site2Tour_{t} :: 0,

	site1Tour_{t} \in Site1Tour_{t},
	site2Tour_{t} \in Site2Tour_{t},
),

\forall v \in RESOURCE (
	site1Tour_{tour1Vehicle_{v}} = site1Vehicle_{v},
	site2Tour_{tour2Vehicle_{v}} = site2Vehicle_{v},
),

\forall o \in SOURCE
	siteOrder_{o} = site1Tour_{tourOrder_{o}},

\forall o \in SINK
	siteOrder_{o} = site2Tour_{tourOrder_{o}},

\forall o \in ORDER
	siteOrder_{o} = siteId_{idSite2Order_{o}},



% dOrderOrder/tOrderOrder
\forall o,i \in SOURCEORDERSINK (
	tOrderOrder_{o,i} :: defaultTime,
	tOrderOrder_{o,i} >= 0,

	dOrderOrder_{o,i} = dSiteSite_{siteOrder_{o},siteOrder_{i}},
	tOrderOrder_{o,i} = tSiteSite_{siteOrder_{o},siteOrder_{i}},
),



% Tour time constraint
\forall t \in TOUR (
	SpanTour_{t} = [t1Tour_{t},t2Tour_{t}],

	%makespanTour_{t} :: defaultTime,
	%makespanTour_{t} = t2Tour_{t} - t1Tour_{t} + 1,

	t1NextSourceTour_{t} = t1Order_{nextSourceTour_{t}},

	t1NextSourceTour_{t} \in HORIZON_sink,

	%timeSourceTour_{t} = timeOrder_{sourceTour_{t}},
),


\forall o \in SOURCEORDER (
	% Active time constraint
	ScheduleOrder_{o} = Schedule0Resource_{vehicleOrder_{o}},
	TimeActiveOrder_{o} = TimeOrder_{o} \cap ScheduleOrder_{o},


	\inf TimeActiveOrder_{o} = t1Order_{o},
	\sup TimeActiveOrder_{o} = t2Order_{o},

	% Rest time constraint
	TimeRestOrder_{o} = TimeOrder_{o} \setminus ScheduleOrder_{o},
	TimeOrder_{o} = TimeActiveOrder_{o} \cup TimeRestOrder_{o},
	TimeRestOrder_{o} \subset ScheduleRestVehicle_{vehicleOrder_{o}},


	% Recursive sorting constraint
	TimeOrder_{o} \prec TimeOrder_{nextOrder_{o}},


	% Active order constraint
	activeOrder_{o} == TimeOrder_{o} <> {},
	activeOrder_{o} == timeActiveOrder_{o} > 0,

	activeOrder_{o} == o \in SourceActiveOrder,
	activeOrder_{o} == dateOrder_{o} <> dateInactive,

	

	mileageOrder_{o} > 0 -> activeOrder_{o},

	activeOrder_{o} -> t1Order_{o} \in ScheduleOrder_{o},
	t2Order_{o} \in ScheduleOrder_{o},


	SpanTourOrder_{o} = SpanTour_{tourOrder_{o}},


	\forall d \in Date (
		activeDateOrder_{o,d} == dateOrder_{o} = d,
		activeDateOrder_{o,d} == TimeOrder_{o} \cap TimeDate_{d} <> {},

		activeDateOrder_{o,d} -> SpanTourOrder_{o} \cap TimeDate_{d} <> {},
	),


	activeOrder_{o} == \bigvee_{d \in Date}{activeDateOrder_{o,d}},


	%t2Order_{o} \in ScheduleOrder_{o},

	mileageOrder_{o} = dOrderOrder_{o,nextOrder_{o}},

	nextOrder_{o} \in ORDERSINK,

	timeServiceOrder_{o}	:: defaultTime, % Possibly 0 at sources
	time0ServiceOrder_{o}	:: defaultTime, % Normally always > 0

	timeToNextOrder_{o}	:: defaultTime,
	timeActiveOrder_{o}	:: defaultTime,


	timeToNextOrder_{o} = tOrderOrder_{o,nextOrder_{o}},

	timeServiceOrder_{o} = #TimeServiceOrder_{o},
	timeRestOrder_{o} = #TimeRestOrder_{o},


	timeServiceOrder_{o} = activeOrder_{o} * time0ServiceOrder_{o},

	timeServiceRestOrder_{o} = timeServiceOrder_{o} + timeRestOrder_{o},
	timeServiceRestOrder_{o} = activeOrder_{o} * (time0ServiceOrder_{o} + timeRestOrder_{o}),


	timeActiveOrder_{o} = #TimeActiveOrder_{o},
	timeActiveOrder_{o} = timeServiceOrder_{o} + timeToNextOrder_{o},


	timeOrder_{o} = #TimeOrder_{o},
	timeOrder_{o} = timeToNextOrder_{o} + timeServiceRestOrder_{o},
),


% Special for service time
% Set partitioning
\forall t \in TOUR (
	SourceOrderTour_{t} = SourceTour_{t} \cup OrderTour_{t},

	OrderSinkTour_{t} = OrderTour_{t} \cup SinkTour_{t},

	tourOrder_{sourceTour_{t}} = t,
	tourOrder_{sinkTour_{t}}   = t,


	% date
	t1NextSourceTour_{t} :: defaultDateTime,

	dateTour_{t} \in \{ \forall o \in SourceOrderTour_{t} dateOrder_{o} \},
	dateTour_{t} \in \{ \forall o \in OrderTour_{t} dateOrder_{o} \} \cup \{ dateInactive \},

	dateTour_{t} = t1NextSourceTour_{t}[dateFormat] ||
	dateTour_{t} = dateInactive,


	%?? `quantityTour`,	% ??????


	% Max quantity constraint
	quantityTour_{t} = \sum_{o \in OrderTour_{t}}{quantityOrder_{o}},


	quantityTour_{t} = 0 \vee
	quantityTour_{t} \in [minQuantityTour_{t}, maxQuantityTour_{t}],


	quantityCapacitatedByProducts =>
	\forall p \in PRODUCT (
		quantityProductTour_{t,p} = \sum_{o \in OrderProductTour_{t,p}}{quantityOrder_{o}},

		quantityProductTour_{t,p} \in [minQuantityProductTour_{t,p}, maxQuantityProductTour_{t,p}] \vee
		quantityProductTour_{t,p} = 0,	% Zhou 1201
	),


	weightTour_{t} >= 0.0,
	volumeTour_{t} >= 0.0,


	% Max weight/volume constraint
	weightCapacitated => (
		weightTour_{t} = \sum_{o \in OrderTour_{t}}{weightOrder_{o}},
		weightTour_{t} \in [0.0, maxWeightTour_{t}],

		activeTour_{t} == weightTour_{t} > 0.0,

		%rateWeightTour_{t} = weightTour_{t} / maxWeightTour_{t},
		%rateWeightTour_{t} = 0.0 || rateWeightTour_{t} > 0.5,
	),
	volumeCapacitated => (
		volumeTour_{t} = \sum_{o \in OrderTour_{t}}{volumeOrder_{o}},
		volumeTour_{t} \in [0.0, maxVolumeTour_{t}],

		activeTour_{t} == volumeTour_{t} > 0,

		%rateVolumeTour_{t} = volumeTour_{t} / maxVolumeTour_{t},
		%rateVolumeTour_{t} = 0.0 || rateVolumeTour_{t} > 0.5,
	),

	weightCapacitatedByProducts =>
	\forall p \in PRODUCT (
		weightProductTour_{t,p} = \sum_{o \in OrderProductTour_{t,p}}{weightOrder_{o}},
		weightProductTour_{t,p} \in [0.0, maxWeightProductTour_{t,p}],
	),
	volumeCapacitatedByProducts =>
	\forall p \in PRODUCT (
		volumeProductTour_{t,p} = \sum_{o \in OrderProductTour_{t,p}}{volumeOrder_{o}},
		volumeProductTour_{t,p} \in [0.0, maxVolumeProductTour_{t,p}],
	),


	mileageTour_{t} = \sum_{o \in SourceOrderTour_{t}}{mileageOrder_{o}}, 

	costMileageTour_{t} = mileageTour_{t} * costKilometerTour_{t},
	costQuantityTour_{t} = quantityTour_{t} * costUnitTour_{t},


	costTour_{t} = costMileageTour_{t} + costQuantityTour_{t},


	time0ServiceTour_{t} =
		timeFixedTour_{t} + \lceil quantityTour_{t} * timeLoadingUnitTypeVehicle_{typeVehicleTour_{t}} \rceil,
		%timeFixedTour_{t} + \lceil weightTour_{t} * timeLoadingUnitTypeVehicle_{typeVehicleTour_{t}} \rceil,


	% Special for non 0 int logic
	time0ServiceOrder_{sourceTour_{t}} = time0ServiceTour_{t},

	timeActiveOrder_{sourceTour_{t}} = activeTour_{t} * (time0ServiceTour_{t} + timeToNextOrder_{sourceTour_{t}}),
	timeOrder_{sourceTour_{t}} = activeTour_{t} * (time0ServiceTour_{t} + timeToNextOrder_{sourceTour_{t}} + timeRestOrder_{sourceTour_{t}}),
),


\forall o \in ORDER (
	tourOrder_{o} \in TourVehicle_{vehicleTour_{tourOrder_{o}}},

	timeLoadingUnitOrder_{o} = timeLoadingUnitTypeVehicle_{typeVehicleOrder_{o}},
	timeUnloadingUnitOrder_{o} = timeUnloadingUnitTypeVehicle_{typeVehicleOrder_{o}},

	time0ServiceOrder_{o} = timeFixedOrder_{o} + \lfloor quantityOrder_{o} * timeUnloadingUnitOrder_{o} + 0.5 \rfloor,

	(idOrder_{o} TAG_SERVICE_TIME_GT_0 : time0ServiceOrder_{o} > 0),
),


\forall o<>i \in SOURCEORDER
	nextOrder_{o} <> nextOrder_{i},


%\forall o<>i \in SOURCEORDERSINK (
%	tourOrder_{o} <> tourOrder_{i} || TimeOrder_{o} \cap TimeOrder_{i} = {},
%	%vehicleOrder_{o} <> vehicleOrder_{i} || TimeOrder_{o} \cap TimeOrder_{i} = {},
%), % ??????




/*******************************************************/
/*                  TYPEVEHICLE                        */
/*******************************************************/

% Vehicle number constraints
\forall t \in TYPEVEHICLE (
	VehicleActiveTypeVehicle_{t} = VehicleTypeVehicle_{t} \cap VehicleActive,

	nbVehicleTypeVehicle_{t} = #{VehicleActiveTypeVehicle_{t}},

	nbVehicleTypeVehicle_{t} \in [minVehicleTypeVehicle_{t},maxVehicleTypeVehicle_{t}],
),



/********************************************************/
/*                        RESOURCE                       */
/********************************************************/

\forall t \in TOUR (
	TAG_RESOURCE_HORIZON_CAPACITY_INSUFFICIENT HORIZON :

	TimeActiveTour_{t} = \bigcup_{o \in SourceOrderTour_{t}}{TimeActiveOrder_{o}},

	%timeActiveTour_{t} = \sum_{o \in SourceOrderTour_{t}}{timeActiveOrder_{o}},
	%\forall o \in SourceOrderTour_{t}
	%	timeActiveOrder_{o} > 0,		% BUG if source only

	TimeTour_{t} = \bigcup_{o \in SourceOrderTour_{t}}{TimeOrder_{o}},

	TimeActiveTour_{t} = TimeTour_{t} \cap Schedule0Tour_{t},
	% BUG ?????? % JZ 0711
	%?? #TimeActiveTour_{5} =< 175, See DEMO

	%TimeActiveTour_{t} \subset Schedule0Tour_{t},


	#TimeActiveTour_{t} =< maxWorktimeDayTour_{t},
	#TimeTour_{t} =< maxMakespanDayTour_{t},

	timeActiveTour_{t} = #TimeActiveTour_{t},
),


\forall v \in RESOURCE (
	TourActiveVehicle_{v}	= TourVehicle_{v} \cap TourActive,


	TourActiveVehicle_{v}	= [tour1Vehicle_{v},tour2ActiveVehicle_{v}],

	tour2ActiveVehicle_{v}	=< tour2Vehicle_{v},

	\forall t \in TourVehicle_{v} \setminus tour2Vehicle_{v} (
		site2Tour_{t} = site1Tour_{t+1},
	),


	SourceVehicle_{v}	= \bigcup_{t \in TourVehicle_{v}}{SourceTour_{t}},
	SinkVehicle_{v}		= \bigcup_{t \in TourVehicle_{v}}{SinkTour_{t}},
	SourceActiveVehicle_{v} = \bigcup_{t \in TourActiveVehicle_{v}}{SourceTour_{t}},


	SourceOrderVehicle_{v}	= \bigcup_{t \in TourVehicle_{v}}{SourceOrderTour_{t}},
	SourceActiveOrderVehicle_{v} = \bigcup_{t \in TourActiveVehicle_{v}}{SourceOrderTour_{t}},


	OrderSinkVehicle_{v}	= \bigcup_{t \in TourVehicle_{v}}{OrderSinkTour_{t}},


	\forall o \in SourceOrderVehicle_{v} (
		nextOrder_{o} \in OrderSinkVehicle_{v},

		%siteOrder_{o} \in SiteVehicle_{v},	% BUG
	),

	OrderVehicle_{v} = \bigcup_{t \in TourActiveVehicle_{v}}{OrderTour_{t}},


	%OrderVehicle_{v} = SourceOrderVehicle_{v} \setminus SourceVehicle_{v},
	%OrderVehicle_{v} = OrderSinkVehicle_{v} \setminus SinkVehicle_{v},
	%OrderVehicle_{v} = SourceActiveOrderVehicle_{v} \setminus SourceVehicle_{v},

	SourceOrderVehicle_{v}		= OrderVehicle_{v} \cup SourceVehicle_{v},
	OrderSinkVehicle_{v}		= OrderVehicle_{v} \cup SinkVehicle_{v},
	SourceActiveOrderVehicle_{v}	= OrderVehicle_{v} \cup SourceActiveVehicle_{v},


	mileageVehicle_{v} = \sum_{t \in TourActiveVehicle_{v}}{mileageTour_{t}},

	%TimeVehicle_{v} = \bigcup_{t \in TourActiveVehicle_{v}}{TimeTour_{t}},
	%TimeVehicle_{v} = \bigcup_{o \in SourceOrderVehicle_{v}}{TimeOrder_{o}},
	%TimeVehicle_{v} = \bigcup_{d \in DateVehicle_{v}}{TimeDateVehicle_{v,d}},


	% TimeActiveVehicle
	TimeActiveVehicle_{v} = \bigcup_{o \in SourceOrderVehicle_{v}}{TimeActiveOrder_{o}},
	TimeActiveVehicle_{v} = \bigcup_{o \in SourceActiveOrderVehicle_{v}}{TimeActiveOrder_{o}},	% ??????

	#TourVehicle_{v} > 1 => (
		TimeActiveVehicle_{v} = \bigcup_{t \in TourVehicle_{v}}{TimeActiveTour_{t}},
		TimeActiveVehicle_{v} = \bigcup_{t \in TourActiveVehicle_{v}}{TimeActiveTour_{t}}, 		% ??????
	),

	TimeActiveVehicle_{v} = \bigcup_{d \in DateVehicle_{v}}{TimeActiveDateVehicle_{v,d}},


	\forall t1<t2 \in TourVehicle_{v} (
		TimeActiveTour_{t1} \prec TimeActiveTour_{t2},


		
		%activeTour_{t2} -> activeTour_{t1},
		%TimeTour_{t1} \prec TimeTour_{t2}, % ??????
		% Redundant constraint, useful in case of INACTIVE tour
		%t2Tour_{t1} =< t2Tour_{t2},
	),


	%site1Tour_{tour1Vehicle_{v}} = site1Vehicle_{v},
	site2Tour_{tour2ActiveVehicle_{v}} = site2Vehicle_{v},


	%#TourActiveVehicle_{v} > 1 => (
	%	site2Tour_{tour1Vehicle_{v}} \in SiteVehicle_{v},
	%	\forall t \in TourActiveVehicle_{v} \setminus \{tour1Vehicle_{v},tour2ActiveVehicle_{v}\} (
	%		site1Tour_{t} \in SiteVehicle_{v},
	%		site2Tour_{t} \in SiteVehicle_{v},
	%	),
	%	site1Tour_{tour2ActiveVehicle_{v}} \in SiteVehicle_{v},
	%),


	%[t1Tour_{tour1Vehicle_{v}}, t2Tour_{tour2ActiveVehicle_{v}}] \subset HorizonVehicle_{v},
	%TimeVehicle_{v} = [t1Tour_{tour1Vehicle_{v}}, t2Tour_{tour2ActiveVehicle_{v}}],
	%TimeVehicle_{v} \subset HorizonVehicle_{v},
	

	timeActiveVehicle_{v}	=< maxWorktimeVehicle_{v},
	timeActiveVehicle_{v}	= #TimeActiveVehicle_{v},


	#TourVehicle_{v} > 1 => (
		timeActiveVehicle_{v} 	= \sum_{o \in SourceOrderVehicle_{v}}{timeActiveOrder_{o}},
		timeActiveVehicle_{v} 	= \sum_{o \in SourceActiveOrderVehicle_{v}}{timeActiveOrder_{o}},	% ??????

		timeActiveVehicle_{v}	= \sum_{t \in TourVehicle_{v}}{timeActiveTour_{t}},
		timeActiveVehicle_{v}	= \sum_{t \in TourActiveVehicle_{v}}{timeActiveTour_{t}},		% ??????
	),


	% Capacity
	quantityVehicle_{v}	= \sum_{t \in TourActiveVehicle_{v}}{quantityTour_{t}},

 
 
	% Max quantity constraint
	quantityVehicle_{v} = \sum_{o \in OrderVehicle_{v}}{quantityOrder_{o}},
	quantityVehicle_{v} =< maxQuantityVehicle_{v},

	quantityCapacitatedByProducts =>
	\forall p \in PRODUCT (
		quantityProductVehicle_{v,p} = \sum_{o \in OrderProductVehicle_{v,p}}{quantityOrder_{o}},
		quantityProductVehicle_{v,p} =< maxQuantityProductVehicle_{v,p} * maxTourByVehicle_{v},
	),


	% Max weight/volume constraint
	weightCapacitated => (
		weightVehicle_{v} = \sum_{t \in TourActiveVehicle_{v}}{weightTour_{t}},
		weightVehicle_{v} = \sum_{o \in OrderVehicle_{v}}{weightOrder_{o}},
		weightVehicle_{v} =< maxWeightVehicle_{v},
	),
	volumeCapacitated => (
		volumeVehicle_{v} = \sum_{t \in TourActiveVehicle_{v}}{volumeTour_{t}},
		volumeVehicle_{v} = \sum_{o \in OrderVehicle_{v}}{volumeOrder_{o}},
		volumeVehicle_{v} =< maxVolumeVehicle_{v},
	),


	% Cost
	nbDayVehicle_{v}	:: 0,
	nbNightVehicle_{v}	:: 0,


	%costMileageVehicle_{v} = \sum_{t \in TourActiveVehicle_{v}}{costMileageTour_{t}} / #OrderVehicle_{v},
	%OrderVehicle_{v} = {} => costMileageVehicle_{v} = 0.0,
% ????????

	costVehicle_{v} =
		costDayVehicle_{v} * nbDayVehicle_{v} +
		costNightVehicle_{v} * nbNightVehicle_{v} +
		\sum_{t \in TourActiveVehicle_{v}}{costTour_{t}},


	activeVehicle_{v} == v \in VehicleActive,

	activeVehicle_{v} == activeTour_{tour1Vehicle_{v}},
	activeVehicle_{v} == OrderVehicle_{v} <> {},
	activeVehicle_{v} == makespanVehicle_{v} > 0,
	activeVehicle_{v} == timeActiveVehicle_{v} > 0,
),



/******************************************************/
/*                     TOUR                           */
/******************************************************/

(TAG_RESOURCE_TOUR_CAPACITY_INSUFFICIENT #TOUR :
	SOURCEORDER = \bigcup_{t \in TOUR}{SourceOrderTour_{t}},
	SourceActiveOrder = \bigcup_{t \in TourActive}{SourceOrderTour_{t}},

	SOURCEORDER = \bigcup_{v \in RESOURCE}{SourceOrderVehicle_{v}},

	SourceActiveOrder = \bigcup_{v \in RESOURCE}{SourceActiveOrderVehicle_{v}},


	SourceActiveOrder = \bigcup_{v \in VehicleActive}{SourceActiveOrderVehicle_{v}},

	\forall v<i \in RESOURCE
		SourceActiveOrderVehicle_{v} \cap SourceActiveOrderVehicle_{i} = {}, % ??????

	\forall t<i \in TOUR
		SourceOrderTour_{t} \cap SourceOrderTour_{i} = {},

	ORDER = \bigcup_{v \in RESOURCE}{OrderVehicle_{v}}, % ??????
	ORDER = \bigcup_{t \in TOUR}{OrderTour_{t}}, % ??????

	ORDER = \bigcup_{v \in VehicleActive}{OrderVehicle_{v}},
	ORDER = \bigcup_{t \in TourActive}{OrderTour_{t}},

	\forall v<i \in RESOURCE
		OrderVehicle_{v} \cap OrderVehicle_{i} = {},

	\forall t<i \in TOUR
		OrderTour_{t} \cap OrderTour_{i} = {},
),


%\forall t<>i \in TOUR
%	OrderTour_{t} \cap OrderTour_{i} = {},
%ORDER = \bigcup_{t \in TOUR}{OrderTour_{t}},


% Order not coupled constraint
%\forall o \in ORDER
%\forall i \in OrderNotCoupledOrder_{o}
%	! sameTourOrderOrder_{o,i},


%['Work Directory' "Model\Debug\DebugSolution.n"],
%['Work Directory' "Model\Debug\WriteDebug.n"],

% prevOrder
%\forall o \in ORDERSINK
%	prevOrder_{o} \in SOURCEORDER,
%\forall o \in SOURCEORDER
%	prevOrder_{nextOrder_{o}} = o, % ??????


\forall o \in SOURCEORDER
\forall n \in ORDERSINK
	nextOrder_{o} = n == o = prevOrder_{n},


\forall t \in TOUR (
	t1Tour_{t} = \inf{TimeActiveTour_{t}},
	t2Tour_{t} = \sup{TimeActiveTour_{t}},


	t1Tour_{t} = \inf{TimeTour_{t}},
	t2Tour_{t} = \sup{TimeTour_{t}},

	t1Tour_{t} \in ScheduleExtendedTour_{t},
	t2Tour_{t} \in Schedule0Tour_{t},

	%activeTour_{t} -> t1Tour_{t} \in Schedule0Tour_{t},

	rearTour_{t} = prevOrder_{sinkTour_{t}},

	t1Tour_{t} = t1Order_{sourceTour_{t}},
	t2Tour_{t} = t2Order_{rearTour_{t}},

	%t1Order_{sinkTour_{t}} = t2Tour_{t} + 1,
	% NO: sink datetime determined internally in routing algorithm


	\forall o \in SourceOrderTour_{t} (
		nextOrder_{o} \in OrderSinkTour_{t},

		% union non-empty implying subset non-empty
		activeTour_{t} -> activeOrder_{o},	% ????????
	),


	IdZoneTour_{t} = \{ \forall o \in OrderTour_{t} idZoneOrder_{o} \},


	\forall o \in ORDER (
		inZoneTourOrder_{o,t} == idZoneOrder_{o} \in IdZoneTour_{t},

		o \in OrderTour_{t} == t = tourOrder_{o},
		%o \in OrderTour_{t} == tourOrder_{o} = t,
		% ?????? ENFORCE_SETINTMAPPING_PARTITIONING_FOR_FLOATSUM
	),


	\forall p \in PRODUCT
		OrderProductTour_{t,p} = OrderTour_{t} \cap OrderProduct_{p},


	nextSourceTour_{t} = nextOrder_{sourceTour_{t}},
	%prevSinkTour_{t} = prevOrder_{sinkTour_{t}},


	% Active logic
	activeTour_{t} == t \in TourActive,



	activeTour_{t} == sourceTour_{t} \in SourceActive,
	activeTour_{t} == sinkTour_{t} \in SinkActive,

	activeTour_{t} == #SourceOrderTour_{t} > 1,
	activeTour_{t} == OrderTour_{t} <> {},

	activeTour_{t} == quantityTour_{t} > 0,
	activeTour_{t} == timeActiveTour_{t} > 0,

	%activeTour_{t} == timeOrder_{sourceTour_{t}} > 0,

	activeTour_{t} == #TimeTour_{t} > 0,
	activeTour_{t} == TimeActiveTour_{t} <> {},

	activeTour_{t} == activeOrder_{sourceTour_{t}},

	%activeTour_{t} == nextSourceTour_{t} \in OrderTour_{t},
	activeTour_{t} == nextSourceTour_{t} <> sinkTour_{t},
	activeTour_{t} == rearTour_{t} <> sourceTour_{t},


	activeTour_{t} == dateTour_{t} <> dateInactive,


