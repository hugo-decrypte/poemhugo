'Search Count' = 0 =>
singleTourCapacitySufficient := \bigvee_{t \in \overline{TourActive}}{
	\overline{#OrderTour_{t}} >= nbOrder
},

costOriented := (loop > 0 || maxVehicleConfig =< 1 || singleTourCapacitySufficient),



\forall n \in ORDERSINK (
	slackPrevOrder_{n} := #{\Delta{prevOrder_{n}}},
),

\forall o \in SOURCEORDER (
	DeltaNextOrder_{o} := \Delta{nextOrder_{o}} \cap ORDER,

	slackNextOrder_{o} = #{DeltaNextOrder_{o}},
	%slackNextOrder_{o} = #{\Delta{nextOrder_{o}}},	% ??????

	slackTimeOrder_{o} = #{\Delta{timeActiveOrder_{o}}},


	DistNextOrder_{o} := \{\forall i \in DeltaNextOrder_{o}  tOrderOrder_{o,i}\},
	diffDistNextOrder_{o} := DistNextOrder_{o}[2] - DistNextOrder_{o}[1],
),


\forall s \in Site2Vehicle \cup SiteDepot
\forall t \in TOUR
	tSinkSiteTour_{t,s} = \underline{tSiteSite_{siteOrder_{prevOrder_{sinkTour_{t}}},s}},

\forall t \in TOUR (
	slackOrderTour_{t} = #{\Delta{OrderTour_{t}}},

	instantiatedOrderTour_{t} := slackOrderTour_{t} = 0,	%\underline{activeTour_{t}} && slackOrderTour_{t} = 0,	% 0825

	\forall o,n \in SOURCEORDER (
		detourOrderOrderTour_{t,o,n} =
		detourSiteSiteTour_{t,siteOrder_{o},siteOrder_{n}},
	),

	\forall n \in ORDER (
		detourOrderTour_{t,n} = \max_{o \in SourceOrderTour_{t}}{
			detourOrderOrderTour_{t,o,n}
		},
	),


	%\forall o<i \in OrderTour_{t} (
	%	areaSquareOrderOrderTour_{t,o,i} =<
	%	areaSquareRightOrderOrderTour_{t,o,i},
	%),

	%sourceChainedToNextTour_{t} := (#{DeltaNextOrder_{sourceTour_{t}}} = 1),
),


\forall t \in TOUR
	instantiatedPreviousTour_{t} :=
	\bigwedge_{i \in TourVehicle_{vehicleTour_{t}} : i < t}{instantiatedOrderTour_{i}},


\forall o \in ORDER (
	slackVehicleOrder_{o} = #{\Delta{vehicleOrder_{o}}},

	slackT1Order_{o} = #{\Delta{t1Order_{o}}},

	t1QueryOrder_{o} = \underline{t1Order_{o}} - 1,


	%\forall t \in TOUR (
	%	incompatibilityOrderTour_{t,o} := \overline{#OrderTour_{t}} - \overline{cardIfOrderTour_{t,o}},
	%),
	%maxIncompatibilityOrder_{o} := \max_{t \in \Delta{tourOrder_{o}}}{incompatibilityOrderTour_{t,o}},
),

\forall o \in SOURCEORDER (
	slackTourOrder_{o} = \sum_{t \in \Delta{tourOrder_{o}}}{instantiatedPreviousTour_{t}},

	%tourNotInstantiatedOrder_{o} == slackTourOrder_{o} > 1,

	\forall n \in ORDER
		timeNextOrder_{o,n} = \underline{time0ServiceOrder_{o} + tOrderOrder_{o,n}},

	% Memory efficient by DeltaNextOrder
	\forall n \in DeltaNextOrder_{o} (
		t1NextOrder_{o,n} := \overline{TimeActiveOrder_{o}}[timeNextOrder_{o,n}],

		t1QueryNextOrder_{o,n} :: defaultDateTime,
		t1QueryNextOrder_{o,n} := \max(t1NextOrder_{o,n}, t1QueryOrder_{n}),
		%t1QueryNextOrder_{o,n} := (! relaxation) * \max(t1NextOrder_{o,n}, t1QueryOrder_{n}),
	),

	%minSlackTourOrder_{o} = \min_{i \in DeltaNextOrder_{o}}{slackTourOrder_{i}},
	%t1MinNextOrder_{o} = \min_{i \in DeltaNextOrder_{o}}{t1QueryNextOrder_{o,i}},

	\forall n \in ORDER (
		timeQueryOrderOrder_{o,n} :: defaultTime,
		
		timeQueryOrderOrder_{o,n} = (
			%\underline{tOrderOrder_{o,n}}
			\underline{tOrderOrder_{o,n} + timeToNextOrder_{n}}
		),
	),
),



\forall o \in SOURCEORDER
	chainedQueryOrder_{o} :: true,

\forall o \in SOURCE
	! chainedQueryOrder_{o},		% ????????

\forall o \in ORDER (
	instantiatedOrder_{o} == slackTourOrder_{o} = 1,

	chainedQueryOrder_{o} := (#{\Delta{prevOrder_{o}}} = 1),
	%chainedQueryOrder_{o} := (#{\Delta{prevOrder_{o}}} = 1 && chainedQueryOrder_{prevOrder_{o}}),
),




