/******************************************************/
/*                  	CAPACITY                      */
/******************************************************/

worktime :: defaultTime,
makespan :: defaultTime,

(TAG_RESOURCE_TOUR_CAPACITY_INSUFFICIENT \overline{#TourActive} :
	% quantity/weight/volume
	quantity = \sum_{t \in TourActive}{quantityTour_{t}},
	quantity = \sum_{v \in VehicleActive}{quantityVehicle_{v}},

	weightCapacitated => (
		weight = \sum_{t \in TourActive}{weightTour_{t}},
		weight = \sum_{v \in VehicleActive}{weightVehicle_{v}},
	),
	volumeCapacitated => (
		volume = \sum_{t \in TourActive}{volumeTour_{t}},
		volume = \sum_{v \in VehicleActive}{volumeVehicle_{v}},
	),


	% mileage
	mileage = \sum_{v \in VehicleActive}{mileageVehicle_{v}},
	mileage	= \sum_{t \in TourActive}{mileageTour_{t}},
	mileage	= \sum_{o \in SourceActiveOrder}{mileageOrder_{o}},

	% worktime
	worktime = \sum_{t \in TourActive}{timeActiveTour_{t}},
	worktime = \sum_{v \in VehicleActive}{timeActiveVehicle_{v}},
	worktime = \sum_{o \in SOURCEORDER}{timeActiveOrder_{o}},	// ?????? for compensation in NCL
	worktime = \sum_{o \in SourceActiveOrder}{timeActiveOrder_{o}},
	worktime =< totalWorktime,

	% makespan
	makespan = \sum_{v \in VehicleActive}{makespanVehicle_{v}},
	makespan =< totalMakespan,
),



