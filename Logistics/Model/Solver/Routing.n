/********************************************************/
/*                      QUERY                           */
/********************************************************/

% Toward last 2 tours not instantiated
nbTourOrderInstantiated = \sum_{t \in \underline{TourActive}}{instantiatedOrderTour_{t}},
nbOrderInstantiated = \sum_{t \in \underline{TourActive}}{#{\underline{OrderTour_{t}}}},
nbOrderToInstantiate = #ORDER - nbOrderInstantiated,


minTourToInstantiate = \underline{nbTourActive} - nbTourOrderInstantiated,
maxTourToInstantiate = \overline{nbTourActive}  - nbTourOrderInstantiated,

minCapacityTourFuzzy =
	\min_{t \in \Delta{TourActive}}{\overline{#{OrderTour_{t}}} - #{\underline{OrderTour_{t}}}},


% Instantiate active tour number if critical point reached
minTourToInstantiate =< 2 && nbOrderToInstantiate =< minCapacityTourFuzzy => (
	nbTourActive = ?,

	\forall t \in \overline{TourActive} -> (
		\min	#{\Delta{#OrderTour_{t}}},
		\min	\overline{#{OrderTour_{t}}},
	)
	(
		activeTour_{t} ?,
		%#{OrderTour_{t}} = ? (<-),	% ????????
	),
),


\forall o \in ORDER
instantiatedOrder_{o} => (
	\forall i \in OrderSiteOrder_{o}
		sameTourOrderOrder_{o,i} ?,
),


% To chain orders to orders
\forall t \in TourToPlan -> (
	% Sequential: First a tour whose previous vehicle tours are all instantiated.
	\max	instantiatedPreviousTour_{t},
)
(
	\forall s \in SITE
		inTourSite_{s,t} == s = site2Tour_{t},
	

	activeTour_{t} =>
		dateTour_{t} = ? (->),


	% To instantiate as soon as a tour is assigned all of its orders
	instantiatedOrderTour_{t} => (
		t " " idTour_{t} :

		\forall s \in \Delta{site2Tour_{t}} -> (
			\min	\Delta{site2Tour_{t}},
			\min	tSinkSiteTour_{t,s},
		)
		inTourSite_{s,t} ?,

		%site2Tour_{t} = s ?,
	),

	\forall o \in SourceOrderTour_{t} -> (
		% Tour integrity: tour to be chained continuously
		%\max	sourceChainedToNextTour_{t},

		%\max	\underline{chainedQueryOrder_{o}},
		\max	(maxTourToInstantiate > 2) * \underline{chainedQueryOrder_{o}},
	)
	\forall n \in DeltaNextOrder_{o} -> (
		% Least tour slack
		\min	slackTourOrder_{n},

		%\min	\underline{detourOrderTour_{t,n}},

		\min	detourOrderOrderTour_{t,o,n},


		% Earliest in terms of time window
		\min	t1QueryNextOrder_{o,n},


		% Least distance
		\min	timeQueryOrderOrder_{o,n},

		%\min	(! relaxation) * slackTourOrder_{n},
		%\min	distQueryOrderTour_{t,n},
		%\min	relaxation * (slackNextOrder_{o} * slackPrevOrder_{n}),
		%\max	relaxation * slackTimeOrder_{o} * slackTimeOrder_{n},
		%\min	(slackNextOrder_{o} * slackPrevOrder_{n}),
		%\min	(!relaxation) * slackTimeOrder_{o} * slackTimeOrder_{n},
		%\max	diffDistNextOrder_{o},
		%\min	incompatibilityOrderTour_{t,n},
		%\max	\overline{dOrderOrder_{o, n} =< distOrderSourceTour_{t,n}},

		\max	maxQuantityTour_{t},
		\max	maxWeightTour_{t},

		% Gready: greatest priority
		\max	priorityOrder_{n},
	)
	( o " " idOrder_{o} " " idSite_{siteOrder_{o}} " >> next " n " " idOrder_{n} " " idSite2Order_{n} " " t " " idTour_{t} :
			nextOrder_{o} = n ?,
	)
),


\forall t \in TourActive (
	t " " idTour_{t} :

	% To be in time: the first of order as early as possible
	t1NextSourceTour_{t} = ? (->),

	t1Tour_{t} = ? (<-),
	t2Tour_{t} = ? (->),
),


% To instantiate at first t1 of each order, as early as possible
\forall o \in OrderToPlan -> (
	\min	\underline{t1Order_{o}},	% sequential search 
	\min	\Delta{timeOrder_{o}},		% least slack
)
t1Order_{o} = ? (->),

% To instantiate at first t1 of each order, as early as possible
\forall o \in SOURCEORDER -> (
