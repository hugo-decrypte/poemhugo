% DEPOT constraints
quantityCapacitatedByProducts =>
\forall d \in DEPOT (
	TourDepot_{d} = \{ \forall t \in TOUR (site1Tour_{t} = siteDepot_{d} ? t : 0) \} \setminus 0,
	VehicleDepot_{d} = \{ \forall v \in RESOURCE (site1Vehicle_{v} = siteDepot_{d} ? v : 0) \} \setminus 0,

	\forall p \in PRODUCT (
		quantityProductDepot_{d,p} =
			\sum_{t \in TourDepot_{d}}{quantityProductTour_{t,p}} -
			\sum_{v \in VehicleDepot_{d}}{quantity0ProductVehicle_{v,p}},

		quantityProductDepot_{d,p} \in [minQuantityProductDepot_{d,p}, maxQuantityProductDepot_{d,p}] \vee
		quantityProductDepot_{d,p} = 0,
	),
),

TourActive = \bigcup_{v \in VehicleActive}{TourActiveVehicle_{v}},


/*******************************************************/
/*                  	WORKTIME                       */
/*******************************************************/

% Max makespan/time constraints
\forall v \in RESOURCE (
	\forall o<>i \in SourceOrderVehicle_{v}
		TimeOrder_{o} \cap TimeOrder_{i} = {},

	%\forall o \in SourceOrderVehicle_{v}
	%	TimeOrder_{o} \prec TimeOrder_{nextOrder_{o}},

	\forall d \in DateVehicle_{v} (
		SourceActiveOrderDateVehicle_{v,d} = \{
			\forall o \in SourceOrderVehicle_{v}
			(dateOrder_{o} = d ? o : 0)
		\} \setminus 0,

		% date worktime
		TimeActiveDateVehicle_{v,d} = TimeActiveVehicle_{v} \cap HorizonDateVehicle_{v,d},
		%TimeDateVehicle_{v,d} = TimeVehicle_{v} \cap HorizonDateVehicle_{v,d},

		% date makespan
		t1DateVehicle_{v,d} \in ScheduleExtendedVehicle_{v},
		t2DateVehicle_{v,d} \in Schedule0Resource_{v},

		t1DateVehicle_{v,d} = \inf TimeActiveDateVehicle_{v,d},
		t2DateVehicle_{v,d} = \sup TimeActiveDateVehicle_{v,d},

		SpanDateVehicle_{v,d} = [t1DateVehicle_{v,d}, t2DateVehicle_{v,d}],
		SpanDateVehicle_{v,d} \subset HorizonDate_{d},

		% active logic for date worktime/makespan
		activeDateVehicle_{v,d} == SourceActiveOrderDateVehicle_{v,d} <> {},
		activeDateVehicle_{v,d} == TimeActiveDateVehicle_{v,d} <> {},
		activeDateVehicle_{v,d} == SpanDateVehicle_{v,d} <> {},

		% active time and makespan
		timeActiveDateVehicle_{v,d} = #TimeActiveDateVehicle_{v,d},
		makespanDateVehicle_{v,d} = #SpanDateVehicle_{v,d},

		timeActiveDateVehicle_{v,d} =< maxWorktimeDayVehicle_{v},	% 10:00:00
		timeActiveDateVehicle_{v,d} =< maxWorktimeDateVehicle_{v,d},

		makespanDateVehicle_{v,d} =< maxMakespanDayVehicle_{v},	% 12:00:00
		makespanDateVehicle_{v,d} =< maxMakespanDateVehicle_{v,d},
	),

	SourceActiveOrderVehicle_{v} = \bigcup_{d \in DateVehicle_{v}}{SourceActiveOrderDateVehicle_{v,d}},

	makespanVehicle_{v} = \sum_{d \in DateVehicle_{v}}{makespanDateVehicle_{v,d}},


	\forall d1<d2 \in DateVehicle_{v} (
		TimeActiveDateVehicle_{v,d1} \prec TimeActiveDateVehicle_{v,d2},
		%activeDateVehicle_{v,d2} -> activeDateVehicle_{v,d1},
	),


	nbDayVehicle_{v}	= \sum_{d \in DateVehicle_{v}}{activeDateVehicle_{v,d}},
	nbNightVehicle_{v}	= (nbDayVehicle_{v}-1 > 0) * (nbDayVehicle_{v}-1),	% ??????
),


% Order time constraint
\forall o \in SOURCEORDER (
	SpanTourOrder_{o} = SpanTour_{tourOrder_{o}},

	% Important for reasoning
	TimeTourOrder_{o} = TimeTour_{tourOrder_{o}},			% ??????
	TimeActiveTourOrder_{o} = TimeActiveTour_{tourOrder_{o}},	% ??????

	ruleRouteTimeInterruptible => (
		TimeOrder_{o} \subset SpanTourOrder_{o},
		;

		TimeOrder_{o} \subset ScheduleOrder_{o},
	),
),


