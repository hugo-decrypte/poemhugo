// table infos 
INSTR6=TableEx(DATAOBJ=DATA3; RECT=0 520 1900 _; BORDERHORZ=PEN1; BORDERVERT=PEN1; LINEHORZ=PEN1; LINEVERT=PEN1; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR6_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=70;
INSTR6_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR6_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR6_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
