%% 2025.09.06
%% NumTVA = > codeTax
%% Siret  = > establishment

%% D:/POEM/PoemClient/PoemPrint/PoemPrint.exe D:/POEM/Logistics/PoemPrint/PrintSupply.ini 
%% "[DSN=POEM_Logistics;USR=;DBPWD=;OWNER=;DEVICENAME=Microsoft Print to PDF;OUTPUT=D:/POEM/Logistics/PoemPrint/SupplyOrder'1'.PDF]"   
%% "D:/POEM/Logistics/PoemPrint/" "'1'" "000" ""


'@' => (

	printFile = "/PrintSupply",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),

@ ("
////////////////////////////////////////////
////////////////////////////////////////////
// PARAMETRES
//\"DataPrint.exe\" \"DEPDIR/Print/PrintSupply.ini\" \"[DSN=GestionStock; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=ConfirmCommand.pdf; XMLFILE=DeliveryTmp.txt]\" \"11020170131\"
// {/*PARAM0*/}  \"DataPrint.exe\" 
// {/*PARAM1*/}  file  INI
// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;
// {/*PARAM3*/}  output directory
// {/*PARAM4*/}  code supply
// {/*PARAM5*/}  code user
// {/*PARAM6*/}  PWD
//
//DSN=GestionStock
//USR= 
//PWD= 
//OWNER= 
////////////////////////////////////////////
//
\n\n"),

@ ("
[HEADER]
VERSION=1.0
TITLE=Commande Aprovisionnement
\n\n"),


 ['Work Directory' "Model\Print\PrintHeaderFooter.n"],

/*
// TITLE
//HEADER1=Text(1200 100 2000 150, \"Purchase Order\", FONT4, CENTER|VCENTER, COLOR1)
// logo.jpg 1368 x 264 : 1100 x 212

\n\n"),

@ ("

[FOOTER]
\n\n"),
*/

@ ("
[BACKGROUND]
\n\n"),


@ ("
[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
//OUTPUT=c:/DataPrint/TourneeVrac.xps
//OUTPUT=c:/DataPrint/TourneeVrac.pdf
//OUTPUT={/*PARAM4*/}

DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}TracePrintSupply.log

DOCNAME=Commande Approvisionnement
PAGESIZE=A4
//LANDSCAPEMODE= ( 0 : portrai; 1 : paysage)
LANDSCAPEMODE=0

PAGEWIDTH= 2100
PAGEHEIGHT= 2970
MARGIN=100 400 100 100
PAGENUMER=AUTO
PAGEBREAK=AUTO
\n\n"),



%% [STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],



@ ("
[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}Logo.jpg

//PICTURE2={/*PARAM3*/}ConditionGeneraleAchat.bmp
\n\n"),

@ ("

[DATA]
//DSN=
//USR=
//PWD=
//OWNER=

\n\n"),

@ ("
DATACOUNT=6
\n\n"),



%//////////////
%// agency info used in HEADER and FOOTER
%DATA1=MY_ADRESS
%NAME1=MYADRESS

 ['Work Directory' "Model\Print\PrintMyInfosData.n"],



@ ("
//////////////
DATA2=SEL_OBJ
NAME2=Objet

SQL2=SELECT 
SQL2_1=  S.Id as CODESUPPLY, 
SQL2_2=  S.IdAgency as CODEAGENCY, 
SQL2_3=  SR.Id as CODECLIENT, 
SQL2_4=  ' ' as BANKACCOUNT, 
SQL2_5=  SR.Country as COUNTRY, 
SQL2_6=  " SQL_CASEWHEN "SR.Country='France'" SQL_THEN "'Bon de commande  '" SQL_ELSE "'Purchase order   '" SQL_CASEEND "  as TITLEDOC,
SQL2_7=  " SQL_CASEWHEN "SR.Country='France'" SQL_THEN "'Commande No : '" SQL_ELSE "'Order no : '" SQL_CASEEND " as TITLECODEOBJ,
SQL2_8=  S.Id as CODEOBJ,
SQL2_9=   'Date : ' as TITLEDATEOBJ,
SQL2_10=  " SQL_CASEWHEN "SR.Country in ('France','FRANCE')"
				 SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(S.DateSupply,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(S.DateSupply,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(S.DateSupply,1,4)" SQL_CONCATEND " "
				 SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(S.DateSupply,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(S.DateSupply,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(S.DateSupply,9,2)" SQL_CONCATEND " "
			     SQL_CASEEND " as DATEOBJ,
SQL2_11=  " SQL_CASEWHEN "SR.Country in ('France','FRANCE')" SQL_THEN "'Fournisseur No : '" SQL_ELSE "'Supplier No : '" SQL_CASEEND " as TITLEREFERENCEOBJ,
SQL2_12=  S.IdSupplier as REFERENCEOBJ,
SQL2_13=  ' ' as CODECLUB
SQL2_14= FROM {/*OWNER*/}SUPPLY S left join {/*OWNER*/}SUPPLIER SR on SR.Id=S.IdSupplier
SQL2_15= WHERE S.ID in ({/*PARAM4*/})

\n"),
@ ("\n"),

@ ("



DATA3=INFO_ORDERS
NAME3=INFOORDERS

SQL3=SELECT 
SQL3_1=   LS.IdProduct as C1,
SQL3_2=   " SQL_CASEWHEN "A.Drawing is NULL" SQL_THEN "' '" SQL_ELSE "A.Drawing" SQL_CASEEND " as DrawingC1,
SQL3_3=   A.Designation as DesigC2,
SQL3_4=   A.DesignationTech as DesiTechC2,
SQL3_5=   LS.Quantity as QTYC3,
SQL3_6=   Format(LS.PriceUnit,'0.0000') as PriceC4,
SQL3_7=   Format(LS.Quantity*LS.PriceUnit, '0.00') as AmountC5,
SQL3_8=   " SQL_CASEWHEN "LS.DateDelivery is not NULL and LS.DateDelivery>'0'" SQL_THEN "mid(LS.DateDelivery,1,4) +'.'+ mid(LS.DateDelivery,6,2) +'.'+ mid(LS.DateDelivery,9,2)" SQL_ELSE "' '" SQL_CASEEND " as DateLivC6,
SQL3_9=   LS.Comments as CmtsC7,
SQL3_10=  LS.Comments1 as Cmts1C7
SQL3_11= FROM {/*OWNER*/}Supply_Product LS, {/*OWNER*/}PRODUCT A
SQL3_12= WHERE LS.IdProduct=A.ID
SQL3_13=   and LS.IdSupply='{/*CODESUPPLY*/}'
SQL3_14= ORDER BY LS.IdProduct
\n\n"),

@ ("

DATA4=LINE_TOTAL
NAME4=LINETOTAL

SQL4=SELECT 
SQL4_1=   'TOTAL' as C1,
SQL4_2=   ' ' as DesigC2,
SQL4_3=   ' ' as DateLivC3,
SQL4_4=   ' ' as QTYC4,
SQL4_5=   Format(sum(int(LS.Quantity*LS.PriceUnit*100+0.5)/100),'0.00') as C5,
SQL4_6=   ' ' as C6,
SQL4_7=   "SQL_CONCAT"'Weight :'"SQL_CONCATWITH"Format(sum(LS.Quantity*A.Weight),'0.0')"SQL_CONCATEND" as C7,
SQL4_8=   LS.IdSupply as C8
SQL4_9=  FROM {/*OWNER*/}Supply_Product LS, {/*OWNER*/}PRODUCT A
SQL4_10= WHERE LS.IdProduct=A.ID and LS.IdSupply='{/*CODESUPPLY*/}'
SQL4_11= GROUP BY LS.IdSupply
\n\n"),

@ ("
/////////////////////////
DATA5=INFO_TITLE
NAME5=InfoTitre


SQL5=SELECT DISTINCT
SQL5_1=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Référence'" SQL_ELSE "'Reference'" SQL_CASEEND " as C1, 
SQL5_2=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Désignation'" SQL_ELSE "'Designation'" SQL_CASEEND " as C2, 
SQL5_3=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Quantit '" SQL_ELSE "'Quantity'" SQL_CASEEND " as C3, 
SQL5_4=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Prix d''achat'" SQL_ELSE "'Unit'" SQL_CASEEND " as C4, 
SQL5_5=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'unitaire'" SQL_ELSE "'Price'" SQL_CASEEND " as C5,
SQL5_6=   S.Currency as C6, 
SQL5_7=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Montant net'" SQL_ELSE "'Net Amount'" SQL_CASEEND " as C7, 
SQL5_8=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'H.T'" SQL_ELSE "'Excluding Tax'" SQL_CASEEND " as C8, 
SQL5_9=   " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Date de'" SQL_ELSE "'Planned'" SQL_CASEEND " as C9, 
SQL5_10=  " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'livraison'" SQL_ELSE "'Delivery'" SQL_CASEEND " as C10, 
SQL5_11=  " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'prévue'" SQL_ELSE "'Date'" SQL_CASEEND " as C11, 
SQL5_12=  " SQL_CASEWHEN "SR.Country is NULL or SR.Country='France'" SQL_THEN "'Commentaire'" SQL_ELSE "'Comments'" SQL_CASEEND " as C12
SQL5_13= FROM {/*OWNER*/}SUPPLY S left join {/*OWNER*/}SUPPLIER SR on S.IdSupplier=SR.Id
SQL5_14= WHERE S.Id='{/*CODESUPPLY*/}'
\n\n"),

@ ("
/////////////////////////
DATA6=INFO_DESTIN
NAME6=InfoDestination

SQL6=SELECT 
SQL6_1=   S.CustomsInfo as C_Comment,
SQL6_2=   '0' as NoL
SQL6_3= FROM {/*OWNER*/}SUPPLY S
SQL6_4= WHERE S.Id='{/*CODESUPPLY*/}' AND S.CustomsInfo is not NULL and S.CustomsInfo>' '

SQL6_5= UNION ALL SELECT 
SQL6_6=  "SQL_CONCAT" " SQL_CASEWHEN "SR.Country='France'" SQL_THEN "'Réalisation par '" SQL_ELSE "'Realized by '" SQL_CASEEND " "SQL_CONCATWITH"S.ProductCondition"SQL_CONCATEND" as C_Comment,
SQL6_7=   '1' as NoL
SQL6_8= FROM {/*OWNER*/}SUPPLY S left join {/*OWNER*/}SUPPLIER SR on S.IdSupplier=SR.Id
SQL6_9= WHERE S.Id='{/*CODESUPPLY*/}' AND S.ProductCondition is not NULL and S.ProductCondition>' '

SQL6_10=UNION ALL SELECT 
SQL6_11=  "SQL_CONCAT" " SQL_CASEWHEN "SR.Country='France'" SQL_THEN "'Conditionnement : '" SQL_ELSE "'Packaging : '" SQL_CASEEND " "SQL_CONCATWITH"S.Packaging"SQL_CONCATEND" as C_Comment,
SQL6_12=   '2' as NoL
SQL6_13=FROM {/*OWNER*/}SUPPLY S left join {/*OWNER*/}SUPPLIER SR on S.IdSupplier=SR.Id
SQL6_14=WHERE S.Id='{/*CODESUPPLY*/}' AND S.Packaging is not NULL and S.Packaging>' '

SQL6_15=UNION ALL SELECT 
SQL6_16=  "SQL_CONCAT" " SQL_CASEWHEN "SR.Country='France'" SQL_THEN "'Règles de transport : '" SQL_ELSE "'Transport rules : '" SQL_CASEEND " "SQL_CONCATWITH"S.Incoterm"SQL_CONCATEND" as C_Comment,
SQL6_17=   '3' as NoL
SQL6_18=FROM {/*OWNER*/}SUPPLY S left join {/*OWNER*/}SUPPLIER SR on S.IdSupplier=SR.Id
SQL6_19=WHERE S.Id='{/*CODESUPPLY*/}' AND S.Incoterm is not NULL and S.Incoterm>' '

SQL6_20=UNION ALL SELECT 
SQL6_21=  "SQL_CONCAT" " SQL_CASEWHEN "SR.Country='France'" SQL_THEN "'Mode de règlement : '" SQL_ELSE "'Method of payment : '" SQL_CASEEND " "SQL_CONCATWITH"S.PayCondition"SQL_CONCATEND" as C_Comment,
SQL6_22=   '4' as NoL
SQL6_23=FROM {/*OWNER*/}SUPPLY S left join {/*OWNER*/}SUPPLIER SR on S.IdSupplier=SR.Id
SQL6_24=WHERE S.Id='{/*CODESUPPLY*/}' AND S.PayCondition is not NULL and S.PayCondition>' '

SQL6_25=ORDER BY NoL
\n\n"),


@ ("

