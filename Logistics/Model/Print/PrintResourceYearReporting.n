FONT11=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=1]
FONT12=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=1; UNDERLINE=1]
FONT13=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=1; UNDERLINE=0]
FONT14=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=0; UNDERLINE=1]
FONT15=[FACENAME=Calibri(Corps); HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=1]
