'@' => (

	printFile = (serverPrintPath "PrintResourceYearReporting.ini"),
	[printFile] <- '@',

	("printFile=" printFile : ),


@ ("////////////////////////////////////////////////////// \n"),
DOC_Title = TAG_REPORT_YEAR_TITLE,

@ ("[HEADER]\n"),
@ ("VERSION=1.0\n"),
@ ("TITLE=" DOC_Title "\n"),

@ ("//////////////////////////////////////////// \n"),
@ ("////////////////////////////////////////////\n"),
@ ("// PARAMETRES\n"),
@ ("//\"DataPrint.exe\" \"DEPDIR/Print/PrintResourceYearReporting.ini\" \"[DSN=; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=ResourceYearReporting.pdf; XMLFILE=ResourceYearReporting.txt]\" \"11020170131\" \n"),
@ ("// {/*PARAM0*/}  \"DataPrint.exe\" \n"),
@ ("// {/*PARAM1*/}  \" \" fichier  INI\n"),
@ ("// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;\n"),
@ ("// {/*PARAM3*/}  picture directury \n"),
@ ("// {/*PARAM4*/}  Date in the year \n"),
@ ("// {/*PARAM5*/}  code Resource\n"),
@ ("// {/*PARAM6*/}  code user\n"),
@ ("//DSN=\n"),
@ ("//USR= \n"),
@ ("//PWD= \n"),
@ ("//OWNER= \n"),


@ ("
//PAGENUM=Text(0 70 2000 120, \"" TAG_PRINT_PAGE "\", FONT5, RIGHT|VCENTER, COLOR1)

