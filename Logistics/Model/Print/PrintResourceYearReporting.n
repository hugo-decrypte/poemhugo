@ ("[STYLE]\n"),

@ ("
FONTCOUNT=21
FONT1=[FACENAME=Matura MT Script Capitals; HEIGHT=200; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT2=[FACENAME=Arial; HEIGHT=120; BOLD=1; ITALIC=0; UNDERLINE=0]
