ALIGN9=RIGHT|BOTTOM
\n"),



@ ("
[PICTURE]
PICTURECOUNT=0
//PICTURE1={/*PARAM4*/}/ProductProductionProcess.jpg
\n"),



@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
\n"),




@ ("
DATACOUNT=3
\n"),


@ ("
DATA1=INFO_PERIOD
NAME1=InfoPeriod
\n"),


@ ("
SQL1=SELECT distinct
SQL1_1=   '{/*STRDATE1*/}' as dateFirst,
SQL1_2=   '{/*STRDATE2*/}' as dateLast,
SQL1_3=   " SQL_CURRENTDATETIME " as PrintTime, 
SQL1_4=   trim(max(ct.LastName)) + '  ' + max(ct.FirstName) as ResourceName, ct.idResource
SQL1_5= FROM {/*OWNER*/}Contract ct
SQL1_6= WHERE ct.IdResource='{/*RESOURCEID*/}'
SQL1_7=  GROUP BY ct.IdResource
\n"),


@ ("
DATA2=INFO_MONTHDATA
NAME2=InfoMonthData
\n"),


@ ("
SQL2=SELECT max(" SQL_CASEWHEN "NoMonth=1 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE " " SQL_CASEWHEN "NoDate>'31'" SQL_THEN "Comments" SQL_ELSE "' '" SQL_CASEEND "" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=1"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=1" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "), 
SQL2_1=    max(" SQL_CASEWHEN "NoMonth=2 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=2"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=2"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_2=    max(" SQL_CASEWHEN "NoMonth=3 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=3"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=3"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_3=    max(" SQL_CASEWHEN "NoMonth=4 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=4"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=4"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_4=    max(" SQL_CASEWHEN "NoMonth=5 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=5"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=5"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_5=    max(" SQL_CASEWHEN "NoMonth=6 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=6"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=6"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_6=    max(" SQL_CASEWHEN "NoMonth=7 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=7"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=7"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_7=    max(" SQL_CASEWHEN "NoMonth=8 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=8"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=8"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_8=    max(" SQL_CASEWHEN "NoMonth=9 and NoDay=2"  SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=9"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=9"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_9=    max(" SQL_CASEWHEN "NoMonth=10 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=10"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=10" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_10=   max(" SQL_CASEWHEN "NoMonth=11 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=11"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=11" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL2_11=   max(" SQL_CASEWHEN "NoMonth=12 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=12"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=12" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),

SQL2_12=  NoDate from (SELECT
SQL2_13=  (select left(w.Name,3)+' '+" SQL_SUBSTRING "(rd.DateResource,9,2) from {/*OWNER*/}Alias w where w.category='CALENDAR' and w.field='weekday' and w.ID+0=DatePart(" SQL_DATEPART_WEEKDAY ", rd.DateResource"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL2_14=  "SQL_FORMATNUM"(rd.WorkTime/60.0,"SQL_FORMATSCALE2") as V,
SQL2_15=  DatePart(" SQL_DATEPART_MONTH   ", rd.DateResource) as NoMonth, 
SQL2_16=  DatePart(" SQL_DATEPART_WEEK    ", rd.DateResource) as NoWeek, 
SQL2_17=  DatePart(" SQL_DATEPART_WEEKDAY ", rd.DateResource"SQL_FIRSTWEEKDAY") as NoDay,
SQL2_18=  " SQL_SUBSTRING "(rd.DateResource,9,2) as NoDate,
SQL2_19=  rd.Comments as Comments
SQL2_20= FROM {/*OWNER*/}Resource_Date rd
SQL2_21= WHERE rd.IdResource='{/*RESOURCEID*/}' and '{/*D1*/}'<=rd.DateResource and rd.DateResource<='{/*D2*/}'

SQL2_22= UNION ALL SELECT
SQL2_23=  (select left(w.Name,3)+' '+d.ID from {/*OWNER*/}Alias w where w.category='CALENDAR' and w.field='weekday' and w.id+0=DatePart(" SQL_DATEPART_WEEKDAY ",DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL2_24=  ra.idTypeAbsence as V,
SQL2_25=  DatePart(" SQL_DATEPART_MONTH   ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))) as NoMonth, 
SQL2_26=  DatePart(" SQL_DATEPART_WEEK    ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))) as NoWeek, 
SQL2_27=  DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))"SQL_FIRSTWEEKDAY") as NoDay,
SQL2_28=  d.ID as NoDate,
SQL2_29=  ra.Comments as Comments
SQL2_30= FROM {/*OWNER*/}Resource_Absence ra, {/*OWNER*/}Alias m, {/*OWNER*/}Alias d
SQL2_31= WHERE m.category='ENUMERATION' and m.ID>='01' and m.ID<='12' and d.category='ENUMERATION' and d.ID>='01' and d.ID<='31' and ra.IdResource='{/*RESOURCEID*/}' and DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}')) <= DateAdd(" SQL_DATEPART_DAY ",-1,DateAdd(" SQL_DATEPART_MONTH ",m.ID+0,'{/*D1*/}')) 
SQL2_32=  and ra.DateStart<='{/*YEAR*/}-'+m.ID+'-'+d.ID and '{/*YEAR*/}-'+m.ID+'-'+d.ID<=ra.DateEnd

SQL2_33= UNION ALL SELECT
SQL2_34=  (select left(w.Name,3)+' '+" SQL_SUBSTRING "(c.Id,9,2)from {/*OWNER*/}Alias w where w.category='CALENDAR' and w.field='weekday' and w.ID+0=DatePart(" SQL_DATEPART_WEEKDAY ", c.Id"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL2_35=  'FERIE' as V,
SQL2_36=  DatePart(" SQL_DATEPART_MONTH   ",c.id) as NoMonth, 
SQL2_37=  DatePart(" SQL_DATEPART_WEEK    ",c.id) as NoWeek, 
SQL2_38=  DatePart(" SQL_DATEPART_WEEKDAY ",c.id"SQL_FIRSTWEEKDAY") as NoDay,
SQL2_39=  " SQL_SUBSTRING "(c.id,9,2) as NoDate,
SQL2_40=  c.Comments as Comments
SQL2_41= FROM {/*OWNER*/}Calendar c
SQL2_42= WHERE '{/*D1*/}'<=c.Id and c.Id<='{/*D2*/}'

SQL2_43= UNION ALL SELECT
SQL2_44=  (select left(w.Name,3)+' '+d.ID from {/*OWNER*/}Alias w where w.category='CALENDAR' and w.field='weekday' and w.id+0=DatePart(" SQL_DATEPART_WEEKDAY ",DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL2_45=  ' ' as V,
SQL2_46=  DatePart(" SQL_DATEPART_MONTH   ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))) as NoMonth, 
SQL2_47=  DatePart(" SQL_DATEPART_WEEK    ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))) as NoWeek, 
SQL2_48=  DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))"SQL_FIRSTWEEKDAY") as NoDay,
SQL2_49=  d.ID as NoDate,
SQL2_50=  " SQL_CASEWHEN "DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))"SQL_FIRSTWEEKDAY")<6" SQL_THEN "'Absence non d clar e'" SQL_ELSE "' '" SQL_CASEEND " as Comments
SQL2_51= FROM {/*OWNER*/}Alias m, {/*OWNER*/}Alias d
SQL2_52= WHERE m.category='ENUMERATION' and m.ID>='01' and m.ID<='12' and d.category='ENUMERATION' and d.ID>='01' and d.ID<='31' and DatePart(" SQL_DATEPART_MONTH ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, '{/*D1*/}'))) = m.ID+0 
SQL2_53=  and not exists (select 1 from {/*OWNER*/}Calendar c where '{/*D1*/}'<=c.Id and c.Id<='{/*D2*/}' and c.type='0' and '{/*YEAR*/}-'+m.ID+'-'+d.ID=c.Id )
SQL2_54=  and not exists (select 1 from {/*OWNER*/}Resource_Date rd where rd.IdResource='{/*RESOURCEID*/}' and '{/*YEAR*/}-'+m.ID+'-'+d.ID=rd.DateResource )
SQL2_55=  and not exists (select 1 from {/*OWNER*/}Resource_Absence ra where ra.IdResource='{/*RESOURCEID*/}' and ra.DateStart<='{/*YEAR*/}-'+m.ID+'-'+d.ID and '{/*YEAR*/}-'+m.ID+'-'+d.ID<=ra.DateEnd )

SQL2_56= UNION ALL SELECT
SQL2_57=  trim("SQL_FORMATNUM"(sum(1),"SQL_FORMATSCALE0"))+' j' as NameDay,
SQL2_58=  trim("SQL_FORMATNUM"(sum(rd.WorkTime)/60.0,"SQL_FORMATSCALE2")) as V,
SQL2_59=  m.id+0 as NoMonth, 
SQL2_60=  0 as NoWeek, 
SQL2_61=  0 as NoDay,
SQL2_62=  '32' as NoDate,
SQL2_63=  'Tot' as Comments
SQL2_64= FROM {/*OWNER*/}Resource_Date rd, {/*OWNER*/}Alias m
SQL2_65= WHERE rd.IdResource='{/*RESOURCEID*/}' and m.category='ENUMERATION' and m.ID>='01' and m.ID<='12' and '{/*YEAR*/}-'+m.ID+'-01'<=rd.DateResource and rd.DateResource<='{/*YEAR*/}-'+m.ID+'-31' 
SQL2_66= GROUP BY m.id

SQL2_67= UNION ALL SELECT
SQL2_68=  "SQL_FORMATNUM"(ra.overtime/60.0,"SQL_FORMATSCALE2") as NameDay,
SQL2_69=  "SQL_FORMATNUM"(ra.excessTime/60.0,"SQL_FORMATSCALE2") as V,
SQL2_70=  DatePart(" SQL_DATEPART_MONTH ", ra.dateStart) as NoMonth, 
SQL2_71=  0 as NoWeek, 
SQL2_72=  0 as NoDay,
SQL2_73=  '33' as NoDate,
SQL2_74=  'HS' as Comments
SQL2_75= FROM {/*OWNER*/}Resource_Activity ra
SQL2_76= WHERE ra.IdResource='{/*RESOURCEID*/}' and ra.type='2' and '{/*D1*/}'<=ra.DateStart and ra.DateStart<='{/*D2*/}'

SQL2_77= UNION ALL SELECT
SQL2_78=  "SQL_FORMATNUM"(ra.reservedTime/60.0,"SQL_FORMATSCALE2") as NameDay,
SQL2_79=  "SQL_FORMATNUM"(ra.reservedYear/60.0,"SQL_FORMATSCALE2") as V,
SQL2_80=  DatePart(" SQL_DATEPART_MONTH ", ra.dateStart) as NoMonth, 
SQL2_81=  0 as NoWeek, 
SQL2_82=  0 as NoDay,
SQL2_83=  '34' as NoDate,
SQL2_84=  'HR' as Comments
SQL2_85= FROM {/*OWNER*/}Resource_Activity ra
SQL2_86= WHERE ra.IdResource='{/*RESOURCEID*/}' and ra.type='2' and '{/*D1*/}'<=ra.DateStart and ra.DateStart<='{/*D2*/}'

SQL2_87=  ) dat 
SQL2_88= group by NoDate ORDER BY NoDate;
\n"),


@ ("
DATA3=LIST
NAME3=List
\n"),


@ ("
SQL3=SELECT distinct
SQL3_1=   numDate as DATE1, DateAdd(" SQL_DATEPART_DAY ", -1, DateAdd(" SQL_DATEPART_MONTH ", 12, numDate)) as DATE2,
SQL3_2=   format(numDate,'dd/MM/yyyy') as STRDATE1, format(DateAdd(" SQL_DATEPART_DAY ", -1, DateAdd(" SQL_DATEPART_MONTH ", 12, numDate)),'dd/MM/yyyy') as STRDATE2,
SQL3_3=   format(numDate,'yyyy-MM-dd') as D1,
SQL3_4=   format(DateAdd(" SQL_DATEPART_DAY ", -1, DateAdd(" SQL_DATEPART_MONTH ", 12, numDate)),'yyyy-MM-dd') as D2,
SQL3_5=   IDR as RESOURCEID, " SQL_SUBSTRING "('{/*PARAM4*/}',1,4) as YEAR
SQL3_6= from (SELECT " SQL_DATESERIAL "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4), 01, 01) as numDate, 
SQL3_7=   DatePart(" SQL_DATEPART_WEEKDAY ", " SQL_DATESERIAL "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4), 01, 01)"SQL_FIRSTWEEKDAY") as numDay,
SQL3_8=   r.IdResource as IDR
SQL3_9=  FROM {/*OWNER*/}Contract r
SQL3_10= WHERE r.IdResource in ({/*PARAM5*/}) 
SQL3_11=) dat 
SQL3_12= ORDER BY IDR
\n"),


%SQL3_11=  or r.IdResource in 
%SQL3_12=   ( select r0.id 
%SQL3_13=   	 from {/*OWNER*/}Resource r0, {/*OWNER*/}Club_Club cc, {/*OWNER*/}" SQL_TABLE_USER " u
%SQL3_14=  	 where u.id='{/*PARAM6*/}' and cc.idClub=u.idClub and r0.idClub=cc.idClubRelated
%SQL3_15=  	  and (u.permission='2' or r0.id=u.idResource ) )
%SQL3_16=) dat 
%SQL3_17= ORDER BY IDR
%\n"),



@ ("
// FIELDS3=CODEPERIOD
// ITEM3=[BEG=\"(\"; END=\")\"; SEP=\",\"; RET=\",\"]
// TEXT3=({/*PARAM5*/})
\n"),


@ ("
[TABLE]
\n"),


@ ("
TABLECOUNT=1
\n"),


@ ("
TABLE1=Table(DATAOBJ=DATA2; RECT=(0 0 2770 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=PEN1; LINEHORZ=; LINEVERT=PEN1;
TABLE1_1=TITLE=\"" DOC_Title "\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
TABLE1_3=CX_VERTHDR=0; FONT_VERTHDR=; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR2; 
TABLE1_4=FIELDCOUNT=33; 
TABLE1_5=NAMES=(\"SITE\", \"" TAG_DRIVER "\", \"D1\", \"D2\", \"D3\", \"D4\", \"D5\", \"D6\", \"D7\", \"D8\", \"D9\", \"D10\", \"D11\", \"D12\", \"D13\", \"D14\", \"D15\", \"D16\", \"D17\", \"D18\", \"D19\", \"D20\", \"D21\", \"D22\", \"D23\", \"D24\", \"D25\", \"D26\", \"D27\", \"D28\", \"D29\", \"D30\", \"D31\"); 
