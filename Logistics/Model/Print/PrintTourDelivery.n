'@' => (

	printFile = "/PrintTourDelivery",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),


@ ("//////////////////////////////////////////// \n"),
@ ("////////////////////////////////////////////\n"),
@ ("// PARAMETRES\n"),
@ ("//\"DataPrint.exe\" \"DIR/PoemPrint/PrintTourDelivery.ini\" \"[DSN=; DBUSR=; DBPWD=; OWNER=; DEVICENAME=Microsoft Print to PDF; OUTPUT=Delivery.pdf; XMLFILE=OrderTmp.txt]\" \"11020170131\" \n"),
@ ("// {/*PARAM0*/}  \"PoemPrint.exe\" \n"),
@ ("// {/*PARAM1*/}  \" \" file  INI\n"),
@ ("// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;\n"),
@ ("// {/*PARAM3*/}  picture directury\n"),
@ ("// {/*PARAM4*/}  code Delivery  \n"),
@ ("// {/*PARAM5*/}  code user\n"),
@ ("//DSN=\n"),
@ ("//USR= \n"),
@ ("//PWD= \n"),
@ ("//OWNER= \n"),

@ ("\n\n"),

@ ("[HEADER]\n"),
@ ("VERSION=1.0\n"),
@ ("TITLE=Bon de livraison\n"),


 ['Work Directory' "Model\Print\PrintHeaderFooter.n"],

