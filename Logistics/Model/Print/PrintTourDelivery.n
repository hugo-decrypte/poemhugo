@ ("[BACKGROUND]\n"),
@ ("\n\n"),

@ ("
[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver ;  Microsoft Print to PDF
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
