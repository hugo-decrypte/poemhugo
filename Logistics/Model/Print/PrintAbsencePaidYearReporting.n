// pr visionnel

//HEADER5=Line(0  360, 2970 360, PEN1); 
\n"),

@ ("
[FOOTER]
PAGENUM=Text1(1200 0 2900 50, \"" TAG_PRINT_PAGE "\", FONT9, RIGHT|VCENTER, COLOR1)
FOOTER1=Text(10 0 1200 50, \"" TAG_PRINT_DATE "\", FONT9, LEFT|VCENTER, COLOR1)
\n"),

@ ("
[BACKGROUND]
\n"),

@ ("
[CONFIG]
\n"),

@ ("PRINTERTYPE=1\n"),


@ ("
DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}/PrintAbsencePaidYearReporting.log
\n"),


@ ("DOCNAME=" DOC_Title "\n"),

@ ("
PAGESIZE=A4
LANDSCAPEMODE=1

PAGEWIDTH= 2970
PAGEHEIGHT= 2100
//MARGIN=100 450 100 100
MARGIN=100 100 100 100
PAGENUMER=AUTO
PAGEBREAK=AUTO
\n"),

@ ("[STYLE]\n"),

@ ("
FONTCOUNT=21
FONT1=[FACENAME=Matura MT Script Capitals; HEIGHT=200; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT2=[FACENAME=Arial; HEIGHT=120; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT3=[FACENAME=Courier; HEIGHT=100; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT4=[FACENAME=Times New Roman; HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT5=[FACENAME=Times New Roman; HEIGHT=160; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT6=[FACENAME=Times New Roman; HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT7=[FACENAME=Wingdings; HEIGHT=120; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT8=[FACENAME=Webdings; HEIGHT=120; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT9=[FACENAME=Calibri(Corps);  HEIGHT=60; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT10=[FACENAME=Calibri(Corps); HEIGHT=80; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT11=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=1]
FONT12=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=1; UNDERLINE=1]
FONT13=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=1; UNDERLINE=0]
FONT14=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=0; UNDERLINE=1]
FONT15=[FACENAME=Calibri(Corps); HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=1]
FONT16=[FACENAME=Calibri(Corps); HEIGHT=70; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT17=[FACENAME=Calibri(Corps); HEIGHT=58; BOLD=0; ITALIC=0; UNDERLINE=0]

FONT18=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT19=[FACENAME=Calibri(Corps); HEIGHT=60; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT20=[FACENAME=Calibri(Corps); HEIGHT=50; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT21=[FACENAME=Arial; HEIGHT=60; BOLD=0; ITALIC=0; UNDERLINE=0]
\n"),

@ ("
PENCOUNT=6
PEN1=[WIDTH=1;COLOR=(0 0 0)]
PEN2=[WIDTH=3;COLOR=(0 0 0)]
PEN3=[WIDTH=3;COLOR=(255 0 0)]
PEN4=[WIDTH=4;COLOR=(0 255 0)]
PEN5=[WIDTH=5;COLOR=(0 0 255)]
PEN6=[WIDTH=3;COLOR=(200 200 200)]
\n"),

@ ("
COLORCOUNT=6
COLOR1=(0 0 0)
COLOR2=(255 0 0)
COLOR3=(0 0 255)
COLOR4=(255 255 255)
COLOR5=(255 255 200)
COLOR6=(220 220 220)
\n"),

@ ("
ALIGNCOUNT=9
ALIGN1=LEFT|TOP
ALIGN2=LEFT|VCENTER
ALIGN3=LEFT|BOTTOM
ALIGN4=CENTER|TOP
ALIGN5=CENTER|VCENTER
ALIGN6=CENTER|BOTTOM
ALIGN7=RIGHT|TOP
ALIGN8=RIGHT|VCENTER
ALIGN9=RIGHT|BOTTOM
\n"),



@ ("
[PICTURE]
PICTURECOUNT=0
//PICTURE1={/*PARAM3*/}/ProductProductionProcess.jpg
\n"),



@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
\n"),




@ ("
DATACOUNT=4
\n"),


@ ("
DATA1=INFO_PERIOD
NAME1=InfoPeriod
\n"),


@ ("
SQL1=SELECT distinct
SQL1_1=   '{/*STRDATE1*/}' as dateFirst,
SQL1_2=   '{/*STRDATE2*/}' as dateLast,
SQL1_3=   " SQL_CURRENTDATETIME " as PrintTime, 
SQL1_4=   trim(max(ct.LastName)) + '  ' + max(ct.FirstName) as ResourceName, ct.idResource, {/*YEAR*/} as Y
SQL1_5= FROM {/*OWNER*/}Contract ct
SQL1_6= WHERE ct.IdResource='{/*RESOURCEID*/}'
SQL1_7=  GROUP BY ct.IdResource
\n"),


@ ("
DATA2=LIST
NAME2=List
\n"),


@ ("
SQL2=SELECT distinct
SQL2_1=   " SQL_DATESERIAL "(Y, 06, 01) as DATE1, " SQL_DATESERIAL "(Y+1, 05, 31) as DATE2,
SQL2_2=   '01/06/'+"SQL_FORMATNUM"(Y,"SQL_FORMATSCALE0") as STRDATE1, '31/05/'+"SQL_FORMATNUM"(Y+1,"SQL_FORMATSCALE0") as STRDATE2,
SQL2_3=   "SQL_FORMATNUM"(Y,"SQL_FORMATSCALE0")+'-06-01' as D1,
SQL2_4=   "SQL_FORMATNUM"(Y+1,"SQL_FORMATSCALE0")+'-05-31' as D2,
SQL2_5=   IDR as RESOURCEID, Y as YEAR
SQL2_6= from (SELECT " SQL_DATESERIAL "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4), 01, 01) as numDate, 
SQL2_7=   DatePart(" SQL_DATEPART_WEEKDAY ", " SQL_DATESERIAL "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4), 01, 01)"SQL_FIRSTWEEKDAY") as numDay,
SQL2_8=   r.IdResource as IDR, " SQL_CASEWHEN "" SQL_SUBSTRING "('{/*PARAM4*/}',5,2)>='06'" SQL_THEN " " SQL_SUBSTRING "('{/*PARAM4*/}',1,4)" SQL_ELSE " " SQL_FORMATNUM "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4)-1," SQL_FORMATSCALE0 ")" SQL_CASEEND " as Y
SQL2_9=  FROM {/*OWNER*/}Contract r
SQL2_10= WHERE r.IdResource in ({/*PARAM5*/}) 
SQL2_11=) dat 
SQL2_12= ORDER BY IDR
\n\n"),


%SQL2_11=  or r.IdResource in 
%SQL2_12=   ( select r0.id 
%SQL2_13=   	 from {/*OWNER*/}Resource r0, {/*OWNER*/}Club_Club cc, {/*OWNER*/}" SQL_TABLE_USER " u
%SQL2_14=  	 where u.id='{/*PARAM6*/}' and cc.idClub=u.idClub and r0.idClub=cc.idClubRelated
%SQL2_15=  	  and (u.permission='2' or r0.id=u.idResource ) )
%SQL2_16=) dat 
%SQL2_17= ORDER BY IDR
%\n"),

@ ("
DATA3=INFO_MONTHHEAD
NAME3=InfoMonthHead
\n\n"),

@ ("
SQL3=SELECT 
SQL3_1=  max(" SQL_CASEWHEN "m.ID='06'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_2=  max(" SQL_CASEWHEN "m.ID='07'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_3=  max(" SQL_CASEWHEN "m.ID='08'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_4=  max(" SQL_CASEWHEN "m.ID='09'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_5=  max(" SQL_CASEWHEN "m.ID='10'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_6=  max(" SQL_CASEWHEN "m.ID='11'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_7=  max(" SQL_CASEWHEN "m.ID='12'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}, "SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_8=  max(" SQL_CASEWHEN "m.ID='01'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}+1,"SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_9=  max(" SQL_CASEWHEN "m.ID='02'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}+1,"SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_10= max(" SQL_CASEWHEN "m.ID='03'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}+1,"SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_11= max(" SQL_CASEWHEN "m.ID='04'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}+1,"SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND "),
SQL3_12= max(" SQL_CASEWHEN "m.ID='05'" SQL_THEN " " SQL_CONCAT "m.name" SQL_CONCATWITH "' '" SQL_CONCATWITH ""SQL_FORMATNUM"({/*YEAR*/}+1,"SQL_FORMATSCALE0")" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND ")

SQL3_13= FROM {/*OWNER*/}ALIAS m
SQL3_14= WHERE m.category='CALENDAR' and m.field='month' and m.ID>='01' and m.ID<='12' 
\n\n"),



@ ("
DATA4=INFO_MONTHDATA
NAME4=InfoMonthData
\n"),

firstDate = ( SQL_DATESERIAL "({/*YEAR*/}, 06, 01)"),

lastMonthDate=(" and DatePart(" SQL_DATEPART_MONTH ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")))=DatePart(" SQL_DATEPART_MONTH ", DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")) "),


@ ("
SQL4=SELECT max(" SQL_CASEWHEN "NoMonth=6  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE " " SQL_CASEWHEN "NoDate>'31'" SQL_THEN "Comments" SQL_ELSE "' '" SQL_CASEEND "" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=6"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=6" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_1=     max(" SQL_CASEWHEN "NoMonth=7  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=7"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=7"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_2=     max(" SQL_CASEWHEN "NoMonth=8  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=8"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=8"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_3=     max(" SQL_CASEWHEN "NoMonth=9  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=9"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=9"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_4=     max(" SQL_CASEWHEN "NoMonth=10 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=10"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=10" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_5=     max(" SQL_CASEWHEN "NoMonth=11 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=11"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=11" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_6=     max(" SQL_CASEWHEN "NoMonth=12 and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=12"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=12" SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_7=     max(" SQL_CASEWHEN "NoMonth=1  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=1"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=1"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_8=     max(" SQL_CASEWHEN "NoMonth=2  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=2"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=2"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_9=     max(" SQL_CASEWHEN "NoMonth=3  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=3"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=3"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_10=    max(" SQL_CASEWHEN "NoMonth=4  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=4"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=4"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),
SQL4_11=    max(" SQL_CASEWHEN "NoMonth=5  and NoDay=2" SQL_THEN "trim("SQL_FORMATNUM"(NoWeek,"SQL_FORMATSCALE0"))" SQL_ELSE "' '" SQL_CASEEND "),  max(" SQL_CASEWHEN "NoMonth=5"  SQL_THEN "NameDay" SQL_ELSE "' '" SQL_CASEEND "), max(" SQL_CASEWHEN "NoMonth=5"  SQL_THEN "V" SQL_ELSE "' '" SQL_CASEEND "),

SQL4_12=  NoDate from (SELECT
SQL4_13=  (select " SQL_CONCAT "left(w.Name,3)" SQL_CONCATWITH "' '" SQL_CONCATWITH "d.ID" SQL_CONCATEND " from {/*OWNER*/}ALIAS w where w.category='CALENDAR' and w.field='weekday' and w.id+0=DatePart(" SQL_DATEPART_WEEKDAY ",DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL4_14=  ra.idTypeAbsence as V,
SQL4_15=  DatePart(" SQL_DATEPART_MONTH   ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))) as NoMonth, 
SQL4_16=  DatePart(" SQL_DATEPART_WEEK    ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))) as NoWeek, 
SQL4_17=  DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))"SQL_FIRSTWEEKDAY") as NoDay,
SQL4_18=  d.ID as NoDate,
SQL4_19=  ra.Comments as Comments
SQL4_20= FROM {/*OWNER*/}RESOURCE_ABSENCE ra, {/*OWNER*/}TYPEABSENCE ta, {/*OWNER*/}ALIAS m, {/*OWNER*/}ALIAS d
SQL4_21= WHERE ra.idTypeAbsence=ta.id and ta.timePaid>0 and m.category='ENUMERATION' and m.ID>='01' and m.ID<='12' and d.category='ENUMERATION' and d.ID>='01' and d.ID<='31' and ra.IdResource='{/*RESOURCEID*/}' 
SQL4_22=  " lastMonthDate "
SQL4_23=  and ra.DateStart<=" SQL_FORMATDATE "(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"') and " SQL_FORMATDATE "(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"')<=ra.DateEnd

SQL4_24= UNION ALL SELECT
SQL4_25=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))"SQL_FIRSTWEEKDAY")= 6" SQL_THEN "1" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0") as NameDay,
SQL4_26=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))"SQL_FIRSTWEEKDAY")<=6" SQL_THEN "1" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0") as V,
SQL4_27=  DatePart(" SQL_DATEPART_MONTH ",DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")) as NoMonth, 
SQL4_28=  0 as NoWeek, 
SQL4_29=  0 as NoDay, '35' as NoDate, 'Total' as Comments
SQL4_30= FROM {/*OWNER*/}RESOURCE_ABSENCE ra, {/*OWNER*/}ALIAS m, {/*OWNER*/}ALIAS d, {/*OWNER*/}TYPEABSENCE ta
SQL4_31= WHERE m.category='ENUMERATION' and m.ID>='01' and m.ID<='12' and d.category='ENUMERATION' and d.ID>='01' and d.ID<='31' and ra.IdResource='{/*RESOURCEID*/}' 
SQL4_32=  " lastMonthDate "
SQL4_33=  and ra.DateStart<="SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"') and "SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"')<=ra.DateEnd and ra.idTypeAbsence=ta.id and ta.timePaid>0
SQL4_34= group by m.ID

SQL4_35= UNION ALL SELECT
SQL4_36=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " SQL_DATESERIAL "({/*YEAR*/}, 06, 01)))"SQL_FIRSTWEEKDAY")=6" SQL_THEN "1" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0") as NameDay,
SQL4_37=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " SQL_DATESERIAL "({/*YEAR*/}, 06, 01)))"SQL_FIRSTWEEKDAY")<=6" SQL_THEN "1" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0") as V,
SQL4_38=  DatePart(" SQL_DATEPART_MONTH ",DateAdd(" SQL_DATEPART_MONTH ", m0.ID-1, " SQL_DATESERIAL "({/*YEAR*/}, 06, 01))) as NoMonth, 
SQL4_39=  0 as NoWeek, 
SQL4_40=  0 as NoDay, '36' as NoDate, 'Cpt' as Comments
SQL4_41= FROM {/*OWNER*/}RESOURCE_ABSENCE ra, {/*OWNER*/}ALIAS m0, {/*OWNER*/}ALIAS m, {/*OWNER*/}ALIAS d, {/*OWNER*/}TYPEABSENCE ta
SQL4_42= WHERE ra.IdResource='{/*RESOURCEID*/}' and m0.category='ENUMERATION' and m0.ID>='01' and m0.ID<='12'  
SQL4_43=  and m.category='ENUMERATION' and m.ID>='01' and m.ID<=m0.ID and d.category='ENUMERATION' and d.ID>='01' and d.ID<='31'
SQL4_44=  " lastMonthDate "
SQL4_45=  and ra.DateStart<="SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " SQL_DATESERIAL "({/*YEAR*/}, 06, 01))),'"SQL_FORMATDATESTR"') and "SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " SQL_DATESERIAL "({/*YEAR*/}, 06, 01))),'"SQL_FORMATDATESTR"')<=ra.DateEnd 
SQL4_46=  and ra.idTypeAbsence=ta.id and ta.timePaid>0
SQL4_47= group by m0.ID

SQL4_48= UNION ALL SELECT
SQL4_49=  (select " SQL_CONCAT "left(w.Name,3)" SQL_CONCATWITH "' '" SQL_CONCATWITH "d.ID" SQL_CONCATEND " from {/*OWNER*/}ALIAS w where w.category='CALENDAR' and w.field='weekday' and w.id+0=DatePart(" SQL_DATEPART_WEEKDAY ",DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL4_50=  ' ' as V,
SQL4_51=  DatePart(" SQL_DATEPART_MONTH ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))) as NoMonth, 
SQL4_52=  DatePart(" SQL_DATEPART_WEEK ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))) as NoWeek, 
SQL4_53=  DatePart(" SQL_DATEPART_WEEKDAY ", DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate "))"SQL_FIRSTWEEKDAY") as NoDay,
SQL4_54=  d.ID as NoDate,
SQL4_55=  ' ' as Comments
SQL4_56= FROM {/*OWNER*/}ALIAS m, {/*OWNER*/}ALIAS d
SQL4_57= WHERE m.category='ENUMERATION' and m.ID>='01' and m.ID<='12' and d.category='ENUMERATION' and d.ID>='01' and d.ID<='31' 
SQL4_58=  and not exists (select 1 from {/*OWNER*/}CALENDAR c where '{/*D1*/}'<=c.Id and c.Id<='{/*D2*/}' and c.type='0' and "SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"')=c.Id )
SQL4_59=  and not exists (select 1 from {/*OWNER*/}RESOURCE_ABSENCE ra, {/*OWNER*/}TYPEABSENCE ta where ra.idTypeAbsence=ta.id and ta.timePaid>0 and ra.IdResource='{/*RESOURCEID*/}' and ra.DateStart<="SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"') and "SQL_FORMATDATE"(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, DateAdd(" SQL_DATEPART_MONTH ", m.ID-1, " firstDate ")),'"SQL_FORMATDATESTR"')<=ra.DateEnd )

SQL4_60= UNION ALL SELECT
SQL4_61=  (select " SQL_CONCAT "left(w.Name,3)" SQL_CONCATWITH "' '" SQL_CONCATWITH "" SQL_SUBSTRING "(c.Id,9,2)" SQL_CONCATEND " from {/*OWNER*/}ALIAS w where w.category='CALENDAR' and w.field='weekday' and w.ID+0=DatePart(" SQL_DATEPART_WEEKDAY ", c.Id"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL4_62=  'FERIE' as V,
SQL4_63=  DatePart(" SQL_DATEPART_MONTH ",c.id) as NoMonth, 
SQL4_64=  DatePart(" SQL_DATEPART_WEEK ",c.id) as NoWeek, 
SQL4_65=  DatePart(" SQL_DATEPART_WEEKDAY ",c.id"SQL_FIRSTWEEKDAY") as NoDay,
SQL4_66=  " SQL_SUBSTRING "(c.id,9,2) as NoDate,
SQL4_67=  c.Comments as Comments
SQL4_68= FROM {/*OWNER*/}CALENDAR c
SQL4_69= WHERE '{/*D1*/}'<=c.Id and c.Id<='{/*D2*/}'

SQL4_70=  ) dat 
SQL4_71= group by NoDate ORDER BY NoDate;

\n"),




