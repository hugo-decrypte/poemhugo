'@' => (

	printFile = (serverPrintPath "PrintAbsencePaidYearReporting.ini"),
	[printFile] <- '@',

	("printFile=" printFile : ),


@ ("////////////////////////////////////////////////////// \n"),
DOC_Title = TAG_REPORT_YEAR_TITLE,

@ ("[HEADER]\n"),
@ ("VERSION=1.0\n"),
@ ("TITLE=" DOC_Title "\n"),

@ ("//////////////////////////////////////////// \n"),
@ ("////////////////////////////////////////////\n"),
@ ("// PARAMETRES\n"),
@ ("//\"DataPrint.exe\" \"DEPDIR/Print/PrintAbsencePaidYearReporting.ini\" \"[DSN=; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=PrintAbsencePaidYearReporting.pdf; XMLFILE=PrintAbsencePaidYearReporting.txt]\" \"11020170131\" \n"),
@ ("// {/*PARAM0*/}  \"DataPrint.exe\" \n"),
@ ("// {/*PARAM1*/}  \" \" fichier  INI\n"),
@ ("// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;\n"),
@ ("// {/*PARAM3*/}  picture directury \n"),
@ ("// {/*PARAM4*/}  Date in the year \n"),
@ ("// {/*PARAM5*/}  code Resource\n"),
@ ("// {/*PARAM6*/}  code user\n"),
@ ("//DSN=\n"),
@ ("//USR= \n"),
@ ("//PWD= \n"),
@ ("//OWNER= \n"),


@ ("// present paid absence (CP) overview \n"),
@ ("// from the first may to the end june next year \n"),
@ ("// if the  input date is before june, period ended by may of this year\n"),
@ ("// if the  input date is fter june, period starts from may of this year\n"),


@ ("
//PAGENUM=Text(0 70 2000 120, \"" TAG_PRINT_PAGE "\", FONT5, RIGHT|VCENTER, COLOR1)

// logo
//HEADER1=Picture(120 180 330 340, PICTURE1)

// TITLE
// HEADER1=Text(0 70 2870 160, \"" TAG_PRINT_FULLNAME "\", FONT10, LEFT|VCENTER, COLOR1)
