// Table-6. Functions for Dates
// Function	Description	Example	Result
// Date( )	Gets the current date	Date( )	1/20/2006
// Now( )	Gets the current date and time	Now( )	1/20/2006 10:16:26 PM
// DatePart( )	Extracts a part of a date (like the year, month, or day number)	DatePart(#1/20/2006#, "d")	20
// DateSerial( )	Converts a year, month, and day into an Access date value	DateSerial(2006, 5, 4)	5/4/2006
// DateAdd( )	Offsets a date by a given interval	DateAdd ("yyyy", 2, #22/11/2006#)	22/11/2008
// DateDiff( )	Measures an interval between two dates	DateDiff("w", #10/15/2006#, #1/11/2007#)	12
// MonthName( )	Gets the name that corresponds to a month number (from 1 to 12)	MonthName(1)	"January"
// WeekdayName( )	Gets the name that corresponds to a weekday number (from 1 to 7)	WeekdayName(1)	"Sunday"
// Format( )	Converts a date into formatted text (using any of the date formats	Format (#27/04/2008#, 

// today : Date()
// format(Date(), 'dd/mm/yyyy' )
// DatePart('yyyy', Date() )

// Table-5. Date Components
// Component	Description	Value for February 20, 2006 1:30 PM
// yyyy	Year, in four-digit format	2006
// q	Quarter, from 1 to 4	1
// m	Month, from 1 to 12	2
// y	Day of year, from 1 to 365 (usually)	51
// d	Day, from 1 to 31	20
// w	Day of week, from 1 to 7	2
// ww	Week of the year, from 1 to 52	8
// h	Hour, from 1 to 24	13
// n	Minute, from 1 to 60	30
// s	Second, from 1 to 60	0


DATACOUNT=3

DATA1=INFO_PERIOD
NAME1=InfoPeriod

SQL1=SELECT distinct
SQL1_1=   dat.IdDr,
SQL1_2=   max(iif( dat.NoDate='01', dat.IdClient, ' ' ) ) as C1, max(iif( dat.NoDate='02', dat.IdClient, ' ' ) ) as C2, 
SQL1_3=   max(iif( dat.NoDate='03', dat.IdClient, ' ' ) ) as C3, max(iif( dat.NoDate='04', dat.IdClient, ' ' ) ) as C4, 
SQL1_4=   max(iif( dat.NoDate='05', dat.IdClient, ' ' ) ) as C5, max(iif( dat.NoDate='06', dat.IdClient, ' ' ) ) as C6, 
SQL1_5=   max(iif( dat.NoDate='07', dat.IdClient, ' ' ) ) as C7, max(iif( dat.NoDate='08', dat.IdClient, ' ' ) ) as C8, 
SQL1_6=   max(iif( dat.NoDate='09', dat.IdClient, ' ' ) ) as C9, max(iif( dat.NoDate='10', dat.IdClient, ' ' ) ) as C10, 
SQL1_7=   max(iif( dat.NoDate='11', dat.IdClient, ' ' ) ) as C11, max(iif( dat.NoDate='12', dat.IdClient, ' ' ) ) as C12, 
SQL1_8=   max(iif( dat.NoDate='13', dat.IdClient, ' ' ) ) as C13, max(iif( dat.NoDate='14', dat.IdClient, ' ' ) ) as C14, 
SQL1_9=   max(iif( dat.NoDate='15', dat.IdClient, ' ' ) ) as C15, max(iif( dat.NoDate='16', dat.IdClient, ' ' ) ) as C16, 
SQL1_10=  max(iif( dat.NoDate='17', dat.IdClient, ' ' ) ) as C17, max(iif( dat.NoDate='18', dat.IdClient, ' ' ) ) as C18, 
SQL1_11=  max(iif( dat.NoDate='19', dat.IdClient, ' ' ) ) as C19, max(iif( dat.NoDate='20', dat.IdClient, ' ' ) ) as C20, 
SQL1_12=  max(iif( dat.NoDate='21', dat.IdClient, ' ' ) ) as C21, max(iif( dat.NoDate='22', dat.IdClient, ' ' ) ) as C22, 
SQL1_13=  max(iif( dat.NoDate='23', dat.IdClient, ' ' ) ) as C23, max(iif( dat.NoDate='24', dat.IdClient, ' ' ) ) as C24, 
SQL1_14=  max(iif( dat.NoDate='25', dat.IdClient, ' ' ) ) as C25, max(iif( dat.NoDate='26', dat.IdClient, ' ' ) ) as C26, 
SQL1_15=  max(iif( dat.NoDate='27', dat.IdClient, ' ' ) ) as C27, max(iif( dat.NoDate='28', dat.IdClient, ' ' ) ) as C28, 
SQL1_16=  max(iif( dat.NoDate='29', dat.IdClient, ' ' ) ) as C29, max(iif( dat.NoDate='30', dat.IdClient, ' ' ) ) as C30, 
SQL1_17=  max(iif( dat.NoDate='31', dat.IdClient, ' ' ) ) as C31, 
SQL1_18=  Now() as PrintTime
SQL1_19= from (SELECT Format(Date()+1,'dd/mm/yyyy') + ' - ' + Format(Date()+14,'dd/mm/yyyy') as IdDr, 
SQL1_20=   IIF ( DatePart('w', Date()+m.NoMonth)=1, '99', format((select sum(IIF ( DatePart('w', Date()+m0.NoMonth)>1 and DatePart('w', Date()+m0.NoMonth) <8 , 1, 0) ) from {/*OWNER*/}MonthLabel m0 where m0.NoMonth>=1 and m0.NoMonth<=m.NoMonth), '0#') ) as NoDate, 
SQL1_21=   IIF( DatePart('w', Date()+m.NoMonth )=7 , 
SQL1_22=   'SEM' + format(DatePart('ww', Date()+m.NoMonth ) - IIF( DatePart('d', DateSerial( DatePart('yyyy',Date()),01,01) ) >4 or DatePart('d', DateSerial( DatePart('yyyy',Date()), 01,01) ) <2 ,1, 0 ),'0#') ,
SQL1_23=   Format(DatePart('d',Date()+m.NoMonth),'0#') + ' -' + mLab.NameFR ) as IdClient 
SQL1_24=  FROM {/*OWNER*/}MonthLabel m, {/*OWNER*/}MonthLabel mLab
SQL1_25=  WHERE m.NoMonth<=14 and m.NoMonth>=1 and mLab.NoMonth=DatePart('m', Date()+m.NoMonth)
SQL1_26=) dat 
SQL1_27= group by dat.IdDr 


DATA2=INFO_DATECMD
NAME2=InfoDateCmd


SQL2=SELECT 
SQL2_1=   dat.SiteName,
SQL2_2=   dat.drName,
SQL2_3=   max(iif( dat.NoDate='01', dat.IdClient, ' ' ) ) as C1, max(iif( dat.NoDate='02', dat.IdClient, ' ' ) ) as C2, 
SQL2_4=   max(iif( dat.NoDate='03', dat.IdClient, ' ' ) ) as C3, max(iif( dat.NoDate='04', dat.IdClient, ' ' ) ) as C4, 
SQL2_5=   max(iif( dat.NoDate='05', dat.IdClient, ' ' ) ) as C5, max(iif( dat.NoDate='06', dat.IdClient, ' ' ) ) as C6, 
SQL2_6=   max(iif( dat.NoDate='07', dat.IdClient, ' ' ) ) as C7, max(iif( dat.NoDate='08', dat.IdClient, ' ' ) ) as C8, 
SQL2_7=   max(iif( dat.NoDate='09', dat.IdClient, ' ' ) ) as C9, max(iif( dat.NoDate='10', dat.IdClient, ' ' ) ) as C10, 
SQL2_8=   max(iif( dat.NoDate='11', dat.IdClient, ' ' ) ) as C11, max(iif( dat.NoDate='12', dat.IdClient, ' ' ) ) as C12, 
SQL2_9=   max(iif( dat.NoDate='13', dat.IdClient, ' ' ) ) as C13, max(iif( dat.NoDate='14', dat.IdClient, ' ' ) ) as C14, 
SQL2_10=  max(iif( dat.NoDate='15', dat.IdClient, ' ' ) ) as C15, max(iif( dat.NoDate='16', dat.IdClient, ' ' ) ) as C16, 
SQL2_11=  max(iif( dat.NoDate='17', dat.IdClient, ' ' ) ) as C17, max(iif( dat.NoDate='18', dat.IdClient, ' ' ) ) as C18, 
SQL2_12=  max(iif( dat.NoDate='19', dat.IdClient, ' ' ) ) as C19, max(iif( dat.NoDate='20', dat.IdClient, ' ' ) ) as C20, 
SQL2_13=  max(iif( dat.NoDate='21', dat.IdClient, ' ' ) ) as C21, max(iif( dat.NoDate='22', dat.IdClient, ' ' ) ) as C22, 
SQL2_14=  max(iif( dat.NoDate='23', dat.IdClient, ' ' ) ) as C23, max(iif( dat.NoDate='24', dat.IdClient, ' ' ) ) as C24, 
SQL2_15=  max(iif( dat.NoDate='25', dat.IdClient, ' ' ) ) as C25, max(iif( dat.NoDate='26', dat.IdClient, ' ' ) ) as C26, 
SQL2_16=  max(iif( dat.NoDate='27', dat.IdClient, ' ' ) ) as C27, max(iif( dat.NoDate='28', dat.IdClient, ' ' ) ) as C28, 
SQL2_17=  max(iif( dat.NoDate='29', dat.IdClient, ' ' ) ) as C29, max(iif( dat.NoDate='30', dat.IdClient, ' ' ) ) as C30, 
SQL2_18=  max(iif( dat.NoDate='31', dat.IdClient, ' ' ) ) as C31, max(dat.Client) as Cli
SQL2_19= from (SELECT d.Id as IdDr, d.Name as drName, (select a.Name from {/*OWNER*/}Agency a where a.idClub=d.IdClub and a.Id='1') as SiteName, '1' as SiteId,
SQL2_20=   format((select sum(IIF ( DatePart('w', Date()+m.NoMonth)>1 and DatePart('w', Date()+m.NoMonth) <8 , 1, 0) ) from {/*OWNER*/}MonthLabel m where m.NoMonth>=1 and format(Date()+m.NoMonth, 'yyyymmdd')<=format(pl.DateActivity,'########')), '0#') as NoDate, 
SQL2_21=   IdOrder as IdClient, IdOrder as Client
SQL2_22=  FROM {/*OWNER*/}Resource_Task pl, {/*OWNER*/}Resource d
SQL2_23=  WHERE d.IdClub={/*PARAM3*/} and d.Id={/*PARAM4*/} and d.Id=pl.IdResource and Date()<DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)) and Date()+14>=DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)) 

SQL2_24= UNION ALL 
SQL2_25= SELECT d.Id as IdDr, d.Name as drName, (select a.Name from {/*OWNER*/}Agency a where a.IdClub=d.IdClub and a.Id='1') as SiteName, '1' as SiteId,
SQL2_26=   format(m.NoMonth, '0#') as NoDate, 
SQL2_27=   ' ' as IdClient, 'zz' as Client
SQL2_28=  FROM {/*OWNER*/}Resource d, {/*OWNER*/}MonthLabel m 
SQL2_29=  WHERE not exists (select 1 from {/*OWNER*/}Resource_Task pl where d.IdClub=pl.IdClub and d.Id=pl.IdResource and Date()<DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2))  
SQL2_30=    and Date()+14>=DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)))
SQL2_31=    and d.IdClub={/*PARAM3*/} and d.Id={/*PARAM4*/} and m.NoMonth>=1 and m.NoMonth<=31

SQL2_32= UNION ALL SELECT '99' as IdDr, 'Total' as drName, ' ' as SiteName, 'zz' as SiteId,
SQL2_33=   format((select sum(IIF ( DatePart('w', Date()+m.NoMonth)>1 and DatePart('w', Date()+m.NoMonth) <8 , 1, 0) ) from {/*OWNER*/}MonthLabel m where m.NoMonth>=1 and format(Date()+m.NoMonth, 'yyyymmdd')<=format(pl.DateActivity,'########')), '0#') as NoDate, 
SQL2_34=   format(count(1),'0') as IdClient , 'zzz' as Client
SQL2_35=  FROM {/*OWNER*/}Resource_Task pl
SQL2_36=  WHERE pl.IdClub={/*PARAM3*/} and pl.IdResource in ({/*PARAM4*/}) and Date()<DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)) and Date()+14>=DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2))
SQL2_37=  GROUP BY pl.DateActivity

SQL2_38= ) dat
SQL2_39= group by dat.IdDr, dat.drName, dat.SiteName, SiteId
SQL2_40= order by dat.SiteId, dat.drName ;

//SQL2_20=   format(DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)), 'dd/mm/yyyy') as Date0, 
//SQL2_22=   DatePart('ww', DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)) ) - IIF( DatePart('d', DateSerial( mid(pl.DateActivity,1,4),01,01) ) >4 or DatePart('d', DateSerial( mid(pl.DateActivity,1,4), 01,01) ) <2 ,1, 0 ) as "NoWeek" , 
//SQL2_23=   DatePart('w', DateSerial(mid(pl.DateActivity,1,4), mid(pl.DateActivity,5,2), mid(pl.DateActivity,7,2)) ) - 1 as NoDay, 


