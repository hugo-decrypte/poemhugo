%% 2025.09.04
%% NumTVA = > codeTax
%% Siret  = > establishment


'@' => (

	printFile = "/PrintOrderDelivery",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),


@ ("//////////////////////////////////////////// \n"),
@ ("////////////////////////////////////////////\n"),
@ ("// PARAMETRES\n"),
@ ("//\"DataPrint.exe\" \"DIR/PoemPrint/PrintOrderDelivery.ini\" \"[DSN=; DBUSR=; DBPWD=; OWNER=; DEVICENAME=Microsoft Print to PDF; OUTPUT=DeliveryOrder.pdf; XMLFILE=OrderTmp.txt]\" \"11020170131\" \n"),
@ ("// {/*PARAM0*/}  \"PoemPrint.exe\" \n"),
@ ("// {/*PARAM1*/}  \" \" file  INI\n"),
@ ("// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;\n"),
@ ("// {/*PARAM3*/}  picture directury\n"),
@ ("// {/*PARAM4*/}  code Order  \n"),
@ ("// {/*PARAM5*/}  code user\n"),
@ ("//DSN=\n"),
@ ("//USR= \n"),
@ ("//PWD= \n"),
@ ("//OWNER= \n"),

@ ("[HEADER]\n"),
@ ("VERSION=1.0\n"),
@ ("TITLE=Bon de livraison de commande\n"),


 ['Work Directory' "Model\Print\PrintHeaderFooter.n"],


%@ ("[FOOTER]\n"),



@ ("[BACKGROUND]\n"),
@ ("\n\n"),

@ ("
[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
//OUTPUT=c:/DataPrint/Tournee.xps
//OUTPUT=c:/DataPrint/Tournee.pdf
//OUTPUT={/*PARAM4*/}

DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}TracePrintOrderDelivery.log

DOCNAME=Bon de livraison
PAGESIZE=A4
//LANDSCAPEMODE= ( 0 : portrai; 1 : paysage)
LANDSCAPEMODE=0

PAGEWIDTH= 2100
PAGEHEIGHT= 2970
MARGIN=100 450 100 100
PAGENUMER=AUTO
PAGEBREAK=AUTO
\n"),
@ ("\n\n"),


%% [STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],

@ ("\n\n"),


@ ("[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}Logo.jpg
//PICTURE1={/*PARAM4*/}Logo.bmp
//PICTURE1=D:\GestionCommande/Logo.bmp
\n\n"),

@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
PWD={/*PARAM6*/}
\n\n"),




@ ("DATACOUNT=6\n\n"),


@ ("//////////////\n"),
@ ("\n"),

%@ ("// agency info used in HEADER and FOOTER\n"),
%@ ("DATA1=MY_ADRESS\n"),
%@ ("NAME1=MYADRESS\n"),
%@ ("\n"),


 ['Work Directory' "Model\Print\PrintMyInfosData.n"],


@ ("// compagny Registre info, BankInfo in FOOTER\n"),
@ ("\n\n"),




@ ("
//////////////
DATA2=SEL_OBJ
NAME2=Objet

SQL2=SELECT 
SQL2_1=   O.Id as CODEORDER, 
SQL2_2=   O.IdAgency as CODEAGENCY, 
SQL2_3=   CL.Id as CODECLIENT, 
SQL2_4=   CL.BankAccount as BANKACCOUNT, 
SQL2_5=   CL.Country as COUNTRY, 
SQL2_6=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Bon de livraison  '" SQL_ELSE "'Delivery   '" SQL_CASEEND "  as TITLEDOC,
SQL2_7=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Commande No : '" SQL_ELSE "'Order no : '" SQL_CASEEND " as TITLECODEOBJ,
SQL2_8=  O.Id as CODEOBJ,
SQL2_9=   'Date : ' as TITLEDATEOBJ,
SQL2_10=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')"
				 SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(O.DateDelivery,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,1,4)" SQL_CONCATEND " "
				 SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(O.DateDelivery,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,9,2)" SQL_CONCATEND " "
			     SQL_CASEEND " as DATEOBJ,
SQL2_11=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')" SQL_THEN "'Client No : '" SQL_ELSE "'Client No : '" SQL_CASEEND " as TITLEREFERENCEOBJ,
SQL2_12=  O.IdClient as REFERENCEOBJ,
SQL2_13=  ' ' as CODECLUB
SQL2_14= FROM {/*OWNER*/}CLIENTORDER O left join {/*OWNER*/}CLIENT CL on CL.Id=O.IdClient
SQL2_15= WHERE O.ID in ({/*PARAM4*/})

\n"),
@ ("\n"),




%% INSTR2, 4
@ ("
// ADDRESS DELIVERY
DATA3=ADDRESS_DELIV
NAME3=AddressDeliv

SQL3=SELECT DISTINCT
SQL3_1=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Adresse de livraison'" SQL_ELSE "'Shipping adress'" SQL_CASEEND " as TitleAdressDeliv, 
SQL3_2=   PT.NameClient as PtDeliv, 
SQL3_3=   PT.Address as AddresDeliv, 
SQL3_4=   PT.AddressSup as AddresSupDeliv, 
SQL3_5=   " SQL_CONCAT "TRIM(PT.PostCode)" SQL_CONCATWITH "'   '" SQL_CONCATWITH "PT.City" SQL_CONCATEND " as PostCodeCityDeliv, 
SQL3_6=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "' '" SQL_ELSE "CL.Country" SQL_CASEEND " as CountryDeliv,
SQL3_7=   O.Id as IdDelivery,
SQL3_8=   " SQL_CASEWHEN "CL.Country='France'"
				 SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(O.DateDelivery,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,1,4)" SQL_CONCATEND " "
				 SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(O.DateDelivery,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(O.DateDelivery,9,2)" SQL_CONCATEND " "
			     SQL_CASEEND " as DateDelivery,
SQL3_9=   'STOCK' as Packing,
SQL3_10=  'STOCK' as Sender,
SQL3_11=  'STOCK' as ShipNo
SQL3_12= FROM {/*OWNER*/}CLIENTORDER O , {/*OWNER*/}CLIENT CL, {/*OWNER*/}POINTDELIVERY PT
SQL3_13= WHERE CL.Id=O.IdClient 
SQL3_14=  AND PT.IdClient=O.IdClient AND PT.IdPoint=O.IdPointDelivery
SQL3_15= AND O.Id='{/*CODEORDER*/}'
\n"),
@ ("\n"),


@ ("
//////////////
DATA4=INFO_ORDERS
NAME4=INFOORDERS

SQL4=SELECT DISTINCT
SQL4_1=   'STOCK' as C1,
SQL4_2=   ' ' as C2,
SQL4_3=   ' ' as C3,
SQL4_4=   ' ' as C4,
SQL4_5=   OP.IdOrder as C5,
SQL4_6=   OP.Quantity as QTY6,
SQL4_7=   ' ' as C7,
SQL4_8=   ' ' as C8,
SQL4_9=   ' ' as C9,
SQL4_10=   ' ' as C10,
SQL4_11=   ' ' as C11
SQL4_12= FROM {/*OWNER*/}ORDER_PRODUCT OP
SQL4_13= WHERE OP.IdOrder='{/*CODEORDER*/}'
SQL4_14=   AND OP.NoPallet={/*PALETTE*/} AND OP.IdProduct='{/*PRODUCT*/}' 
SQL4_15=   AND OP.IdOrder>= (select min(OP1.IdOrder) from {/*OWNER*/}ORDER_PRODUCT OP1
SQL4_16=      WHERE OP1.IdOrder='{/*CODEORDER*/}' 
SQL4_17=       AND OP1.NoPallet={/*PALETTE*/} AND OP1.IdProduct='{/*PRODUCT*/}'
SQL4_18=    )
SQL4_19= ORDER BY OP.IdOrder
\n"),
@ ("\n"),


@ ("
// DETAIL DELIVERY
DATA5=INFO_DELIVERY
NAME5=InfoDelivery

SQL5=SELECT 
SQL5_1=   " SQL_CASEWHEN "SamePal+CmdSup=0" SQL_THEN "PACKING" SQL_ELSE "' '" SQL_CASEEND " as C1, 
SQL5_2=   " SQL_CASEWHEN "SamePal+CmdSup=0" SQL_THEN "PALETTE" SQL_ELSE "' '" SQL_CASEEND " as C2, 
SQL5_3=   " SQL_CASEWHEN "CmdSup=0" SQL_THEN "PRODUCT" SQL_ELSE "' '" SQL_CASEEND " as C3, 
SQL5_4=   " SQL_CASEWHEN "CmdSup=0" SQL_THEN "DescriArticle" SQL_ELSE "' '" SQL_CASEEND " as C4,
SQL5_5=   Cmd,
SQL5_6=   QTY,
SQL5_7=   NW as C7, 
SQL5_8=  " SQL_CASEWHEN "SamePal+CmdSup=0" SQL_THEN "GW" SQL_ELSE "' '" SQL_CASEEND " as C8,
SQL5_9=  " SQL_CASEWHEN "SamePal+CmdSup=0" SQL_THEN "L" SQL_ELSE "' '" SQL_CASEEND " as C9, 
SQL5_10=  " SQL_CASEWHEN "SamePal+CmdSup=0" SQL_THEN "W" SQL_ELSE "' '" SQL_CASEEND " as C10, 
SQL5_11=  " SQL_CASEWHEN "SamePal+CmdSup=0" SQL_THEN "H" SQL_ELSE "' '" SQL_CASEEND " as C11, V as C12, QtyPackage as C13, NbPackage as C14
SQL5_12= FROM (SELECT
SQL5_13=   'STOCK' as PACKING, 
SQL5_14=   OP.IdOrder as IdDelivery, 
SQL5_15=   " SQL_CASEWHEN "OP.NoPallet is NULL" SQL_THEN "0" SQL_ELSE "OP.NoPallet" SQL_CASEEND " as PALETTE, 
SQL5_16=   PRD.ID as PARENT, PRD.ID as PRODUCT,
SQL5_17=   PRD.Designation as DescriArticle,
SQL5_18=   OP.IdOrder as Cmd,
SQL5_19=   " SQL_FORMATNUM "(OP.Quantity," SQL_FORMATSCALE0 ") as QTY,
SQL5_20=   " SQL_FORMATNUM "(PRD.QuantityPackaging," SQL_FORMATSCALE0 ") as QtyPackage,
SQL5_21=   " SQL_FORMATNUM "(" SQL_CASEWHEN "PRD.QuantityPackaging is not NULL and PRD.QuantityPackaging>0" SQL_THEN "OP.Quantity/PRD.QuantityPackaging" SQL_ELSE "1" SQL_CASEEND "," SQL_FORMATSCALE0 ") as NbPackage,
SQL5_22=   " SQL_FORMATNUM "(PRD.Weight*OP.Quantity," SQL_FORMATSCALE2 ") as NW, 
SQL5_23=   " SQL_CASEWHEN "P.WeightGlobal is not NULL and P.WeightGlobal>0" 
			SQL_THEN "" SQL_FORMATNUM "(P.WeightGlobal," SQL_FORMATSCALE1 ")"
			SQL_ELSE "" SQL_CONCAT "'PN + '" SQL_CONCATWITH " " SQL_FORMATNUM "(" SQL_CASEWHEN " O.WeightPallet is NULL" SQL_THEN "30" SQL_ELSE "O.WeightPallet" SQL_CASEEND "," SQL_FORMATSCALE1 ")" SQL_CONCATEND " " 
			SQL_CASEEND " as GW,

SQL5_24=   round(P.Length) as L, 
SQL5_25=   round(P.Width) as W, 
SQL5_26=   round(P.Height) as H,
SQL5_27=   " SQL_FORMATNUM "(PRD.Volume*OP.Quantity, " SQL_FORMATSCALE2 ") as V, 
SQL5_28=   0 as CmdSup,
SQL5_29=  " SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}ORDER_PRODUCT OP1 
SQL5_30=        where OP1.IdOrder=OP.IdOrder AND OP1.NoPallet=OP.NoPallet AND OP1.IdProduct<OP.IdProduct)
SQL5_31=   " SQL_THEN "1" SQL_ELSE "0" SQL_CASEEND "  as SamePal
SQL5_32= FROM (({/*OWNER*/}CLIENTORDER O inner join {/*OWNER*/}ORDER_PRODUCT OP on O.Id=OP.IdOrder)
SQL5_33=   inner join {/*OWNER*/}PRODUCT PRD on PRD.ID=OP.IdProduct)
SQL5_34=   left join {/*OWNER*/}PALLET P on P.IdPacking=" SQL_CONCAT "'C'" SQL_CONCATWITH "OP.IdOrder" SQL_CONCATEND " and P.NoPallet=OP.NoPallet
SQL5_35= WHERE PRD.TypeProduct<>'F'
SQL5_36=   AND OP.IdOrder='{/*CODEORDER*/}'
SQL5_37= UNION ALL 

SQL5_38= SELECT
SQL5_39=   'STOCK' as PACKING, 
SQL5_40=   OP.IdOrder as IdDelivery, 
SQL5_41=   " SQL_CASEWHEN "OP.NoPallet is NULL" SQL_THEN "0" SQL_ELSE "OP.NoPallet" SQL_CASEEND " as PALETTE, 
SQL5_42=   OP.IdProduct as PARENT, " SQL_CONCAT "' -> '" SQL_CONCATWITH "PRD.ID" SQL_CONCATEND " as PRODUCT, 
SQL5_43=   PRD.Designation as DescriArticle,
SQL5_44=   OP.IdOrder as Cmd,
SQL5_45=   " SQL_FORMATNUM "(OP.Quantity," SQL_FORMATSCALE0 ") as QTY,
SQL5_46=   " SQL_FORMATNUM "(PRD.QuantityPackaging," SQL_FORMATSCALE0 ") as QtyPackage,
SQL5_47=   " SQL_FORMATNUM "(" SQL_CASEWHEN "PRD.QuantityPackaging is not NULL and PRD.QuantityPackaging>0" SQL_THEN "OP.Quantity/PRD.QuantityPackaging" SQL_ELSE "1" SQL_CASEEND "," SQL_FORMATSCALE0 ") as NbPackage,
SQL5_48=   " SQL_FORMATNUM "(PRD.Weight*OP.Quantity," SQL_FORMATSCALE2 ") as NW, 
SQL5_49=   " SQL_CASEWHEN "P.WeightGlobal is not NULL and P.WeightGlobal>0" 
			SQL_THEN "" SQL_FORMATNUM "(P.WeightGlobal," SQL_FORMATSCALE1 ")" 
			SQL_ELSE "" SQL_CONCAT "'PN + '" SQL_CONCATWITH " " SQL_FORMATNUM "(" SQL_CASEWHEN " O.WeightPallet is NULL" SQL_THEN "30" SQL_ELSE "O.WeightPallet" SQL_CASEEND "," SQL_FORMATSCALE1 ")" SQL_CONCATEND " " 
			SQL_CASEEND " as GW,
SQL5_50=   " SQL_FORMATNUM "(P.Length," SQL_FORMATSCALE0 ") as L, 
SQL5_51=   " SQL_FORMATNUM "(P.Width," SQL_FORMATSCALE0 ") as W, 
SQL5_52=   " SQL_FORMATNUM "(P.Height," SQL_FORMATSCALE0 ") as H,
SQL5_53=   " SQL_FORMATNUM "(PRD.Volume*OP.Quantity," SQL_FORMATSCALE2 ") as V, 
SQL5_54=   0 as CmdSup,
SQL5_55=  " SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}ORDER_PRODUCT OP1 
SQL5_56=        where OP1.IdOrder=OP.IdOrder AND OP1.NoPallet=OP.NoPallet AND OP1.IdProduct<OP.IdProduct) 
SQL5_57=   " SQL_THEN "1" SQL_ELSE "0" SQL_CASEEND "  as SamePal
SQL5_58= FROM ((({/*OWNER*/}CLIENTORDER O inner join {/*OWNER*/}ORDER_PRODUCT OP on O.Id=OP.IdOrder)
SQL5_59=   inner join {/*OWNER*/}PRODUCT_COMPONENT PC on PC.IdProduct=OP.IdProduct)
SQL5_60=   inner join {/*OWNER*/}PRODUCT PRD on PRD.ID=PC.IdSubProduct)
SQL5_61=   left join {/*OWNER*/}PALLET P on P.IdPacking=" SQL_CONCAT "'C'" SQL_CONCATWITH "OP.IdOrder" SQL_CONCATEND " and P.NoPallet=OP.NoPallet
SQL5_62= WHERE PRD.TypeProduct<>'F'
SQL5_63=   AND OP.IdOrder='{/*CODEORDER*/}'
SQL5_64= ) t

SQL5_65= ORDER BY IdDelivery, PARENT, PRODUCT
\n"),
@ ("\n"),



@ ("
// TOTAL DELIVERY
DATA6=LINE_TOTAL
NAME6=LINETOTAL

SQL6=SELECT DISTINCT
SQL6_1=   'TOTAL' as Col1, 
SQL6_2=   sum(QTY_C9) as Col2,
SQL6_3=   " SQL_FORMATNUM "(sum(C10)," SQL_FORMATSCALE2 ") as Col3,
SQL6_4=   " SQL_FORMATNUM "(sum(C11)," SQL_FORMATSCALE2 ") as Col4,
SQL6_5=   " SQL_FORMATNUM "(sum(C12)," SQL_FORMATSCALE2 ") as Col5,
SQL6_6=   " SQL_FORMATNUM "(sum(C13)," SQL_FORMATSCALE0 ") as Col6,
SQL6_7=   " SQL_FORMATNUM "(sum(C14)," SQL_FORMATSCALE0 ") as Col7
SQL6_8=  FROM (SELECT 'STOCK', OP.NoPallet,
SQL6_9=   sum(OP.Quantity) as QTY_C9,
SQL6_10=  sum(PRD.Weight*OP.Quantity) as C10, 
SQL6_11=  sum(PRD.Volume*OP.Quantity) as C11,
SQL6_12=  sum(PRD.Weight*OP.Quantity)+ " SQL_CASEWHEN "O.WeightPallet is NULL" SQL_THEN "30" SQL_ELSE "min(O.WeightPallet)" SQL_CASEEND " as C12,
SQL6_13=  sum(PRD.QuantityPackaging) as C13,
SQL6_14=  sum(" SQL_CASEWHEN "PRD.QuantityPackaging is not NULL and PRD.QuantityPackaging>0" SQL_THEN "OP.Quantity/PRD.QuantityPackaging" SQL_ELSE "1" SQL_CASEEND ") as C14
SQL6_15= FROM (({/*OWNER*/}CLIENTORDER O inner join {/*OWNER*/}ORDER_PRODUCT OP on O.Id=OP.IdOrder)
SQL6_16=  inner join {/*OWNER*/}PRODUCT PRD on PRD.ID=OP.IdProduct) 
SQL6_17=  LEFT JOIN {/*OWNER*/}PALLET P on P.NoPallet=OP.NoPallet
SQL6_18=WHERE PRD.TypeProduct<>'F'
SQL6_19=   AND O.Id='{/*CODEORDER*/}'
SQL6_20=GROUP BY OP.NoPallet, P.WeightGlobal, O.WeightPallet) t
\n"),
@ ("\n"),


@ ("
[TABLE]

TABLECOUNT=1

TABLE1=Table(DATAOBJ=DATA3; RECT=(0 0 1900 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=;
TABLE1_1=TITLE=\"Produits Client\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
TABLE1_3=CX_VERTHDR=0; FONT_VERTHDR=; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR2; 
TABLE1_4=CY_ROW=50;
TABLE1_5=FIELDCOUNT=11; 
TABLE1_6=NAMES=(\"Mark\", \"pale\", \"Art\", \"desc\", \"Command\", \"Qty\", \"NW\", \"GW\", \"L\", \"W\", \"H\"); 
TABLE1_7=WIDTHES=(150, 110, 190, 550, 180, 130, 140, 150, 100, 100, 100); 
TABLE1_8=FONTS=(FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9); 
TABLE1_9=TEXTALIGNS=(ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2); 
TABLE1_10=TEXTCOLORS=(COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1); 
TABLE1_11=FILLCOLORS=(COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5); 
TABLE1_12=FIELDS=(DATA3.1, DATA3.2, DATA3.3, DATA3.4, DATA3.5, DATA3.6, DATA3.7, DATA3.8, DATA3.9, DATA3.10, DATA3.11); 
TABLE1_13=)
\n"),
@ ("\n"),


@ ("
[XML]

FILE={/*XMLFILE*/}
XMLCOUNT =0
XML1=|\"NOM_PDF {/*OUTPUT*/}\"
XML2=|\"NUM_FAX1 {/*DATA1.1*/}\"
XML3=|\"NUM_FAX2 {/*DATA1.2*/}\"
XML4=|\"CODE_FACT {/*DATA1.3*/}\"
XML5=|\"MAIL1_RAPPORT {/*DATA1.6*/}\"
XML6=|\"MAIL2_RAPPORT {/*DATA1.7*/}\"
XML7=|\"TYPE_RAPPORT {/*DATA1.8*/}\"
\n"),
@ ("\n"),


@ ("
[SQL]
SQLCOUNT=0

//SQL1=UPDATE {/*OWNER*/}Delivery D set State='2' where D.[IdDelivery]={/*PARAM3*/} and (State<'2' or State is NULL)
\n"),
@ ("\n"),


@ ("[SCRIPT]\n"),
@ ("\n"),


@ ("
DATAOBJ=DATA2
\n"),
@ ("\n"),


@ ("
INSTRCOUNT=9
\n"),
@ ("\n"),


@ ("//INSTR1=StartDoc\n"),
@ ("\n"),

@ ("
INSTR1=StartPage 1
\n"),

@ ("
// table  adresses livraisons 
INSTR2=Table(DATAOBJ=DATA3; RECT=10 0 _ _; BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR2_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=60;
INSTR2_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR2_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR2_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR2_5=FIELDCOUNT=6;
INSTR2_6=FIELD1=[NAME=\"Tit\",  RECT=(300    0  1900  80),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.1];
INSTR2_7=FIELD2=[NAME=\"Nom\",  RECT=(300  100  1900 160),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.2];
INSTR2_8=FIELD3=[NAME=\"Add\",  RECT=(300  160  1900 220),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.3];
INSTR2_9=FIELD4=[NAME=\"Ad1\",  RECT=(300  220  1900 280),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.4];
INSTR2_10=FIELD5=[NAME=\"CPC\", RECT=(300  280  1900 340),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.5];
INSTR2_11=FIELD6=[NAME=\"CTR\", RECT=(300  340  1900 400),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.6];
INSTR2_12=)
\n"),
@ ("\n"),

@ ("/////////////////////////////////////////////////////////////////////\n"),

@ ("
INSTR3=Line(0  420, 1900  420, PEN1); 
\n"),
@ ("\n"),


@ ("
/////////////////////////////////////////////////////////////
// table infos livraisons 
INSTR4=TableEx(DATAOBJ=DATA3; RECT=0 460 2700 540; BORDERHORZ=PEN1; BORDERVERT=PEN1; LINEHORZ=PEN1; LINEVERT=PEN1; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR4_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=80;
INSTR4_2=TITLE=\"Delivery INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR4_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR4_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 

INSTR4_5=FIELDCOUNT=14;
INSTR4_6=NAMES=(
INSTR4_7=FIELD1=[NAME=\"No palette\",     RECT=(0     0   100  40),  FONT=9, ALIGN=6, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"No\"];
INSTR4_8=FIELD2=[NAME=\"No palette\",     RECT=(0    40   100  80),  FONT=16,ALIGN=4, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, TEXT=\"Palette\"];
INSTR4_9=FIELD3=[NAME=\"Article\",        RECT=(100   0   420  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Article\"];
