@ ("[STYLE]\n"),

@ ("FONTCOUNT=22\n"),
@ ("FONT1=[FACENAME=Matura MT Script Capitals; HEIGHT=200; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT2=[FACENAME=Arial; HEIGHT=120; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT3=[FACENAME=Courier; HEIGHT=100; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT4=[FACENAME=Times New Roman; HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT5=[FACENAME=Times New Roman; HEIGHT=140; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT6=[FACENAME=Times New Roman; HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT7=[FACENAME=Wingdings; HEIGHT=120; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT8=[FACENAME=Webdings; HEIGHT=120; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT9=[FACENAME=Calibri(Corps);  HEIGHT=80; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT10=[FACENAME=Calibri(Corps); HEIGHT=80; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT11=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=1]\n"),
@ ("FONT12=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=1; UNDERLINE=1]\n"),
@ ("FONT13=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=1; UNDERLINE=0]\n"),
@ ("FONT14=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=0; UNDERLINE=1]\n"),
@ ("FONT15=[FACENAME=Calibri(Corps); HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=1]\n"),
@ ("FONT16=[FACENAME=Calibri(Corps); HEIGHT=70; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT17=[FACENAME=Calibri(Corps); HEIGHT=58; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),

@ ("FONT18=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT19=[FACENAME=Calibri(Corps); HEIGHT=60; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT20=[FACENAME=Calibri(Corps); HEIGHT=50; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT21=[FACENAME=Arial; HEIGHT=60; BOLD=0; ITALIC=0; UNDERLINE=0]\n"),
@ ("FONT22=[FACENAME=Times New Roman; HEIGHT=160; BOLD=1; ITALIC=0; UNDERLINE=0]\n"),
@ ("\n\n"),


@ ("PENCOUNT=6\n"),
@ ("PEN1=[WIDTH=1;COLOR=(0 0 0)]\n"),
@ ("PEN2=[WIDTH=3;COLOR=(0 0 0)]\n"),
@ ("PEN3=[WIDTH=3;COLOR=(255 0 0)]\n"),
@ ("PEN4=[WIDTH=4;COLOR=(0 255 0)]\n"),
@ ("PEN5=[WIDTH=5;COLOR=(0 0 255)]\n"),
@ ("PEN6=[WIDTH=5;COLOR=(255 255 255)]\n"),
@ ("\n\n"),

@ ("COLORCOUNT=6\n"),
@ ("COLOR1=(0 0 0)\n"),
@ ("COLOR2=(255 0 0)\n"),
@ ("COLOR3=(0 0 255)\n"),
@ ("COLOR4=(255 255 255)\n"),
@ ("COLOR5=(255 255 200)\n"),
@ ("COLOR6=(220 220 245)\n"),
@ ("\n\n"),

@ ("ALIGNCOUNT=9\n"),
@ ("ALIGN1=LEFT|TOP\n"),
@ ("ALIGN2=LEFT|VCENTER\n"),
@ ("ALIGN3=LEFT|BOTTOM\n"),
@ ("ALIGN4=CENTER|TOP\n"),
@ ("ALIGN5=CENTER|VCENTER\n"),
@ ("ALIGN6=CENTER|BOTTOM\n"),
@ ("ALIGN7=RIGHT|TOP\n"),
@ ("ALIGN8=RIGHT|VCENTER\n"),
@ ("ALIGN9=RIGHT|BOTTOM\n"),
@ ("\n\n"),
