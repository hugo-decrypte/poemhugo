TABLE1_9=TEXTALIGNS=(ALIGN2, ALIGN2, ALIGN2, ALIGN8, ALIGN2, ALIGN8, ALIGN8);
TABLE1_10=TEXTCOLORS=(COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1);
