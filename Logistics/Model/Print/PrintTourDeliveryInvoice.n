@ ("

// table infos facture + adresses livraisons + adresse facturation
INSTR3=Table(DATAOBJ=DATA3; RECT=10 30 _ 30; BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR3_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; 
INSTR3_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR3_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR3_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR3_5=FIELDCOUNT=21;
INSTR3_6=FIELD1=[NAME=\"DAT\",  RECT=(10    20  580   60),  FONT=9, ALIGN=2, TCOLOR=3, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.2];
INSTR3_7=FIELD2=[NAME=\"DAT\",  RECT=(10    60  580  100),  FONT=9, ALIGN=2, TCOLOR=3, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.3];

INSTR3_8=FIELD3=[NAME=\"Tit\",  RECT=(600    0  1180  60),  FONT=4, ALIGN=1, TCOLOR=1, FCOLOR=4, LPEN=,   RPEN=,   TPEN=,  BPEN=, OBJ=DATA3.4];
