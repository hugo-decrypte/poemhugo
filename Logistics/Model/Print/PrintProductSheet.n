%% 2025.09.04
%% NumTVA = > codeTax
%% Siret  = > establishment

'@' => (

	printFile = "/PrintProductSheet",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),

@ ("
////////////////////////////////////////////
////////////////////////////////////////////
// PARAMETRES
//\"DataPrint.exe\" \"DEPDIR/Print/PrintProductSheet.ini\" \"[DSN=GestionStock; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=Product.pdf; XMLFILE=DeliveryTmp.txt]\" \"11020170131\"
// {/*PARAM0*/}  \"DataPrint.exe\" 
// {/*PARAM1*/}  fichier  INI
// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;
// {/*PARAM3*/}  Print Directory
// {/*PARAM4*/}  code product
// {/*PARAM5*/}  USERID

//DSN=GestionStock
//USR= 
//PWD= 
//OWNER= 

////////////////////////////
\n\n"),

@ ("

[HEADER]
VERSION=1.0
TITLE=Fiche Palette

//PAGENUM=Text(0 70 2000 120, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT5, RIGHT|VCENTER, COLOR1)

// TITLE
//HEADER1=Text(0 70 2000 120, \"Produit \", FONT4, CENTER|VCENTER, COLOR1)

// Societe
// logo.jpg 1368 x 264 : 1100 x 212
HEADER1=Picture(200 60 490 185, PICTURE1)
// Label compagny
HEADER2=Text(120  190 1000 230, {/*DATA1.2.1*/}, FONT10, LEFT|VCENTER, COLOR1)
// adress
HEADER3=Text(120  240 1000 270, \"{/*DATA1.3.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER4=Text(120  270 1000 300, \"{/*DATA1.4.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
// post code, city
HEADER5=Text(120  300 1000 330, \"{/*DATA1.5.1*/}  {/*DATA1.6.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER6=Text(120  330 1000 360, \"{/*DATA1.7.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER7=Text(500  270 1200 300, \"Tél.  : {/*DATA1.8.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER8=Text(500  300 1200 330, \"Email : {/*DATA1.10.1*/}\", FONT16, LEFT|VCENTER, COLOR1)


// TITLE
HEADER9=Text(1100 120 1950 200, \"{/*DATA1.19.1*/}\", FONT5, CENTER|VCENTER, COLOR1)

// Lot no
HEADER10=Text(1100 200 1600 260, \"{/*DATA1.20.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)
HEADER11=Text(1610 200 1950 260, \"{/*DATA1.21.1*/}\", FONT6, LEFT|VCENTER, COLOR1)
// date
HEADER12=Text(1100 260 1600 320, \"{/*DATA1.22.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)
HEADER13=Text(1610 260 1950 320, \"{/*DATA1.23.1*/}\", FONT6, LEFT|VCENTER, COLOR1)
// Reference
HEADER14=Text(1100 320 1600 380, \"{/*DATA1.24.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)
HEADER15=Text(1610 320 1950 380, \"{/*DATA1.25.1*/}\", FONT6, LEFT|VCENTER, COLOR1)

HEADER16=Line(110  400, 2000  400, PEN1)

\n\n"),

@ ("

[FOOTER]
PAGENUM=Text(1200 0 2100 50, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT9, RIGHT|VCENTER, COLOR1)
FOOTER1=Text(0 50 2000 80, \"{/*DATA1.18.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
FOOTER2=Line(0 0,1900  0, PEN1); 
\n\n"),

@ ("

[BACKGROUND]
\n\n"),

@ ("

[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
//OUTPUT=c:/DataPrint/TourneeVrac.xps
//OUTPUT=c:/DataPrint/TourneeVrac.pdf
//OUTPUT={/*PARAM4*/}

DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}/TracePrintProductSheet.log

DOCNAME=Fiche Palette
PAGESIZE=A4
//LANDSCAPEMODE= ( 0 : portrai; 1 : paysage)
LANDSCAPEMODE=0

PAGEWIDTH= 2100
PAGEHEIGHT= 2970
MARGIN=100 350 100 100
PAGENUMER=AUTO
PAGEBREAK=AUTO
\n\n"),

%% [STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],


/*
[STYLE]

FONTCOUNT=21
FONT1=[FACENAME=Matura MT Script Capitals; HEIGHT=200; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT2=[FACENAME=Arial; HEIGHT=120; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT3=[FACENAME=Courier; HEIGHT=100; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT4=[FACENAME=Times New Roman; HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT5=[FACENAME=Times New Roman; HEIGHT=160; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT6=[FACENAME=Times New Roman; HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT7=[FACENAME=Wingdings; HEIGHT=120; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT8=[FACENAME=Webdings; HEIGHT=120; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT9=[FACENAME=Calibri(Corps);  HEIGHT=80; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT10=[FACENAME=Calibri(Corps); HEIGHT=80; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT11=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=1]
FONT12=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=1; UNDERLINE=1]
FONT13=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=1; UNDERLINE=0]
FONT14=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=0; ITALIC=0; UNDERLINE=1]
FONT15=[FACENAME=Calibri(Corps); HEIGHT=100; BOLD=1; ITALIC=0; UNDERLINE=1]
FONT16=[FACENAME=Calibri(Corps); HEIGHT=70; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT17=[FACENAME=Calibri(Corps); HEIGHT=58; BOLD=0; ITALIC=0; UNDERLINE=0]

FONT18=[FACENAME=Calibri(Corps); HEIGHT=90; BOLD=1; ITALIC=0; UNDERLINE=0]
FONT19=[FACENAME=Calibri(Corps); HEIGHT=65; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT20=[FACENAME=Calibri(Corps); HEIGHT=50; BOLD=0; ITALIC=0; UNDERLINE=0]
FONT21=[FACENAME=Arial; HEIGHT=60; BOLD=0; ITALIC=0; UNDERLINE=0]

// 2017.03.24 change font9 to Calibri(Corps); 
//FONT9=[FACENAME=Times New Roman; HEIGHT=80; BOLD=0; ITALIC=0; UNDERLINE=0]

PENCOUNT=6
PEN1=[WIDTH=1;COLOR=(0 0 0)]
PEN2=[WIDTH=3;COLOR=(0 0 0)]
PEN3=[WIDTH=3;COLOR=(255 0 0)]
PEN4=[WIDTH=4;COLOR=(0 255 0)]
PEN5=[WIDTH=5;COLOR=(0 0 255)]
PEN6=[WIDTH=5;COLOR=(255 255 255)]

COLORCOUNT=5
COLOR1=(0 0 0)
COLOR2=(255 0 0)
COLOR3=(0 0 255)
COLOR4=(255 255 255)
COLOR5=(255 255 200)

ALIGNCOUNT=9
ALIGN1=LEFT|TOP
ALIGN2=LEFT|VCENTER
ALIGN3=LEFT|BOTTOM
ALIGN4=CENTER|TOP
ALIGN5=CENTER|VCENTER
ALIGN6=CENTER|BOTTOM
ALIGN7=RIGHT|TOP
ALIGN8=RIGHT|VCENTER
ALIGN9=RIGHT|BOTTOM
*/

@ ("
[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}/Logo.jpg
\n\n"),


@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
PWD={/*PARAM6*/}


\n\n"),


@ ("

DATACOUNT=4
\n\n"),


@ ("
//////////////
DATA1=MY_ADRESS
NAME1=MYADRESS
\n\n"),

@ ("SQL1=SELECT \n"),
@ ("SQL1_1=   " SQL_CASEWHEN "AG.NAME is not NULL" SQL_THEN "AG.NAME" SQL_ELSE "' '" SQL_CASEEND " as Nom,\n"),
@ ("SQL1_2=   " SQL_CASEWHEN "AG.LABEL is not NULL" SQL_THEN "AG.LABEL" SQL_ELSE "' '" SQL_CASEEND " as Label,\n"),
@ ("SQL1_3=   " SQL_CASEWHEN "AG.ADDRESS is not NULL" SQL_THEN "AG.ADDRESS" SQL_ELSE "' '" SQL_CASEEND " as Adr,\n"),
@ ("SQL1_4=   " SQL_CASEWHEN "AG.ADDRESSSUP is not NULL" SQL_THEN "AG.ADDRESSSUP" SQL_ELSE "' '" SQL_CASEEND " as Adr2,\n"),
@ ("SQL1_5=   " SQL_CASEWHEN "AG.PostCode is not NULL" SQL_THEN "AG.PostCode" SQL_ELSE "' '" SQL_CASEEND " as CodePost,\n"),
@ ("SQL1_6=   " SQL_CASEWHEN "AG.City is not NULL" SQL_THEN "AG.City" SQL_ELSE "' '" SQL_CASEEND " as City,\n"),
@ ("SQL1_7=   " SQL_CASEWHEN "AG.Country is not NULL" SQL_THEN "AG.Country" SQL_ELSE "'France'" SQL_CASEEND " as Country,\n"),
@ ("SQL1_8=   " SQL_CASEWHEN "AG.Phone is not NULL" SQL_THEN "AG.Phone" SQL_ELSE "' '" SQL_CASEEND " as Phone,\n"),
@ ("SQL1_9=   " SQL_CASEWHEN "AG.Fax is not NULL" SQL_THEN "AG.Fax" SQL_ELSE "' '" SQL_CASEEND " as Fax,\n"),
@ ("SQL1_10=  " SQL_CASEWHEN "AG.EMAIL is not NULL" SQL_THEN "AG.EMAIL" SQL_ELSE "' '" SQL_CASEEND " as Mail,\n"),
@ ("\n"),
@ ("SQL1_11=  " SQL_CASEWHEN "AG.Capital is not NULL" SQL_THEN "AG.Capital" SQL_ELSE "'Type Société : ________ au capital de ______ _'" SQL_CASEEND " as TypeCompagny,\n"),
@ ("SQL1_12=  " SQL_CONCAT "'TVA Intracom : '" SQL_CONCATWITH " " SQL_CASEWHEN "AG.codeTax is not NULL" SQL_THEN "AG.codeTax" SQL_ELSE "' '" SQL_CASEEND " " SQL_CONCATEND " as NoTVA,\n"),
@ ("SQL1_13=  " SQL_CASEWHEN "AG.establishment is not NULL" SQL_THEN "AG.establishment" SQL_ELSE "'SIRET :'" SQL_CASEEND " as Siret,\n"),
@ ("SQL1_14=  " SQL_CASEWHEN "AG.RCS is not NULL" SQL_THEN "AG.RCS" SQL_ELSE "'RCS :'" SQL_CASEEND " as RCS,\n"),
@ ("SQL1_15=  " SQL_CASEWHEN "AG.APE is not NULL" SQL_THEN "AG.APE" SQL_ELSE "'APE :'" SQL_CASEEND " as APE,\n"),
@ ("\n"),
@ ("SQL1_16=  " SQL_CONCAT "'SIRET : '" SQL_CONCATWITH " " SQL_CASEWHEN "AG.establishment is not NULL" SQL_THEN "trim(AG.establishment)" SQL_ELSE "' '" SQL_CASEEND " " SQL_CONCATWITH "' - RCS : '" SQL_CONCATWITH " " SQL_CASEWHEN "AG.RCS is not NULL" SQL_THEN "trim(AG.RCS)" SQL_ELSE "' '" SQL_CASEEND " " SQL_CONCATWITH "' - APE : '" SQL_CONCATWITH " " SQL_CASEWHEN "AG.APE is not NULL" SQL_THEN "AG.APE" SQL_ELSE "' '" SQL_CASEEND " " SQL_CONCATEND " as InfoRegistre,\n"),
@ ("SQL1_17=  'IBAN : ' as BankInfo,\n"),
@ ("SQL1_18=  " SQL_CASEWHEN "AG.Country='France'" SQL_THEN "" SQL_CONCAT "'Imprimée le '" SQL_CONCATWITH " " SQL_FORMATDATE "(" SQL_CURRENTDATETIME ", '" SQL_FORMATDATE_FR ", " SQL_FORMATTIMESTR "')" SQL_CONCATEND " " SQL_ELSE "" SQL_CONCAT "'Printed '" SQL_CONCATWITH " " SQL_FORMATDATE "(" SQL_CURRENTDATETIME ", '" SQL_FORMATDATESTR ", " SQL_FORMATTIMESTR "')" SQL_CONCATEND " " SQL_CASEEND " as PrintDate,\n"),
@ ("\n"),
@ ("SQL1_19=  " SQL_CASEWHEN "AG.Country='France'" SQL_THEN "'Produit'" SQL_ELSE "'Product'" SQL_CASEEND " as TitleDoc,\n"),
@ ("SQL1_20=  " SQL_CASEWHEN "AG.Country='France'" SQL_THEN "'Produit No : '" SQL_ELSE "'Product no : '" SQL_CASEEND " as TitlePacking,\n"),
@ ("SQL1_21=  P.Id as IdP,\n"),
@ ("SQL1_22=  " SQL_CASEWHEN "AG.Country='France'" SQL_THEN "'Désignation : '" SQL_ELSE "'Designation : '" SQL_CASEEND " as TitleDate,\n"),
@ ("SQL1_23=  P.Designation,\n"),
@ ("SQL1_24=  " SQL_CASEWHEN "AG.Country='France'" SQL_THEN "'Référence : '" SQL_ELSE "'Reference : '" SQL_CASEEND " as TitleReference,\n"),
@ ("SQL1_25=  P.Reference as Reference\n"),

@ ("SQL1_26= FROM {/*OWNER*/}PRODUCT P, {/*OWNER*/}USER U, {/*OWNER*/}AGENCY AG \n"),
@ ("SQL1_27= WHERE  AG.ID=U.IdAgency and P.Id={/*PARAM4*/} and U.Id='{/*PARAM5*/}'\n\n"),

@ ("// compagny Registre info in FOOTER\n"),
@ ("\n"),
@ ("\n"),


@ ("


DATA2=INFO_PRODUCT
NAME2=InfoProduct

SQL2=SELECT 
SQL2_1=   P.ID as PRODUCT, 
SQL2_2=   P.Designation as DescriProduct,
SQL2_3=   P.DesignationTech,
SQL2_4=   " SQL_CASEWHEN "P.Length is not NULL and P.Length>0" SQL_THEN "" SQL_FORMATNUM "(P.Length,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL2_5=   " SQL_CASEWHEN "P.Width  is not NULL and P.Width>0" SQL_THEN " " SQL_FORMATNUM "(P.Width,"SQL_FORMATSCALE0") " SQL_ELSE " NULL" SQL_CASEEND ",
SQL2_6=   " SQL_CASEWHEN "P.Height is not NULL and P.Height>0" SQL_THEN "" SQL_FORMATNUM "(P.Height,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL2_7=   " SQL_CASEWHEN "P.Depth  is not NULL and P.Depth>0" SQL_THEN " " SQL_FORMATNUM "(P.Depth,"SQL_FORMATSCALE0") " SQL_ELSE " NULL" SQL_CASEEND ",
SQL2_8=   " SQL_CASEWHEN "P.Volume is not NULL and P.Volume>0" SQL_THEN "" SQL_FORMATNUM "(P.Volume,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL2_9=   " SQL_CASEWHEN "P.Weight is not NULL and P.Weight>0" SQL_THEN "" SQL_FORMATNUM "(P.Weight,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL2_10=  (select sum(PC.Quantity) FROM {/*OWNER*/}PRODUCT_COMPONENT PC WHERE P.ID=PC.IdProduct) as QTY
SQL2_11= FROM {/*OWNER*/}PRODUCT P 
SQL2_12= WHERE P.ID in ({/*PARAM4*/})
\n\n"),


@ ("

//////////////
DATA3=INFO_SUBPRODUCT
NAME3=INFOSUBPRODUCT

SQL3=SELECT DISTINCT
SQL3_1=   P.ID as PRODUCT, 
SQL3_2=   P.Designation as DescriProduct,
SQL3_3=   P.DesignationTech,
SQL3_4=   " SQL_CASEWHEN "P.Length is not NULL and P.Length>0" SQL_THEN "" SQL_FORMATNUM "(P.Length,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_5=   " SQL_CASEWHEN "PC.LengthByPiece is not NULL and PC.LengthByPiece>0" SQL_THEN "" SQL_FORMATNUM "(PC.LengthByPiece,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_6=   " SQL_CASEWHEN "P.Width  is not NULL and P.Width>0" SQL_THEN " " SQL_FORMATNUM "(P.Width,"SQL_FORMATSCALE0")" SQL_ELSE "  NULL" SQL_CASEEND ",
SQL3_7=   " SQL_CASEWHEN "PC.WidthByPiece is not NULL and PC.WidthByPiece>0" SQL_THEN "" SQL_FORMATNUM "(PC.WidthByPiece,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_8=   " SQL_CASEWHEN "P.Height is not NULL and P.Height>0" SQL_THEN "" SQL_FORMATNUM "(P.Height,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_9=   " SQL_CASEWHEN "PC.HeightByPiece is not NULL and PC.HeightByPiece>0" SQL_THEN "" SQL_FORMATNUM "(PC.HeightByPiece,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_10=  " SQL_CASEWHEN "P.Depth  is not NULL and P.Depth>0" SQL_THEN " " SQL_FORMATNUM "(P.Depth,"SQL_FORMATSCALE0")" SQL_ELSE "  NULL" SQL_CASEEND ",
SQL3_11=  " SQL_CASEWHEN "PC.DepthByPiece is not NULL and PC.DepthByPiece>0" SQL_THEN "" SQL_FORMATNUM "(PC.DepthByPiece,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_12=  " SQL_CASEWHEN "P.Volume is not NULL and P.Volume>0" SQL_THEN "" SQL_FORMATNUM "(P.Volume,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_13=  " SQL_CASEWHEN "PC.VolumeByPiece is not NULL and PC.VolumeByPiece>0" SQL_THEN "" SQL_FORMATNUM "(PC.VolumeByPiece,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_14=  " SQL_CASEWHEN "P.Weight is not NULL and P.Weight>0" SQL_THEN "" SQL_FORMATNUM "(P.Weight,"SQL_FORMATSCALE0")" SQL_ELSE " NULL" SQL_CASEEND ",
SQL3_15=  PC.Quantity
SQL3_16= FROM {/*OWNER*/}PRODUCT P inner join {/*OWNER*/}PRODUCT_COMPONENT PC on P.ID=PC.IdSubProduct
SQL3_17= WHERE PC.IdProduct={/*PARAM4*/}
SQL3_18= ORDER BY P.Id
\n\n"),


@ ("

DATA4=LINE_TOTAL
NAME4=LINETOTAL

SQL4=SELECT DISTINCT 
SQL4_1=   'TOTAL' as PRODUCT, 
SQL4_2=   ' ' as DescriProduct,
SQL4_3=   ' ' as DesignationTech,
SQL4_4=   " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "P.Length is not NULL" SQL_THEN "P.Length" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"), " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "PC.LengthByPiece is not NULL" SQL_THEN "PC.LengthByPiece" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"),
SQL4_5=   " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "P.Width is not NULL" SQL_THEN " P.Width " SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"), " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "PC.WidthByPiece is not NULL " SQL_THEN "PC.WidthByPiece " SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"),
SQL4_6=   " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "P.Height is not NULL" SQL_THEN "P.Height" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"), " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "PC.HeightByPiece is not NULL" SQL_THEN "PC.HeightByPiece" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"),
SQL4_7=   " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "P.Depth is not NULL" SQL_THEN " P.Depth " SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"), " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "PC.DepthByPiece is not NULL " SQL_THEN "PC.DepthByPiece " SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"),
SQL4_8=   " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "P.Volume is not NULL" SQL_THEN "P.Volume" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"), " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "PC.VolumeByPiece is not NULL" SQL_THEN "PC.VolumeByPiece" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"),
SQL4_9=   " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "P.Weight is not NULL" SQL_THEN "P.Weight" SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"), " SQL_FORMATNUM "(sum(" SQL_CASEWHEN "PC.Quantity is not NULL     " SQL_THEN "PC.Quantity     " SQL_ELSE "0" SQL_CASEEND "),"SQL_FORMATSCALE0"),
SQL4_10=  PC.IdProduct
SQL4_11= FROM {/*OWNER*/}PRODUCT P 
SQL4_12=   inner join {/*OWNER*/}PRODUCT_COMPONENT PC on P.ID=PC.IdSubProduct
SQL4_13= WHERE PC.IdProduct={/*PARAM4*/}
SQL4_14= GROUP BY PC.IdProduct
\n\n"),


@ ("

[TABLE]

TABLECOUNT=1

TABLE1=Table(DATAOBJ=DATA3; RECT=(0 0 1900 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=;
TABLE1_1=TITLE=\"Produits Client\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
TABLE1_3=CX_VERTHDR=0; FONT_VERTHDR=; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR2; 
TABLE1_4=CY_ROW=50;
TABLE1_5=FIELDCOUNT=11; 
TABLE1_6=NAMES=(\"Mark\", \"pale\", \"Art\", \"desc\", \"Command\", \"Qty\", \"NW\", \"GW\", \"L\", \"W\", \"H\"); 
TABLE1_7=WIDTHES=(150, 110, 190, 550, 180, 130, 140, 150, 100, 100, 100); 
TABLE1_8=FONTS=(FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9); 
TABLE1_9=TEXTALIGNS=(ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2); 
TABLE1_10=TEXTCOLORS=(COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1); 
TABLE1_11=FILLCOLORS=(COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5); 
TABLE1_12=FIELDS=(DATA3.1, DATA3.2, DATA3.3, DATA3.4, DATA3.5, DATA3.6, DATA3.7, DATA3.8, DATA3.9, DATA3.10, DATA3.11); 
TABLE1_13=)
\n\n"),


@ ("


[XML]

FILE={/*XMLFILE*/}
XMLCOUNT =0
XML1=|\"NOM_PDF {/*OUTPUT*/}\"
XML2=|\"NUM_FAX1 {/*DATA1.1*/}\"
XML3=|\"NUM_FAX2 {/*DATA1.2*/}\"
XML4=|\"CODE_FACT {/*DATA1.3*/}\"
XML5=|\"MAIL1_RAPPORT {/*DATA1.6*/}\"
XML6=|\"MAIL2_RAPPORT {/*DATA1.7*/}\"
XML7=|\"TYPE_RAPPORT {/*DATA1.8*/}\"
\n\n"),


@ ("

[SQL]
SQLCOUNT=0

//SQL1=UPDATE {/*OWNER*/}DELIVERY D set State='2' where D.[IdDelivery]={/*PARAM3*/} and (State<'2' or State is NULL)

\n\n"),


@ ("

[SCRIPT]

//DATAOBJ=DATA5

INSTRCOUNT=10
\n\n"),


@ ("

INSTR1=StartDoc

INSTR2=StartPage 1
\n\n"),


@ ("

//INSTR2=Line(10  430, 2600  430, PEN1); 
\n\n"),


@ ("

// table  adresses livraisons 
INSTR3=Table(DATAOBJ=DATA2; RECT=0 50 _ _; BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR3_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=60;
INSTR3_2=TITLE=\"PRODUCT INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR3_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR3_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR3_5=FIELDCOUNT=20;
INSTR3_6=FIELD1=[NAME=\"ID\",   RECT=(100    0   350  60),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"ID Product :\"];
