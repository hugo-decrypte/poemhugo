'@' => (

	printFile = "/PrintTourPalletSheet",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),

@ ("
////////////////////////////////////////////
////////////////////////////////////////////
// PARAMETRES
//\"DataPrint.exe\" \"DEPDIR/Print/PrintPalletSheet.ini\" \"[DSN=GestionStock; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=Delivery.pdf; XMLFILE=DeliveryTmp.txt]\" \"11020170131\"
// {/*PARAM0*/}  \"DataPrint.exe\" 
// {/*PARAM1*/}  fichier  INI
// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;
// {/*PARAM3*/}  print directery
// {/*PARAM4*/}  code delivery
// {/*PARAM5*/}  user id
//
//DSN=Logistics
//USR= 
//PWD= 
//OWNER= 

\n"),


@ ("

[HEADER]
VERSION=1.0
TITLE=Fiche Palette

// Societe
// logo.jpg 1368 x 264 : 1100 x 212
\n"),

@ ("HEADER1=Picture(200 60 490 185, PICTURE1)\n"),

@ ("// Label compagny\n"),
@ ("HEADER2=Text(120  190 1000 230, {/*DATA1.2.1*/}, FONT10, LEFT|VCENTER, COLOR1)\n"),
@ ("// adress\n"),
@ ("HEADER3=Text(120  240 1000 270, \"{/*DATA1.3.1*/}\", FONT16, LEFT|VCENTER, COLOR1)\n"),
@ ("HEADER4=Text(120  270 1000 300, \"{/*DATA1.4.1*/}\", FONT16, LEFT|VCENTER, COLOR1)\n"),
@ ("// post code, city\n"),
@ ("HEADER5=Text(120  300 1000 330, \"{/*DATA1.5.1*/}  {/*DATA1.6.1*/}\", FONT16, LEFT|VCENTER, COLOR1)\n"),
@ ("HEADER6=Text(120  330 1000 360, \"{/*DATA1.7.1*/}\", FONT16, LEFT|VCENTER, COLOR1)\n"),
@ ("HEADER7=Text(500  270 1200 300, \"Tél.  : {/*DATA1.8.1*/}\", FONT16, LEFT|VCENTER, COLOR1)\n"),
@ ("HEADER8=Text(500  300 1200 330, \"Email : {/*DATA1.10.1*/}\", FONT16, LEFT|VCENTER, COLOR1)\n"),
@ ("\n\n"),
%%@ ("// TITLE\n"),
%%@ ("HEADER9=Text(1100 120 1950 200, \"{/*DATA1.19.1*/}\", FONT5, CENTER|VCENTER, COLOR1)\n"),

%%@ ("// order no\n"),
%%@ ("HEADER10=Text(1100 200 1600 260, \"{/*DATA1.20.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)\n"),
%%@ ("HEADER11=Text(1610 200 1950 260, \"{/*DATA1.21.1*/}\", FONT6, LEFT|VCENTER, COLOR1)\n"),
%%@ ("\n// Line\n"),
%%@ ("HEADER9=Line(110  390, 2100  390, PEN1); \n"),
@ ("////////////////\n"),




@ ("[FOOTER]\n"),
@ ("PAGENUM=Text(1200 0 2900 50, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT9, RIGHT|VCENTER, COLOR1)\n"),
@ ("// compagny registre info \n"),
@ ("FOOTER1=Text(0 0 2800 50, \"{/*DATA1.11.1*/} - {/*DATA1.16.1*/} - {/*DATA1.12.1*/}\", FONT10, CENTER|VCENTER, COLOR1)\n"),
@ ("// print date time\n"),
@ ("FOOTER2=Text(0 50 1900 80, \"{/*DATA1.18.1*/}\", FONT16, RIGHT|VCENTER, COLOR1)\n"),
@ ("FOOTER3=Line(0 0, 1900  0, PEN1); \n"),

@ ("\n\n"),


@ ("
[BACKGROUND]
\n\n"),


@ ("

[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
//OUTPUT=c:/DataPrint/Pallet.xps
//OUTPUT=c:/DataPrint/Pallet.pdf
//OUTPUT={/*PARAM4*/}

DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}TracePrintTourPalletSheet.log

DOCNAME=Fiche Palette
PAGESIZE=A4
//LANDSCAPEMODE= ( 0 : portrai; 1 : paysage)
LANDSCAPEMODE=0

PAGEWIDTH= 2100
PAGEHEIGHT= 2970
MARGIN=100 400 100 100
PAGENUMER=AUTO
PAGEBREAK=AUTO


\n"),


%% [STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],




@ ("
[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}Logo.jpg
\n\n"),


@ ("

[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
PWD={/*PARAM6*/}
\n\n"),


@ ("

DATACOUNT=6
\n\n"),

%//////////////
%// agency info used in HEADER and FOOTER
%DATA1=MY_ADRESS
%NAME1=MYADRESS

 ['Work Directory' "Model\Print\PrintMyInfosData.n"],



@ ("
//////////////
DATA2=OBJ_DATA
NAME2=OBJ_DATA

SQL2=SELECT distinct
SQL2_1=   D.ID as CODEDELIVERY, DP.NoPalletDelivery as NOPALLET, D.NbPallet as NBPALLET,
SQL2_2=   D.IdAgency as CODEAGENCY, 
SQL2_3=   CL.Id as CODECLIENT, 
SQL2_4=   CL.BankAccount as BANKACCOUNT, 
SQL2_5=   CL.Country as COUNTRY, 
SQL2_6=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Fiches Palette de livraison  '" SQL_ELSE "'Delivery pallet sheet   '" SQL_CASEEND " as TITLEDOC,
SQL2_7=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'No : '" SQL_ELSE "'no : '" SQL_CASEEND " as TITLECODEOBJ,
SQL2_8=  " SQL_CONCAT "" SQL_FORMATNUM "(DP.NoPalletDelivery,"SQL_FORMATSCALE0")" SQL_CONCATWITH "'/'" SQL_CONCATWITH " " SQL_FORMATNUM "(D.NbPallet,"SQL_FORMATSCALE0")" SQL_CONCATEND " as CODEOBJ,
SQL2_9=   'Date : ' as TITLEDATEOBJ,
SQL2_10=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')"
				 SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(D.DateDelivery,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,1,4)" SQL_CONCATEND " "
				 SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(D.DateDelivery,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,9,2)" SQL_CONCATEND " "
			     SQL_CASEEND " as DATEOBJ,
SQL2_11=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')" SQL_THEN "'Client No : '" SQL_ELSE "'Client No : '" SQL_CASEEND " as TITLEREFERENCEOBJ,
SQL2_12=  D.IdClient as REFERENCEOBJ,
SQL2_13=  ' ' as CODECLUB
SQL2_14= FROM ({/*OWNER*/}DELIVERY D inner join {/*OWNER*/}DELIVERY_PRODUCT DP on D.id=DP.idDelivery) left join {/*OWNER*/}CLIENT CL on CL.Id=D.IdClient
SQL2_15= WHERE D.IdTour in ({/*PARAM4*/}) and DP.NoPalletDelivery is not NULL
\n\n"),



@ ("

DATA3=INFO_DELIVERY
NAME3=InfoDelivery

SQL3=SELECT 
SQL3_1=   NoLot, DateExpiration, PRODUCT, 
SQL3_2=   DescriArticle,
SQL3_3=   Cmd,
SQL3_4=   " SQL_FORMATNUM "(QTY,"SQL_FORMATSCALE0"),
SQL3_5=   " SQL_FORMATNUM "(NW,"SQL_FORMATSCALE1")
SQL3_6= FROM (SELECT
SQL3_7=   P.ID as PRODUCT, 
SQL3_8=   P.Designation as DescriArticle,
SQL3_9=   ' ' as Cmd,
SQL3_10=   sum(LP.Quantity) as QTY,
SQL3_11=   " SQL_CASEWHEN "LP.NoLot is not NULL and LP.NoLot>' '" SQL_THEN "LP.NoLot" SQL_ELSE " " SQL_CASEWHEN "LP.DateCreate is not NULL and LP.DateCreate >'0'" SQL_THEN "" SQL_FORMATDATE "(LP.DateCreate,'" SQL_FORMATDATESTR "')" SQL_ELSE "' '" SQL_CASEEND " " SQL_CASEEND " as NoLot,
SQL3_12=   " SQL_CASEWHEN "LP.DateExpiration is not NULL and LP.DateExpiration>'0'" SQL_THEN "" SQL_FORMATDATE "(LP.DateExpiration,'" SQL_FORMATDATESTR "')" SQL_ELSE "' '" SQL_CASEEND " as DateExpiration,
SQL3_13=   P.Weight*sum(LP.Quantity) as NW 
SQL3_14= FROM (({/*OWNER*/}DELIVERY D
SQL3_15=  inner join {/*OWNER*/}DELIVERY_PRODUCT LD on D.Id=LD.IdDelivery)
SQL3_16=  inner join {/*OWNER*/}PRODUCT P on P.ID=LD.IdProduct)
SQL3_17=  left join {/*OWNER*/}PALLET_PRODUCT LP on LP.IdPacking=LD.IdPacking and LP.NoPallet=LD.NoPallet and LP.IdProduct=LD.IdProduct
SQL3_16=  inner join {/*OWNER*/}PALLET_PRODUCT LP on LP.IdPacking=PL.IdPacking and LP.NoPallet=PL.NoPallet)
SQL3_18= WHERE P.TypeProduct='P' and LD.NoPalletDelivery is not NULL
SQL3_19=   AND LD.IdDelivery='{/*CODEDELIVERY*/}'
SQL3_20=   and LD.NoPalletDelivery={/*NOPALLET*/} 
SQL3_21= Group BY P.ID, P.Designation, P.Weight, LD.IdProduct,LD.IdOrder, LP.NoLot, LP.DateCreate, LP.DateExpiration
SQL3_22= ORDER BY LD.IdProduct, LD.IdOrder) t

\n\n"),



@ ("

//////////////
DATA4=INFO_ORDERS
NAME4=INFOORDERS

SQL4=SELECT DISTINCT
SQL4_1=   LD.IdPacking as C1,
SQL4_2=   ' ' as C2,
SQL4_3=   ' ' as C3,
SQL4_4=   ' ' as C4,
SQL4_5=   LD.IdOrder as CMD5,
SQL4_6=   LD.Quantity as QTY6,
SQL4_7=   ' ' as C7,
SQL4_8=   ' ' as C8,
SQL4_9=   ' ' as C9,
SQL4_10=   ' ' as C10,
SQL4_11=   ' ' as C11
SQL4_12= FROM {/*OWNER*/}DELIVERY_PRODUCT LD
SQL4_13= WHERE LD.IdDelivery='{/*CODEDELIVERY*/}'
SQL4_14=   AND LD.IdPacking='{/*PACKING*/}' AND LD.NoPallet={/*PALETTE*/} AND LD.IdProduct='{/*PRODUCT*/}' 
SQL4_15=   AND LD.IdOrder>= (select min(LD1.IdOrder) from {/*OWNER*/}DELIVERY_PRODUCT LD1
SQL4_16=      WHERE LD1.IdDelivery='{/*CODEDELIVERY*/}'
SQL4_17=       AND LD1.IdPacking='{/*PACKING*/}' AND LD1.NoPallet={/*PALETTE*/} AND LD1.IdProduct='{/*PRODUCT*/}'
SQL4_18=    )
SQL4_19= ORDER BY LD.IdOrder

\n\n"),



@ ("
DATA5=LINE_TOTAL
NAME5=LINETOTAL

SQL5=SELECT DISTINCT 'TOTAL' as Col6, sum(QTY_C9) as Col9, round(sum(C10),0) as Col10, round(sum(C11),0) as Col11
SQL5_1=   FROM (SELECT LD.IdDelivery, LD.NoPalletDelivery,
SQL5_2=   sum(LD.Quantity) as QTY_C9,
SQL5_3=   sum(P.Weight*LD.Quantity) as C10, 
SQL5_4=   PL.WeightGlobal as C11
SQL5_5= FROM (({/*OWNER*/}DELIVERY D inner join {/*OWNER*/}DELIVERY_PRODUCT LD on D.Id=LD.IdDelivery)
SQL5_6=   inner join {/*OWNER*/}PRODUCT P on P.ID=LD.IdProduct) 
SQL5_7=   LEFT JOIN {/*OWNER*/}PALLET PL on PL.IdPacking=LD.IdDelivery AND PL.NoPallet=LD.NoPalletDelivery
SQL5_8= WHERE P.TypeProduct='P' and LD.NoPalletDelivery is not NULL
SQL5_9=   AND D.Id='{/*CODEDELIVERY*/}' and LD.NoPalletDelivery={/*NOPALLET*/}
SQL5_10= GROUP BY LD.IdDelivery, LD.NoPalletDelivery, PL.WeightGlobal, D.WeightPallet) t

\n\n"),



@ ("

DATA6=ADDRESS_DELIV
NAME6=AddressDeliv

SQL6=SELECT DISTINCT
SQL6_1=   " SQL_CASEWHEN "PT.Country='France'" SQL_THEN "'Adresse de livraison'" SQL_ELSE "'Shipping adress'" SQL_CASEEND " as TitleAdressDeliv, 
SQL6_2=   PT.NameClient as PtDeliv, 
SQL6_3=   PT.Address as AddresDeliv, 
SQL6_4=   PT.AddressSup as AddresSupDeliv, 
SQL6_5=   " SQL_CONCAT "TRIM(PT.PostCode)" SQL_CONCATWITH "'   '" SQL_CONCATWITH "PT.City" SQL_CONCATEND "as PostCodeCityDeliv, 
SQL6_6=   " SQL_CASEWHEN "PT.Country='France'" SQL_THEN "'FRANCE '" SQL_ELSE "PT.Country" SQL_CASEEND " as CountryDeliv,
SQL6_7=   D.Id as IdDelivery,
SQL6_8=   " SQL_CONCAT "'{/*NOPALLET*/}'" SQL_CONCATWITH "' / '" SQL_CONCATWITH "(select " SQL_FORMATNUM "(count(1),"SQL_FORMATSCALE0") from {/*OWNER*/}PALLET PL0 where PL0.IdPacking=D.Id)" SQL_CONCATEND " as NoP,
SQL6_9=   " SQL_FORMATDATE "(PL.DatePreparation,'"SQL_FORMATDATE_FR"') as DateModif ,
SQL6_10=  " SQL_CONCAT "" SQL_FORMATNUM "(PL.Length,"SQL_FORMATSCALE0")" SQL_CONCATWITH "' x '" SQL_CONCATWITH "" SQL_FORMATNUM "(PL.Width,"SQL_FORMATSCALE0")" SQL_CONCATWITH "' x '" SQL_CONCATWITH "" SQL_FORMATNUM "(PL.Height,"SQL_FORMATSCALE0")" SQL_CONCATWITH "' cm'" SQL_CONCATEND " as Dimension,
SQL6_11=  " SQL_CONCAT "" SQL_FORMATNUM "(PL.WeightNet,"SQL_FORMATSCALE0")" SQL_CONCATWITH "' KG'" SQL_CONCATEND " as WN, " SQL_CONCAT "" SQL_FORMATNUM "(" SQL_CASEWHEN "PL.WeightPallet is NULL or PL.WeightPallet<0" SQL_THEN "PL.WeightNet+30" SQL_ELSE "PL.WeightNet+PL.WeightPallet" SQL_CASEEND ","SQL_FORMATSCALE0")" SQL_CONCATWITH "' KG'" SQL_CONCATEND " as WG,
SQL6_12=  " SQL_FORMATDATE "(D.DateDelivery,'"SQL_FORMATDATE_FR"') as DateDeliv 
SQL6_13= FROM {/*OWNER*/}DELIVERY D, {/*OWNER*/}POINTDELIVERY PT, {/*OWNER*/}PALLET PL
SQL6_14= WHERE PT.IdClient=D.IdClient AND PT.IdPoint=D.IdPointDelivery 
SQL6_15=  AND D.Id='{/*CODEDELIVERY*/}'
SQL6_16=  AND PL.IdPacking=D.Id and PL.NoPallet={/*NOPALLET*/}

\n\n"),



@ ("

[TABLE]

TABLECOUNT=1

TABLE1=Table(DATAOBJ=DATA4; RECT=(0 0 1900 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=;
TABLE1_1=TITLE=\"Produits Client\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
TABLE1_3=CX_VERTHDR=0; FONT_VERTHDR=; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR2; 
TABLE1_4=CY_ROW=50;
TABLE1_5=FIELDCOUNT=11; 
TABLE1_6=NAMES=(\"Mark\", \"pale\", \"Art\", \"desc\", \"Command\", \"Qty\", \"NW\", \"GW\", \"L\", \"W\", \"H\"); 
TABLE1_7=WIDTHES=(150, 110, 190, 550, 180, 130, 140, 150, 100, 100, 100); 
TABLE1_8=FONTS=(FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9); 
TABLE1_9=TEXTALIGNS=(ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2); 
TABLE1_10=TEXTCOLORS=(COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1); 
TABLE1_11=FILLCOLORS=(COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5); 
TABLE1_12=FIELDS=(DATA4.1, DATA4.2, DATA4.3, DATA4.4, DATA4.5, DATA4.6, DATA4.7, DATA4.8, DATA4.9, DATA4.10, DATA4.11); 
TABLE1_13=)

\n\n"),



