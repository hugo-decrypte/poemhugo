INSTRCOUNT=9

\n\n"),



@ ("

//INSTR1=StartDoc

INSTR1=StartPage 1

INSTR2=Line(10  430, 2600  430, PEN1); 

// table  adresses livraisons 
INSTR3=Table(DATAOBJ=DATA6; RECT=10 0 _ _; BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR3_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=60;
INSTR3_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR3_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR3_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR3_5=FIELDCOUNT=18;
INSTR3_6=FIELD1=[NAME=\"Tit\",  RECT=(300    0  1900  60),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.1];
INSTR3_7=FIELD2=[NAME=\"Nom\",  RECT=(300  100  1900 160),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.2];
INSTR3_8=FIELD3=[NAME=\"Add\",  RECT=(300  160  1900 220),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.3];
INSTR3_9=FIELD4=[NAME=\"Ad1\",  RECT=(300  220  1900 280),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.4];
INSTR3_10=FIELD5=[NAME=\"CPC\", RECT=(300  280  1900 340),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.5];
INSTR3_11=FIELD6=[NAME=\"CTR\", RECT=(300  340  1900 400),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.6];
INSTR3_12=FIELD7=[NAME=\"PAL\", RECT=(1100   0  1700  70),  FONT=5, ALIGN=8, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"NO. Palette : \"];
INSTR3_13=FIELD8=[NAME=\"PAL\", RECT=(1700   0  1900  70),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.8];
INSTR3_14=FIELD9=[NAME=\"BL\",  RECT=(10   440   400 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"Bon de Livraison : \"];
INSTR3_15=FIELD10=[NAME=\"BL\", RECT=(410  440  1900 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.7];
INSTR3_16=FIELD11=[NAME=\"DAT\",RECT=(10   500   400 560),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"Date de préparation :\"];
INSTR3_17=FIELD12=[NAME=\"DAT\",RECT=(410  500  1900 560),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.9];
INSTR3_18=FIELD13=[NAME=\"DIM\",RECT=(710  440  1000 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"Dimension :\"];
INSTR3_19=FIELD14=[NAME=\"DIM\",RECT=(950  440  1900 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.10];
INSTR3_20=FIELD15=[NAME=\"WN\", RECT=(1410 440  1700 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"Poids net :\"];
INSTR3_21=FIELD16=[NAME=\"WN\", RECT=(1710 440  1900 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.11];
INSTR3_22=FIELD17=[NAME=\"WG\", RECT=(1410 500  1700 560),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"Poids Global :\"];
INSTR3_23=FIELD18=[NAME=\"WG\", RECT=(1710 500  1900 560),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.12];
