ALIGN9=RIGHT|BOTTOM
\n"),


@ ("
[PICTURE]
PICTURECOUNT=0
//PICTURE1={/*PARAM4*/}/ProductProductionProcess.jpg
\n"),



@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
\n"),


@ ("
DATACOUNT=3
\n"),

@ ("
DATA1=INFO_PERIOD
NAME1=InfoPeriod
\n"),

@ ("
SQL1=SELECT distinct
SQL1_1=   '{/*STRDATE1*/}' as dateFirst,
SQL1_2=   '{/*STRDATE2*/}' as dateLast,
SQL1_3=   " SQL_CURRENTDATETIME " as PrintTime, 
SQL1_4=   trim(max(ct.LastName)) + '  ' + max(ct.FirstName) as ResourceName, ct.idResource
SQL1_5= FROM {/*OWNER*/}Contract ct
SQL1_6= WHERE ct.IdResource='{/*RESOURCEID*/}'
SQL1_7=  GROUP BY ct.IdResource
\n"),



@ ("
DATA2=INFO_DATECMD
NAME2=InfoDateCmd
\n"),

@ ("
SQL2=SELECT 
SQL2_1=   (select left(w.Name,3)+' '+" SQL_SUBSTRING "(rd.DateResource,9,2)+'/'+" SQL_SUBSTRING "(rd.DateResource,6,2) from {/*OWNER*/}Alias w where w.category='CALENDAR' and w.field='weekday' and w.ID+0=DatePart(" SQL_DATEPART_WEEKDAY ",rd.DateResource"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL2_2=   " SQL_CASEWHEN "rd.WorkTime is NULL"    SQL_THEN "' '" SQL_ELSE ""SQL_FORMATNUM"(rd.WorkTime/60.0,"SQL_FORMATSCALE2")"   SQL_CASEEND " as C1, 
SQL2_3=   " SQL_CASEWHEN "rd.NightTime is NULL"   SQL_THEN "' '" SQL_ELSE ""SQL_FORMATNUM"(rd.NightTime/60.0,"SQL_FORMATSCALE2")"   SQL_CASEEND " as C2, 
SQL2_4=   " SQL_CASEWHEN "rd.BreakTime is NULL"   SQL_THEN "' '" SQL_ELSE ""SQL_FORMATNUM"(rd.BreakTime/60.0,"SQL_FORMATSCALE2")"    SQL_CASEEND " as C3, 
SQL2_5=   " SQL_CASEWHEN "rd.DrivingTime is NULL" SQL_THEN "' '" SQL_ELSE ""SQL_FORMATNUM"(rd.DrivingTime/60.0,"SQL_FORMATSCALE2")" SQL_CASEEND " as C4,
SQL2_6=   " SQL_CASEWHEN "rd.RouteTime is NULL"   SQL_THEN "' '" SQL_ELSE ""SQL_FORMATNUM"(rd.RouteTime/60.0,"SQL_FORMATSCALE2")"   SQL_CASEEND " as C5,
SQL2_7=   ' ' as C6_VP, 
SQL2_8=   ' ' as C7_GD,
SQL2_9=   " SQL_CASEWHEN "rd.WorkTime>=240" SQL_THEN "'X'" SQL_ELSE "' '" SQL_CASEEND " as C8_Panier, 
SQL2_10=  ' ' as C9_Absent,
SQL2_11=  ' ' as C10_CP,
SQL2_12=  rd.IdTypeProcess as C11_Act,
SQL2_13=  ' ' as C12_Ville,
SQL2_14=  ' ' as C13_Client,
SQL2_15=  " SQL_CASEWHEN "rd.Comments is NULL" SQL_THEN "' '" SQL_ELSE "rd.Comments" SQL_CASEEND "as C14_Comments, DatePart(" SQL_DATEPART_WEEKDAY ",rd.DateResource"SQL_FIRSTWEEKDAY") as NumWeekDay
SQL2_16= FROM {/*OWNER*/}Resource_Date rd
SQL2_17= WHERE rd.IdResource='{/*RESOURCEID*/}' and '{/*D1*/}'<=rd.DateResource and rd.DateResource<='{/*D7*/}'

SQL2_18= UNION ALL SELECT
SQL2_19=  left(d.Name,3)+format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),' dd/MM') as NameDay,
SQL2_20=  ' ' as C1,
SQL2_21=  ' ' as C2, 
SQL2_22=  ' ' as C3, 
SQL2_23=  ' ' as C4,
SQL2_24=  ' ' as C5,
SQL2_25=  ' ' as C6_VP, 
SQL2_26=  ' ' as C7_GD,
SQL2_27=  ' ' as C8_Panier, 
SQL2_28=  " SQL_CASEWHEN "ra.idTypeAbsence>' ' and ra.idTypeAbsence not in ('CP')" SQL_THEN "'X'" SQL_ELSE "' '" SQL_CASEEND " as C9_Absent,
SQL2_29=  " SQL_CASEWHEN "ra.idTypeAbsence='CP'" SQL_THEN "'X'" SQL_ELSE "' '" SQL_CASEEND " as C10_CP,
SQL2_30=  ra.idTypeAbsence as C11_Act,
SQL2_31=  ' ' as C12_Ville,
SQL2_32=  ' ' as C13_Client,
SQL2_33=  ra.Comments as C14_Comments, d.ID+0 as NumWeekDay
SQL2_34= FROM {/*OWNER*/}Resource_Absence ra, {/*OWNER*/}Alias d
SQL2_35= WHERE ra.IdResource='{/*RESOURCEID*/}' and d.Category='CALENDAR' and d.field='weekday' and d.ID>='1' and d.ID<='6' and format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd')<='{/*D7*/}'
SQL2_36=  and ra.DateStart<=format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd') and format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd')<=ra.DateEnd

SQL2_37= UNION ALL SELECT
SQL2_38=  (select left(d.Name,3)+' '+" SQL_SUBSTRING "(c.Id,9,2)+'/'+" SQL_SUBSTRING "(c.Id,6,2) from {/*OWNER*/}Alias d where d.Category='CALENDAR' and d.field='weekday' and d.ID+0=DatePart(" SQL_DATEPART_WEEKDAY ",c.Id"SQL_FIRSTWEEKDAY") ) as NameDay,
SQL2_39=  ' ' as C1,
SQL2_40=  ' ' as C2, 
SQL2_41=  ' ' as C3, 
SQL2_42=  ' ' as C4,
SQL2_43=  ' ' as C5,
SQL2_44=  ' ' as C6_VP, 
SQL2_45=  ' ' as C7_GD,
SQL2_46=  ' ' as C8_Panier, 
SQL2_47=  ' ' as C9_Absent,
SQL2_48=  ' ' as C10_CP,
SQL2_49=  '" TAG_HOLIDAY "' as C11_Act,
SQL2_50=  ' ' as C12_Ville,
SQL2_51=  ' ' as C13_Client,
SQL2_52=  c.Comments as C14_Comments, DatePart(" SQL_DATEPART_WEEKDAY ",c.Id"SQL_FIRSTWEEKDAY") as NumWeekDay
SQL2_53= FROM {/*OWNER*/}Calendar c
SQL2_54= WHERE '{/*D1*/}'<=c.Id and c.Id<='{/*D7*/}'

SQL2_55= UNION ALL SELECT
SQL2_56=  'TOTAL' as NameDay,
SQL2_57=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "rd.WorkTime is NULL"    SQL_THEN "0" SQL_ELSE "rd.WorkTime"    SQL_CASEEND ")/60.0,"SQL_FORMATSCALE2") as C1, 
SQL2_58=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "rd.NightTime is NULL"   SQL_THEN "0" SQL_ELSE "rd.NightTime"   SQL_CASEEND ")/60.0,"SQL_FORMATSCALE2") as C2, 
SQL2_59=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "rd.BreakTime is NULL"   SQL_THEN "0" SQL_ELSE "rd.BreakTime"   SQL_CASEEND ")/60.0,"SQL_FORMATSCALE2") as C3, 
SQL2_60=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "rd.DrivingTime is NULL" SQL_THEN "0" SQL_ELSE "rd.DrivingTime" SQL_CASEEND ")/60.0,"SQL_FORMATSCALE2") as C4,
SQL2_61=  "SQL_FORMATNUM"(sum(" SQL_CASEWHEN "rd.RouteTime is NULL"   SQL_THEN "0" SQL_ELSE "rd.RouteTime"   SQL_CASEEND ")/60.0,"SQL_FORMATSCALE2") as C5,
SQL2_62=  ' ' as C6_VP, 
SQL2_63=  ' ' as C7_GD,
SQL2_64=  ' ' as C8_Panier, 
SQL2_65=  ' ' as C9_Absent,
SQL2_66=  ' ' as C10_CP,
SQL2_67=  ' ' as C11_Act,
SQL2_68=  ' ' as C12_Ville,
SQL2_69=  ' ' as C13_Client,
SQL2_70=  ' ' as C14_Comments, 8 as NumWeekDay
SQL2_71= FROM {/*OWNER*/}Resource_Date rd
SQL2_72= WHERE rd.IdResource='{/*RESOURCEID*/}' and '{/*D1*/}'<=rd.DateResource and rd.DateResource<='{/*D7*/}'

SQL2_73= UNION ALL SELECT
SQL2_74=  left(d.Name,3)+format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),' dd/MM') as NameDay,
SQL2_75=  ' ' as C1,
SQL2_76=  ' ' as C2, 
SQL2_77=  ' ' as C3, 
SQL2_78=  ' ' as C4,
SQL2_79=  ' ' as C5,
SQL2_80=  ' ' as C6_VP, 
SQL2_81=  ' ' as C7_GD,
SQL2_82=  ' ' as C8_Panier, 
SQL2_83=  ' ' as C9_Absent,
SQL2_84=  ' ' as C10_CP,
SQL2_85=  " SQL_CASEWHEN "d.ID<'6'" SQL_THEN "'Absent'" SQL_ELSE "' '" SQL_CASEEND " as C11_Act,
SQL2_86=  ' ' as C12_Ville,
SQL2_87=  ' ' as C13_Client,
SQL2_88=  " SQL_CASEWHEN "d.ID<'6'" SQL_THEN "'Absence non d clar e'" SQL_ELSE "' '" SQL_CASEEND " as C14_Comments, d.Id as NumWeekDay
SQL2_89= FROM {/*OWNER*/}Alias d 
SQL2_90= WHERE d.Category='CALENDAR' and d.field='weekday' and d.ID>='1' and d.ID<='7' 
SQL2_91=  and not exists (select 1 from {/*OWNER*/}Calendar c where c.type='0' and c.Id=format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd') )
SQL2_92=  and not exists (select 1 from {/*OWNER*/}Resource_Date rd where rd.IdResource='{/*RESOURCEID*/}' and rd.DateResource=format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd') )
SQL2_93=  and not exists (select 1 from {/*OWNER*/}Resource_Absence ra where ra.IdResource='{/*RESOURCEID*/}' and ra.DateStart<=format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd') and format(DateAdd(" SQL_DATEPART_DAY ", d.ID-1, '{/*D1*/}'),'yyyy-MM-dd')<=ra.DateEnd )

SQL2_94= ORDER BY NumWeekDay ;
\n"),


@ ("DATA3=LIST\n"),
@ ("NAME3=List\n"),

@ ("
SQL3=SELECT distinct
SQL3_1=   DateAdd(" SQL_DATEPART_DAY ",1-numDay,numDate) as DATE1, DateAdd(" SQL_DATEPART_DAY ",7-numDay,numDate) as DATE2,
SQL3_2=   format(DateAdd(" SQL_DATEPART_DAY ",1-numDay,numDate),'dd/MM/yyyy') as STRDATE1, format(DateAdd(" SQL_DATEPART_DAY ",7-numDay,numDate),'dd/MM/yyyy') as STRDATE2,
SQL3_3=   format(DateAdd(" SQL_DATEPART_DAY ",1-numDay,numDate),'yyyy-MM-dd') as D1,
SQL3_4=   format(DateAdd(" SQL_DATEPART_DAY ",7-numDay,numDate),'yyyy-MM-dd') as D7,
SQL3_5=   IDR as RESOURCEID
SQL3_6= from (SELECT " SQL_DATESERIAL "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4), " SQL_SUBSTRING "('{/*PARAM4*/}',5,2), " SQL_SUBSTRING "('{/*PARAM4*/}',7,2)) as numDate, 
SQL3_7=   DatePart(" SQL_DATEPART_WEEKDAY ", " SQL_DATESERIAL "(" SQL_SUBSTRING "('{/*PARAM4*/}',1,4), " SQL_SUBSTRING "('{/*PARAM4*/}',5,2), " SQL_SUBSTRING "('{/*PARAM4*/}',7,2))"SQL_FIRSTWEEKDAY") as numDay,
SQL3_8=   r.ID as IDR
SQL3_9=  FROM {/*OWNER*/}Resource r
SQL3_10=  WHERE r.Id in ({/*PARAM5*/})
SQL3_11=) dat 
\n"),

@ ("
// FIELDS3=CODEPERIOD
// ITEM3=[BEG=\"(\"; END=\")\"; SEP=\",\"; RET=\",\"]
// TEXT3=({/*PARAM5*/})
\n"),

@ ("
[TABLE]

TABLECOUNT=1
\n"),

@ ("
TABLE1=Table(DATAOBJ=DATA2; RECT=(0 0 2770 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=PEN1; LINEHORZ=; LINEVERT=PEN1;
TABLE1_1=TITLE=\"" DOC_Title "\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
TABLE1_3=CX_VERTHDR=0; FONT_VERTHDR=; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR2; 
TABLE1_4=FIELDCOUNT=33; 
TABLE1_5=NAMES=(\"SITE\", \"" TAG_DRIVER "\", \"D1\", \"D2\", \"D3\", \"D4\", \"D5\", \"D6\", \"D7\", \"D8\", \"D9\", \"D10\", \"D11\", \"D12\", \"D13\", \"D14\", \"D15\", \"D16\", \"D17\", \"D18\", \"D19\", \"D20\", \"D21\", \"D22\", \"D23\", \"D24\", \"D25\", \"D26\", \"D27\", \"D28\", \"D29\", \"D30\", \"D31\"); 
TABLE1_6=WIDTHES=(200, 245, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75, 75); 
TABLE1_7=FONTS=(FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9, FONT9); 
TABLE1_8=TEXTALIGNS=(ALIGN2, ALIGN2, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5, ALIGN5); 
TABLE1_9=TEXTCOLORS=(COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1); 
TABLE1_10=FILLCOLORS=(COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4, COLOR4); 
TABLE1_11=FIELDS=(DATA2.1, DATA2.2, DATA2.3, DATA2.4, DATA2.5, DATA2.6, DATA2.7, DATA2.8, DATA2.9, DATA2.10, DATA2.11, DATA2.12, DATA2.13, DATA2.14, DATA2.15, DATA2.16, DATA2.17, DATA2.18, DATA2.19, DATA2.20, DATA2.21, DATA2.22, DATA2.23, DATA2.24, DATA2.25, DATA2.26, DATA2.27, DATA2.28, DATA2.29, DATA2.30, DATA2.31, DATA2.32, DATA2.33); 
TABLE1_12=)
\n"),

