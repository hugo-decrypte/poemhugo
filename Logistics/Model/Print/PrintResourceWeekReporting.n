@ ("
INSTR2=Text(0  0 2870  60, \"" TAG_PRINT_FULLNAME "\", FONT10, LEFT|VCENTER, COLOR1)
INSTR3=Text(500  0 2270  60, \"" TAG_PRINT_WEEK "\", FONT12, CENTER|VCENTER, COLOR1)

INSTR4=Line(0  60, 2770 60, PEN1); 
\n"),

@ ("
/////////////////////////////////////////////////////////////
INSTR5=TableEx(DATAOBJ=DATA1; RECT=0 100 2770 220; BORDERHORZ=PEN2; BORDERVERT=PEN2; LINEHORZ=; LINEVERT=; FILLCOLOR=COLOR6; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR5_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; 
INSTR5_2=TITLE=\"" DOC_Title "\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR5_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR5_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR5_5=FIELDCOUNT=29;
INSTR5_6=NAMES=(
INSTR5_7= FIELD1=[NAME=\"N1\",      RECT=(110     0    430   40),  FONT=10,ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1,  RPEN=1, TPEN=1, BPEN=1, TEXT=\"" TAG_WORKTIME "\"];
INSTR5_8= FIELD2=[NAME=\"N2\",      RECT=(430     0    880   40),  FONT=10,ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1,  RPEN=1, TPEN=1, BPEN=1, TEXT=\"" TAG_PRINT_TIMEOF "\"];
