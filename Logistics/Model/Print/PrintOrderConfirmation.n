// table infos lignes de commande 
INSTR5=Table(DATAOBJ=DATA3; RECT=0 500 1900 620; BORDERHORZ=PEN1; BORDERVERT=PEN1; LINEHORZ=PEN1; LINEVERT=PEN1; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR5_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=120;
INSTR5_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR5_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR5_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR5_5=FIELDCOUNT=24;
INSTR5_6=NAMES=(
INSTR5_7=FIELD1=[NAME=\"Ref\",     RECT=(0     0   250  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1,  BPEN=, TEXT=\" \"];
INSTR5_8=FIELD2=[NAME=\"Ref\",     RECT=(0    40   250  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, OBJ=DATA3.1];
INSTR5_9=FIELD3=[NAME=\"Ref\",     RECT=(0    80   250 120),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, TEXT=\" \"];
INSTR5_10=FIELD4=[NAME=\"Des\",    RECT=(250   0   900  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1,  BPEN=, TEXT=\" \"];
INSTR5_11=FIELD5=[NAME=\"Des\",    RECT=(250  40   900  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, OBJ=DATA3.2];
INSTR5_12=FIELD6=[NAME=\"Des\",    RECT=(250  80   900 120),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, TEXT=\" \"];
INSTR5_13=FIELD7=[NAME=\"Dat\",    RECT=(900   0  1080  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1,  BPEN=, OBJ=DATA3.3];
INSTR5_14=FIELD8=[NAME=\"Dat1\",   RECT=(900  40  1080  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, OBJ=DATA3.4];
INSTR5_15=FIELD9=[NAME=\"Dat2\",   RECT=(900  80  1080 120),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, OBJ=DATA3.5];
INSTR5_16=FIELD10=[NAME=\"Qty\",   RECT=(1080  0  1200  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1,  BPEN=, TEXT=\" \"];
INSTR5_17=FIELD11=[NAME=\"Qty\",   RECT=(1080 40  1200  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, OBJ=DATA3.6];
