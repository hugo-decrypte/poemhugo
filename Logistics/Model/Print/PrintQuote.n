'@' => (

	printFile = "/PrintQuote",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),

@ ("
////////////////////////////////////////////
////////////////////////////////////////////
// PARAMETRES
//\"DataPrint.exe\" \"DEPDIR/Print/PrintQuote.ini\" \"[DSN=GestionStock; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=Devis.pdf; XMLFILE=DevisTmp.txt]\" \"11020170131\"
// {/*PARAM0*/}  \"DataPrint.exe\" 
// {/*PARAM1*/}  file  INI
// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;
// {/*PARAM3*/}  print directery
// {/*PARAM4*/}  code quote
// {/*PARAM5*/}  user id
// {/*PARAM6*/}  pwd

//
//DSN=GestionStock
//USR= 
//PWD= 
//OWNER= 
////////////////////////////////////////////

\n"),

@ ("[HEADER]\n"),
@ ("VERSION=1.0\n"),
@ ("TITLE=Devis\n"),

%%TITLE="Devis",

 ['Work Directory' "Model\Print\PrintHeaderFooter.n"],

/*
HEADER1=Picture(200 60 490 185, PICTURE1)

// Label compagny
// adress
// post code, city
//Tél.  : 
//Email : 

// TITLE
// order no
// delivery date
// Reference

HEADER16=Line(110  400, 2000  400, PEN1);
*/


% [FOOTER]
/*
// Line
// PAGENUM
// compagny registre info 
// bank info 
// print date time
*/



@ ("[BACKGROUND]\n"),
@ ("\n\n"),


@ ("
[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
//OUTPUT=c:/DataPrint/TourneeVrac.xps
//OUTPUT=c:/DataPrint/TourneeVrac.pdf
//OUTPUT={/*PARAM4*/}

DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}TracePrintQuote.log

DOCNAME=Devis
PAGESIZE=A4
//LANDSCAPEMODE=1
LANDSCAPEMODE=0

PAGEWIDTH= 2100
PAGEHEIGHT= 2970
MARGIN=100 400 100 100

PAGENUMER=AUTO
PAGEBREAK=AUTO
\n"),

@ ("\n\n"),



%% [STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],
 
@ ("\n\n"),
@ ("
[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}Logo.jpg
\n\n"),

@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
PWD={/*PARAM6*/}
\n\n"),

@ ("
DATACOUNT=11
\n"),



%//////////////
%// agency info used in HEADER and FOOTER
%DATA1=MY_ADRESS
%NAME1=MYADRESS

 ['Work Directory' "Model\Print\PrintMyInfosData.n"],


@ ("\n\n"),



@ ("
//////////////
DATA2=SEL_OBJ
NAME2=Objet

SQL2=SELECT 
SQL2_1=   Q.Id as CODEQUOTE, 
SQL2_2=   Q.IdAgency as CODEAGENCY, 
SQL2_3=   CL.Id as CODECLIENT, 
SQL2_4=   CL.BankAccount as BANKACCOUNT, 
SQL2_5=   CL.Country as COUNTRY, 
SQL2_6=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Devis  '" SQL_ELSE "'Quote   '" SQL_CASEEND " as TITLEDOC,
SQL2_7=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'No : '" SQL_ELSE "'no : '" SQL_CASEEND " as TITLECODEOBJ,
SQL2_8=  Q.Id as CODEOBJ,
SQL2_9=   'Date : ' as TITLEDATEOBJ,
SQL2_10=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')"
				 SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(Q.DateQuote,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(Q.DateQuote,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(Q.DateQuote,1,4)" SQL_CONCATEND " "
				 SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(Q.DateQuote,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(Q.DateQuote,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(Q.DateQuote,9,2)" SQL_CONCATEND " "
			     SQL_CASEEND " as DATEOBJ,
SQL2_11=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')" SQL_THEN "'Client No : '" SQL_ELSE "'Client No : '" SQL_CASEEND " as TITLEREFERENCEOBJ,
SQL2_12=  Q.IdClient as REFERENCEOBJ,
SQL2_13=  ' ' as CODECLUB
SQL2_14= FROM {/*OWNER*/}QUOTE Q left join {/*OWNER*/}CLIENT CL on CL.Id=Q.IdClient
SQL2_15= WHERE Q.ID in ({/*PARAM4*/})
\n\n"),

@ ("\n"),


@ ("

DATA3=INFO_QUOTE
NAME3=InfoDevis

SQL3=SELECT DISTINCT
SQL3_1=   " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'N° Devis : '" SQL_ELSE "'Quote no : '" SQL_CASEEND " " SQL_CONCATWITH " Q.Id" SQL_CONCATEND "as IdFacture,
SQL3_2=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "" SQL_CONCAT "'Date Devis : ' " SQL_CONCATWITH " " SQL_FORMATDATE "(Q.DateQuote,'"SQL_FORMATDATE_D" ')" SQL_CONCATWITH " MI.NameFR " SQL_CONCATWITH " ' ' " SQL_CONCATWITH " " SQL_FORMATDATE "(Q.DateQuote, '"SQL_FORMATDATE_Y"') " SQL_CONCATEND "
SQL3_3=    " SQL_ELSE "" SQL_CONCAT "'Date quote : ' " SQL_CONCATWITH " MI.NameEN " SQL_CONCATWITH "' '" SQL_CONCATWITH " " SQL_FORMATDATE "(Q.DateQuote,'"SQL_FORMATDATE_D", "SQL_FORMATDATE_Y"')" SQL_CONCATEND "" SQL_CASEEND " as DateFact,
SQL3_4=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "" SQL_CONCAT "'Devis valable jusqu''au : ' " SQL_CONCATWITH " " SQL_FORMATDATE "(Q.DateValid, '"SQL_FORMATDATE_D" ') " SQL_CONCATWITH " MP.NameFR " SQL_CONCATWITH "' '" SQL_CONCATWITH " " SQL_FORMATDATE "(Q.DateValid, '"SQL_FORMATDATE_Y"')" SQL_CONCATEND "
SQL3_5=    " SQL_ELSE "" SQL_CONCAT "'Quote valid until : '" SQL_CONCATWITH " MP.NameEN " SQL_CONCATWITH "' '" SQL_CONCATWITH " " SQL_FORMATDATE "(Q.DateValid, '"SQL_FORMATDATE_D", "SQL_FORMATDATE_Y"')" SQL_CONCATEND "" SQL_CASEEND " as DateMaxPayment,
SQL3_6=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Adresse de livraison'" SQL_ELSE "'Shipping adress'" SQL_CASEEND " as TitleAdressDeliv, 
SQL3_7=   PT.NameClient as PtDeliv, 

SQL3_8=   PT.Address as AddresDeliv, 
SQL3_9=   PT.AddressSup as AddresSupDeliv, 
SQL3_10=  " SQL_CONCAT "TRIM(PT.PostCode) " SQL_CONCATWITH " '   ' " SQL_CONCATWITH " PT.City" SQL_CONCATEND "as PostCodeCityDeliv, 
SQL3_11=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "' '" SQL_ELSE "CL.Country" SQL_CASEEND " as CountryDeliv,

SQL3_12=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Adresse de facturation'" SQL_ELSE "'Billing adress'" SQL_CASEEND " as TitleAdressFact, 
SQL3_13=   CL.Name as NameFact, 

SQL3_14=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Service comptabilité '" SQL_ELSE "'Accountant department'" SQL_CASEEND " as Compta,
SQL3_15=   CL.Address as AddresFact, 
SQL3_16=   CL.AddressSup as AddresSupFact, 
SQL3_17=   " SQL_CONCAT "TRIM(CL.PostCode) " SQL_CONCATWITH " '   ' " SQL_CONCATWITH " CL.City" SQL_CONCATEND "as PostCodeCityFact, 
SQL3_18=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "' '" SQL_ELSE "CL.Country" SQL_CASEEND " as Country,

SQL3_19=  " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Référence : '" SQL_ELSE "'Our reference: '" SQL_CASEEND " " SQL_CONCATWITH "Q.Reference" SQL_CONCATEND "as ReferenceDeliv,
SQL3_20=  " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'N° TVA : '  " SQL_ELSE "'Customer VAT no.: '" SQL_CASEEND " " SQL_CONCATWITH " " SQL_CASEWHEN "CL.codeTax is NULL" SQL_THEN "' '" SQL_ELSE "CL.codeTax" SQL_CASEEND "" SQL_CONCATEND "as TVANo,

SQL3_21=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "' Règlement de facture à 30 jours date de facture, fin du mois'" SQL_ELSE "'Terms of sale: 30 days, date of invoice'" SQL_CASEEND " as REGL_C19,
SQL3_22=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "' '" SQL_ELSE "'Exonération de T.V.A. Article 262 TER-l du CGI'" SQL_CASEEND " as REGL_C20,
SQL3_23=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Règlement de facture : '" SQL_ELSE "'Terms of sale: '" SQL_CASEEND " as REGL_C21,
SQL3_24=  Q.Comments as REGL_C22,
SQL3_25=  " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN " 'Suivi par : '" SQL_ELSE "'Followed by: '" SQL_CASEEND " " SQL_CONCATWITH " " SQL_CASEWHEN "Q.FollowedBy is NULL" SQL_THEN "' '" SQL_ELSE "Q.FollowedBy" SQL_CASEEND "" SQL_CONCATEND "as FollowedBy,

SQL3_26=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Devis'" SQL_ELSE "'Quote'" SQL_CASEEND " as TITLE

SQL3_27=FROM {/*OWNER*/}QUOTE Q, {/*OWNER*/}CLIENT CL, {/*OWNER*/}POINTDELIVERY PT, {/*OWNER*/}MONTHLABEL MI, {/*OWNER*/}MONTHLABEL MP
SQL3_28=WHERE CL.Id=Q.IdClient 
SQL3_29=  AND PT.IdClient=Q.IdClient AND PT.IdPoint=Q.IdPointDelivery
SQL3_30=  AND MI.NoMonth="SQL_SUBSTRING"(Q.DateQuote,6,2)+0
SQL3_31=  AND MP.NoMonth="SQL_SUBSTRING"(Q.DateValid,6,2)+0
SQL3_32=  AND Q.Id='{/*CODEQUOTE*/}'
\n\n"),


@ ("

//////////////
DATA4=LINE_FACT_COLHEAD
NAME4=LINEFACTCOLHEAD

SQL4=SELECT DISTINCT
SQL4_1=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Désignation'" SQL_ELSE "'Description'" SQL_CASEEND " as Design,
SQL4_2=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Quantité'" SQL_ELSE "'Quantity'" SQL_CASEEND " as Qty,
SQL4_3=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Prix'" SQL_ELSE "'Price'" SQL_CASEEND " as Price,
SQL4_4=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Remise'" SQL_ELSE "'Discount'" SQL_CASEEND " as Remise,
SQL4_5=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Montant HT'" SQL_ELSE "'Amount'" SQL_CASEEND " as Amount,
SQL4_6=   " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'TVA'" SQL_ELSE "'VAT'" SQL_CASEEND " as TVA
SQL4_7= FROM {/*OWNER*/}QUOTE Q, {/*OWNER*/}CLIENT CL
SQL4_8= WHERE CL.Id=Q.IdClient
SQL4_9=  AND Q.Id='{/*CODEQUOTE*/}' 
\n\n"),


@ ("
DATA5=LINEQUOTE
NAME5=LineQuote

SQL5=SELECT 
SQL5_1=   P.Designation as Design,
SQL5_2=   " SQL_FORMATNUM "(LQ.Quantity, "SQL_FORMATSCALE0") as QTY,
SQL5_3=   " SQL_CONCAT "" SQL_FORMATNUM "(LQ.PriceUnit,"SQL_FORMATSCALE2") " SQL_CONCATWITH " ' ' " SQL_CONCATWITH " " SQL_CASEWHEN "Q.Currency is NULL or Q.Currency<=' '" SQL_THEN "'€'" SQL_ELSE "trim(Q.Currency)" SQL_CASEEND "" SQL_CONCATEND "as PriceUnit,
SQL5_4=   " SQL_CASEWHEN "LQ.Discount<>0" SQL_THEN "" SQL_CONCAT "" SQL_FORMATNUM "(LQ.Discount,"SQL_FORMATSCALE1")" SQL_CONCATWITH "'% '" SQL_CONCATEND "" SQL_ELSE "' '" SQL_CASEEND " as Dis,
SQL5_5=   " SQL_CONCAT "" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "" SQL_FORMATNUM "(LQ.PriceUnit*(LQ.Quantity*(100.0-LQ.Discount)/100.0),"SQL_FORMATSCALE2")" SQL_ELSE "" SQL_FORMATNUM "(LQ.PriceUnit*(LQ.Quantity),"SQL_FORMATSCALE2")" SQL_CASEEND " " SQL_CONCATWITH " ' € '" SQL_CONCATEND "as PriceTotal,
SQL5_6=   LQ.IdVAT,
SQL5_7=   P.ID as Product, P.TypeProduct, P.Family
SQL5_8=FROM {/*OWNER*/}QUOTE_PRODUCT LQ, {/*OWNER*/}QUOTE Q, {/*OWNER*/}PRODUCT P
SQL5_9=WHERE P.ID=LQ.IdProduct AND LQ.IdQuote=Q.Id and LQ.IdQuote='{/*CODEQUOTE*/}' 
SQL5_10=ORDER BY P.TypeProduct desc, P.Family, P.Designation, P.Id
\n\n"),


@ ("
// line total 
DATA6=TOTALQUOTE
NAME6=TotalQuote

SQL6=SELECT 
SQL6_1=   'TOTAL' as Design,
SQL6_2=   " SQL_FORMATNUM "(sum(LQ.Quantity), "SQL_FORMATSCALE0") as QTY,
SQL6_3=   ' ' as PriceUnit,
SQL6_4=   ' ' as Discount,
SQL6_5=   " SQL_CONCAT "" SQL_FORMATNUM "(sum( (LQ.PriceUnit*LQ.Quantity*(100.0-" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "LQ.Discount" SQL_ELSE "0.00" SQL_CASEEND "))/100.0), "SQL_FORMATSCALE2") " SQL_CONCATWITH " ' € '" SQL_CONCATEND "as PriceTotal,
SQL6_6=   ' ' as IdVAT
SQL6_7=FROM {/*OWNER*/}QUOTE_PRODUCT LQ, {/*OWNER*/}QUOTE Q, {/*OWNER*/}PRODUCT P
SQL6_8=WHERE P.ID=LQ.IdProduct AND LQ.IdQuote=Q.Id and LQ.IdQuote='{/*CODEQUOTE*/}' 
\n\n"),


@ ("
// table total title
DATA7=TOTAL_TITLE
NAME7=TOTALTITLE

SQL7=SELECT DISTINCT
SQL7_1=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'TOTAL HT'   " SQL_ELSE "'TOTAL H.T.'" SQL_CASEEND " as C1, 
SQL7_2=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'TOTAL TVA'  " SQL_ELSE "'TOTAL V.A.T.'" SQL_CASEEND " as C2,
SQL7_3=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'TOTAL TTC'  " SQL_ELSE "'TOTAL PRICE'" SQL_CASEEND " as C3, 
SQL7_4=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'NET A PAYER'" SQL_ELSE "'NET TO PAY'" SQL_CASEEND " as C4,

SQL7_5=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Code' " SQL_ELSE "'Code'" SQL_CASEEND " as C5,
SQL7_6=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Base' " SQL_ELSE "'Base'" SQL_CASEEND " as C6,
SQL7_7=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Taux' " SQL_ELSE "'Rate'" SQL_CASEEND " as C7,
SQL7_8=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Taxe' " SQL_ELSE "'Tax'"  SQL_CASEEND " as C8

SQL7_9= FROM {/*OWNER*/}QUOTE Q, {/*OWNER*/}CLIENT CL
SQL7_10= WHERE CL.Id=Q.IdClient AND Q.Id='{/*CODEQUOTE*/}' 
\n\n"),

%% SQL7_12=  " SQL_CONCAT "" SQL_CASEWHEN "tabTVA.MinTVA=tabTVA.MaxTVA" SQL_THEN "" SQL_FORMATNUM "(tabTVA.MaxTVA,"SQL_FORMATSCALE2")" SQL_ELSE "'xx'" SQL_CASEEND "" SQL_CONCATWITH " ' %'" SQL_CONCATEND "as TVA,


@ ("
// table total
DATA8=TOTAL
NAME8=TOTAL

SQL8=SELECT DISTINCT
SQL8_1=  " SQL_CONCAT "" SQL_FORMATNUM "(Q.AmountHT*" SQL_CASEWHEN "Q.Discount is NULL" SQL_THEN "100" SQL_ELSE "(100-Q.Discount)" SQL_CASEEND "/100.0, "SQL_FORMATSCALE2") " SQL_CONCATWITH " ' € '" SQL_CONCATEND "as PriceHT,
SQL8_2=  " SQL_CONCAT "" SQL_FORMATNUM "(tabTVA.TotalTVA*(100.0-" SQL_CASEWHEN "Q.Discount is not NULL and Q.Discount<>0" SQL_THEN "Q.Discount" SQL_ELSE "0.00" SQL_CASEEND ")/100.0, "SQL_FORMATSCALE2") " SQL_CONCATWITH " ' € '" SQL_CONCATEND "as PriceTVA,
SQL8_3=  " SQL_CONCAT "" SQL_FORMATNUM "((tabTVA.TotalTVA+Q.AmountHT)*(100.0-" SQL_CASEWHEN "Q.Discount is not NULL and Q.Discount<>0" SQL_THEN "Q.Discount" SQL_ELSE "0.00" SQL_CASEEND ")/100.0, "SQL_FORMATSCALE2")" SQL_CONCATWITH " ' € '" SQL_CONCATEND "as PriceTotal,
SQL8_4=  " SQL_CONCAT "" SQL_FORMATNUM "((tabTVA.TotalTVA+Q.AmountHT)*(100.0-" SQL_CASEWHEN "Q.Discount is not NULL and Q.Discount<>0" SQL_THEN "Q.Discount" SQL_ELSE "0.00" SQL_CASEEND ")/100.0, "SQL_FORMATSCALE2")" SQL_CONCATWITH " ' € '" SQL_CONCATEND "as NetPay

SQL8_5= FROM {/*OWNER*/}QUOTE Q, {/*OWNER*/}CLIENT CL,
SQL8_6=   (SELECT DISTINCT 
SQL8_7=      LQ.IdQuote as IdLD, min(T.VAT) as MinTVA, max(T.VAT) as MaxTVA,
SQL8_8=      sum(LQ.PriceUnit*LQ.Quantity*(100.0-" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "LQ.Discount" SQL_ELSE "0.00" SQL_CASEEND ")/100.0*T.VAT/100.0) as TotalTVA 
SQL8_9=    FROM {/*OWNER*/}QUOTE_PRODUCT LQ, {/*OWNER*/}VAT T 
SQL8_10=    WHERE T.Id=LQ.IdVAT AND LQ.IdQuote='{/*CODEQUOTE*/}' 
SQL8_11=    Group by LQ.IdQuote ) tabTVA
SQL8_12= WHERE CL.Id=Q.IdClient and tabTVA.IdLD=Q.Id AND Q.Id='{/*CODEQUOTE*/}' 
\n\n"),

%% SQL8_5=  " SQL_CONCAT "" SQL_CASEWHEN "tabTVA.MinTVA=tabTVA.MaxTVA" SQL_THEN "" SQL_FORMATNUM "(tabTVA.MaxTVA,"SQL_FORMATSCALE2")" SQL_ELSE "'xx'" SQL_CASEEND "" SQL_CONCATWITH " ' %'" SQL_CONCATEND "as TVA,

@ ("

//////
//  calcul des TVA par code et la totale
DATA9=TVA
NAME9=TVA

SQL9=SELECT TITLE, QTY, Price, AmountTVA, LAB from
SQL9_1=(SELECT DISTINCT T.Id as \"TITLE\",
SQL9_2=  " SQL_FORMATNUM "(sum(round(LQ.PriceUnit*LQ.Quantity*(100.0-" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "LQ.Discount" SQL_ELSE "0.00" SQL_CASEEND "),0))/100.0, "SQL_FORMATSCALE2") as QTY, 
SQL9_3=  " SQL_FORMATNUM "(T.VAT, "SQL_FORMATSCALE2")+ '% ' as Price,
SQL9_4=  " SQL_FORMATNUM "(round(sum(round(LQ.PriceUnit*LQ.Quantity*(100.0-" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "LQ.Discount" SQL_ELSE "0.00" SQL_CASEEND "),0)/100.0)*T.VAT, 0)/100.0, "SQL_FORMATSCALE2") as AmountTVA, 1 as LAB
SQL9_5= FROM {/*OWNER*/}QUOTE Q,{/*OWNER*/}QUOTE_PRODUCT LQ, {/*OWNER*/}VAT T, {/*OWNER*/}CLIENT CL
SQL9_6= WHERE Q.Id=LQ.IdQuote and T.Id=LQ.IdVAT and CL.Id=Q.IdClient and CL.Country in ('France','FRANCE')
SQL9_7=    AND LQ.IdQuote='{/*CODEQUOTE*/}'
SQL9_8= Group BY T.Id,T.VAT) t

SQL9_9=UNION ALL (SELECT DISTINCT " SQL_CASEWHEN "CL.Country in ('France','FRANCE')" SQL_THEN " 'Total'" SQL_ELSE "CL.Country" SQL_CASEEND " as TITLE,
SQL9_10=  " SQL_FORMATNUM "(sum(round(LQ.PriceUnit*LQ.Quantity*(100.0-" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "LQ.Discount" SQL_ELSE "0.00" SQL_CASEEND "), 0))/100.0, "SQL_FORMATSCALE2") as QTY, 
SQL9_11=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')" SQL_THEN "' '" SQL_ELSE "CL.Country" SQL_CASEEND " as Price,
SQL9_12=  " SQL_FORMATNUM "(round(sum(round(LQ.PriceUnit*LQ.Quantity*(100.0-" SQL_CASEWHEN "LQ.Discount is not NULL and LQ.Discount<>0" SQL_THEN "LQ.Discount" SQL_ELSE "0.00" SQL_CASEEND "), 0)/100.0*T.VAT),0)/100.0, "SQL_FORMATSCALE2") as AmountTVA, count(1) as LAB
SQL9_13= FROM {/*OWNER*/}QUOTE Q,{/*OWNER*/}QUOTE_PRODUCT LQ, {/*OWNER*/}VAT T, {/*OWNER*/}CLIENT CL
SQL9_14= WHERE Q.Id=LQ.IdQuote and T.Id=LQ.IdVAT and CL.Id=Q.IdClient and CL.Country in ('France','FRANCE') and LQ.IdQuote='{/*CODEQUOTE*/}'
SQL9_15=    AND (select count(1) from (select distinct LQ0.IdVAT from {/*OWNER*/}QUOTE_PRODUCT LQ0 where LQ0.IdQuote='{/*CODEQUOTE*/}') num)>1
SQL9_16= GROUP BY CL.Country)
\n\n"),


@ ("

//////////////
DATA10=LINE_CUSTOMINFO
NAME10=LINECUSTOMINFO

SQL10=SELECT 
SQL10_1=   Q.CustomsInfo as C_Comment,
SQL10_2=   '0' as NoL
SQL10_3= FROM {/*OWNER*/}QUOTE Q
SQL10_4= WHERE Q.Id='{/*CODEQUOTE*/}' and Q.CustomsInfo is not NULL and Q.CustomsInfo>' '

SQL10_5= UNION ALL SELECT 
SQL10_6=   " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Réalisation par '" SQL_ELSE "'Realized by '" SQL_CASEEND " " SQL_CONCATWITH " Q.ProductCondition" SQL_CONCATEND "as C_Comment,
SQL10_7=   '1' as NoL
SQL10_8= FROM {/*OWNER*/}QUOTE Q left join {/*OWNER*/}CLIENT CL on CL.Id=Q.IdClient
SQL10_9= WHERE Q.Id='{/*CODEQUOTE*/}' and Q.ProductCondition is not NULL and Q.ProductCondition>' '

SQL10_10=UNION ALL SELECT 
SQL10_11=   " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Conditionnement : '" SQL_ELSE "'Packaging : '" SQL_CASEEND " " SQL_CONCATWITH " Q.Packaging" SQL_CONCATEND "as C_Comment,
SQL10_12=   '2' as NoL
SQL10_13=FROM {/*OWNER*/}QUOTE Q left join {/*OWNER*/}CLIENT CL on CL.Id=Q.IdClient
SQL10_14=WHERE Q.Id='{/*CODEQUOTE*/}' and Q.PayCondition is not NULL and Q.PayCondition>' '

SQL10_15=UNION ALL SELECT 
SQL10_16=   " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Règles de transport : '" SQL_ELSE "'Transport rules : '" SQL_CASEEND " " SQL_CONCATWITH " Q.Incoterm" SQL_CONCATEND "as C_Comment,
SQL10_17=   '3' as NoL
SQL10_18=FROM {/*OWNER*/}QUOTE Q left join {/*OWNER*/}CLIENT CL on CL.Id=Q.IdClient
SQL10_19=WHERE Q.Id='{/*CODEQUOTE*/}' and Q.Incoterm is not NULL and Q.Incoterm>' '

SQL10_20=UNION ALL SELECT 
SQL10_21=   " SQL_CONCAT "" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Mode de règlement : '" SQL_ELSE "'Method of payment : '" SQL_CASEEND " " SQL_CONCATWITH " Q.PayCondition" SQL_CONCATEND "as C_Comment,
SQL10_22=   '4' as NoL
SQL10_23=FROM {/*OWNER*/}QUOTE Q left join {/*OWNER*/}CLIENT CL on CL.Id=Q.IdClient
SQL10_24=WHERE Q.Id='{/*CODEQUOTE*/}' and Q.PayCondition is not NULL and Q.PayCondition>' '

SQL10_25=UNION ALL SELECT 
SQL10_26=   Q.Comments as C_Comment,
SQL10_27=   '5' as NoL
SQL10_28=FROM {/*OWNER*/}QUOTE Q left join {/*OWNER*/}CLIENT CL on CL.Id=Q.IdClient
SQL10_29=WHERE Q.Id='{/*CODEQUOTE*/}' and Q.Comments is not NULL and Q.Comments>' '

SQL10_30=UNION (SELECT DISTINCT
SQL10_31=  'Exonération de T.V.A. Article 262 TER-l du CGI' as C_Comment,
SQL10_32=  ' ' as NoL 
SQL10_33= FROM {/*OWNER*/}QUOTE Q, {/*OWNER*/}CLIENT CL
SQL10_34= WHERE CL.Id=Q.IdClient and CL.Country not in ('France','FRANCE')
SQL10_35=    AND Q.Id='{/*CODEQUOTE*/}' )

SQL10_36=ORDER BY NoL
\n\n"),


@ ("

//////////////
DATA11=SIGNING
NAME11=Singing

SQL11=SELECT 
SQL11_1=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN " 'Bon pour commande'" SQL_ELSE "'Accepted for Order'" SQL_CASEEND " as Acceptation,
SQL11_2=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN " 'Date : '" SQL_ELSE "'Date :'" SQL_CASEEND " as SigningDate,
SQL11_3=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN " 'Signature '" SQL_ELSE "'Signing'" SQL_CASEEND " as Signing,
SQL11_4=  ' ' as B1,
SQL11_5=  ' ' as B2,
SQL11_6=  '' as B3,
SQL11_7=  ' ' as B4,
SQL11_8=  ' ' as B5,
SQL11_9=  ' ' as B6,
SQL11_10= '' as B7
SQL11_11=FROM {/*OWNER*/}QUOTE Q, {/*OWNER*/}CLIENT CL
SQL11_12=WHERE CL.Id=Q.IdClient 
SQL11_13=  AND Q.Id='{/*CODEQUOTE*/}'
\n\n"),


@ ("

