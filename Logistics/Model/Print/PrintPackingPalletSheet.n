INSTR3_17=FIELD12=[NAME=\"DAT\",RECT=(410  500  1900 560),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.9];
INSTR3_18=FIELD13=[NAME=\"DIM\",RECT=(710  440  1000 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"Dimension :\"];
INSTR3_19=FIELD14=[NAME=\"DIM\",RECT=(950  440  1900 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.10];
