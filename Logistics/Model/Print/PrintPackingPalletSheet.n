INSTR3_12=FIELD7=[NAME=\"PAL\", RECT=(1100 100  1600 200),  FONT=5, ALIGN=8, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, TEXT=\"NO. Palette : \"];
