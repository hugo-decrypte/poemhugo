@ ("

/////////////////////////////////////////////////////////////
// table infos livraisons 
INSTR5=TableEx(DATAOBJ=DATA6; RECT=0 660 2700 740; BORDERHORZ=PEN1; BORDERVERT=PEN1; LINEHORZ=PEN1; LINEVERT=PEN1; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR5_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=80;
INSTR5_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR5_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR5_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 

INSTR5_5=FIELDCOUNT=9;
INSTR5_6=FIELD1=[NAME=\"NoLot\",         RECT=(0     0   210  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"No Lot\"];
INSTR5_7=FIELD2=[NAME=\"DateLC\",        RECT=(210   0   450  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Date LC\"];
INSTR5_8=FIELD3=[NAME=\"Article\",       RECT=(450   0   650  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Article\"];
INSTR5_9=FIELD4=[NAME=\"Description\",   RECT=(650   0  1400  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Description\"];
INSTR5_10=FIELD5=[NAME=\"Order\",        RECT=(1400  0  1580  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Commande\"];
INSTR5_11=FIELD6=[NAME=\"Quantity(PCS)\",RECT=(1580  0  1720  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Quantité\"];
