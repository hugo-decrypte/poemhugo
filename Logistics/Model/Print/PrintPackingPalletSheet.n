%% 2025.09.04
%% NumTVA = > codeTax
%% Siret  = > establishment


'@' => (

	printFile = "/PrintPackingPalletSheet",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),

@ ("
////////////////////////////////////////////
////////////////////////////////////////////
// PARAMETRES
//\"DataPrint.exe\" \"DEPDIR/Print/PrintPackingPalletSheet.ini\" \"[DSN=Logistics; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=Delivery.pdf; XMLFILE=DeliveryTmp.txt]\" \"11020170131\"
// {/*PARAM0*/}  \"DataPrint.exe\" 
// {/*PARAM1*/}  fichier  INI
// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;
// {/*PARAM3*/}  print directery
// {/*PARAM4*/}  code delivery
// {/*PARAM5*/}  user id

//DSN=Logistics
//USR= 
//PWD= 
//OWNER= 

\n"),


@ ("
[HEADER]
VERSION=1.0
TITLE=Fiche Palette

//PAGENUM=Text(0 70 2000 120, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT5, RIGHT|VCENTER, COLOR1)

// TITLE
//HEADER1=Text(0 70 2000 120, \"Palettes\", FONT4, CENTER|VCENTER, COLOR1)


// Societe
// 2888 * 1245 : 290 120
HEADER1=Picture(200 60 490 185, PICTURE1)

// Label compagny,
HEADER2=Text(120  190 1000 230, {/*DATA1.2.1*/}, FONT10, LEFT|VCENTER, COLOR1)
// adress
HEADER3=Text(120  240 1000 270, \"{/*DATA1.3.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER4=Text(120  270 1000 300, \"{/*DATA1.4.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
// post code, city
HEADER5=Text(120  300 1000 330, \"{/*DATA1.5.1*/}  {/*DATA1.6.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER6=Text(120  330 1000 360, \"{/*DATA1.7.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER7=Text(500  270 1200 300, \"Tél.  : {/*DATA1.8.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER8=Text(500  300 1200 330, \"Email : {/*DATA1.10.1*/}\", FONT16, LEFT|VCENTER, COLOR1)


// TITLE
HEADER9=Text(1100 120 1950 200, \"{/*DATA1.19.1*/}\", FONT5, CENTER|VCENTER, COLOR1)

// Lot no
HEADER10=Text(1100 200 1600 260, \"{/*DATA1.20.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)
HEADER11=Text(1610 200 1950 260, \"{/*DATA1.21.1*/}\", FONT6, LEFT|VCENTER, COLOR1)
// date
HEADER12=Text(1100 260 1600 320, \"{/*DATA1.22.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)
HEADER13=Text(1610 260 1950 320, \"{/*DATA1.23.1*/}\", FONT6, LEFT|VCENTER, COLOR1)
// Reference
HEADER14=Text(1100 320 1600 380, \"{/*DATA1.24.1*/}\", FONT6, RIGHT|VCENTER, COLOR1)
HEADER15=Text(1610 320 1950 380, \"{/*DATA1.25.1*/}\", FONT6, LEFT|VCENTER, COLOR1)

HEADER16=Line(110  400, 2000  400, PEN1)
////////////////
\n\n"),


@ ("
[FOOTER]
PAGENUM=Text(1200 0 2100 50, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT9, RIGHT|VCENTER, COLOR1)
FOOTER1=Text(0 50 2000 80, \"{/*DATA1.18.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
FOOTER2=Line(0 0,1900  0, PEN1)
\n\n"),


@ ("[BACKGROUND]\n"),


@ ("[BACKGROUND]\n"),

@ ("[CONFIG]\n"),

@ ("PRINTERTYPE=1\n"),
@ ("//DEVICENAME=PDF Architect Driver\n"),
@ ("//DEVICENAME=PDFCreator\n"),
@ ("//DEVICENAME=WIN2PDF\n"),
@ ("//DEVICENAME=Microsoft XPS Document Writer\n"),
@ ("//OUTPUT=c:/DataPrint/PalletPacking.xps\n"),
@ ("//OUTPUT=c:/DataPrint/PalletPacking.pdf\n"),
@ ("//OUTPUT={/*PARAM4*/}\n"),
@ ("\n"),

@ ("DEBUG=0\n"),
@ ("TRACEDATA=1\n"),
@ ("TRACESYS=1\n"),
@ ("TRACESCRIPT=1\n"),
@ ("TRACEFILE={/*PARAM3*/}/TracePrintPackingPalletSheet.log\n"),


@ ("DOCNAME=Fiche Palette\n"),
@ ("PAGESIZE=A4\n"),
@ ("//LANDSCAPEMODE= ( 0 : portrai; 1 : paysage)\n"),
@ ("LANDSCAPEMODE=0\n"),

@ ("PAGEWIDTH= 2100\n"),
@ ("PAGEHEIGHT= 2970\n"),
@ ("MARGIN=100 400 100 100\n"),
@ ("PAGENUMER=AUTO\n"),
@ ("PAGEBREAK=AUTO\n"),
@ ("\n"),



%% [STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],



@ ("
[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}/Logo.jpg
\n\n"),


@ ("
[DATA]
//DSN={/*PARAM6*/}
//USR={/*PARAM7*/}
//PWD={/*PARAM8*/}
//OWNER=
PWD={/*PARAM6*/}
\n\n"),


@ ("
DATACOUNT=6
\n\n"),


%//////////////
%// agency info used in HEADER and FOOTER
%DATA1=MY_ADRESS
%NAME1=MYADRESS

 ['Work Directory' "Model\Print\PrintMyInfosData.n"],

@ ("// compagny Registre info in FOOTER\n"),
@ ("\n\n"),



@ ("
DATA2=OBJ_DATA
NAME2=OBJ_DATA


SQL2=SELECT 
SQL2_1=   PK.Id as CODEPACKING, PL.NoPallet as NOPALLET,
SQL2_2=   PK.IdAgency as CODEAGENCY, 
SQL2_3=   PK.NbPallet as Nb, 
SQL2_4=   ' ' as BANKACCOUNT, 
SQL2_5=   PK.Country as COUNTRY, 
SQL2_6=  " SQL_CASEWHEN "PK.Country='France'" SQL_THEN "'Palette en Stock  '" SQL_ELSE "'Pallet in stock  '" SQL_CASEEND "  as TITLEDOC,
SQL2_7=  " SQL_CASEWHEN "PK.Country='France'" SQL_THEN "'Entrée No : '" SQL_ELSE "'Checkin no : '" SQL_CASEEND " as TITLECODEOBJ,
SQL2_8=  PK.Id as CODEOBJ,
SQL2_9=   'Date : ' as TITLEDATEOBJ,
SQL2_10=  " SQL_CASEWHEN "PK.Country in ('France','FRANCE')"
				SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(PK.DateDelivery,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(PK.DateDelivery,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(PK.DateDelivery,1,4)" SQL_CONCATEND " "
				SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(PK.DateDelivery,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(PK.DateDelivery,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(PK.DateDelivery,9,2)" SQL_CONCATEND " "
			SQL_CASEEND " as DATEOBJ,
SQL2_11=  " SQL_CASEWHEN "PK.Country in ('France','FRANCE')" SQL_THEN "'Réception : '" SQL_ELSE "'Received By : '" SQL_CASEEND " as TITLEREFERENCEOBJ,
SQL2_12=  PK.ReceivedBy as REFERENCEOBJ,
SQL2_13=  ' ' as CODECLUB
SQL2_14= FROM {/*OWNER*/}PACKING PK inner join {/*OWNER*/}PALLET PL  on PK.Id=PL.IdPacking
SQL2_15= WHERE PK.ID in ({/*PARAM4*/})
"),


%% concat
@ ("
DATA3=INFO_DELIVERY
NAME3=InfoDelivery

SQL3=SELECT 
SQL3_1=   NoLot, DateExpiration, PRODUCT, 
SQL3_2=   DescriArticle,
SQL3_3=   Cmd,
SQL3_4=   " SQL_FORMATNUM "(QTY,"SQL_FORMATSCALE0"),
SQL3_5=   " SQL_FORMATNUM "(NW,"SQL_FORMATSCALE1")
SQL3_6= FROM (SELECT
SQL3_7=   P.ID as PRODUCT, 
SQL3_8=   P.Designation as DescriArticle,
SQL3_9=   ' ' as Cmd,
SQL3_10=   sum(LP.Quantity) as QTY,
SQL3_11=   " SQL_CASEWHEN "LP.NoLot is not NULL and LP.NoLot>' '" SQL_THEN "LP.NoLot" SQL_ELSE " " SQL_CASEWHEN "LP.DateCreate is not NULL and LP.DateCreate >'0'" SQL_THEN "" SQL_FORMATDATE "(LP.DateCreate,'"SQL_FORMATDATESTR"')" SQL_ELSE "' '" SQL_CASEEND " " SQL_CASEEND " as NoLot,
SQL3_12=   " SQL_CASEWHEN "LP.DateExpiration is not NULL and LP.DateExpiration>0" SQL_THEN " " SQL_FORMATDATE "(LP.DateExpiration,'"SQL_FORMATDATESTR"')" SQL_ELSE "' '" SQL_CASEEND " as DateExpiration,
SQL3_13=   P.Weight*sum(LP.Quantity) as NW 
SQL3_14= FROM (({/*OWNER*/}PACKING PK
SQL3_15=  inner join {/*OWNER*/}PALLET PL on PK.Id=PL.IdPacking)
SQL3_16=  inner join {/*OWNER*/}PALLET_PRODUCT LP on LP.IdPacking=PL.IdPacking and LP.NoPallet=PL.NoPallet)
SQL3_17=  inner join {/*OWNER*/}PRODUCT P on P.ID=LP.IdProduct
SQL3_18= WHERE P.TypeProduct<>'F' 
SQL3_19=   AND PK.Id='{/*CODEPACKING*/}'
SQL3_20=   and PL.NoPallet={/*NOPALLET*/}
SQL3_21= Group BY P.ID, P.Designation, P.Weight, LP.IdProduct,LP.NoLot, LP.DateCreate, LP.DateExpiration
SQL3_22= ORDER BY LP.IdProduct) t
\n\n"),



@ ("
//////////////
DATA4=INFO_ORDERS
NAME4=INFOORDERS

SQL4=SELECT DISTINCT
SQL4_1=   LD.IdPacking as C1,
SQL4_2=   ' ' as C2,
SQL4_3=   ' ' as C3,
SQL4_4=   ' ' as C4,
SQL4_5=   LD.IdOrder as CMD5,
SQL4_6=   LD.Quantity as QTY6,
SQL4_7=   ' ' as C7,
SQL4_8=   ' ' as C8,
SQL4_9=   ' ' as C9,
SQL4_10=   ' ' as C10,
SQL4_11=   ' ' as C11
SQL4_12= FROM {/*OWNER*/}PALLET_PRODUCT LP
SQL4_13= WHERE LP.IdPacking='{/*PACKING*/}'
SQL4_14=   AND LP.NoPallet={/*PALETTE*/} AND LP.IdProduct='{/*PRODUCT*/}'
\n\n"),


@ ("
DATA5=LINE_TOTAL
NAME5=LINETOTAL

SQL5=SELECT DISTINCT 'TOTAL' as Col6, sum(QTY_C9) as Col9, round(sum(C10)) as Col10, round(sum(C11)) as Col11
SQL5_1=   FROM (SELECT PL.IdPacking, PL.NoPallet,
SQL5_2=   sum(LP.Quantity) as QTY_C9,
SQL5_3=   sum(P.Weight*LP.Quantity) as C10, 
SQL5_4=   sum(P.Weight*LP.Quantity)+ " SQL_CASEWHEN "PL.WeightPallet is NULL" SQL_THEN "30" SQL_ELSE "PL.WeightPallet" SQL_CASEEND " as C11
SQL5_5= FROM (({/*OWNER*/}PALLET PL inner join {/*OWNER*/}PALLET_PRODUCT LP on PL.IdPacking=LP.IdPacking and PL.NoPallet=LP.NoPallet)
SQL5_6=   inner join {/*OWNER*/}PRODUCT P on P.ID=LP.IdProduct) 
SQL5_7= WHERE P.TypeProduct<>'F' 
SQL5_8=   AND PL.IdPacking='{/*CODEPACKING*/}' and PL.NoPallet={/*NOPALLET*/}
SQL5_9= GROUP BY PL.IdPacking, PL.NoPallet, PL.WeightPallet) t
\n\n"),


@ ("

DATA6=ADDRESS_DELIV
NAME6=AddressDeliv

SQL6=SELECT DISTINCT
SQL6_1=   " SQL_CASEWHEN "PK.Country='France'" SQL_THEN "'Adresse départ'" SQL_ELSE "'Shipping adress'" SQL_CASEEND " as TitleAdressDeliv, 
SQL6_2=   PK.IdSender as PtDeliv, 
SQL6_3=   PK.ReceivedBy as AddresDeliv, 
SQL6_4=   PK.ShipmentPort as AddresSupDeliv, 
SQL6_5=   PK.ShipNo as PostCodeCityDeliv, 
SQL6_6=   " SQL_CASEWHEN "PK.Country='France'" SQL_THEN "' '" SQL_ELSE "PK.Country" SQL_CASEEND " as CountryDeliv,
SQL6_7=   PK.Id as IdDelivery,
SQL6_8=   "SQL_CONCAT"'{/*NOPALLET*/} ('"SQL_CONCATWITH"(select " SQL_FORMATNUM "(count(1),"SQL_FORMATSCALE0") from {/*OWNER*/}PALLET PL0 where PL0.IdPacking=PK.Id and PL0.NoPallet<={/*NOPALLET*/} )"SQL_CONCATWITH"' / ' "SQL_CONCATWITH" (select " SQL_FORMATNUM "(count(1), "SQL_FORMATSCALE0") from {/*OWNER*/}PALLET PL0 where PL0.IdPacking=PK.Id) "SQL_CONCATWITH" ')'"SQL_CONCATEND" as NoP,
SQL6_9=   " SQL_FORMATDATE "(PL.DatePreparation,'"SQL_FORMATDATE_FR"') as DateModif ,
SQL6_10=  "SQL_CONCAT"" SQL_FORMATNUM "(PL.Length,"SQL_FORMATSCALE0")"SQL_CONCATWITH"' x '"SQL_CONCATWITH"" SQL_FORMATNUM "(PL.Width,"SQL_FORMATSCALE0")"SQL_CONCATWITH"' x '"SQL_CONCATWITH"" SQL_FORMATNUM "(PL.Height,"SQL_FORMATSCALE0")"SQL_CONCATWITH"' cm'"SQL_CONCATEND"  as Dimension,
SQL6_11=  "SQL_CONCAT"" SQL_FORMATNUM "(PL.WeightNet,"SQL_FORMATSCALE0")"SQL_CONCATWITH"' KG') as WN, "SQL_CONCAT"" SQL_FORMATNUM "(" SQL_CASEWHEN "PL.WeightGlobal is NULL or PL.WeightGlobal<PL.WeightNet" SQL_THEN "PL.WeightNet+30" SQL_ELSE "PL.WeightGlobal" SQL_CASEEND ","SQL_FORMATSCALE0")"SQL_CONCATWITH"' KG'"SQL_CONCATEND"  as WG,
SQL6_12=  " SQL_FORMATDATE "(PK.DateDelivery,'"SQL_FORMATDATE_FR"') as DateDeliv 
SQL6_13= FROM {/*OWNER*/}PACKING PK , {/*OWNER*/}PALLET PL
SQL6_14= WHERE PK.Id=PL.IdPacking 
SQL6_15=  AND PK.Id='{/*CODEPACKING*/}'
SQL6_16=  AND PL.NoPallet={/*NOPALLET*/}
\n\n"),





@ ("
[TABLE]

TABLECOUNT=1

TABLE1=Table(DATAOBJ=DATA4; RECT=(0 0 1900 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=;
TABLE1_1=TITLE=\"Produits Client\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
