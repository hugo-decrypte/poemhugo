INSTR3_15=FIELD10=[NAME=\"BL\", RECT=(410  440  1900 500),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA6.7];
