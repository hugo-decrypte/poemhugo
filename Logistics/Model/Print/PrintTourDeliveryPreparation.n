\n\n"),



@ ("
[SCRIPT]

DATAOBJ=DATA2

INSTRCOUNT=9
\n\n"),



@ ("
//INSTR1=StartDoc

INSTR1=StartPage 1

INSTR2=Text(10 30 500  40, \" \", FONT9, LEFT|VCENTER, COLOR1)

// table  adresses livraisons 
INSTR3=Table(DATAOBJ=DATA3; RECT=10 0 _ _; BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR3_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=60;
INSTR3_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR3_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR3_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 
INSTR3_5=FIELDCOUNT=6;
INSTR3_6=FIELD1=[NAME=\"Tit\",  RECT=(300    0  1900  40),  FONT=4, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.1];
INSTR3_7=FIELD2=[NAME=\"Nom\",  RECT=(300  100  1900 160),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.2];
INSTR3_8=FIELD3=[NAME=\"Add\",  RECT=(300  160  1900 220),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.3];
INSTR3_9=FIELD4=[NAME=\"Ad1\",  RECT=(300  220  1900 280),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.4];
INSTR3_10=FIELD5=[NAME=\"CPC\", RECT=(300  280  1900 340),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.5];
INSTR3_11=FIELD6=[NAME=\"CTR\", RECT=(300  340  1900 400),  FONT=5, ALIGN=2, TCOLOR=1, FCOLOR=4, LPEN=,  RPEN=,  TPEN=,  BPEN=, OBJ=DATA3.6];
INSTR3_12=)
\n\n"),



@ ("
/////////////////////////////////////////////////////////////////////

INSTR4=Line(10  421, 2870  421, PEN1); 
\n\n"),



@ ("
/////////////////////////////////////////////////////////////
// table infos livraisons 
INSTR5=TableEx(DATAOBJ=DATA3; RECT=0 500 2870 580; BORDERHORZ=PEN1; BORDERVERT=PEN1; LINEHORZ=PEN1; LINEVERT=PEN1; FILLCOLOR=COLOR5; FONT=FONT9; TEXT_COLOR=(100 0 0); 
INSTR5_1=CY_TITLE=0; CY_HORZHDR=0; CX_VERTHDR=0; CY_ROW=80;
INSTR5_2=TITLE=\"TOUR INFO\"; FONT_TITLE=FONT1; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;
INSTR5_3=FONT_HORZHDR=FONT9; ALIGN_HORZHDR=CENTER|VCENTER; COLOR_HORZHDR=COLOR1; LINEHORZ_HORZHDR=; 
INSTR5_4=FONT_VERTHDR=FONT9; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR1; LINEVERT_VERTHDR=; 

INSTR5_5=FIELDCOUNT=16;
INSTR5_6=FIELD1=[NAME=\"Mark & Nos\",     RECT=(0     0   150  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Entrée\"];
INSTR5_7=FIELD2=[NAME=\"Mark & Nos\",     RECT=(0    40   150  80),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=,  BPEN=, TEXT=\"No.\"];
INSTR5_8=FIELD3=[NAME=\"No palette\",     RECT=(150   0   260  40),  FONT=9, ALIGN=5, TCOLOR=1, FCOLOR=4, LPEN=1, RPEN=, TPEN=1, BPEN=, TEXT=\"Palette\"];
