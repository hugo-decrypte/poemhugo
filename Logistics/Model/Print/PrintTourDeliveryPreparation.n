%% 2025.09.30  select obj condition :
%% SQL2_15= WHERE D.IdTour in ({/*PARAM4*/})


'@' => (

	printFile = "/PrintTourDeliveryPreparation",
	[serverPrintPath printFile ".ini"] <- '@',

	("printFile=" serverPrintPath printFile ".ini" : ),

@ ("
////////////////////////////////////////////
////////////////////////////////////////////
// PARAMETRES
//\"DataPrint.exe\" \"APPDIR/PrintTourDeliveryPreparation.ini\" \"[DSN=GestionStock; DBUSR=; DBPWD=; OWNER=; DEVICENAME=WIN2PDF; OUTPUT=Delivery.pdf; XMLFILE=DeliveryTmp.txt]\" \"11020170131\"
// {/*PARAM0*/}  \"DataPrint.exe\" 
// {/*PARAM1*/}  \" \" fichier  INI
// {/*PARAM2*/}  \"[DSN= ; DBUSR= ; DBPWD=; OWNER= ; DEVICENAME= ; OUTPUT= ; XMLFILE= ]\"  les options separes par ;
// {/*PARAM3*/}  print directery
// {/*PARAM4*/}  code delivery
// {/*PARAM5*/}  user id
//
//DSN=GestionStock
//USR= 
//PWD= 
//OWNER= 
////////////////////////////////////////////

\n\n"),


@ ("[HEADER]\n"),
@ ("VERSION=1.0\n"),
@ ("TITLE=Preparation de livraison\n"),

@ ("
//PAGENUM=Text(0 70 2000 120, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT5, RIGHT|VCENTER, COLOR1)

// TITLE
//HEADER1=Text(0 70 2000 120, \"Bon de livraion {/*DATA1.2.1*/}({/*DATA1.1.1*/}) client {/*DATA1.10.1*/}\", FONT4, CENTER|VCENTER, COLOR1)

// Societe
// logo.jpg 1368 x 264 : 1100 x 212 290*125 435*190; 
HEADER1=Picture(200 60 490 185, PICTURE1)

HEADER2=Text(120  190 2000 230, {/*DATA1.2.1*/}, FONT10, LEFT|VCENTER, COLOR1)
HEADER3=Text(120  240 1000 270, \"{/*DATA1.3.1*/}, {/*DATA1.4.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER4=Text(120  270 1000 300, \"{/*DATA1.5.1*/}  {/*DATA1.6.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER5=Text(120  300 2000 330, \"{/*DATA1.7.1*/}\", FONT16, LEFT|VCENTER, COLOR1)

HEADER6=Text(920  210 2000 240, \"Tél.  : {/*DATA1.8.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER7=Text(920  240 2000 270, \"Email : {/*DATA1.10.1*/}\", FONT16, LEFT|VCENTER, COLOR1)
HEADER8=Text(920  270 2900 300, \"{/*DATA3.11.1*/}\", FONT16, LEFT|VCENTER, COLOR1)

HEADER9=Text(1100 120 2900 200, \"Préparation de Livraison\", FONT5, RIGHT|VCENTER, COLOR1)
HEADER10=Text(1100 200 2900 280, \"N° {/*DATA3.7.1*/}\", FONT5, RIGHT|VCENTER, COLOR1)
HEADER11=Text(1100 280 2900 360, \"Date de Livraison : {/*DATA3.8.1*/}\", FONT5, RIGHT|VCENTER, COLOR1)

HEADER12=Line(100  380, 2900  380, PEN1); 


[FOOTER]
PAGENUM=Text(1200 0 2900 50, \"page {/*PAGENUM*/}/{/*PAGECOUNT*/}\", FONT9, RIGHT|VCENTER, COLOR1)
FOOTER1=Text(0 0 2800 50, \"{/*DATA1.11.1*/}   {/*DATA1.12.1*/}\", FONT10, CENTER|VCENTER, COLOR1)
FOOTER2=Text(0 50 2900 80, \"{/*DATA1.18.1*/}\", FONT16, RIGHT|VCENTER, COLOR1)
FOOTER3=Line(0 0,2770  0, PEN1); 
\n\n"),


@ ("
[BACKGROUND]

[CONFIG]

PRINTERTYPE=1
//DEVICENAME=PDF Architect Driver
//DEVICENAME=PDFCreator
//DEVICENAME=WIN2PDF
//DEVICENAME=Microsoft XPS Document Writer
//OUTPUT=c:/DataPrint/TourneeVrac.xps
//OUTPUT=c:/DataPrint/TourneeVrac.pdf
//OUTPUT={/*PARAM4*/}

DEBUG=0
TRACEDATA=1
TRACESYS=1
TRACESCRIPT=1
TRACEFILE={/*PARAM3*/}/TracePrintTourDeliveryPreparation.log

DOCNAME=Feuille de livraison
PAGESIZE=A4
//LANDSCAPEMODE= ( 0 : portrai; 1 : paysage)
LANDSCAPEMODE=1

PAGEWIDTH= 2970
PAGEHEIGHT= 2100
MARGIN=100 450 100 100
PAGENUMER=AUTO
PAGEBREAK=AUTO
\n\n"),

%[STYLE]
 ['Work Directory' "Model\Print\PrintStyleConfig.n"],


@ ("\n\n"),
@ ("
[PICTURE]
PICTURECOUNT=1
PICTURE1={/*PARAM3*/}/Logo.jpg
\n\n"),

@ ("
[DATA]
//DSN=
//USR=
//PWD=
//OWNER=
PWD={/*PARAM6*/}
\n\n"),

@ ("
DATACOUNT=6
\n\n"),


%//////////////
%// agency info used in HEADER and FOOTER
%DATA1=MY_ADRESS
%NAME1=MYADRESS

 ['Work Directory' "Model\Print\PrintMyInfosData.n"],


@ ("\n\n"),



@ ("
//////////////
DATA2=SEL_OBJ
NAME2=Objet

SQL2=SELECT 
SQL2_1=   D.ID as CODEDELIVERY, 
SQL2_2=   D.IdAgency as CODEAGENCY, 
SQL2_3=   CL.Id as CODECLIENT, 
SQL2_4=   CL.BankAccount as BANKACCOUNT, 
SQL2_5=   CL.Country as COUNTRY, 
SQL2_6=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Préparation de livraison  '" SQL_ELSE "'Delivery preparation   '" SQL_CASEEND " as TITLEDOC,
SQL2_7=  " SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'No : '" SQL_ELSE "'no : '" SQL_CASEEND " as TITLECODEOBJ,
SQL2_8=  D.Id as CODEOBJ,
SQL2_9=   'Date : ' as TITLEDATEOBJ,
SQL2_10=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')"
				 SQL_THEN " " SQL_CONCAT " " SQL_SUBSTRING "(D.DateDelivery,9,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,6,2)" SQL_CONCATWITH "'/'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,1,4)" SQL_CONCATEND " "
				 SQL_ELSE " " SQL_CONCAT " " SQL_SUBSTRING "(D.DateDelivery,1,4)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,6,2)" SQL_CONCATWITH "'-'" SQL_CONCATWITH "" SQL_SUBSTRING "(D.DateDelivery,9,2)" SQL_CONCATEND " "
			     SQL_CASEEND " as DATEOBJ,
SQL2_11=  " SQL_CASEWHEN "CL.Country in ('France','FRANCE')" SQL_THEN "'Client No : '" SQL_ELSE "'Client No : '" SQL_CASEEND " as TITLEREFERENCEOBJ,
SQL2_12=  D.IdClient as REFERENCEOBJ,
SQL2_13=  ' ' as CODECLUB
SQL2_14= FROM {/*OWNER*/}DELIVERY D left join {/*OWNER*/}CLIENT CL on CL.Id=D.IdClient
SQL2_15= WHERE D.IdTour in ({/*PARAM4*/})
\n\n"),



@ ("
// Addres Delivery
// INSTR3

DATA3=ADDRESS_DELIV
NAME3=AddressDeliv

SQL3=SELECT DISTINCT
SQL3_1=   (" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Adresse de livraison'" SQL_ELSE " 'Shipping adress'" SQL_CASEEND ") as TitleAdressDeliv, 
SQL3_2=   PT.NameClient as PtDeliv, 
SQL3_3=   PT.Address as AddresDeliv, 
SQL3_4=   PT.AddressSup as AddresSupDeliv, 
SQL3_5=   TRIM(PT.PostCode) + '   ' + PT.City as PostCodeCityDeliv, 
SQL3_6=   (" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "' '" SQL_ELSE "CL.Country" SQL_CASEEND ") as CountryDeliv,
SQL3_7=   D.ID as IdDelivery,
SQL3_8=   "SQL_FORMATDATE"(D.DateDelivery,'"SQL_FORMATDATE_FR"') as DateDeliv ,
SQL3_9=   D.IdPacking as Packing,
SQL3_10=  (select IdSender from PACKING P where P.Id=D.IdPacking) as Sender,
SQL3_11=  "SQL_CONCAT"(" SQL_CASEWHEN "CL.Country='France'" SQL_THEN "'Suivi par : '" SQL_ELSE "'Followed by: '" SQL_CASEEND ")"SQL_CONCATWITH"(" SQL_CASEWHEN "D.FollowedBy is NULL" SQL_THEN "' '" SQL_ELSE "D.FollowedBy" SQL_CASEEND ")"SQL_CONCATEND"  as FollowedBy
SQL3_12= FROM {/*OWNER*/}DELIVERY D , {/*OWNER*/}CLIENT CL, {/*OWNER*/}POINTDELIVERY PT
SQL3_13= WHERE CL.Id=D.IdClient
SQL3_14=  AND PT.IdClient=D.IdClient AND PT.IdPoint=D.IdPointDelivery
SQL3_15= AND D.ID='{/*CODEDELIVERY*/}'
\n\n"),



@ ("
// detail delivery 
// INSTR4, INSTR5

DATA4=INFO_DELIVERY
NAME4=InfoDelivery

SQL4=SELECT 
SQL4_1=   PACKING as C1, 
SQL4_2=   PALETTE as C2, 
SQL4_3=   PRODUCT as C3, 
SQL4_4=   DESIGNATION as C4,
SQL4_5=   Cmd,
SQL4_6=   QTY,
SQL4_7=   NW as C7, 
SQL4_8=   GW as C8,
SQL4_9=   L as C9, 
SQL4_10=  W as C10, 
SQL4_11=  H as C11, PalletDelivery as C12
SQL4_12= FROM (SELECT
SQL4_13=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND (LD1.IdProduct<LD.IdProduct or (LD1.IdProduct=LD.IdProduct and LD1.IdOrder<LD.IdOrder)))" SQL_THEN "' '" SQL_ELSE "LD.IdPacking" SQL_CASEEND ") as PACKING, 
SQL4_14=   LD.IdDelivery as IdDelivery, 
SQL4_15=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND (LD1.IdProduct<LD.IdProduct or (LD1.IdProduct=LD.IdProduct and LD1.IdOrder<LD.IdOrder)))" SQL_THEN "' '" SQL_ELSE "LD.NoPallet" SQL_CASEEND ") as PALETTE, 
SQL4_16=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND LD1.IdProduct=LD.IdProduct AND LD1.IdOrder<LD.IdOrder)" SQL_THEN "' '" SQL_ELSE "A.ID" SQL_CASEEND ") as PRODUCT, 
SQL4_17=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND LD1.IdProduct=LD.IdProduct AND LD1.IdOrder<LD.IdOrder)" SQL_THEN "' '" SQL_ELSE "A.Designation" SQL_CASEEND ") as DESIGNATION,
SQL4_18=   LD.IdOrder as Cmd,
SQL4_19=   "SQL_FORMATNUM"(LD.Quantity,"SQL_FORMATSCALE0") as QTY,
SQL4_20=   "SQL_FORMATNUM"(A.Weight*LD.Quantity, "SQL_FORMATSCALE1") as NW, 
SQL4_21=   (" SQL_CASEWHEN "P.WeightGlobal is NULL and D.WeightPallet is NULL" SQL_THEN "'PN + 30'" SQL_ELSE " " SQL_CASEWHEN "D.WeightPallet is NULL" SQL_THEN ""SQL_CONCAT"'PN + '"SQL_CONCATWITH""SQL_FORMATNUM"(D.WeightPallet,"SQL_FORMATSCALE0")"SQL_CONCATEND"" SQL_ELSE ""SQL_FORMATNUM"(P.WeightGlobal,"SQL_FORMATSCALE0")" SQL_CASEEND " " SQL_CASEEND ") as GW,
SQL4_22=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND (LD1.IdProduct<LD.IdProduct or (LD1.IdProduct=LD.IdProduct and LD1.IdOrder<LD.IdOrder)))" SQL_THEN "' '" SQL_ELSE "round(P.Length)" SQL_CASEEND ") as L, 
SQL4_23=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND (LD1.IdProduct<LD.IdProduct or (LD1.IdProduct=LD.IdProduct and LD1.IdOrder<LD.IdOrder)))" SQL_THEN "' '" SQL_ELSE "round(P.Width)" SQL_CASEEND ") as W, 
SQL4_24=   (" SQL_CASEWHEN "exists (select 1 from {/*OWNER*/}DELIVERY_PRODUCT LD1 where LD1.IdDelivery=LD.IdDelivery AND LD1.IdPacking=LD.IdPacking AND LD1.NoPallet=LD.NoPallet AND (LD1.IdProduct<LD.IdProduct or (LD1.IdProduct=LD.IdProduct and LD1.IdOrder<LD.IdOrder)))" SQL_THEN "' '" SQL_ELSE "round(P.Height)" SQL_CASEEND ") as H,
SQL4_25=   LD.IdPacking as IDPACKING, 
SQL4_26=   LD.NoPallet as NoPALETTE, 
SQL4_27=   A.ID as IdPRODUCT, 
SQL4_28=  LD.NoPalletDelivery as PalletDelivery
SQL4_29= FROM (({/*OWNER*/}DELIVERY D inner join {/*OWNER*/}DELIVERY_PRODUCT LD on D.ID=LD.IdDelivery)
SQL4_30=   inner join {/*OWNER*/}PRODUCT A on A.ID=LD.IdProduct)
SQL4_31=   left join {/*OWNER*/}PALLET P on P.IdPacking=LD.IdPacking AND P.NoPallet=LD.NoPallet
SQL4_32= WHERE A.TypeProduct='P'
SQL4_33=   AND LD.IdDelivery='{/*CODEDELIVERY*/}'
SQL4_34= ) t
SQL4_35= ORDER BY IdPACKING, NoPALETTE, IdProduct, Cmd
\n\n"),



@ ("
////////////// not used
DATA5=INFO_ORDERS
NAME5=INFOORDERS

SQL5=SELECT DISTINCT
SQL5_1=   LD.IdPacking as C1,
SQL5_2=   ' ' as C2,
SQL5_3=   ' ' as C3,
SQL5_4=   ' ' as C4,
SQL5_5=   LD.IdOrder as CMD5,
SQL5_6=   LD.Quantity as QTY6,
SQL5_7=   ' ' as C7,
SQL5_8=   ' ' as C8,
SQL5_9=   ' ' as C9,
SQL5_10=   ' ' as C10,
SQL5_11=   ' ' as C11
SQL5_12= FROM {/*OWNER*/}DELIVERY_PRODUCT LD
SQL5_13= WHERE LD.IdDelivery='{/*CODEDELIVERY*/}'
SQL5_14=   AND LD.IdPacking='{/*PACKING*/}' AND LD.NoPallet={/*PALETTE*/} AND LD.IdProduct='{/*PRODUCT*/}' 
SQL5_15=   AND LD.IdOrder>= (select min(LD1.IdOrder) from {/*OWNER*/}DELIVERY_PRODUCT LD1
SQL5_16=      WHERE LD1.IdDelivery='{/*CODEDELIVERY*/}'
SQL5_17=       AND LD1.IdPacking='{/*PACKING*/}' AND LD1.NoPallet={/*PALETTE*/} AND LD1.IdProduct='{/*PRODUCT*/}'
SQL5_18=    )
SQL5_19= ORDER BY LD.IdOrder
\n\n"),



@ ("
DATA6=LINE_TOTAL
NAME6=LINETOTAL

SQL6=SELECT DISTINCT 'TOTAL' as Col6, sum(QTY_C9) as Col9, round(sum(C10)) as Col10, round(sum(C11)) as Col11, count(1) as Col12_NbPallet
SQL6_1= FROM (SELECT LD.IdPacking, LD.NoPallet,
SQL6_2=   sum(LD.Quantity) as QTY_C9,
SQL6_3=   sum(A.Weight*LD.Quantity) as C10, 
SQL6_4=   sum(A.Weight*LD.Quantity)+ (" SQL_CASEWHEN "P.WeightGlobal is NULL and D.WeightPallet is NULL" SQL_THEN "30" SQL_ELSE " " SQL_CASEWHEN "D.WeightPallet is not NULL" SQL_THEN "min(D.WeightPallet)" SQL_ELSE "min(P.WeightGlobal)-min(P.WeightNet)" SQL_CASEEND " " SQL_CASEEND ") as C11
SQL6_5=  FROM (({/*OWNER*/}DELIVERY D inner join {/*OWNER*/}DELIVERY_PRODUCT LD on D.ID=LD.IdDelivery)
SQL6_6=   inner join {/*OWNER*/}PRODUCT A on A.ID=LD.IdProduct) 
SQL6_7=   LEFT JOIN {/*OWNER*/}PALLET P on P.IdPacking=LD.IdPacking AND P.NoPallet=LD.NoPallet
SQL6_8=  WHERE A.TypeProduct='P' and LD.NoPalletDelivery is NULL
SQL6_9=   AND D.ID='{/*CODEDELIVERY*/}' 
SQL6_10= GROUP BY LD.IdPacking, LD.NoPallet, P.WeightGlobal, D.WeightPallet
SQL6_11= UNION ALL SELECT LD.IdDelivery, LD.NoPalletDelivery,
SQL6_12=   sum(LD.Quantity) as QTY_C9,
SQL6_13=   sum(A.Weight*LD.Quantity) as C10, 
SQL6_14=   sum(A.Weight*LD.Quantity)+ (" SQL_CASEWHEN "P.WeightGlobal is NULL and D.WeightPallet is NULL" SQL_THEN "30" SQL_ELSE " " SQL_CASEWHEN "D.WeightPallet is not NULL" SQL_THEN "min(D.WeightPallet)" SQL_ELSE "min(P.WeightGlobal)-min(P.WeightNet)" SQL_CASEEND " " SQL_CASEEND ") as C11
SQL6_15= FROM (({/*OWNER*/}DELIVERY D inner join {/*OWNER*/}DELIVERY_PRODUCT LD on D.ID=LD.IdDelivery)
SQL6_16=   inner join {/*OWNER*/}PRODUCT A on A.ID=LD.IdProduct) 
SQL6_17=   LEFT JOIN {/*OWNER*/}PALLET P on P.IdPacking=LD.IdDelivery AND P.NoPallet=LD.NoPalletDelivery
SQL6_18= WHERE A.TypeProduct='P' and LD.NoPalletDelivery is not NULL
SQL6_19=   AND D.ID='{/*CODEDELIVERY*/}'
SQL6_20= GROUP BY LD.IdDelivery, LD.NoPalletDelivery, P.WeightGlobal, D.WeightPallet) t
\n\n"),



@ ("

[TABLE]

TABLECOUNT=1

TABLE1=Table(DATAOBJ=DATA5; RECT=(0 0 1900 _); FONT=FONT5; TEXT_COLOR=(100 0 0); BORDERHORZ=; BORDERVERT=; LINEHORZ=; LINEVERT=;
TABLE1_1=TITLE=\"Produits Client\"; FONT_TITLE=FONT9; ALIGN_TITLE=CENTER|VCENTER; COLOR_TITLE=COLOR1;CY_TITLE=0;
TABLE1_2=CY_HORZHDR=0; FONT_HORZHDR=FONT9; ALIGN_HORZHDR=ALIGN5; COLOR_HORZHDR=COLOR2; 
TABLE1_3=CX_VERTHDR=0; FONT_VERTHDR=; ALIGN_VERTHDR=CENTER|VCENTER; COLOR_VERTHDR=COLOR2; 
TABLE1_4=CY_ROW=50;
TABLE1_5=FIELDCOUNT=11; 
TABLE1_6=NAMES=(\"Mark\", \"pale\", \"Art\", \"desc\", \"Order\", \"Qty\", \"NW\", \"GW\", \"L\", \"W\", \"H\"); 
TABLE1_7=WIDTHES=(150, 110, 190, 550, 180, 130, 140, 150, 100, 100, 100); 
TABLE1_8=FONTS=(FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9,FONT9); 
TABLE1_9=TEXTALIGNS=(ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2, ALIGN2); 
TABLE1_10=TEXTCOLORS=(COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1, COLOR1); 
TABLE1_11=FILLCOLORS=(COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5, COLOR5); 
TABLE1_12=FIELDS=(DATA5.1, DATA5.2, DATA5.3, DATA5.4, DATA5.5, DATA5.6, DATA5.7, DATA5.8, DATA5.9, DATA5.10, DATA5.11); 
TABLE1_13=)
\n\n"),



@ ("

