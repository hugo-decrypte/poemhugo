['Work Directory' "Model\Common\Config\ReadUserLogin.n"],
['Work Directory' "Model\Common\Config\ReadConfigLogin.n"],

['Work Directory' "Model\Common\Config\ReadConfigDate.n"],
['Work Directory' "Model\Common\Config\ReadDateTime.n"],

['Work Directory' "Model\Input\Vehicle\ReadVehicle.n"],
['Work Directory' "Model\Input\Vehicle\ReadResource.n"],

['Work Directory' "Model\Input\Depot\ReadDepot.n"],
['Work Directory' "Model\Input\Product\ReadProduct.n"],


%1   3   "D2312010"   "30P01"   1 
%1   2   "21P02"   1



'()' => (
	% idOrder, idVehicle, idxTour
	nbSelected = (),

	( TAG_SELECTION_ERROR :
		nbSelected > 0,
	),

	nbParameterOrder = (),

	\forall i \in [1, nbSelected] (
		idOrderSelected_{i}		:: "",
		idVehicle1Selected_{i}		:: "",
		idxTourVehicle1Selected_{i}	:: 0,

		idOrderSelected_{i}		= (),
		idVehicle1Selected_{i}		= (),
		idxTourVehicle1Selected_{i}	= (),
	),


	% idVehicle, idxTour
	nbTourSelected = (),

	( TAG_SELECTION_ERROR :
		nbTourSelected > 0,
	),

	nbParameterTour = (),

	idVehicle2Selected		:: "",
	idxTourVehicle2Selected		:: 0,

	idVehicle2Selected		= (),
	idxTourVehicle2Selected		= (),
),


['Work Directory' "Model\Interaction\Solver\Order\MoveOrder.n"],


