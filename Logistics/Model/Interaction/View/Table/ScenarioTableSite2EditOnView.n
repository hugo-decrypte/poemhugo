% Script
@ "Script ",

% ID
@ "SelectDeselect ",

% Caption
@ (" '" TAG_SELECT_DESELECT "' "),	

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,


% Label
@ (" '" TAG_SELECT_DESELECT "' "),



% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableSITE' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)

sqlSiteSelected = (
	"UPDATE " DB_PREFIX "SITE s SET s.selected="
		SQL_CASEWHEN "s.selected IS NULL OR s.selected='" STATE_FALSE "'"
			SQL_THEN "'" STATE_TRUE "'"
			SQL_ELSE "'" STATE_FALSE "'"
		SQL_CASEEND
),

SetSelected_SQL1=(
	"\"" sqlSiteSelected " WHERE s.id in ([/*SITE.ID*/]) \"\n\n\n"
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Site\SelectDeselectSite.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableSITE;1;(string,ID))*/}  \\\n"),
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ SetSelected_SQL1,
),


% BUG ????????
@ ("\n//The reload does not run, bug comview \n"),
@ ("//Script SetSelected  'Selectionner' _ 1 'Selectionner' _ 'tableSITE' '( 0 0 0 0 )' _ _ _  '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
@ ("//\"UPDATE SITE s set s.selected='1' WHERE s.id='[/*SITE.ID*/]'\" \\\n"),
@ ("Reload _ _ _ \n\n\n"),



.



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Script
@ "Script ",

% ID
@ "SetUnSelected ",

% Caption
@ (" '" TAG_DESELECT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW2,


% Label
@ (" '" TAG_DESELECT "' "),	



% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableSITE' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)

SetUnSelected_SQL1=(
	"\"UPDATE " DB_PREFIX "SITE s SET s.selected='' WHERE s.id in ([/*SITE.ID*/]) \"\n\n\n"
),
? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Site\SetUnSelected.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableSITE;1;(string,ID))*/}  \\\n"),
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ SetUnSelected_SQL1,
),


