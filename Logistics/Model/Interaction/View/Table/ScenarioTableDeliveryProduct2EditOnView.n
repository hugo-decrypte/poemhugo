		set DP.IdVAT=P.IdVAT\
		where DP.IdDelivery in ('[/*DELIVERY.ID*/]')\
		and (DP.IdVAT is NULL or DP.IdVAT<= ' ') \"\\\n"
	),
	

	%% DELIVERY_PRODUCT amount HT VAT
	UpdateDeliveryDiscount_SQL4 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP set DP.AmountHT = round(DP.QuantityReal*DP.PriceUnit*(100.0-DP.Discount))/100.0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]')\
		and "idDeliveryOrderProductLineCondition" \"\\\n"
	),
	UpdateDeliveryDiscount_SQL5 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "VAT t on t.Id=DP.IdVAT\
		set DP.AmountVAT= round(DP.AmountHT*t.VAT)/100.0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]')\"\\\n"
	),
	
	%% DELIVERY amount HT VAT
	UpdateDeliveryDiscount_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountHT=0, AmountVAT=0  WHERE ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY D inner join " DB_PREFIX "DELIVERY_PRODUCT DP on D.ID=DP.IdDelivery set\
			D.AmountHT=D.AmountHT+DP.AmountHT,\
			D.AmountVAT=D.AmountVAT+DP.AmountVAT\
		WHERE D.ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountTotal = AmountHT + AmountVAT  WHERE ID in ('[/*DELIVERY.ID*/]')\"\\\n"
	),

	;
 
	%% idVAT from PRODUCT if NULL
	UpdateDeliveryDiscount_SQL3 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT \
		set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct)\
		where IdDelivery in ('[/*DELIVERY.ID*/]')\
		and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
	),
	

	%% DELIVERY_PRODUCT amount HT VAT
	UpdateDeliveryDiscount_SQL4 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set AmountHT = round(QuantityReal*PriceUnit*(100.0-Discount))/100.0\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\
		and "idDeliveryOrderProductLineCondition" \"\\\n"
	),
	UpdateDeliveryDiscount_SQL5 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT \
		set AmountVAT= (select round(AmountHT*t.VAT)/100.0 from " DB_PREFIX "VAT t where t.Id=IdVAT)\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\"\\\n"
	),
	
	%% DELIVERY amount HT VAT
	UpdateDeliveryDiscount_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY set\
		AmountHT=(select sum(DP.AmountHT) from " DB_PREFIX "DELIVERY_PRODUCT DP where ID=DP.IdDelivery),\
		AmountVAT=(select sum(DP.AmountVAT) from " DB_PREFIX "DELIVERY_PRODUCT DP where ID=DP.IdDelivery)\
		WHERE ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountHT=0  WHERE ID in ('[/*DELIVERY.ID*/]') and AmountHT is NULL \"\\\n"
	),
	UpdateDeliveryDiscount_SQL8 = (
