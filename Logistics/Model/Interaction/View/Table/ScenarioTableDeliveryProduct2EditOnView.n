%======================================================================================================
%
@ "//3. modify price\n",


% Script
@ "Script ",

% ID
@ "ModifyPriceUnit ",

% Caption
@ (" '" TAG_UPDATE_UNIT_PRICE "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW3,

% Label
@ (" '" TAG_UPDATE_UNIT_PRICE "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableDELIVERYPRODUCT' ", % JZ 1018

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
UpdateDeliveryPrice_Input = (
	"{/*Input(MPU;" TAG_UPDATE_UNIT_PRICE ";1;\\\n"
	"(float,PRICE," TAG_PRICE_UNIT ",[/*DELIVERY.PRICE*/],10.4.580,0);\\\n"
	")*/}\\\n"
),

UpdateDeliveryPrice_SQL1 = (
	"\"Update " DB_PREFIX "DELIVERY_PRODUCT set PriceUnit=[/*PRICE*/]\
	WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\
	AND "idDeliveryOrderProductLineCondition" \"\\\n"
),

databaseType = "ACCESS" => (
 
	%% idVAT from PRODUCT if NULL
	UpdateDeliveryPrice_SQL2 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "DELIVERY_PRODUCT DP on P.Id=DP.IdProduct\
		set DP.IdVAT=P.IdVAT\
		where DP.IdDelivery in ('[/*DELIVERY.ID*/]')\
		and (DP.IdVAT is NULL or DP.IdVAT<= ' ') \"\\\n"
	),

% JZ 1021 ?????? UpdateDeliveryPrice_SQL2 same to UpdateDeliveryDiscount_SQL3
	

	%% discount = 0 if is NULL
	UpdateDeliveryPrice_SQL3 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP set DP.Discount=0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]')\
		and DP.Discount is NULL \"\\\n"
	),

	%% DELIVERY_PRODUCT amount HT VAT
	UpdateDeliveryPrice_SQL4 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP set DP.AmountHT = round(DP.QuantityReal*DP.PriceUnit*(100.0-DP.Discount))/100.0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]')\
		and "idDeliveryOrderProductLineCondition" \"\\\n"
	),
	UpdateDeliveryPrice_SQL5 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "VAT t on t.Id=DP.IdVAT\
		set DP.AmountVAT= round(DP.AmountHT*t.VAT)/100.0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]')\"\\\n"
	),
	
	%% DELIVERY amount HT VAT
	UpdateDeliveryPrice_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountHT=0, AmountVAT=0  WHERE ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryPrice_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY D inner join " DB_PREFIX "DELIVERY_PRODUCT DP on D.ID=DP.IdDelivery set\
			D.AmountHT=D.AmountHT+DP.AmountHT,\
			D.AmountVAT=D.AmountVAT+DP.AmountVAT\
		WHERE D.ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryPrice_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountTotal = AmountHT + AmountVAT  WHERE ID in ('[/*DELIVERY.ID*/]')\"\\\n"
	),

	;

	%% idVAT from PRODUCT if NULL
	UpdateDeliveryPrice_SQL2 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT \
		set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct)\
		where IdDelivery in ('[/*DELIVERY.ID*/]')\
		and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
	),
	

	%% discount = 0 if is NULL
	UpdateDeliveryPrice_SQL3 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set Discount=0\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\
		and Discount is NULL \"\\\n"
	),

	%% DELIVERY_PRODUCT amount HT VAT
	UpdateDeliveryPrice_SQL4 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set AmountHT = round(QuantityReal*PriceUnit*(100.0-Discount))/100.0\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\
		and "idDeliveryOrderProductLineCondition" \"\\\n"
	),
	UpdateDeliveryPrice_SQL5 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT \
		set AmountVAT= (select round(AmountHT*t.VAT)/100.0 from " DB_PREFIX "VAT t where t.Id=IdVAT)\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\"\\\n"
	),
	
	%% DELIVERY amount HT VAT
	UpdateDeliveryPrice_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY set\
		AmountHT=(select sum(DP.AmountHT) from " DB_PREFIX "DELIVERY_PRODUCT DP where ID=DP.IdDelivery),\
		AmountVAT=(select sum(DP.AmountVAT) from " DB_PREFIX "DELIVERY_PRODUCT DP where ID=DP.IdDelivery)\
		WHERE ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryPrice_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountHT=0  WHERE ID in ('[/*DELIVERY.ID*/]') and AmountHT is NULL \"\\\n"
	),
	UpdateDeliveryPrice_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountVAT=0  WHERE ID in ('[/*DELIVERY.ID*/]') and AmountVAT is NULL \"\\\n"
	),
	UpdateDeliveryPrice_SQL9 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountTotal = AmountHT + AmountVAT  WHERE ID in ('[/*DELIVERY.ID*/]')\"\\\n"
	),

),
? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Delivery\UpdateDeliveryPrice.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableDELIVERYPRODUCT;2;(string,ID);(string,IDDELIVORDPRODUCTLINE);)*/} \\\n"),
		@ UpdateDeliveryPrice_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateDeliveryPrice_Input),
		@ ("'\\\n"),
		@ UpdateDeliveryPrice_SQL1,
		@ UpdateDeliveryPrice_SQL2,
		@ UpdateDeliveryPrice_SQL3,
		@ UpdateDeliveryPrice_SQL4,
		@ UpdateDeliveryPrice_SQL5,
		@ UpdateDeliveryPrice_SQL6,
		@ UpdateDeliveryPrice_SQL7,
		@ UpdateDeliveryPrice_SQL8,	
		databaseType <> "ACCESS" => (
			@ UpdateDeliveryPrice_SQL9,
		),
),

