		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableDELIVERYPRODUCT;2;(string,ID);(string,IDDELIVORDPRODUCTLINE);)*/} \\\n"),
		@ UpdateDeliveryDiscount_Input,
