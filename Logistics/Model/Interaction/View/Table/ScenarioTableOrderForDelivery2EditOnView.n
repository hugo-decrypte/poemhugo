%
%
@ "// 5. modify Discount\n",

% Script
@ "Script ",

% ID
@ "ModifyDiscount ",

% Caption
@ (" '" TAG_UPDATE_DISCOUNT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW5,

% Label
@ (" '" TAG_UPDATE_DISCOUNT "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDERFORDELIVERY' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
UpdateDeliveryDiscount_Input = (
	"{/*Input(ModDis;" TAG_UPDATE_DISCOUNT ";2;\\\n"
	"(float,DISCOUNT,Remise,[/*DELIVERY.DISCOUNT*/],4.1.580,1);\\\n"
	"(string,LABELDISCOUNT,Libellé Remise,[/*DELIVERY.LABELDISCOUNT*/],100." inputWidth ",1,,);\\\n"
	")*/}\\\n"
),

UpdateDeliveryDiscount_SQL1 = (
	"\"Update " DB_PREFIX "DELIVERY_PRODUCT set Discount=[/*DISCOUNT*/], LabelDiscount='[/*LABELDISCOUNT*/]'\
   WHERE IdDelivery in ('[/*DELIVERY.ID*/]') and "idOrderProductLineCondition" \"\\\n"
),


databaseType = "ACCESS" => (

	UpdateDeliveryDiscount_SQL2 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "DELIVERY_PRODUCT DP on P.Id=DP.IdProduct\
		set DP.IdVAT=P.IdVAT\
		where DP.IdDelivery in ('[/*DELIVERY.ID*/]') and (DP.IdVAT is NULL or DP.IdVAT<= ' ') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL3 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP set DP.Discount=0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]') and DP.Discount is NULL \"\\\n"
	),
	UpdateDeliveryDiscount_SQL4 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP set \
			DP.AmountHT = round(DP.QuantityReal*DP.PriceUnit*(100.0-DP.Discount))/100.0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL5 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "VAT t on t.Id=DP.IdVAT\
		set DP.AmountVAT= round(round(DP.QuantityReal*DP.PriceUnit*(100.0-DP.Discount))/100.0*t.VAT)/100.0\
		WHERE DP.IdDelivery in ('[/*DELIVERY.ID*/]')\"\\\n"
	),
	UpdateDeliveryDiscount_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY d set d.AmountHT=0, d.AmountVAT=0 WHERE d.ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY d inner join " DB_PREFIX "DELIVERY_PRODUCT DP on d.ID=DP.IdDelivery set\
		d.AmountHT=d.AmountHT+DP.AmountHT,\
		d.AmountVAT=d.AmountVAT+DP.AmountVAT\
		WHERE d.ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY d set d.AmountTotal = d.AmountHT + d.AmountVAT  WHERE d.ID in ('[/*DELIVERY.ID*/]')\"\n\n\n"
	),
	
	;

	UpdateDeliveryDiscount_SQL2 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT \
		set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct)\
		where IdDelivery in ('[/*DELIVERY.ID*/]') and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL3 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set Discount=0\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]') and Discount is NULL \"\\\n"
	),
	UpdateDeliveryDiscount_SQL4 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set \
			AmountHT = round(QuantityReal*PriceUnit*(100.0-Discount))/100.0\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL5 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT \
		set AmountVAT= (select round(AmountHT*t.VAT)/100.0 from " DB_PREFIX "VAT t where t.Id=IdVAT)\
		WHERE IdDelivery in ('[/*DELIVERY.ID*/]')\"\\\n"
	),
	UpdateDeliveryDiscount_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY set\
			AmountHT=(select sum(DP.AmountHT) from " DB_PREFIX "DELIVERY_PRODUCT DP where ID=DP.IdDelivery),\
			AmountVAT=(select sum(DP.AmountVAT) from " DB_PREFIX "DELIVERY_PRODUCT DP where ID=DP.IdDelivery)\
		WHERE ID in ('[/*DELIVERY.ID*/]') \"\\\n"
	),
	UpdateDeliveryDiscount_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountHT=0  WHERE ID in ('[/*DELIVERY.ID*/]') and AmountHT is NULL \"\\\n"
	),
	UpdateDeliveryDiscount_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountVAT=0  WHERE ID in ('[/*DELIVERY.ID*/]') and AmountVAT is NULL \"\\\n"
	),
	UpdateDeliveryDiscount_SQL9 = (
		"\"Update " DB_PREFIX "DELIVERY set AmountTotal = AmountHT + AmountVAT  WHERE ID in ('[/*DELIVERY.ID*/]')\"\n\n\n"
	),
	
),
? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Delivery\UpdateDeliveryProductDiscount.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableORDERFORDELIVERY;2;(string,ID);(string,IDORDERPRODUCTLINE);)*/} \\\n"),
		@ UpdateDeliveryDiscount_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateDeliveryDiscount),
		@ ("'\\\n"),
		@ UpdateDeliveryDiscount_SQL1,
		@ UpdateDeliveryDiscount_SQL2,
		@ UpdateDeliveryDiscount_SQL3,
		@ UpdateDeliveryDiscount_SQL4,
		@ UpdateDeliveryDiscount_SQL5,
		@ UpdateDeliveryDiscount_SQL6,
		@ UpdateDeliveryDiscount_SQL7,
		@ UpdateDeliveryDiscount_SQL8,	
		databaseType <> "ACCESS" => (
			@ UpdateDeliveryDiscount_SQL9,
		),
),


