%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
%@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% JZ 0926 B

% Instruction... (When Count>0)
UpdateProductQuantity_Input = (
	"{/*Input(" TAG_UPDATE_PRODUCT_QUANTITY ";1;\\\n"
	"(int,QTY," TAG_QUANTITY ",1,10." inputWidth ",0);\\\n"
	")*/}\\\n"
),
UpdateProductQuantity_SQL1 = (
	"\"INSERT INTO " DB_PREFIX "SUPPLY_PRODUCT (IdSupply, IdProduct, Quantity, Comments, DateSupply, DateDelivery) \
	select s.Id, prd.Id, 0, ' ', s.DateSupply, s.DateDelivery\
	from " DB_PREFIX "SUPPLY s, " DB_PREFIX "PRODUCT prd\
	WHERE s.Id in ((/*IDSUPPLY*/)) \
	and prd.Id in ('[/*PRODUCT.IDPRODUCT*/]')\
	and not exists (select 1 from " DB_PREFIX "SUPPLY_PRODUCT ls where ls.IdSupply=s.Id and ls.IdProduct=prd.Id) \"\\\n"
),

UpdateProductQuantity_SQL2 = (
	"\"Update " DB_PREFIX "SUPPLY_PRODUCT set\
		Quantity=[/*QTY*/] \
	WHERE IdSupply in ((/*IDSUPPLY*/)) \
		and IdProduct in ('[/*PRODUCT.IDPRODUCT*/]') \"\\\n"
),

databaseType = "ACCESS" => (

	UpdateProductQuantity_SQL3 = (
		"\"Update " DB_PREFIX "SUPPLY_PRODUCT ls inner join " DB_PREFIX "PRODUCT prd on prd.Id=ls.IdProduct\
		set ls.PriceUnit=prd.PurchasePrice \
		WHERE ls.IdSupply in ((/*IDSUPPLY*/)) \
			and ls.PriceUnit is NULL\
		and prd.Id in ('[/*PRODUCT.IDPRODUCT*/]')\"\\\n"
	),

	UpdateProductQuantity_SQL4 = (
		"\"Update " DB_PREFIX "SUPPLY set Quantity=0, AmountHT=0 \
		WHERE Id in ((/*IDSUPPLY*/)) \"\\\n"
	),
	UpdateProductQuantity_SQL5 = (
		"\"Update " DB_PREFIX "SUPPLY s inner join " DB_PREFIX "SUPPLY_PRODUCT ls on ls.IdSupply=s.Id set\
		s.Quantity=s.Quantity+ls.Quantity,\
		s.AmountHT=s.AmountHT+ls.Quantity*ls.PriceUnit\
		WHERE s.Id in ((/*IDSUPPLY*/))\"\\\n"
	),

	UpdateProductQuantity_SQL6 = (
		"\"Update " DB_PREFIX "PRODUCT \
		set QuantitySupplied=0\
		WHERE Id in ('[/*PRODUCT.IDPRODUCT*/]')\"\n\n\n"
	),
	UpdateProductQuantity_SQL7 = (
		"\"Update " DB_PREFIX "PRODUCT prd inner join " DB_PREFIX "SUPPLY_PRODUCT ls on prd.Id=ls.IdProduct\
			set prd.QuantitySupplied=prd.QuantitySupplied+ls.Quantity\
		WHERE prd.Id in ('[/*PRODUCT.IDPRODUCT*/]') \"\\\n"
	),
	;

	UpdateProductQuantity_SQL3 = (
		"\"Update " DB_PREFIX "SUPPLY_PRODUCT set \
			PriceUnit=(select prd.PurchasePrice from " DB_PREFIX "PRODUCT prd where prd.Id=IdProduct)\
		WHERE IdSupply in ((/*IDSUPPLY*/)) \
			and PriceUnit is NULL\
			and IdProduct in ('[/*PRODUCT.IDPRODUCT*/]') \"\\\n"
	),

	UpdateProductQuantity_SQL4 = (
		"\"Update " DB_PREFIX "SUPPLY set\
			Quantity=(select sum(ls.Quantity) from " DB_PREFIX "SUPPLY_PRODUCT ls where ls.IdSupply=Id),\
			AmountHT=(select sum(ls.Quantity*ls.PriceUnit) from " DB_PREFIX "SUPPLY_PRODUCT ls where ls.IdSupply=Id)\
		WHERE Id in ((/*IDSUPPLY*/))\"\\\n"
	),
	UpdateProductQuantity_SQL5 = (
		"\"Update " DB_PREFIX "SUPPLY set Quantity=0, AmountHT=0 \
		WHERE Id in ((/*IDSUPPLY*/)) and Quantity is NULL\"\\\n"
	),
	UpdateProductQuantity_SQL6 = (
		"\"Update " DB_PREFIX "PRODUCT \
		set QuantitySupplied=(select sum(ls.Quantity) from " DB_PREFIX "SUPPLY_PRODUCT ls where Id=ls.IdProduct)\
		WHERE Id in ('[/*PRODUCT.IDPRODUCT*/]') \"\\\n"
	),
	UpdateProductQuantity_SQL7 = (
		"\"Update " DB_PREFIX "PRODUCT \
		set QuantitySupplied=0\
		WHERE Id in ('[/*PRODUCT.IDPRODUCT*/]') and QuantitySupplied is NULL\"\n\n\n"
	),
),


? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Supply\UpdateProductQuantity.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  (/*IDSUPPLY*/) {/*Selected(tablePRODUCTFORSUPPLY;1;(string,IDPRODUCT))*/} \\\n"),
		@ UpdateProductQuantity_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateProductQuantity_Input),
