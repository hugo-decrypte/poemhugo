		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Supply\UpdateProductPrice.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  (/*IDSUPPLY*/) {/*Selected(tablePRODUCTFORSUPPLY;1;(string,IDPRODUCT))*/} \\\n"),
		@ UpdateProductPrice_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateProductPrice_Input),
		@ ("'\\\n"),
		@ UpdateProductPrice_SQL1,
		@ UpdateProductPrice_SQL2,
		@ UpdateProductPrice_SQL3,
),
%==========================================================================================
%
% Script
@ "Script ",

% ID
@ "ModifyDateDelivery ",

% Caption
@ (" '" TAG_UPDATE_DELIVERY_DATE "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW5,

% Label
@ (" '" TAG_UPDATE_DELIVERY_DATE "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTFORSUPPLY' ", 	% JZ 1018

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
%@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),

% Instruction... (When Count>0)
UpdateProductDateDelivery_Input = (
	"{/*Input(MDD;" TAG_UPDATE_DELIVERY_DATE ";1;\\\n"
	"(date,DATEDELIVERY," TAG_DELIVERY_DATE ",[/*PRODUCT.DATEDELIVERY*/],10." inputWidth ",0,YYYY-MM-DD);\\\n"
	")*/}\\\n"
),
UpdateProductDateDelivery_SQL1 = (
	"\"Update " DB_PREFIX "SUPPLY_PRODUCT set\
		DateDelivery='[/*DATEDELIVERY*/]'\
	WHERE IdSupply in ((/*IDSUPPLY*/))\
	and IdProduct in ('[/*PRODUCT.IDPRODUCT*/]')\"\n\n\n"
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Supply\UpdateProductDateDelivery.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  (/*IDSUPPLY*/) {/*Selected(tablePRODUCTFORSUPPLY;1;(string,IDPRODUCT))*/} \\\n"),
		@ UpdateProductDateDelivery_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateProductDateDelivery_Input),
		@ ("'\\\n"),
		@ UpdateProductDateDelivery_SQL1,
),
%==========================================================================================
%
% Script
@ "Script ",

% ID
@ "ModifyComment ",

% Caption
@ ("'" TAG_UPDATE_COMMENT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW6,

% Label
@ (" '" TAG_UPDATE_COMMENT "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTFORSUPPLY' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),

% Instruction... (When Count>0)
UpdateProductComment_Input = (
	"{/*Input(MCM;" TAG_UPDATE_COMMENT ";1;\\\n"
	" (string,COMMENTS," TAG_COMMENT ",[/*PRODUCT.COMMENTS*/],100." inputWidth ",0,,);\\\n"
	")*/}\\\n"
),
UpdateProductComment_SQL1 = (
	"\"Update " DB_PREFIX "SUPPLY_PRODUCT set\
		Comments='[/*COMMENTS*/]'\
	WHERE IdSupply in ((/*IDSUPPLY*/))\
		and IdProduct in ('[/*PRODUCT.IDPRODUCT*/]')\"\n\n"
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Supply\UpdateProductComment.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) (/*IDSUPPLY*/) {/*Selected(tablePRODUCTFORSUPPLY;1;(string,IDPRODUCT))*/} \\\n"),
		@ UpdateProductComment_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateProductComment_Input),
		@ ("'\\\n"),
		@ UpdateProductComment_SQL1,
),




