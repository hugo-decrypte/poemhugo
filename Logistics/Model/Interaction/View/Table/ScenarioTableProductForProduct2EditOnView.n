%
@ "//1. add a pack of article selected ; add the article into command if it is not in the command\n",
@ "// by double clic\n",
@ "// LengthByPiece,   HeightByPiece,   WidthByPiece,DepthByPiece,   VolumeByPiece\n",

% Script
@ "Script ",

% ID
@ "AddProductToProduct ",

% Caption
@ (" '" TAG_ADD_PRODUCT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,
@ " ",

% Label
@ (" '" TAG_ADD_PRODUCT "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTPRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
%% insert if not exists 
AddProductToProduct_SQL1 = (
	"\"INSERT INTO " DB_PREFIX "PRODUCT_COMPONENT (IdProduct,IdSubProduct,Quantity, Comments) \
	  select P.Id, '[/*PRODUCTPRODUCT.IDSUBPRODUCT*/]', 0, ' ' \
	  from " DB_PREFIX "PRODUCT P \
	  WHERE P.Id in ((/*IDPRODUCT*/))\
	   and not exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=P.Id and PC.IdSubProduct='[/*PRODUCTPRODUCT.IDSUBPRODUCT*/]') \"\\\n"
),

AddProductToProduct_SQL2 = (
	"\"Update " DB_PREFIX "PRODUCT SET PriceUnit=0 where PriceUnit is NULL \"\\\n"
),
AddProductToProduct_SQL3 = (
	"\"Update " DB_PREFIX "PRODUCT SET PurchasePrice=0 where PurchasePrice is NULL \"\\\n"
),
AddProductToProduct_SQL4 = (
	"\"Update " DB_PREFIX "PRODUCT SET Weight=0 where Weight is NULL \"\\\n"
),
AddProductToProduct_SQL5 = (
	"\"Update " DB_PREFIX "PRODUCT SET QuantityPackaging=0 where QuantityPackaging is NULL \"\\\n"
),

databaseType = "ACCESS" => (

	%% add quantity 
	AddProductToProduct_SQL6 = (
		"\"Update " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT P on P.Id=PC.IdSubProduct\
			set PC.Quantity=PC.Quantity+P.QuantityPackaging \
			WHERE PC.IdProduct in ((/*IDPRODUCT*/))\
			and PC.IdSubProduct='[/*PRODUCTPRODUCT.IDSUBPRODUCT*/]' \"\\\n"
	),
	
	%% PRODUCT price, weight 
	AddProductToProduct_SQL7 = (
		"\"Update " DB_PREFIX "PRODUCT SET PriceUnit=0, PurchasePrice=0, Weight=0 WHERE Id in ((/*IDPRODUCT*/)) \"\\\n"
	),

% JZ 1021 : ?????? AddProductToProduct_SQL7 same to UpdateProductToProductQuantity_SQL3


	AddProductToProduct_SQL8 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct) on P.Id=PC.IdProduct SET \
			P.PriceUnit = P.PriceUnit + PC.Quantity*sub.PriceUnit,\
			P.PurchasePrice = P.PurchasePrice + PC.Quantity*sub.PurchasePrice,\
			P.Weight = P.Weight + PC.Quantity*sub.Weight \
			WHERE P.Id in ((/*IDPRODUCT*/))\"\\\n"
	),
	

	%% PRODUCT KIT  price, weight 
	AddProductToProduct_SQL9 = (
		"\"Update " DB_PREFIX "PRODUCT SET PriceUnit=0, PurchasePrice=0, Weight=0 \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=Id and PC.IdSubProduct in ((/*IDPRODUCT*/)) )\"\\\n"
	),
	AddProductToProduct_SQL10 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct) on P.Id=PC.IdProduct SET \
			P.PriceUnit = P.PriceUnit + PC.Quantity*sub.PriceUnit,\
			P.PurchasePrice = P.PurchasePrice + PC.Quantity*sub.PurchasePrice,\
			P.Weight = P.Weight + PC.Quantity*sub.Weight \
			where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=P.Id and PC.IdSubProduct in ((/*IDPRODUCT*/)) )\"\\\n"
	),
	AddProductToProduct_SQL11 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct) on P.Id=PC.IdProduct SET \
			P.PriceUnit = P.PriceUnit + PC.Quantity*sub.PriceUnit,\
			P.PurchasePrice = P.PurchasePrice + PC.Quantity*sub.PurchasePrice,\
			P.Weight = P.Weight + PC.Quantity*sub.Weight \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=P.Id)\"\\\n"
	),
	AddProductToProduct_SQL12 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct) on P.Id=PC.IdProduct SET \
			P.PriceUnit = P.PriceUnit + PC.Quantity*sub.PriceUnit,\
			P.PurchasePrice = P.PurchasePrice + PC.Quantity*sub.PurchasePrice,\
			P.Weight = P.Weight + PC.Quantity*sub.Weight \
			where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=P.Id)\"\\\n"
	),

	;

	AddProductToProduct_SQL1 = (
		"\"Update " DB_PREFIX "PRODUCT_COMPONENT set \
			Quantity=Quantity+(select QuantityPackaging from " DB_PREFIX "PRODUCT where Id=IdSubProduct and IdSubProduct='[/*PRODUCTPRODUCT.IDSUBPRODUCT*/]')\
			WHERE IdProduct in ((/*IDPRODUCT*/))\"\\\n"
	),
	
	AddProductToProduct_SQL2 = (
		"\"Update " DB_PREFIX "PRODUCT SET \
			PriceUnit=(select sum( PC.Quantity*sub.PriceUnit )         from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct \
				where PRODUCT.Id=PC.IdProduct and PC.Quantity is not NULL and PC.Quantity>0 and sub.PriceUnit is not NULL and sub.PriceUnit>0),\
			PurchasePrice=(select sum( PC.Quantity*sub.PurchasePrice ) from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct \
				where PRODUCT.Id=PC.IdProduct and PC.Quantity is not NULL and PC.Quantity>0 and sub.PurchasePrice is not NULL and sub.PurchasePrice>0),\
			Weight=(select sum( PC.Quantity*sub.Weight )               from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct \
				where PRODUCT.Id=PC.IdProduct and PC.Quantity is not NULL and PC.Quantity>0 and sub.Weight is not NULL and sub.Weight>0)\
			WHERE Id in ((/*IDPRODUCT*/))\"\\\n"
	),
	

	AddProductToProduct_SQL3 = (
		"\"Update " DB_PREFIX "PRODUCT SET PriceUnit=0 		WHERE Id in ((/*IDPRODUCT*/)) and PriceUnit is NULL\"\\\n"
	),
	AddProductToProduct_SQL4 = (
		"\"Update " DB_PREFIX "PRODUCT SET PurchasePrice=0  WHERE Id in ((/*IDPRODUCT*/)) and PurchasePrice is NULL\"\\\n"
	),
	AddProductToProduct_SQL5 = (
		"\"Update " DB_PREFIX "PRODUCT SET Weight=0 		WHERE Id in ((/*IDPRODUCT*/)) and Weight is NULL\"\\\n"
	),

	AddProductToProduct_SQL6 = (
		"\"Update " DB_PREFIX "PRODUCT set \
			PriceUnit=(select sum(sub.PriceUnit*PC.Quantity) from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct where PRODUCT.Id=PC.IdProduct), \
			Weight=   (select sum(sub.Weight*PC.Quantity)    from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct where PRODUCT.Id=PC.IdProduct) \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=PRODUCT.Id and PC.IdSubProduct in ((/*IDPRODUCT*/)) )\"\\\n"
	),
	AddProductToProduct_SQL7 = (
		"\"Update " DB_PREFIX "PRODUCT SET PriceUnit=0 		WHERE PriceUnit is NULL\"\\\n"
	),
	AddProductToProduct_SQL8 = (
		"\"Update " DB_PREFIX "PRODUCT SET PurchasePrice=0  WHERE PurchasePrice is NULL\"\\\n"
	),
	AddProductToProduct_SQL9 = (
		"\"Update " DB_PREFIX "PRODUCT SET Weight=0 		WHERE Weight is NULL\"\\\n"
	),

	AddProductToProduct_SQL10 = (
		"\"Update " DB_PREFIX "PRODUCT set \
			PriceUnit=(select sum(sub.PriceUnit*PC.Quantity) from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct where PRODUCT.Id=PC.IdProduct) \
			Weight=(select sum(sub.Weight*PC.Quantity) from " DB_PREFIX "PRODUCT_COMPONENT PC inner join " DB_PREFIX "PRODUCT sub on sub.Id=PC.IdSubProduct where PRODUCT.Id=PC.IdProduct) \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT PC where PC.IdProduct=PRODUCT.Id)\"\\\n"
	),
	AddProductToProduct_SQL11 = (
		"\"Update " DB_PREFIX "PRODUCT SET PriceUnit=0 		WHERE PriceUnit is NULL\"\\\n"
	),
	AddProductToProduct_SQL12 = (
		"\"Update " DB_PREFIX "PRODUCT SET PurchasePrice=0  WHERE PurchasePrice is NULL\"\\\n"
	),
	AddProductToProduct_SQL13 = (
		"\"Update " DB_PREFIX "PRODUCT SET Weight=0 		WHERE Weight is NULL\"\\\n"
	),
),
? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\AddProductToProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) (/*IDPRODUCT*/) {/*Selected(tablePRODUCTPRODUCT;1;(string,IDSUBPRODUCT))*/} \\\n"),
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ AddProductToProduct_SQL1,
		@ AddProductToProduct_SQL2,
		@ AddProductToProduct_SQL3,
		@ AddProductToProduct_SQL4,
		@ AddProductToProduct_SQL5,
		@ AddProductToProduct_SQL6,
		@ AddProductToProduct_SQL7,
		@ AddProductToProduct_SQL8,
		@ AddProductToProduct_SQL9,
		@ AddProductToProduct_SQL10,
		@ AddProductToProduct_SQL11,
		@ AddProductToProduct_SQL12,
		databaseType <> "ACCESS" => (
			@ AddProductToProduct_SQL13,
		),
),


