UpdateProductToProductComment_Input = (
	"{/*Input(" TAG_UPDATE_COMMENT_ON_PRODUCT " [/*PRODUCTPRODUCT.IDSUBPRODUCT*/];1;\\\n"
	"(string,COMMENTS," TAG_COMMENT ",[/*PRODUCTPRODUCT.COMMENTS*/],100." inputWidth ",1);\\\n"
	")*/}\\\n"
),

UpdateProductToProductComment_SQL1 = (
	"\"Update " DB_PREFIX "PRODUCT_COMPONENT set Comments='[/*COMMENTS*/]'\
	WHERE IdProduct in ((/*IDPRODUCT*/))\
	and IdSubProduct in ('[/*PRODUCTPRODUCT.IDSUBPRODUCT*/]') \"\n\n\n"
),

