% JZ 0912


%===========================================================================================
%
@ "Script ",

% ID
@ "SetToDelivery ",

% Caption
@ (" '" TAG_SET_ORDER_TO_DELIVERY "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW5,

% Label
@ (" '" TAG_SET_ORDER_TO_DELIVERY "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),



% Instruction... (When Count>0)
SetToDelivery_Input = (
	"{/*Input(ML;" TAG_SET_ORDER_TO_DELIVERY " : " TAG_ORDER " [/*ORDER.ID*/];1;\\\n"
	"(date,DATEDELIVERY," TAG_DELIVERY_DATE ",[/*ORDER.DATEDELIVERY*/],10." inputWidth ",1,YYYY-MM-DD);\\\n"
	")*/}\\\n"
),	% JZ 0919 : 8.0.450

databaseType = "ACCESS" => (

	SetToDelivery_SQL1 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT LO set LO.QuantityDelivered=0 where LO.IdOrder='[/*ORDER.ID*/]' \"\\\n"
	),
	SetToDelivery_SQL2 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT LO set LO.QuantityRest=LO.Quantity where LO.IdOrder='[/*ORDER.ID*/]' \"\\\n"
	),
	SetToDelivery_SQL3 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT LO inner join " DB_PREFIX "DELIVERY_PRODUCT LD on LD.IdOrder=LO.IdOrder and LD.IdProduct=LO.IdProduct set\
		LO.QuantityDelivered=LO.QuantityDelivered+LD.QuantityReal,\
		LO.QuantityRest=LO.QuantityRest-LD.QuantityReal\
		where LO.IdOrder='[/*ORDER.ID*/]'\"\\\n"
	),
	;

	SetToDelivery_SQL1 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT  set\
			QuantityDelivered=(select sum(LD.QuantityReal) from " DB_PREFIX "DELIVERY_PRODUCT LD where LD.IdOrder=ORDER_PRODUCT.IdOrder and LD.IdProduct=ORDER_PRODUCT.IdProduct),\
			QuantityRest=Quantity-(select sum(LD.QuantityReal) from " DB_PREFIX "DELIVERY_PRODUCT LD where LD.IdOrder=ORDER_PRODUCT.IdOrder and LD.IdProduct=ORDER_PRODUCT.IdProduct)\
		where IdOrder='[/*ORDER.ID*/]'\"\\\n"
	),
	SetToDelivery_SQL2 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityDelivered=0 where IdOrder='[/*ORDER.ID*/]' and QuantityDelivered is NULL \"\\\n"
	),
	SetToDelivery_SQL3 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityRest=Quantity where IdOrder='[/*ORDER.ID*/]' and QuantityRest is NULL \"\\\n"
	),
),
SetToDelivery_SQL4 = (
	"\"INSERT INTO " DB_PREFIX "DELIVERY\
	(IdClub, Id, IdClient, IdPointDelivery, DateDelivery, IdAgency, Quantity, QuantityReal,\
	Comments, IdState) \
	select O.IdClub, "SQL_CONCAT"'D'"SQL_CONCATWITH"O.Id"SQL_CONCATEND", O.IdClient, O.IdPointDelivery, [/*DATEDELIVERY*/], O.IdAgency, O.QuantityRest, O.QuantityRest,\
	"SQL_CONCAT"'Commande '"SQL_CONCATWITH" '[/*ORDER.ID*/]'"SQL_CONCATEND", '0'\
	from " DB_PREFIX "CLIENTORDER O\
	where O.Id = '[/*ORDER.ID*/]'\
   and not exists (select 1 from " DB_PREFIX "DELIVERY d where d.Id="SQL_CONCAT"'D'"SQL_CONCATWITH"O.Id"SQL_CONCATEND") \"\\\n"
),
SetToDelivery_SQL5 = (
	"\"INSERT INTO " DB_PREFIX "DELIVERY_PRODUCT (IdDelivery,IdOrder, IdProduct, NoLine, Quantity, QuantityReal, QuantityOrderRest, QuantityDefective, PriceUnit, Comments, DateDelivery, NoPallet,NoPalletDelivery) \
	select "SQL_CONCAT"'D'"SQL_CONCATWITH"O.Id"SQL_CONCATEND", O.Id, LO.IdProduct, 1 as NoLine,\
	0, 0, 0, 0, LO.PriceUnit, LO.Comments, [/*DATEDELIVERY*/], 1, LO.NoPallet\
	from " DB_PREFIX "CLIENTORDER O inner join " DB_PREFIX "ORDER_PRODUCT LO on LO.IdOrder=O.Id\
	where O.Id='[/*ORDER.ID*/]'\
	and LO.QuantityRest>0\
	and not exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT LD where LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"O.Id"SQL_CONCATEND" and LD.IdOrder=O.Id and LD.IdProduct=LO.IdProduct) \"\\\n"
),

databaseType = "ACCESS" => (

	SetToDelivery_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT LD inner join " DB_PREFIX "ORDER_PRODUCT LO on LD.IdOrder=LO.IdOrder and LD.IdProduct=LO.IdProduct\
		set LD.Quantity=LD.Quantity+LO.QuantityRest, LD.QuantityReal=LD.QuantityReal+LO.QuantityRest\
		where LO.IdOrder='[/*ORDER.ID*/]' and LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and LO.QuantityRest>0 \"\\\n"
	),
	SetToDelivery_SQL6b = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT LD inner join " DB_PREFIX "ORDER_PRODUCT LO on LD.IdOrder=LO.IdOrder and LD.IdProduct=LO.IdProduct\
		set LO.QuantityDelivered=LO.QuantityDelivered+LO.QuantityRest, LO.QuantityRest=0\
		where LO.IdOrder='[/*ORDER.ID*/]' and LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and LO.QuantityRest>0 \"\\\n"
	),

	SetToDelivery_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT LD inner join " DB_PREFIX "ORDER_PRODUCT LO on LD.IdOrder=LO.IdOrder and LD.IdProduct=LO.IdProduct\
		set LD.PriceUnit=LO.PriceUnit\
		where LO.IdOrder='[/*ORDER.ID*/]' and LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and (LD.PriceUnit is NULL or LD.PriceUnit<=0) \"\\\n"
	),
	SetToDelivery_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT LD inner join " DB_PREFIX "ORDER_PRODUCT LO on LD.IdOrder=LO.IdOrder and LD.IdProduct=LO.IdProduct\
		set LD.IdVAT=LO.IdVAT\
		where LO.IdOrder='[/*ORDER.ID*/]' and LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and (LD.IdVAT is NULL or LD.IdVAT<=' ') \"\\\n"
	),

	SetToDelivery_SQL9 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT LD inner join " DB_PREFIX "PRODUCT A on LD.IdProduct=A.Id\
		set LD.IdVAT=A.IdVAT\
		where LD.IdOrder='[/*ORDER.ID*/]' and LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and (LD.IdVAT is NULL or LD.IdVAT<=' ') \"\\\n"
	),
	;

	SetToDelivery_SQL6 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set\
			Quantity=Quantity+(select LO.QuantityRest from " DB_PREFIX "ORDER_PRODUCT LO where LO.IdOrder='[/*ORDER.ID*/]' and DELIVERY_PRODUCT.IdProduct=LO.IdProduct), \
			QuantityReal=QuantityReal+(select LO.QuantityRest  from " DB_PREFIX "ORDER_PRODUCT LO where LO.IdOrder='[/*ORDER.ID*/]' and DELIVERY_PRODUCT.IdProduct=LO.IdProduct) \
		where IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND" \"\\\n"
	),
	SetToDelivery_SQL6b = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT set\
			QuantityDelivered=QuantityDelivered+QuantityRest, \
			QuantityRest=0\
		where IdOrder='[/*ORDER.ID*/]'\
		and QuantityRest>0 \"\\\n"
	),

	SetToDelivery_SQL7 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set\
			PriceUnit= (select LO.PriceUnit from " DB_PREFIX "ORDER_PRODUCT LO where LO.IdOrder='[/*ORDER.ID*/]' and DELIVERY_PRODUCT.IdProduct=LO.IdProduct)\
		where IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and (PriceUnit is NULL or PriceUnit<=0) \"\\\n"
	),
	SetToDelivery_SQL8 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set\
			IdVAT=(select LO.IdVAT from " DB_PREFIX "ORDER_PRODUCT LO where LO.IdOrder='[/*ORDER.ID*/]' and DELIVERY_PRODUCT.IdProduct=LO.IdProduct)\
		where LO.IdOrder='[/*ORDER.ID*/]' and LD.IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and (IdVAT is NULL or IdVAT<=' ') \"\\\n"
	),

	SetToDelivery_SQL9 = (
		"\"Update " DB_PREFIX "DELIVERY_PRODUCT set\
			LD.IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where DELIVERY_PRODUCT.IdProduct=P.Id)\
		where IdDelivery="SQL_CONCAT"'D'"SQL_CONCATWITH"'[/*ORDER.ID*/]'"SQL_CONCATEND"\
		and (IdVAT is NULL or IdVAT<=' ') \"\\\n"
	),
),

SetToDelivery_SQL10 = (
	"\"Update " DB_PREFIX "CLIENTORDER \
	set DateDelivery=[/*DATEDELIVERY*/], IdState='2'\
	where Id='[/*ORDER.ID*/]'\"\n\n"
),

? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\SetToDelivery.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableORDER;1;(string,ID))*/} \\\n"),
		@ SetToDelivery_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" SetToDelivery_Input),
		@ ("'\\\n"),
		@ SetToDelivery_SQL1,
		@ SetToDelivery_SQL2,
		@ SetToDelivery_SQL3,
		@ SetToDelivery_SQL4,
		@ SetToDelivery_SQL5,
		@ SetToDelivery_SQL6,
		@ SetToDelivery_SQL6b,
		@ SetToDelivery_SQL7,
		@ SetToDelivery_SQL8,
		@ SetToDelivery_SQL9,
		@ SetToDelivery_SQL10,
),



