%===========================================================================================
%
% Script
@ "Script ",

% ID
@ "CreateOrder ",

% Caption
@ (" '" TAG_INSERT_ORDER "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,

% Label
@ (" '" TAG_INSERT "' "),	% JZ 0908

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% Instruction... (When Count>0)

CreateOrder_Input = (
	"{/*Input(" TAG_INSERT_ORDER ";4;\\\n"
	"(string,IDORDER," TAG_ORDER_ID ",,50." inputWidth ",0,0,);\\\n"
	"(string,REFERENCE," TAG_REFERENCE ",,50." inputWidth ",0,0,);\\\n"
	"(string,LABELCLIENT,Client,,50." inputWidth ",0,,[/*CLIENT.LABELCLIENT*/]);\\\n"
	"(date,DATEDELIVERY," TAG_DELIVERY_DATE ",,10." inputWidth ",1,YYYY-MM-DD);\\\n"
	")*/}\\\n"
),

CreateOrder_SQL1 = (
	"\"INSERT INTO " DB_PREFIX "CLIENTORDER (IdClub, Id, Reference, IdClient, IdPointDelivery, DateOrder, DateDelivery, IdAgency, IdState) "
	"select cl.IdClub, '[/*IDORDER*/]', '[/*REFERENCE*/]', cl.Id, p.IdPoint, "SQL_FORMATDATE"("SQL_CURRENTDATE",'"SQL_FORMATDATESTR"'), [/*DATEDELIVERY*/], cl.IdAgency, '0' "
	"from " DB_PREFIX "CLIENT cl inner join " DB_PREFIX "POINTDELIVERY p on p.IdClient=cl.Id "
	"where "SQL_CONCAT"trim(cl.Name) "SQL_CONCATWITH" ' (' "SQL_CONCATWITH" trim(p.City) "SQL_CONCATWITH"')'"SQL_CONCATEND" = '[/*LABELCLIENT*/]'\"\n\n"
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\CreateOrder.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) \\\n"),
		@ CreateOrder_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" CreateOrder_Input),
		@ ("'\\\n"),
		@ CreateOrder_SQL1,
	),


%===========================================================================================
%
% Script
@ "Script ",

% ID
@ "DuplicateOrder ",

% Caption
@ (" '" TAG_COPY_ORDER "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW2,

% Label
@ (" '" TAG_COPY "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% Instruction... (When Count>0)
DuplicateOrder_Input = (
	"{/*Input(L;" TAG_COPY_ORDER " [/*ORDER.ID*/];3;\\\n"
	"(string,IDORDER," TAG_ORDER_ID ",,50." inputWidth ",0,0,);\\\n"
	"(string,REFERENCE," TAG_REFERENCE ",,50." inputWidth ",0,0,);\\\n"
	"(date,DATEDELIVERY," TAG_DELIVERY_DATE ",[/*ORDER.DATEDELIVERY*/],10." inputWidth ",1,YYYY-MM-DD);\\\n"
	")*/}\\\n"
),


DuplicateOrder_SQL1 = (
	"\"INSERT INTO " DB_PREFIX "CLIENTORDER\
  (IdClub, Id, IdClient, IdPointDelivery, DateOrder, DateDelivery, IdAgency, Quantity, QuantityRest,\
   Comments, Reference, IdState) \
  select O.IdClub, '[/*IDORDER*/]', O.IdClient, O.IdPointDelivery, "SQL_FORMATDATE"("SQL_CURRENTDATE",'"SQL_FORMATDATESTR"'), [/*DATEDELIVERY*/], O.IdAgency, O.Quantity, O.Quantity,\
  "SQL_CONCAT"'Dupliquée de '"SQL_CONCATWITH" O.Id"SQL_CONCATEND", '[/*REFERENCE*/]', '0'\
  from " DB_PREFIX "CLIENTORDER O\
  where O.Id = '[/*ORDER.ID*/]'\"\\\n"
),
DuplicateOrder_SQL2 = (
	"\"INSERT INTO " DB_PREFIX "ORDER_PRODUCT (IdOrder, IdProduct, Quantity, QuantityDelivered, QuantityRest, PriceUnit, Discount, Comments, DateOrder, DateDelivery,NoPallet) \
  select O.Id, LO.IdProduct,\
   LO.Quantity, 0, LO.Quantity, LO.PriceUnit, LO.Discount, LO.Comments, "SQL_FORMATDATE"("SQL_CURRENTDATE",'"SQL_FORMATDATESTR"'), [/*DATEDELIVERY*/], LO.NoPallet\
  from " DB_PREFIX "CLIENTORDER O," DB_PREFIX "ORDER_PRODUCT LO\
  where O.Id='[/*IDORDER*/]'\
   and LO.IdOrder = '[/*ORDER.ID*/]'\"\n\n"
),
	
? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\DuplicateOrder.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableORDER;1;(string,ID))*/} \\\n"),
		@ DuplicateOrder_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" DuplicateOrder_Input),
		@ ("'\\\n"),
		@ DuplicateOrder_SQL1,
		@ ("\\\n"),
		@ DuplicateOrder_SQL2,
),



%===========================================================================================
%
% Script
@ "Script ",

% ID
@ "ModifyOrder ",

% Caption
@ (" '" TAG_UPDATE_ORDER "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW3,

% Label
@ (" '" TAG_UPDATE "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",


% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),



% Instruction... (When Count>0)
UpdateOrder_Input = (
	"{/*Input(MO;" TAG_UPDATE_ORDER " [/*ORDER.ID*/];7;\\\n"
	"(date,DATEDELIVERY," TAG_DELIVERY_DATE "*,[/*ORDER.DATEDELIVERY*/],10." inputWidth ",1,YYYY-MM-DD);\\\n"
	"(string,INCOTERM," TAG_INCOTERMS ",[/*ORDER.INCOTERM*/],50." inputWidth ",1,,);\\\n"
	"(string,REFERENCE," TAG_REFERENCE ",[/*ORDER.REFERENCE*/],50." inputWidth ",1,,);\\\n"
	"(string,IDINVOICE," TAG_INVOICE_ID ",[/*ORDER.IDINVOICE*/],50." inputWidth ",1,,);\\\n"
	"(string,IDPROFORMA," TAG_PROFORMA_ID ",[/*ORDER.IDPROFORMA*/],50." inputWidth ",1,,);\\\n"
	"(string,COMMENTS," TAG_COMMENT ",[/*ORDER.COMMENTS*/],50." inputWidth ",1,,);\\\n"
	"(string,STATE," TAG_STATE ",[/*ORDER.STATEORDER*/],50." inputWidth ",1,,[/*STATE.LABELSTATE*/]);\\\n"
	" )*/}\\\n"
),
UpdateOrder_SQL1 = (
	"\"Update " DB_PREFIX "CLIENTORDER set \
		DateDelivery=[/*DATEDELIVERY*/],\
		Incoterm='[/*INCOTERM*/]',\
		Reference='[/*REFERENCE*/]',\
		Comments='[/*COMMENTS*/]',\
		IdInvoice='[/*IDINVOICE*/]',\
		IdProforma='[/*IDPROFORMA*/]'\
	where Id in ([/*ORDER.ID*/])\"\n\n"
),


databaseType = "ACCESS" => (

	UpdateOrder_SQL2 = (
		"\"Update " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "STATE s\
		set O.IdState=s.Id\
		where O.Id in ([/*ORDER.ID*/])\
		and "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*STATE*/]' and s.CATEGORY='ORDER'\"\n\n\n"
	),
	;

	UpdateOrder_SQL2 = (
		"\"Update " DB_PREFIX "CLIENTORDER \
		set IdState=(select s.Id from " DB_PREFIX "STATE s where "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*STATE*/]' and s.CATEGORY='ORDER')\
		where Id in ([/*ORDER.ID*/])\"\n\n\n"
	),
),

? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\UpdateOrder.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableORDER;1;(string,ID))*/} \\\n"),
		@ UpdateOrder_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;
	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" UpdateOrder_Input),
		@ ("'\\\n"),
		@ UpdateOrder_SQL1,
		@ UpdateOrder_SQL2,
),


