% Instruction... (When Count>0)


SetOrderState_Input = (
	"{/*Input(MCS;" TAG_UPDATE_ORDERR_STATE ";1;\\\n"
	" (string,STATE," TAG_STATE ",[/*ORDER.IDSTATE*/],50." inputWidth ",0,,[/*STATE.LABELSTATE*/]);\\\n"
	" )*/}\\\n"
),

databaseType = "ACCESS" => (

	SetOrderState_SQL1 = (
		"\"Update " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "STATE s\
		set O.IdState=s.Id\
		where O.Id in ([/*ORDER.ID*/])\
		and "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*STATE*/]' and s.CATEGORY='ORDER'\"\n\n\n"
	),
	;

	SetOrderState_SQL1 = (
		"\"Update " DB_PREFIX "CLIENTORDER \
		set IdState=(select s.Id from " DB_PREFIX "STATE s where "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*STATE*/]' and s.CATEGORY='ORDER')\
		where Id in ([/*ORDER.ID*/])\"\n\n\n"
	),
),


? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\SetOrderState.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
