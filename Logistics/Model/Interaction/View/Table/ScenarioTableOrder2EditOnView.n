% Label
@ ("'" TAG_DELETE "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
%@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),

% Instruction... (When Count>0)
DeleteOrder_SQL1 = (
	"\"Delete from " DB_PREFIX "ORDER_PRODUCT \
	where IdOrder='[/*ORDER.ID*/]'\
	and not exists (select 1 from " DB_PREFIX "ORDER_PRODUCT LO0 where LO0.QuantityDelivered>0 and ORDER_PRODUCT.IdOrder=LO0.IdOrder)\
	and exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=ORDER_PRODUCT.IdOrder and (O.IdState is NULL or O.IdState='0') )\"\\\n"
),

DeleteOrder_SQL2 = (
	"\"Delete from " DB_PREFIX "CLIENTORDER \
	where Id = '[/*ORDER.ID*/]' and (IdState is NULL or IdState='0') \
	and not exists (select 1 from " DB_PREFIX "ORDER_PRODUCT LO0 where LO0.QuantityDelivered>0 and CLIENTORDER.Id=LO0.IdOrder)\"\\\n"
),
DeleteOrder_SQL3 = (
	"\"Update " DB_PREFIX "CLIENTORDER\
	set Comments='NON Supprimée'\
	where Id='[/*ORDER.ID*/]'\"\n\n"
),
? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\DeleteOrder.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableORDER;1;(string,ID))*/}' \\\n"),
		@ ("Reload _ _ _\n\n"),
		;
	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=1; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ DeleteOrder_SQL1,
		@ DeleteOrder_SQL2,
		@ DeleteOrder_SQL3,
),




