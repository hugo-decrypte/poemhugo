%%  tableSUPPLIER = > tableSUPPLIEROFFER
%% 	(string,ID) = > (string,IDSUPPLIER)

% Script
@ "Script ",

% ID
@ "TableProductForOffer ", 


% Caption
@ (" '" TAG_PRODUCT_FOR_OFFER "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_TABLE_PRODUCT,

% Label
@ (" '" TAG_PRODUCTS "' "),


% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableSUPPLIEROFFER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"


@ (PREFIX_OPENTABLE_BEGIN "TableProductForOffer.view" OPENTABLE_END),	

@ (TABLE_ARGUMENTS 
"IDSUPPLIER={/*Selected(tableSUPPLIEROFFER;1;(string,IDSUPPLIER))*/};IDOFFER={/*Selected(tableSUPPLIEROFFER;1;(string,IDOFFER))*/};TITLEOBJ=" TAG_OF_SUPPLIER " {/*Selected(tableSUPPLIEROFFER;1;(string,IDSUPPLIER))*/};FAMILY='XXX']\"\n\n"),
