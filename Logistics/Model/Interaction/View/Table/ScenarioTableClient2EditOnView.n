@ "'tableCLIENT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("'Attention,Vous ne pouvez supprimer que des clients qui ne ont pas de commande' "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=7; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% Instruction... (When Count>0)
DeleteClient_Input = (
	"{/*Input(DCLI;" TAG_DELETE_CLIENT ";2;\\\n"
	"(string,CLIENTID" TAG_ID "*,[/*CLIENT.ID*/],20." inputWidth ",0,,,0);\\\n"
	"(int,NBORDER,Nb Commandes,[/*CLIENT.NBORDER*/],20." inputWidth ",0,,,0);\\\n"
	")*/}\\\n"
),
DeleteClient_SQL1 = (
	" \"Delete from " DB_PREFIX "POINTDELIVERY \
	where IdClient='[/*CLIENTID*/]'\
	and not exists (select 1 from " DB_PREFIX "CLIENTORDER o where o.IdClient=POINTDELIVERY.IdClient )\"\\\n"
),
DeleteClient_SQL2 = (
	" \"delete from " DB_PREFIX "CLIENT \
	where Id = '[/*CLIENTID*/]' \
	and not exists (select 1 from " DB_PREFIX "POINTDELIVERY where CLIENT.Id=IdClient)\
	and not exists (select 1 from " DB_PREFIX "CLIENTORDER o where o.IdClient=CLIENT.Id )\"\\\n"
),
DeleteClient_SQL3 = (
	" \"Update " DB_PREFIX "CLIENT\
	set Comments='NON Supprimée'\
	where Id='[/*CLIENTID*/]' \"\n\n"
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Client\DeleteClient.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  \\\n"),
		@ DeleteClient_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=7; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" DeleteClient_Input),
		@ ("'\\\n"),
		@ DeleteClient_SQL1,
		@ DeleteClient_SQL2,
		@ DeleteClient_SQL3,
),
.






