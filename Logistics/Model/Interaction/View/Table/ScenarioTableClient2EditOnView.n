@ "'tableCLIENT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),

% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=7; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% Instruction... (When Count>0)
UpdateClient_Input = (
	"{/*Input(MCLI;" TAG_UPDATE_CLIENT ";19;\\\n"
	"(string,CLIENTID," TAG_ID "*,[/*CLIENT.ID*/],20." inputWidth ",0,);\\\n"
	"(string,CLIENTNAME," TAG_NAME "*,[/*CLIENT.NAME*/],50." inputWidth ",0,);\\\n"
	"(string,ADDRESSINVOICE," TAG_INVOICE_ADDRESS "*,[/*CLIENT.ADDRESSINVOICE*/],100." inputWidth ",0);\\\n"
	"(string,ADDRESSSUPINVOICE," TAG_INVOICE_ADDRESS2 ",[/*CLIENT.ADDRESSSUPINVOICE*/],100." inputWidth ",1);\\\n"
	"(string,POSTCODE," TAG_POSTCODE ",[/*CLIENT.POSTCODE*/],10." inputWidth ",0);\\\n"
	"(string,CITY," TAG_CITY "*,[/*CLIENT.CITY*/],50." inputWidth ",0);\\\n"
	"(string,COUNTRY," TAG_COUNTRY "*,[/*CLIENT.COUNTRY*/],50." inputWidth ",0);\\\n"
	"(string,VATCODE," TAG_TAX_CODE "*,[/*CLIENT.VATCODE*/],30." inputWidth ",0);\\\n"
	"(string,SIRET," TAG_ESTABLISHMENT "*,[/*CLIENT.SIRET*/],30." inputWidth ",0);\\\n"
	"(string,COMMENTS," TAG_COMMENT ",[/*CLIENT.COMMENTS*/],30." inputWidth ",1);\\\n"
	"(string,IDPOINTDELIVERY," TAG_DELIVERY_POINT_ID "*,[/*CLIENT.IDPOINTDELIVERY*/],20." inputWidth ",0);\\\n"
	"(string,NAMEDELIVERY," TAG_DELIVERY_NAME "*,[/*CLIENT.NAMEDELIVERY*/],50." inputWidth ",0);\\\n"
	"(string,ADDRESSDELIVERY," TAG_DELIVERY_ADDRESS "*,[/*CLIENT.ADDRESSDELIVERY*/],100." inputWidth ",0);\\\n"
	"(string,ADDRESSSUPDELIVERY," TAG_DELIVERY_ADDRESS2 ",[/*CLIENT.ADDRESSSUPDELIVERY*/],100." inputWidth ",1);\\\n"
	"(string,POSTCODEDELIVERY," TAG_DELIVERY_PC ",[/*CLIENT.POSTCODEDELIVERY*/],10." inputWidth ",0);\\\n"
	"(string,CITYDELIVERY," TAG_DELIVERY_CITY "*,[/*CLIENT.CITYDELIVERY*/],60." inputWidth ",0);\\\n"
	"(string,COUNTRYDELIVERY," TAG_DELIVERY_COUNTRY ",[/*CLIENT.COUNTRYDELIVERY*/],50." inputWidth ",0);\\\n"
	"(string,AGENCYNAME," TAG_AGENCY ",[/*CLIENT.NAMEAGENCY*/],100." inputWidth ",0,0,[/*AGENCY.NAMEAGENCY*/]);\\\n"
	"(string,BANKACCOUNT," TAG_BANK_ACCOUNT ",[/*CLIENT.NAMEBANK*/],100." inputWidth ",0,0,[/*BANKACCOUNT.NAMEBANK*/]);\\\n"
	")*/}\\\n"
),
UpdateClient_SQL1=(
	" \"INSERT INTO " DB_PREFIX "CLIENT (idClub, id, name, address, AddressSup, City, PostCode, Country, codeTax, establishment, IdAgency, BankAccount) \
	select '(/*CLUBID*/)', '[/*CLIENTID*/]', '[/*CLIENTNAME*/]', '[/*ADDRESSINVOICE*/]', '[/*ADDRESSSUPINVOICE*/]','[/*CITY*/]','[/*POSTCODE*/]','[/*COUNTRY*/]', '[/*VATCODE*/]','[/*SIRET*/]',ay.Id, b.Id\
	from " DB_PREFIX "AGENCY ay, " DB_PREFIX "BANKACCOUNT b \
	where ay.Name='[/*AGENCYNAME*/]' and b.Name='[/*BANKACCOUNT*/]'\
	and not exists (select 1 from " DB_PREFIX "CLIENT where ID='[/*CLIENTID*/]')\"\\\n"
),

UpdateClient_SQL2=(
	" \"UPDATE " DB_PREFIX "CLIENT SET\
	Name='[/*CLIENTNAME*/]',\
	Address='[/*ADDRESSINVOICE*/]', AddressSup='[/*ADDRESSSUPINVOICE*/]',\
	City='[/*CITY*/]', PostCode='[/*POSTCODE*/]', Country='[/*COUNTRY*/]',\
	codeTax='[/*VATCODE*/]', establishment='[/*SIRET*/]',\
	Comments='[/*COMMENTS*/]'\
	where ID='[/*CLIENTID*/]'\"\\\n"
),

databaseType = "ACCESS" => (

	UpdateClient_SQL3=(
		" \"UPDATE " DB_PREFIX "CLIENT cl, " DB_PREFIX "AGENCY ay, " DB_PREFIX "BANKACCOUNT b \
		set cl.IdAgency=ay.Id, cl.BankAccount=b.Id\
		where ay.Name='[/*AGENCYNAME*/]' and b.Name='[/*BANKACCOUNT*/]'\
		and cl.ID='[/*CLIENTID*/]'\"\\\n"
	),
	;

	UpdateClient_SQL3=(
		" \"UPDATE " DB_PREFIX "CLIENT set \
			IdAgency=(select ay.Id from " DB_PREFIX "AGENCY ay where ay.Name='[/*AGENCYNAME*/]'),\
			BankAccount=(select b.Id from " DB_PREFIX "BANKACCOUNT b where b.Name='[/*BANKACCOUNT*/]')\
		where ID='[/*CLIENTID*/]'\"\\\n"
	),
),

UpdateClient_SQL4=(
	" \"INSERT INTO " DB_PREFIX "POINTDELIVERY (IdClient, IdPoint, NameClient, Address, AddressSup, City, PostCode,Country) \
	select '[/*CLIENTID*/]','[/*IDPOINTDELIVERY*/]', '[/*NAMEDELIVERY*/]', '[/*ADDRESSDELIVERY*/]', '[/*ADDRESSSUPDELIVERY*/]','[/*CITYDELIVERY*/]','[/*POSTCODEDELIVERY*/]','[/*COUNTRYDELIVERY*/]'\
	from " DB_PREFIX "CLIENT cl \	
	where cl.ID='[/*CLIENTID*/]' and '[/*IDPOINTDELIVERY*/]'>' '\
	and not exists (select 1 from " DB_PREFIX "POINTDELIVERY where IdClient='[/*CLIENTID*/]' and IdPoint='[/*IDPOINTDELIVERY*/]')\"\\\n"
),

UpdateClient_SQL5=(
	" \"UPDATE " DB_PREFIX "POINTDELIVERY SET \
	NameClient='[/*NAMEDELIVERY*/]',\
	Address='[/*ADDRESSDELIVERY*/]', AddressSup='[/*ADDRESSSUPDELIVERY*/]',\
	City='[/*CITYDELIVERY*/]', PostCode='[/*POSTCODEDELIVERY*/]',Country='[/*COUNTRYDELIVERY*/]'\
	where IdClient='[/*CLIENTID*/]' and IdPoint='[/*IDPOINTDELIVERY*/]'\"\n\n"
),
? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Client\UpdateClient.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  \\\n"),
		@ UpdateClient_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=7; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" UpdateClient_Input),
		@ ("'\\\n"),
		@ UpdateClient_SQL1,
		@ UpdateClient_SQL2,
		@ UpdateClient_SQL3,
		@ UpdateClient_SQL4,
		@ UpdateClient_SQL5,
),

