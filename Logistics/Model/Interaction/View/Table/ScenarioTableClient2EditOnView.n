% Script
@ "Script ",

% ID
@ "CreateClient ",

% Caption
@ (" '" TAG_INSERT_CLIENT "' "),	% JZ 0906

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,


% Label
@ (" '" TAG_INSERT "' "),


% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableCLIENT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),

% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=7; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% JZ 0917 TAG_DELIVERY_POINT_ID

% Instruction... (When Count>0)
CreateClient_Input=(
	"{/*Input(CCLI;" TAG_INSERT_CLIENT ";18;\\\n"
	"(string,CLIENTID," TAG_ID "*,[/*CLIENT.ID*/],50." inputWidth ",0,);\\\n"
	"(string,CLIENTNAME," TAG_NAME "*,,50." inputWidth ",0,);\\\n"
	"(string,ADDRESSINVOICE," TAG_INVOICE_ADDRESS "*,,50." inputWidth ",0);\\\n"
	"(string,ADDRESSSUPINVOICE," TAG_INVOICE_ADDRESS2 ",,50." inputWidth ",1);\\\n"
	"(string,POSTCODE," TAG_POSTCODE ",,50." inputWidth ",0);\\\n"
	"(string,CITY," TAG_CITY "*,,50." inputWidth ",0);\\\n"
	"(string,COUNTRY," TAG_COUNTRY "*,,50." inputWidth ",0);\\\n"
	"(string,VATCODE," TAG_TAX_CODE "*,,30." inputWidth ",0);\\\n"
	"(string,SIRET," TAG_ESTABLISHMENT ",,30." inputWidth ",1);\\\n"
	"(string,IDPOINTDELIVERY," TAG_DELIVERY_POINT_ID "*,,20." inputWidth ",0);\\\n"
	"(string,NAMEDELIVERY," TAG_DELIVERY_NAME "*,,50." inputWidth ",0);\\\n"
	"(string,ADDRESSDELIVERY," TAG_DELIVERY_ADDRESS "*,,50." inputWidth ",0);\\\n"
	"(string,ADDRESSSUPDELIVERY," TAG_DELIVERY_ADDRESS2 ",,50." inputWidth ",1);\\\n"
	"(string,POSTCODEDELIVERY," TAG_DELIVERY_PC ",,10." inputWidth ",1);\\\n"
	"(string,CITYDELIVERY," TAG_DELIVERY_CITY "*,,50." inputWidth ",0);\\\n"
	"(string,COUNTRYDELIVERY," TAG_DELIVERY_COUNTRY ",,50." inputWidth ",1);\\\n"
	"(string,AGENCYNAME," TAG_AGENCY ",[/*CLIENT.NAMEAGENCY*/],50." inputWidth ",0,0,[/*AGENCY.NAMEAGENCY*/]);\\\n"
	"(string,BANKACCOUNT," TAG_BANK_ACCOUNT ",[/*CLIENT.NAMEBANK*/],50." inputWidth ",0,0,[/*BANKACCOUNT.NAMEBANK*/]);\\\n"
	")*/}\\\n"
),
CreateClient_SQL1=(
	" \"INSERT INTO " DB_PREFIX "CLIENT (IdClub, Id, Name, Address, AddressSup, City, PostCode, Country, codeTax, establishment, IdAgency, BankAccount) \
	select '(/*CLUBID*/)', '[/*CLIENTID*/]', '[/*CLIENTNAME*/]', '[/*ADDRESSINVOICE*/]', '[/*ADDRESSSUPINVOICE*/]','[/*CITY*/]','[/*POSTCODE*/]','[/*COUNTRY*/]', '[/*VATCODE*/]','[/*SIRET*/]',ay.Id, b.Id\
	from " DB_PREFIX "AGENCY ay, " DB_PREFIX "BANKACCOUNT b \
	where ay.Name='[/*AGENCYNAME*/]' and b.Name='[/*BANKACCOUNT*/]'\"\\\n"
),
CreateClient_SQL2=(
	" \"INSERT INTO " DB_PREFIX "POINTDELIVERY (IdClient, IdPoint, NameClient, Address, AddressSup, City, PostCode,Country) \
	select '[/*CLIENTID*/]','[/*IDPOINTDELIVERY*/]', '[/*NAMEDELIVERY*/]', '[/*ADDRESSDELIVERY*/]', '[/*ADDRESSSUPDELIVERY*/]','[/*CITYDELIVERY*/]','[/*POSTCODEDELIVERY*/]','[/*COUNTRYDELIVERY*/]'\
	from " DB_PREFIX "CLIENT cl \
	where cl.ID='[/*CLIENTID*/]' and '[/*IDPOINTDELIVERY*/]'>' '\"\n\n"
),



? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Client\CreateClient.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  \\\n"),
		@ CreateClient_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=7; MESSAGE=1;CANCEL=0;WAITCURSOR=0]' \\\n"),
		@ ("'" CreateClient_Input),
		@ ("'\\\n"),
		@ CreateClient_SQL1,
		@ CreateClient_SQL2,
),



