		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ DeleteProduct_SQL1,
),


%=======================================================%
%
%
@ "//// Script 5. Synchronization quantities between PRODUCT, ClientOrder, Delivery, Packing List=\n\n",

% Script
@ "Script ",

% ID
@ "UpdateQuantities",

% Caption
@ (" '" TAG_CLEAN_QUANTITY_DATA "' "),	% JZ 1001

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW5,

% Label
@ (" '" TAG_CLEAN_QUANTITY_DATA "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
%@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% Instruction... (When Count>0)
UpdateProductQty_SQL1 = (
	"\"Update " DB_PREFIX "DELIVERY_PRODUCT set QuantityReal=Quantity where QuantityReal is NULL\"\\\n"
),
UpdateProductQty_SQL2 = (
	"\"Update " DB_PREFIX "DELIVERY_PRODUCT set QuantityDefective=0 where QuantityDefective is NULL\"\\\n"
),

%%% ORDER_PRODUCT
	databaseType = "ACCESS" => (
		UpdateProductQty_SQL3 = (
			"\"Update " DB_PREFIX "ORDER_PRODUCT OP set OP.QuantityPicked=0\
			where not exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=OP.IdOrder and O.IdState='9')\"\\\n"
		),
		UpdateProductQty_SQL4 = (
			"\"Update " DB_PREFIX "ORDER_PRODUCT OP set OP.QuantityDelivered=0 \
			where not exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=OP.IdOrder and O.IdState='9')\"\\\n"
		),
		UpdateProductQty_SQL5 = (
			"\"Update " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "DELIVERY_PRODUCT DP on OP.IdOrder=DP.IdOrder and OP.IdProduct=DP.IdProduct set \
			OP.QuantityDelivered= OP.QuantityDelivered - DP.QuantityDefective + DP.QuantityReal,\
			OP.QuantityPicked	= OP.QuantityPicked + iif(DP.IdPacking<>'STOCK', DP.QuantityReal, 0)\
			where not exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=OP.IdOrder and O.IdState='9')\"\\\n"
		),
		;
		
		UpdateProductQty_SQL3 = (
			"\"Update " DB_PREFIX "ORDER_PRODUCT set \
				QuantityDelivered=(select sum(DP.QuantityReal-DP.QuantityDefective) from " DB_PREFIX "DELIVERY_PRODUCT DP where ORDER_PRODUCT.IdOrder=DP.IdOrder and ORDER_PRODUCT.IdProduct=DP.IdProduct),\
				QuantityPicked=(select sum(DP.QuantityReal) from " DB_PREFIX "DELIVERY_PRODUCT DP where ORDER_PRODUCT.IdOrder=DP.IdOrder and ORDER_PRODUCT.IdProduct=DP.IdProduct and DP.IdPacking<>'STOCK')\
			where not exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=IdOrder and O.IdState='9')\"\\\n"
		),
		UpdateProductQty_SQL4 = (
			"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityPicked=0\
			where QuantityPicked is NULL and not exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=IdOrder and O.IdState='9')\"\\\n"
		),
		UpdateProductQty_SQL5 = (
			"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityDelivered=0 \
			where QuantityDelivered is NULL and not exists (select 1 from " DB_PREFIX "CLIENTORDER O where O.Id=IdOrder and O.IdState='9')\"\\\n"
		),
	),

	UpdateProductQty_SQL6 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityRest=-QuantityDelivered + Quantity\
		where not exists (select 1 from " DB_PREFIX "CLIENTORDER where Id=IdOrder and IdState='9')\"\\\n"
	),

	UpdateProductQty_SQL7 = (
		"\"Update " DB_PREFIX "PRODUCT set QuantityIn=0 where QuantityIn is NULL\"\\\n"
	),

%%% CLIENTORDER
	databaseType = "ACCESS" => (
		UpdateProductQty_SQL8 = (
			"\"Update " DB_PREFIX "CLIENTORDER set Quantity=0\
			where IdState<>'9'\"\\\n"
		),
		UpdateProductQty_SQL9 = (
			"\"Update " DB_PREFIX "CLIENTORDER set QuantityRest=0\
			where IdState<>'9'\"\\\n"
		),
		UpdateProductQty_SQL10 = (
			"\"Update " DB_PREFIX "CLIENTORDER O inner join " DB_PREFIX "ORDER_PRODUCT OP on OP.IdOrder=O.Id set \
				O.Quantity=O.Quantity + OP.Quantity,\
				O.QuantityRest=O.QuantityRest + OP.QuantityRest\
			where O.IdState<>'9'\"\\\n"
		),
		;

		UpdateProductQty_SQL8 = (
			"\"Update " DB_PREFIX "CLIENTORDER set \
				Quantity=(select sum(OP.Quantity) from " DB_PREFIX "ORDER_PRODUCT OP where OP.IdOrder=Id),\
				QuantityRest=(select sum(OP.QuantityRest) from " DB_PREFIX "ORDER_PRODUCT OP where OP.IdOrder=Id)\
			where IdState<>'9'\"\\\n"
		),
		UpdateProductQty_SQL9 = (
			"\"Update " DB_PREFIX "CLIENTORDER set Quantity=0 where Quantity is NULL\"\\\n"
		),
		UpdateProductQty_SQL10 = (
			"\"Update " DB_PREFIX "CLIENTORDER set QuantityRest=0 where QuantityRest is NULL\"\\\n"
		),
	),

%%% PRODUCT
	databaseType = "ACCESS" => (
		UpdateProductQty_SQL11 = (
			"\"Update " DB_PREFIX "PRODUCT SET\
				QuantityOrdered=0,\
				QuantityStock=0,\
				QuantitySupplied=0\"\\\n"
		),

		UpdateProductQty_SQL12 = (
			"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "CLIENTORDER O on O.Id=OP.IdOrder) on P.Id=OP.IdProduct set \
			P.QuantityOrdered=P.QuantityOrdered+OP.QuantityRest \
			where O.IdState<>'9' \"\\\n"
		),
		UpdateProductQty_SQL13 = (
			"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "PALLET_PRODUCT PP inner join " DB_PREFIX "PACKING PK on PK.Id=PP.IdPacking) on P.Id=PP.IdProduct set \
				P.QuantityStock=P.QuantityStock+PP.QuantityStock \
			where PK.IdState<>'9' \"\\\n"
		),
		UpdateProductQty_SQL14 = (
			"\"Update " DB_PREFIX "PRODUCT P inner join (" DB_PREFIX "SUPPLY_PRODUCT SP inner join " DB_PREFIX "SUPPLY S on S.Id=SP.IdSupply) on P.Id=SP.IdProduct set \
				P.QuantitySupplied=P.QuantitySupplied+SP.Quantity \
			where S.IdState<>'9' \"\\\n"
		),
		;

		UpdateProductQty_SQL11 = (
			"\"Update " DB_PREFIX "PRODUCT set \
				QuantityOrdered=(select sum(OP.QuantityRest) from " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "CLIENTORDER O on O.Id=OP.IdOrder where PRODUCT.Id=OP.IdProduct and O.IdState<>'9' ),\
				QuantityStock=(select sum(PP.QuantityStock) from " DB_PREFIX "PALLET_PRODUCT PP inner join " DB_PREFIX "PACKING PK on PK.Id=PP.IdPacking where PRODUCT.Id=PP.IdProduct and PK.IdState<>'9' ),\
				QuantitySupplied=(select sum(SP.Quantity) from " DB_PREFIX "SUPPLY_PRODUCT SP inner join " DB_PREFIX "SUPPLY S on S.Id=SP.IdSupply where PRODUCT.Id=SP.IdProduct and S.IdState<>'9' ) \"\\\n"
		),
		UpdateProductQty_SQL12 = (
			"\"Update " DB_PREFIX "PRODUCT set QuantityOrdered=0 where QuantityOrdered is NULL\"\\\n"
		),
		UpdateProductQty_SQL13 = (
			"\"Update " DB_PREFIX "PRODUCT set QuantityStock=0 where QuantityStock is NULL\"\\\n"
		),
		UpdateProductQty_SQL14 = (
			"\"Update " DB_PREFIX "PRODUCT set QuantitySupplied=0 where QuantitySupplied is NULL\"\\\n"
		),
	),

	UpdateProductQty_SQL15 = (
		"\"Update " DB_PREFIX "PRODUCT set QuantityPackaging=1 where QuantityPackaging is NULL or QuantityPackaging<=0\"\\\n"
	),

? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Script\ScriptUpdateProductQuantity.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)' \\\n"),
		@ ("Reload _ _ _\n\n"),
		;
	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ UpdateProductQty_SQL1,
		@ UpdateProductQty_SQL2,
		@ UpdateProductQty_SQL3,
		@ UpdateProductQty_SQL4,
		@ UpdateProductQty_SQL5,
		@ UpdateProductQty_SQL6,
		@ UpdateProductQty_SQL7,
		@ UpdateProductQty_SQL8,
		@ UpdateProductQty_SQL9,
		@ UpdateProductQty_SQL10,
		@ UpdateProductQty_SQL11,
		@ UpdateProductQty_SQL12,
		@ UpdateProductQty_SQL13,
		@ UpdateProductQty_SQL14,
		@ UpdateProductQty_SQL15,

		@ ("\n\n\n"),
),

%=======================================================%
%
%
@ "//// Script 6. update selected value\n\n",

% Script
@ "Script ",

% ID
@ "SelectDeselect ",

% Caption
@ (" '" TAG_SELECT_DESELECT "' "),	

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW6,


% Label
@ (" '" TAG_SELECT_DESELECT "' "),



% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
sqlProductSelected = (
	"UPDATE " DB_PREFIX "PRODUCT p SET p.selected="
		SQL_CASEWHEN "p.selected IS NULL OR p.selected='" STATE_FALSE "'"
			SQL_THEN "'" STATE_TRUE "'"
			SQL_ELSE "'" STATE_FALSE "'"
		SQL_CASEEND
),

SetSelected_SQL1=(
	"\"" sqlProductSelected " WHERE p.id in ([/*PRODUCT.ID*/]) \"\n\n\n"
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\SelectDeselectProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tablePRODUCT;1;(string,ID))*/}  \\\n"),
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ SetSelected_SQL1,
		@ ("Reload _ _ _ \n\n\n"),
),

.



