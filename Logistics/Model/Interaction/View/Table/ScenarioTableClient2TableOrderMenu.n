% Script
@ "Script ",

% ID
@ "TableOrderClient ",

% Caption
@ (" '" TAG_ORDER_FOR_CLIENT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_TABLE_ORDER,

% Label
@ (" '" TAG_ORDERS "' "),


% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableClient' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"



@ (PREFIX_OPENTABLE_BEGIN "TableOrder_Menu.view" OPENTABLE_END),

@ (TABLE_ARGUMENTS "IDCOLOR=(250 250 250);IDTOUR='XXX';TITLEOBJ=" TAG_ORDER_FOR_CLIENT " {/*Selected(tableCLIENT;1;(string,ID))*/};OWNEROBJ=IdClient;IDOBJ={/*Selected(tableCLIENT;1;(string,ID))*/};OWNERSUBOBJ=IdProduct;IDSUBOBJ='XXX']\"\n\n"),

