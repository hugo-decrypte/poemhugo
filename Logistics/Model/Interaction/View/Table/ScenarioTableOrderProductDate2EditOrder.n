% Script
@ "Script ",

% ID
@ "EditOrderProduct ",

% Caption
@ ("'" TAG_EDIT  "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT,

% Label
%@ (" 'Editer Détail Commande' "),
@ (" '" TAG_EDIT  "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDERPRODUCTDATE' ", 	% JZ 1018

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

@ (PREFIX_POEMDATA_OPEN "ORDER_PRODUCT_DATE&idOrder in ({/*selected(ORDERPRODUCTDATE;1;(string,ID))*/}) and idProduct in ({/*selected(tableORDER;1;(string,IDPRODUCT))*/})\"\n"),

