UpdateDiscount_Input = (
	"{/*Input(ModDis;" TAG_UPDATE_DISCOUNT ";2;\\\n"
	"(float,DISCOUNT," TAG_DISCOUNT ",[/*PRODUCTFORORDER.DISCOUNT*/],4.1.580,1,,);\\\n"
	"(string,LABELDISCOUNT," TAG_DISCOUNT_LABEL ",[/*PRODUCTFORORDER.LABELDISCOUNT*/],100." inputWidth ",1,,);\\\n"
	")*/}\\\n"
),

UpdateDiscount_SQL1 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set Discount=[/*DISCOUNT*/], LabelDiscount='[/*LABELDISCOUNT*/]'\\\n"
	"  WHERE IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\\\n"
	"    and IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
),

UpdateDiscount_SQL2 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set Discount=0 WHERE IdOrder in ('[/*PRODUCTFORORDER.ID*/]') and Discount is NULL \"\\\n"
),

databaseType = "ACCESS" => (

	UpdateDiscount_SQL3 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "ORDER_PRODUCT OP on P.Id=OP.IdProduct\\\n"
		"  set OP.IdVAT=P.IdVAT\\\n"
		" where OP.IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\\\n"
		"  and (OP.IdVAT is NULL or OP.IdVAT<= ' ') \"\\\n"
		"\\\n"
	),

	UpdateDiscount_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER O set O.AmountHT=0 WHERE O.Id in ('[/*PRODUCTFORORDER.ID*/]') \"\\\n"
	),
	UpdateDiscount_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "ORDER_PRODUCT OP  \\\n"
		"  set O.AmountHT=O.AmountHT + round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0 \\\n"
		" where O.Id=OP.IdOrder and OP.IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\"\n\n"
	),
	;

	UpdateDiscount_SQL3 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT \\\n"
		"  set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct) \\\n"
		" where IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\\\n"
		"  and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
		"\\\n"
	),

	UpdateDiscount_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER \\\n"
		"  set AmountHT=(select sum(round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0) from " DB_PREFIX "ORDER_PRODUCT OP where Id=OP.IdOrder)\\\n"
		" WHERE Id in ('[/*PRODUCTFORORDER.ID*/]')\"\\\n"
	),
	UpdateDiscount_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER set AmountHT=0 WHERE Id in ('[/*PRODUCTFORORDER.ID*/]') and AmountHT is NULL\"\n\n"
	),
),

%%? typeExecute (
%%	"NCL" :
 typeExecute = "NCL" => (
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),

		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\UpdateProductDiscount.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
