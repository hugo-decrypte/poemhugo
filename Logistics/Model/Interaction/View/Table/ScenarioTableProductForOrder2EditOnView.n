%===============================================================================================================
%
@ ("// \n"),
@ ("//  6. Modify Price\n"),
@ ("//  \n"),

% Script
@ "Script ",

% ID
@ "ModifyPriceUnit ",

% Caption
@ (" '" TAG_UPDATE_UNIT_PRICE "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW6,

% Label
@ (" '" TAG_UPDATE_UNIT_PRICE "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTFORORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)


UpdatePrice_Input = (
	"{/*Input(MPU;" TAG_UPDATE_UNIT_PRICE ";1;\\\n"
	"(float,PRICE," TAG_PRICE_UNIT ",[/*PRODUCTFORORDER.PRICE*/],10.4.580,0);\\\n"
	")*/}\\\n"
),

UpdatePrice_SQL1 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set PriceUnit=[/*PRICE*/]\\\n"
	"  WHERE IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\\\n"
	"    and IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
),

UpdatePrice_SQL2 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set Discount=0 WHERE IdOrder in ('[/*PRODUCTFORORDER.ID*/]') and Discount is NULL \"\\\n"
),

databaseType = "ACCESS" => (

	UpdatePrice_SQL3 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "ORDER_PRODUCT OP on P.Id=OP.IdProduct\\\n"
		"  set OP.IdVAT=P.IdVAT\\\n"
		" where OP.IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\\\n"
		"  and (OP.IdVAT is NULL or OP.IdVAT<= ' ') \"\\\n"
	),

	UpdatePrice_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER O set O.AmountHT=0 WHERE O.Id in ('[/*PRODUCTFORORDER.ID*/]') \"\\\n"
	),
	UpdatePrice_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "ORDER_PRODUCT OP  \\\n"
		"  set O.AmountHT=O.AmountHT + round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0 \\\n"
		" where O.Id=OP.IdOrder and OP.IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\"\n\n"
	),
	;

	UpdatePrice_SQL3 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT \\\n"
		"  set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct) \\\n"
		" where IdOrder in ('[/*PRODUCTFORORDER.ID*/]')\\\n"
		"  and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
		"\\\n"
	),

	UpdatePrice_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER \\\n"
		"  set AmountHT=(select sum(round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0) from " DB_PREFIX "ORDER_PRODUCT OP where Id=OP.IdOrder)\\\n"
		" WHERE Id in ('[/*PRODUCTFORORDER.ID*/]')\"\\\n"
	),
	UpdatePrice_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER set AmountHT=0 WHERE Id in ('[/*PRODUCTFORORDER.ID*/]') and AmountHT is NULL\"\n\n"
	),

),

 typeExecute = "NCL" => (
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\UpdateProductPrice.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tablePRODUCTFORORDER;1;(string,IDPRODUCT))*/} \\\n"),
		@ "(/*IDORDER*/) ",
		@ UpdatePrice_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=5;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'\\\n"),
		@ UpdatePrice_Input,
		@ ("'\\\n"),
		@ UpdatePrice_SQL1,
		@ UpdatePrice_SQL2,
		@ UpdatePrice_SQL3,
		@ UpdatePrice_SQL4,
		@ UpdatePrice_SQL5,
),


@ ("\n\n\n"),

