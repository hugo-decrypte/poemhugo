UpdateOrderProductComment_Input = (
	"{/*Input(" TAG_UPDATE_COMMENT " : [/*PRODUCTFORORDER.IDPRODUCT*/];1;\\\n"
	"(string,COMMENTS," TAG_COMMENT ",[/*PRODUCTFORORDER.COMMENTS*/],100." inputWidth ",1);\\\n"
	")*/}"
),

