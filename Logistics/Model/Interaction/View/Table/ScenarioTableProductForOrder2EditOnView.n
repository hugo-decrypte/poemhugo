%===============================================================================================================
%
@ ("// \n"),
@ ("// 8. add a pack of all products selected ; add the product into command if it is not in the command\n"),
@ ("// update quantity in Command, product\n\n"),

% Script
@ "Script ",

% ID
@ "AddMultiSelectToOrder ",

% Caption
@ ("'Add To Order' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW8,

% Label
@ (" 'Ajouter Produits dans Commande' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTFORORDER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

% @ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)


AddMultiSelectToOrder_SQL1 = (
"\"INSERT INTO " DB_PREFIX "ORDER_PRODUCT (IdOrder, IdProduct, Quantity, QuantityDelivered, QuantityRest, Discount, Comments, NoPallet) \
  select O.ID, P.id, 0, 0, 0, 0, ' ', 1 \
 from " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "PRODUCT P \
 WHERE O.ID in ((/*IDORDER*/)) AND P.id in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \
 and not exists (select 1 from " DB_PREFIX "ORDER_PRODUCT OP where OP.IdOrder=O.ID and OP.IdProduct=P.id )  \"\\\n"
),

AddMultiSelectToOrder_SQL2 = (
"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityDelivered=0 WHERE IdOrder in ((/*IDORDER*/)) and QuantityDelivered is NULL and IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]')  \"\\\n"
),
AddMultiSelectToOrder_SQL3 = (
"\"Update " DB_PREFIX "ORDER_PRODUCT set QuantityRest=Quantity WHERE IdOrder in ((/*IDORDER*/)) and QuantityRest is NULL and IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]')  \"\\\n"
),


databaseType = "ACCESS" => (

	AddMultiSelectToOrder_SQL4 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "PRODUCT P on P.Id=OP.IdProduct\
		set OP.Quantity=OP.Quantity+P.QuantityPackaging, OP.QuantityRest=OP.QuantityRest+P.QuantityPackaging \
		WHERE OP.IdOrder in ((/*IDORDER*/))\
		 and OP.IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
	),

	AddMultiSelectToOrder_SQL5 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "PRODUCT P on P.Id=OP.IdProduct \
		 set OP.PriceUnit=P.PriceUnit\
		 WHERE (OP.PriceUnit is NULL or OP.PriceUnit<=0) and OP.IdOrder in ((/*IDORDER*/)) \"\\\n"
	),

	AddMultiSelectToOrder_SQL6 = (
		"\"Update " DB_PREFIX "CLIENTORDER O set O.Quantity=0, QuantityRest=0, O.Weight=0, O.AmountHT=0 WHERE O.ID in ((/*IDORDER*/)) \"\\\n"
	),
	AddMultiSelectToOrder_SQL7 = (
		"\"Update " DB_PREFIX "CLIENTORDER O inner join " DB_PREFIX "ORDER_PRODUCT OP on O.ID=OP.IdOrder set \
			O.Quantity=O.Quantity+OP.Quantity,\
			O.QuantityRest = O.QuantityRest + OP.QuantityRest,\
			O.AmountHT=O.AmountHT+ int(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount)+0.5)/100.0\
		WHERE O.ID in ((/*IDORDER*/)) \"\\\n"
	),
	AddMultiSelectToOrder_SQL8 = (
		"\"Update (" DB_PREFIX "CLIENTORDER O inner join " DB_PREFIX "ORDER_PRODUCT OP on O.ID=OP.IdOrder) inner join " DB_PREFIX "PRODUCT P on P.Id=OP.IdProduct  set \
			O.Weight=O.Weight+OP.Quantity*P.Weight\
		WHERE O.ID in ((/*IDORDER*/)) \"\\\n"
	),
	;

	AddMultiSelectToOrder_SQL4 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT set \
			Quantity=Quantity  		 +(select P.QuantityPackaging from " DB_PREFIX "PRODUCT P where P.Id=IdProduct),\
			QuantityRest=QuantityRest+(select P.QuantityPackaging from " DB_PREFIX "PRODUCT P where P.Id=IdProduct) \
		WHERE IdOrder in ((/*IDORDER*/))\
		 and IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
	),

	AddMultiSelectToOrder_SQL5 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT \
		 set PriceUnit=(select P.PriceUnit from " DB_PREFIX "PRODUCT P where P.Id=IdProduct )\
		 WHERE (PriceUnit is NULL or PriceUnit<=0) and IdOrder in ((/*IDORDER*/)) \"\\\n"
	),

	AddMultiSelectToOrder_SQL6 = (
		"\"Update " DB_PREFIX "CLIENTORDER set \
			Quantity=(select sum(OP.Quantity) from " DB_PREFIX "ORDER_PRODUCT OP where ID=OP.IdOrder),\
			QuantityRest = (select sum(OP.QuantityRest) from " DB_PREFIX "ORDER_PRODUCT OP where ID=OP.IdOrder),\
			AmountHT   = (select sum(TRUNCATE(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount)+0.5)/100.0) from " DB_PREFIX "ORDER_PRODUCT OP where ID=OP.IdOrder),\
			Weight=(select sum(OP.Quantity*P.Weight) from " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "PRODUCT P on P.Id=OP.IdProduct where CLIENTORDER.ID=OP.IdOrder and P.Weight is not NULL)\
		WHERE ID in ((/*IDORDER*/)) \"\\\n"
	),
	AddMultiSelectToOrder_SQL7 = (
		"\"Update " DB_PREFIX "CLIENTORDER set Quantity=0, QuantityRest=0, AmountHT=0 WHERE ID in ((/*IDORDER*/)) and Quantity is NULL \"\\\n"
	),
	AddMultiSelectToOrder_SQL8 = (
		"\"Update " DB_PREFIX "CLIENTORDER set Weight=0 WHERE ID in ((/*IDORDER*/)) and Weight is NULL \"\\\n"
	),

),

AddMultiSelectToOrder_SQL9 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set NoPallet=0 WHERE IdOrder in ((/*IDORDER*/)) and NoPallet is NULL \"\\\n"
),


databaseType = "ACCESS" => (

	AddMultiSelectToOrder_SQL10 = (
		"\"Update " DB_PREFIX "PRODUCT P set P.QuantityOrdered=0 WHERE P.Id in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
	),
	AddMultiSelectToOrder_SQL11 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join ( " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "CLIENTORDER O on O.ID=OP.IdOrder) ON P.id=OP.idorder set\
			P.QuantityOrdered=P.QuantityOrdered+OP.QuantityRest \
			WHERE P.Id=OP.IdProduct and O.IdState<>'9'\
			 AND P.Id in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
	),

	AddMultiSelectToOrder_SQL12 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "ORDER_PRODUCT OP on P.Id=OP.IdProduct\
		  set OP.IdVAT=P.IdVAT\
		 where OP.IdOrder in ((/*IDORDER*/))\
		  and (OP.IdVAT is NULL or OP.IdVAT<= ' ') \"\n\n\n"
	),
	;


	AddMultiSelectToOrder_SQL10 = (
		"\"Update " DB_PREFIX "PRODUCT set\
		 QuantityOrdered=(select sum(OP.QuantityRest) \
			from " DB_PREFIX "ORDER_PRODUCT OP inner join " DB_PREFIX "CLIENTORDER O on O.ID=OP.IdOrder \
			where PRODUCT.Id=OP.IdProduct and O.IdState<>'9')\
		WHERE PRODUCT.Id in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') \"\\\n"
	),
	AddMultiSelectToOrder_SQL11 = (
		"\"Update " DB_PREFIX "PRODUCT set QuantityOrdered=0 WHERE Id in ('[/*PRODUCTFORORDER.IDPRODUCT*/]') and QuantityOrdered is NULL \"\\\n"
	),

	AddMultiSelectToOrder_SQL12 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT\
		  set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct )\
		 where IdOrder in ((/*IDORDER*/))\
		  and (IdVAT is NULL or IdVAT<= ' ') \"\n\n\n"
	),
),

? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=0;COUNT=3;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\AddProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) \\\n"),
		@ ("{/*Selected(tablePRODUCTFORORDER;1;(string,IDPRODUCT))*/} \\\n"),
		@ ("(/*IDORDER*/)"),
		@ ("'\\\n"),
		@ ("Reload ViewTableOrder \\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ AddMultiSelectToOrder_SQL1,
		@ AddMultiSelectToOrder_SQL2,
		@ AddMultiSelectToOrder_SQL3,
		@ AddMultiSelectToOrder_SQL4,
		@ AddMultiSelectToOrder_SQL5,
		@ AddMultiSelectToOrder_SQL6,
		@ AddMultiSelectToOrder_SQL7,
		@ AddMultiSelectToOrder_SQL8,
		@ AddMultiSelectToOrder_SQL9,
		@ AddMultiSelectToOrder_SQL10,
		@ AddMultiSelectToOrder_SQL11,
		@ AddMultiSelectToOrder_SQL12,
),
