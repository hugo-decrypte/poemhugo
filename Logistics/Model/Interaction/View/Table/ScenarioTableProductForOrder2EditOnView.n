	"\"Update " DB_PREFIX "ORDER_PRODUCT set Comments='[/*COMMENTS*/]', Comments_1='[/*COMMENTS2*/]'\
	WHERE IdOrder in ('[/*PRODUCTFORORDER.IDQUOTE*/]')\
	and IdProduct in ('[/*PRODUCTFORORDER.IDPRODUCT*/]')\"\n\n"
),
