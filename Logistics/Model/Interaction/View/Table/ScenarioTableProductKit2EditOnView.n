@ "// Script 1. Create Product\n\n",

% Script
@ "Script ",

% ID
@ "CreateProduct ",

% Caption
@ (" '" TAG_INSERT_PRODUCT_KIT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,

% Label
@ (" '" TAG_INSERT "' "),	% JZ 1001

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTKIT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)

CreateProduct_Input=(
	"{/*Input(CPRD;" TAG_INSERT_PRODUCT_KIT ";4;\\\n"
	"(string,IDNEW,Nouveau ID,,20." inputWidth ",0);\\\n"
	"(string,FAMILY,Famille,,50." inputWidth ",0,1,[/*FAMILYPRODUCT.LABELFAMILY*/],1);\\\n"
	"(string,DESIGNATION," TAG_DESIGNATION ",,50." inputWidth ",1);\\\n"
	"(string,TYPEPRODUCT," TAG_PRODUCT_TYPE ",,100." inputWidth ",0,0,[/*TYPEPRODUCT.LABELTYPE*/]);\\\n"
	")*/}"
),	% JZ 0908

CreateProduct_SQL1=(
	"\"INSERT INTO " DB_PREFIX "PRODUCT (IdClub,Id, Family, Designation, TypeProduct, IdState) \
	values ('(/*CLUBID*/)', '[/*IDNEW*/]', ' ', '[/*DESIGNATION*/]', 'P', '1')\"\\\n"
),

databaseType = "ACCESS" => (

	CreateProduct_SQL2=(
		"\"Update " DB_PREFIX "PRODUCT p, " DB_PREFIX "FAMILYPRODUCT f \
		SET p.Family=f.ID, p.Category=f.Category\
		WHERE p.Id ='[/*IDNEW*/]'\
			and "SQL_CONCAT"trim(f.DESIGNATION) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(f.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*FAMILY*/]'\"\\\n"
	),
	CreateProduct_SQL3=(
		"\"UPDATE " DB_PREFIX "PRODUCT p, " DB_PREFIX "TYPEPRODUCT tp \
		SET p.TypeProduct=tp.ID\
		where p.Id ='[/*IDNEW*/]'\
			and "SQL_CONCAT"trim(tp.Name) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(tp.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND"='[/*TYPEPRODUCT*/]'\"\n\n\n"
	),
	;

	CreateProduct_SQL2=(
		"\"Update " DB_PREFIX "PRODUCT set  \
			Family=(select f.ID from  " DB_PREFIX "FAMILYPRODUCT f where "SQL_CONCAT"trim(f.DESIGNATION) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(f.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*FAMILY*/]'), \
			Category=(select f.Category from  " DB_PREFIX "FAMILYPRODUCT f where "SQL_CONCAT"trim(f.DESIGNATION) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(f.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*FAMILY*/]')\
		WHERE Id ='[/*IDNEW*/]' \"\\\n"
	),
	CreateProduct_SQL3=(
		"\"UPDATE " DB_PREFIX "PRODUCT   \
		SET TypeProduct=select tp.ID from " DB_PREFIX "TYPEPRODUCT tp where "SQL_CONCAT"trim(tp.Name) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(tp.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND"='[/*TYPEPRODUCT*/]')\
		where Id ='[/*IDNEW*/]' \"\n\n\n"
	),
),


? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\CreateProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) \\\n"),
		@ CreateProduct_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" CreateProduct_Input),
		@ ("'\\\n"),
		@ CreateProduct_SQL1,
		@ CreateProduct_SQL2,
		@ CreateProduct_SQL3,
),



%=======================================================%
%
%
@ "// Script 2. Duplicate Product\n\n",

% Script
@ "Script ",

% ID
@ "DuplicateProduct ",

% Caption
@ (" '" TAG_COPY_PRODUCT_KIT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW2,

% Label
@ (" '" TAG_COPY "' "),	% JZ 1001

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTKIT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
DuplicateProduct_Input=(
	"{/*Input(DPRD;" TAG_COPY_PRODUCT_KIT ";1;\\\n"
	"(string,IDNEW,Nouveau ID,,20." inputWidth ",0);\\\n"
	")*/}"
),

DuplicateProduct_SQL1=(
	"\"INSERT INTO " DB_PREFIX "PRODUCT (Id, Family, Designation,DesignationTech, TypeProduct,Category, PriceUnit, PurchasePrice,WeightUnity, LengthUnity, Length,Height,Width,Depth,Volume,Weight, IdState) \
	select '[/*IDNEW*/]', p.Family, p.Designation,p.DesignationTech, p.TypeProduct, Category, PriceUnit, PurchasePrice,p.WeightUnity, p.LengthUnity, p.Length,p.Height,p.Width,p.Depth,p.Volume,p.Weight, '0'\
	from " DB_PREFIX "PRODUCT p\
	where p.Id ='[/*PRODUCTKIT.ID*/]'\"\\\n"
),

DuplicateProduct_SQL2=(
	"\"INSERT INTO " DB_PREFIX "PRODUCT_COMPONENT (IdProduct,IdSubProduct, Quantity,PriceUnit, OrderByLength, OrderByHeight, OrderByWidth, OrderByDepth, LengthByPiece,HeightByPiece, WidthByPiece, DepthByPiece, VolumeByPiece) \
	select '[/*IDNEW*/]', pc.IdSubProduct, pc.Quantity,pc.PriceUnit, pc.OrderByLength, pc.OrderByHeight, pc.OrderByWidth, pc.OrderByDepth, pc.LengthByPiece,pc.HeightByPiece, pc.WidthByPiece, pc.DepthByPiece, pc.VolumeByPiece\
	from " DB_PREFIX "PRODUCT_COMPONENT pc\
	where pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\"\n\n"
),


? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\DuplicateProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tablePRODUCTKIT;1;(string,ID))*/} \\\n"),
		@ DuplicateProduct_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" DuplicateProduct_Input),
		@ ("'\\\n"),
		@ DuplicateProduct_SQL1,
		@ DuplicateProduct_SQL2,
),
@ ("\n\n\n"),



%=======================================================%
%
%
@ "// Script 3. Modify Product\n\n",

% Script
@ "Script ",

% ID
@ "ModifyProduct ",

% Caption
@ ("'" TAG_UPDATE_PRODUCT_KIT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW3,

% Label
@ (" '" TAG_UPDATE "' "),	% JZ 1001

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTKIT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
UpdateProduct_Input=(
	"{/*Input(MPRD;" TAG_UPDATE_PRODUCT_KIT ";6;\\\n"
	"(string,DESIGNATION," TAG_DESIGNATION ",[/*PRODUCTKIT.DESIGNATION*/],50." inputWidth ",0);\\\n"
	"(string,DESIGNATIONTECH," TAG_DESIGNATIONTECH ",[/*PRODUCTKIT.DESIGNATIONTECH*/],50." inputWidth ",1);\\\n"
	"(string,FAMILY," TAG_FAMILY ",[/*PRODUCTKIT.LABELFAMILY*/],50." inputWidth ",0,1,[/*FAMILYPRODUCT.LABELFAMILY*/],1);\\\n"
	"(string,TYPEPRODUCT," TAG_TYPE ",[/*PRODUCTKIT.LABELTYPE*/],50." inputWidth ",0,1,[/*TYPEPRODUCT.LABELTYPE*/],1);\\\n"
	"(float,PRICE," TAG_PRICE_UNIT ",[/*PRODUCTKIT.PRICE*/],10.4.580,1);\\\n"
	"(float,WEIGHT," TAG_WEIGHT ",[/*PRODUCTKIT.WEIGHT*/],10.3.580,1);\\\n"
	")*/}"
),



UpdateProduct_SQL1=(
	"\"UPDATE " DB_PREFIX "PRODUCT SET \
		Designation='[/*DESIGNATION*/]',\
		DesignationTech='[/*DESIGNATIONTECH*/]',\
		Weight=[/*WEIGHT*/],\
		PriceUnit=[/*PRICE*/]\
	where Id ='[/*PRODUCTKIT.ID*/]'\"\\\n"
),

databaseType = "ACCESS" => (
	%% family, category
	UpdateProduct_SQL2=(
		"\"Update " DB_PREFIX "PRODUCT p, " DB_PREFIX "FAMILYPRODUCT f \
		SET p.Family=f.ID, p.Category=f.Category\
		WHERE p.Id ='[/*IDNEW*/]'\
			and "SQL_CONCAT"trim(f.DESIGNATION) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(f.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*FAMILY*/]'\"\\\n"
	),
	%% type
	UpdateProduct_SQL3=(
		"\"UPDATE " DB_PREFIX "PRODUCT p, " DB_PREFIX "TYPEPRODUCT tp SET \
			p.TypeProduct=tp.ID\
		where p.Id ='[/*IDNEW*/]'\
			and "SQL_CONCAT"trim(tp.Name) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(tp.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND"='[/*TYPEPRODUCT*/]'\"\n\n\n"
	),

	%% price, weight
	UpdateProduct_SQL4=(
		"\"Update " DB_PREFIX "PRODUCT set \
			PriceUnit=0, Weight=0 \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT pc0 where pc0.IdProduct=Id and pc0.IdSubProduct='[/*PRODUCTKIT.ID*/]')\"\\\n"
	),
	UpdateProduct_SQL5=(
		"\"Update " DB_PREFIX "PRODUCT p inner join (" DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sp on sp.Id=pc.IdSubProduct) on p.Id=pc.IdProduct set \
			p.PriceUnit=p.PriceUnit+sp.PriceUnit*pc.Quantity \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT pc0 where pc0.IdProduct=p.Id and pc0.IdSubProduct='[/*PRODUCTKIT.ID*/]')\"\\\n"
	),
	UpdateProduct_SQL6=(
		"\"Update " DB_PREFIX "PRODUCT p inner join (" DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sp on sp.Id=pc.IdSubProduct) on p.Id=pc.IdProduct set \
			p.Weight=p.Weight+sp.Weight*pc.Quantity \
		where sp.Weight is not NULL and exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT pc0 where pc0.IdProduct=p.Id and pc0.IdSubProduct='[/*PRODUCTKIT.ID*/]')\"\\\n"
	),

	;

	UpdateProduct_SQL2=(
		"\"Update " DB_PREFIX "PRODUCT set  \
			Family=(select f.ID from  " DB_PREFIX "FAMILYPRODUCT f where "SQL_CONCAT"trim(f.DESIGNATION) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(f.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*FAMILY*/]'), \
			Category=(select f.Category from  " DB_PREFIX "FAMILYPRODUCT f where "SQL_CONCAT"trim(f.DESIGNATION) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(f.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*FAMILY*/]')\
		WHERE Id ='[/*IDNEW*/]' \"\\\n"
	),
	UpdateProduct_SQL3=(
		"\"UPDATE " DB_PREFIX "PRODUCT set \
			TypeProduct=(select tp.ID from " DB_PREFIX "TYPEPRODUCT tp where "SQL_CONCAT"trim(tp.Name) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(tp.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND"='[/*TYPEPRODUCT*/]')\
		where Id ='[/*IDNEW*/]' \"\n\n\n"
	),

	UpdateProduct_SQL4=(
		"\"Update " DB_PREFIX "PRODUCT set \
			PriceUnit=(select sum(sp.PriceUnit*pc.Quantity) from " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sp on sp.Id=pc.IdSubProduct where PRODUCT.Id=pc.IdProduct), \
			Weight=(select sum(sp.Weight*pc.Quantity) from " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sp on sp.Id=pc.IdSubProduct where PRODUCT.Id=pc.IdProduct) \
		where exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT pc0 where pc0.IdProduct=Id and pc0.IdSubProduct='[/*PRODUCTKIT.ID*/]')\"\\\n"
	),
	UpdateProduct_SQL5=(
		"\"Update " DB_PREFIX "PRODUCT set \
			PriceUnit=0 \
		where PriceUnit is NULL and exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT pc0 where pc0.IdProduct=Id and pc0.IdSubProduct='[/*PRODUCTKIT.ID*/]')\"\\\n"
	),
	UpdateProduct_SQL6=(
		"\"Update " DB_PREFIX "PRODUCT set \
			Weight=0 \
		where Weight is NULL and exists (select 1 from " DB_PREFIX "PRODUCT_COMPONENT pc0 where pc0.IdProduct=Id and pc0.IdSubProduct='[/*PRODUCTKIT.ID*/]')\"\\\n"
	),
),

? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\UpdateProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tablePRODUCTKIT;1;(string,ID))*/} \\\n"),
		@ UpdateProduct_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateProduct_Input),
		@ ("'\\\n"),
		@ UpdateProduct_SQL1,
		@ UpdateProduct_SQL2,
		@ UpdateProduct_SQL3,
		@ UpdateProduct_SQL4,
		@ UpdateProduct_SQL5,
		@ UpdateProduct_SQL6,
),

