% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)

DeleteProduct_SQL1 = (
	"\"DELETE FROM " DB_PREFIX "PRODUCT  where Id IN ('[/*PRODUCTKIT.ID*/]')\"\n\n\n"
),
? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Product\DeleteProduct.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tablePRODUCTKIT;1;(string,ID))*/}' \\\n"),
		@ ("Reload _ _ _\n\n"),
		;
	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ DeleteProduct_SQL1,
),


%=======================================================%
%
%
@ "// 10.1  for all component (sub article) , compute their quantity from quantitative measures\n",
@ "// 10.2  for all component semi-finished having components, compute their price from their components sum(quntity*price)\n",
@ "// 10.3  the total price of the product is the sum(quantity*price) of all comenents not being component of prd semi-finished component\n",


% Script
@ "Script ",

% ID
@ "ModifyMeasuresForQty ",

% Caption
@ ("'" TAG_UPDATE_QUANTITY_MESURE "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW5,
@ " ",

% Label
@ ("'" TAG_UPDATE_QUANTITY_MESURE "' "),	% JZ 1001

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCTKIT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)
@ ("'{/*Input(MMQTY;" TAG_UPDATE_QUANTITY_MESURE ";10;\\\n"),
@ ("(float,LENGTH,Length,[/*PRODUCTKIT.LENGTH*/],10.3.580,1);\\\n"),
@ ("(float,WIDTH,Width,[/*PRODUCTKIT.WIDTH*/],10.3.580,1);\\\n"),
@ ("(float,HEIGHT,Height,[/*PRODUCTKIT.HEIGHT*/],10.3.580,1);\\\n"),
@ ("(float,DEPTH,Depth,[/*PRODUCTKIT.DEPTH*/],10.3.580,1);\\\n"),
@ ("(float,VOLUME,Volume,[/*PRODUCTKIT.VOLUME*/],12.3.580,1);\\\n"),
@ ("(float,WEIGHT,Weight,[/*PRODUCTKIT.WEIGHT*/],10.3.580,1);\\\n"),
@ ("(float,PARAMETER1,Parameter1,[/*PRODUCTKIT.PARAMETER1*/],10.3.580,1);\\\n"),
@ ("(float,PARAMETER2,Parameter2,[/*PRODUCTKIT.PARAMETER2*/],10.3.580,1);\\\n"),
@ ("(string,FORMULA1,Formula 1,[/*PRODUCTKIT.FORMULA1*/],200." inputWidth ",1);\\\n"),
@ ("(string,FORMULA2,Formula 2,[/*PRODUCTKIT.FORMULA2*/],200." inputWidth ",1);\\\n"),
@ (")*/}'\\\n"),
@ ("\"Update " DB_PREFIX "PRODUCT SET\
   Length=[/*LENGTH*/],\
   Height=[/*HEIGHT*/],\
   Width= [/*WIDTH*/],\
   Depth= [/*DEPTH*/],\
   Volume=[/*VOLUME*/],\
   Weight=[/*WEIGHT*/],\
   Parameter1=[/*PARAMETER1*/],\
   Parameter2=[/*PARAMETER2*/],\
   Formula1='[/*FORMULA1*/]',\
   Formula2='[/*FORMULA2*/]' \
  WHERE Id ='[/*PRODUCTKIT.ID*/]'\"\\\n"),

@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT SET\
   Quantity=1\
  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
   and (\
     (LengthByPiece is not NULL and LengthByPiece>0) or \
     (WidthByPiece is not NULL and WidthByPiece>0) or \
     (DepthByPiece is not NULL and DepthByPiece>0) or \
     (HeightByPiece is not NULL and HeightByPiece>0) or \
     (VolumeByPiece is not NULL and VolumeByPiece>0)\
   ) \"\\\n"),

databaseType = "ACCESS" => (

	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Length+pc.LengthByPiece-0.001)/pc.LengthByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Length is not NULL and prd.Length>0\
	   and pc.LengthByPiece is not NULL and pc.LengthByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Height+pc.HeightByPiece-0.001)/pc.HeightByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Height is not NULL and prd.Height>0\
	   and pc.HeightByPiece is not NULL and pc.HeightByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Width+pc.WidthByPiece-0.001)/pc.WidthByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Width is not NULL and prd.Width>0\
	   and pc.WidthByPiece is not NULL and pc.WidthByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Depth+pc.DepthByPiece-0.001)/pc.DepthByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Depth is not NULL and prd.Depth>0\
	   and pc.DepthByPiece is not NULL and pc.DepthByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT prd on prd.Id=pc.IdProduct SET\
	   pc.Quantity=pc.Quantity*ROUND((prd.Volume+pc.VolumeByPiece-0.001)/pc.VolumeByPiece,0)\
	  WHERE pc.IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and prd.Volume is not NULL and prd.Volume>0\
	   and pc.VolumeByPiece is not NULL and pc.VolumeByPiece>0 \"\\\n"),
	@ ("\\\n"),

	@ ("\"Update " DB_PREFIX "PRODUCT set\
		PriceUnit=0,\
		PurchasePrice=0,\
		Weight=0\
	  WHERE Id ='[/*PRODUCTKIT.ID*/]'\"\\\n"),

	@ ("\"Update (" DB_PREFIX "PRODUCT prd inner join " DB_PREFIX "PRODUCT_COMPONENT pc on prd.Id=pc.IdProduct)\
			inner join " DB_PREFIX "PRODUCT sub on sub.Id=pc.IdSubProduct set\
		prd.PriceUnit	 =prd.PriceUnit+pc.Quantity*sub.PriceUnit, \
		prd.PurchasePrice=prd.PurchasePrice+pc.Quantity*sub.PurchasePrice, \
		prd.Weight		 =prd.Weight+pc.Quantity*sub.Weight \
	  WHERE prd.Id ='[/*PRODUCTKIT.ID*/]' and pc.Quantity>0 \"\\\n"),

	;

	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT SET\
	   Quantity=Quantity*(select TRUNCATE((prd.Length+LengthByPiece-0.001)/LengthByPiece,0) from " DB_PREFIX "PRODUCT prd where prd.Id=IdProduct)\
	  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and exists (select 1 from " DB_PREFIX "PRODUCT where id=idProduct and Length is not NULL and Length>0)\
	   and LengthByPiece is not NULL and LengthByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT SET\
	   Quantity=Quantity*(select TRUNCATE((prd.Height+HeightByPiece-0.001)/HeightByPiece,0) from " DB_PREFIX "PRODUCT prd where prd.Id=IdProduct)\
	  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and exists (select 1 from " DB_PREFIX "PRODUCT where id=idProduct and Height is not NULL and Height>0)\
	   and HeightByPiece is not NULL and HeightByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT SET\
		Quantity=Quantity*(select TRUNCATE((prd.Width+WidthByPiece-0.001)/WidthByPiece,0) from " DB_PREFIX "PRODUCT prd where prd.Id=IdProduct)\
	  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and exists (select 1 from " DB_PREFIX "PRODUCT where id=idProduct and Width is not NULL and Width>0)\
	   and WidthByPiece is not NULL and WidthByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT SET\
		Quantity=Quantity*(select TRUNCATE((prd.Depth+DepthByPiece-0.001)/DepthByPiece,0) from " DB_PREFIX "PRODUCT prd where prd.Id=IdProduct)\
	  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and exists (select 1 from " DB_PREFIX "PRODUCT where id=idProduct and Depth is not NULL and Depth>0)\
	   and DepthByPiece is not NULL and DepthByPiece>0\"\\\n"),
	@ ("\\\n"),
	@ ("\"Update " DB_PREFIX "PRODUCT_COMPONENT SET\
		Quantity=Quantity*(select TRUNCATE((prd.Volume+VolumeByPiece-0.001)/VolumeByPiece,0) from " DB_PREFIX "PRODUCT prd where prd.Id=IdProduct)\
	  WHERE IdProduct ='[/*PRODUCTKIT.ID*/]'\
	   and exists (select 1 from " DB_PREFIX "PRODUCT where id=idProduct and Volume is not NULL and Volume>0)\
	   and VolumeByPiece is not NULL and VolumeByPiece>0\"\\\n"),
	@ ("\\\n"),

	@ ("\"Update " DB_PREFIX "PRODUCT set\
	   PriceUnit=(select sum(pc.Quantity*sub.PriceUnit) \
		from " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sub on sub.Id=pc.IdSubProduct \
		where pc.IdProduct='[/*PRODUCTKIT.ID*/]' and pc.Quantity is not NULL and pc.Quantity>0 and sub.PriceUnit is not NULL and sub.PriceUnit>0),\
	   PurchasePrice=(select sum(pc.Quantity*sub.PurchasePrice) \
		from " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sub on sub.Id=pc.IdSubProduct \
		where pc.IdProduct='[/*PRODUCTKIT.ID*/]' and pc.Quantity is not NULL and pc.Quantity>0 and sub.PurchasePrice is not NULL and sub.PurchasePrice>0),\
	   Weight=(select sum(pc.Quantity*sub.Weight) \
		from " DB_PREFIX "PRODUCT_COMPONENT pc inner join " DB_PREFIX "PRODUCT sub on sub.Id=pc.IdSubProduct \
		where pc.IdProduct='[/*PRODUCTKIT.ID*/]' and pc.Quantity is not NULL and pc.Quantity>0 and sub.Weight is not NULL and sub.Weight>0)\
	  WHERE Id ='[/*PRODUCTKIT.ID*/]'\"\\\n"),

),

@ ("\"Update " DB_PREFIX "PRODUCT SET Weight=0 WHERE Id ='[/*PRODUCTKIT.ID*/]' and Weight is NULL\"\\\n"),
@ ("\"Update " DB_PREFIX "PRODUCT SET PurchasePrice=0 WHERE Id ='[/*PRODUCTKIT.ID*/]' and PurchasePrice is NULL\"\n\n\n"),

