@ (" '" TAG_HISTOGRAM_REVENUE "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_HISTOGRAM_COST_RECEIPTS_PROFIT,

% Label
@ (" '" TAG_HISTOGRAM_REVENUE "' "),	% JZ 0906

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableCLIENT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

scriptSolverType = "PoemServer" => (
	@ (" '[COUNT=1; NETNCL=HTTP; SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/); MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
	;
	@ "'[COUNT=1;MESSAGE=0;CANCEL=0;SKIP=0]'\\\n",
),


% Instruction... (When Count>0)
@ ("\t Open '[FILE=(/*HTTPDIRECTORY*/)HistogramBalanceSheetRevenueSelected.view;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' _ _ \\\n"),
@ ("\t \"[POEMSERVER=(/*SERVERIP*/);SERVERPORT=(/*SERVERPORT*/);USERID=(/*USERID*/);IDCOLOR=(250 250 250);OWNEROBJ=IdClient;IDOBJ={/*Selected(tableCLIENT;1;(string,ID))*/};TITLEOBJ=" TAG_FOR_CLIENT " {/*Selected(tableCLIENT;1;(string,ID))*/};OWNERSUBOBJ=IdProduct;IDSUBOBJ='XXX';]\"\n\n"),

