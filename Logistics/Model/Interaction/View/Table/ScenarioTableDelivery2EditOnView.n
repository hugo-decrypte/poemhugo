%=======================================================%
@ "// 0	Cré 	\n",
@ "// 1	Validée	\n",
@ "// 2	Livrée	\n",
@ "// 3	Facturée\n",	
@ "// 4	Quantité erronée	quantité  prévue et quantité  réelle sont difé rentes ou quantité défecteuse positive\n",
@ "// 6	Refacturée	Factueré la partie trop livrée ou faire un avoir\n",
@ "// 9	Terminée\n\n",


%======================================================================================================
%
% Script
@ "Script ",

% ID
@ "ModifyDelivery ",

% Caption
@ (" '" TAG_UPDATE_DELIVERY "' "),	% JZ 0911

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,

% Label
@ (" '" TAG_UPDATE "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableDELIVERY' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
%@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
%@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
%@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),


% Instruction... (When Count>0)
UpdateDelivery_Input = (
	"{/*Input(MCM;" TAG_UPDATE_DELIVERY " [/*DELIVERY.ID*/];8;\\\n"
	"(date,DATEDELIV," TAG_DELIVERY_DATE ",[/*DELIVERY.DATEDELIVERY*/],10." inputWidth ",1,YYYY-MM-DD);\\\n"
	"(date,DATEINVOICE," TAG_INVOICE_DATE ",[/*DELIVERY.DATEINVOICE*/],10." inputWidth ",1,YYYY-MM-DD);\\\n"
	"(date,DATEPAYMENT," TAG_PAYMENT_DATE ",[/*DELIVERY.DATEPAYMENT*/],10." inputWidth ",1,YYYY-MM-DD);\\\n"
	"(string,IDINVOICE," TAG_INVOICE_ID ",[/*DELIVERY.IDINVOICE*/],50." inputWidth ",1,,);\\\n"
	"(string,COMMENTS," TAG_COMMENT ",[/*DELIVERY.COMMENTS*/],50." inputWidth ",1,,);\\\n"
	"(string,MESSAGE," TAG_MESSAGE ",[/*DELIVERY.MESSAGE*/],50." inputWidth ",1,,);\\\n"
	"(string,FOLLOWEDBY," TAG_FOLLOWED_BY ",[/*DELIVERY.FOLLOWEDBY*/],50." inputWidth ",1,,);\\\n"
	"(string,STATE," TAG_STATE ",[/*DELIVERY.IDSTATE*/],50." inputWidth ",0,,[/*STATE.LABELSTATE*/]);\\\n"
	")*/}\\\n"
),
UpdateDelivery_SQL1 = (
	"\"UPDATE " DB_PREFIX "DELIVERY set \
		DateDelivery=[/*DATEDELIV*/],\
		DateInvoice=[/*DATEINVOICE*/],\
		DatePayment=[/*DATEPAYMENT*/],\
		IdInvoice='[/*IDINVOICE*/]',\
		Comments='[/*COMMENTS*/]',\
		CustomsInfo='[/*MESSAGE*/]',\
		FollowedBy='[/*FOLLOWEDBY*/]'\
	WHERE d.Id = '[/*DELIVERY.ID*/]'\"\\\n"
),

databaseType = "ACCESS" => (

	UpdateDelivery_SQL2 = (
		"\"UPDATE " DB_PREFIX "DELIVERY d, " DB_PREFIX "STATE s\
			d.IdState=s.Id\
		WHERE d.Id = '[/*DELIVERY.ID*/]'\
			AND "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*STATE*/]' and s.CATEGORY='DELIVERY'\"\n\n\n"
	),
	;

	UpdateDelivery_SQL2 = (
		"\"UPDATE " DB_PREFIX "DELIVERY \
			IdState=(select s.Id from " DB_PREFIX "STATE s where "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '[/*STATE*/]' and s.CATEGORY='DELIVERY'\
		WHERE d.Id = '[/*DELIVERY.ID*/]'\"\n\n\n"
	),

),


? typeExecute (
	"NCL" :
		%%%%%%%%%%%  by NCL
		@ (" '[SINGLESEL=1;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Delivery\UpdateDelivery.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/)  {/*Selected(tableDELIVERY;1;(string,ID))*/} \\\n"),
		@ UpdateDelivery_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;

	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=1;RELOAD=1;TYPE=SQL;COUNT=2; COUNT=2;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'" UpdateDelivery_Input),
		@ ("'\\\n"),
		@ UpdateDelivery_SQL1,
		@ UpdateDelivery_SQL2,
),

.
