@ "// 1. modify no pallet delivery for line command\n",

% Script
@ "Script ",

% ID
@ "ModifyPallet ",

% Caption
@ (" '" TAG_UPDATE_DELIVERY_PALLET "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW1,

% Label
@ (" '" TAG_UPDATE_DELIVERY_PALLET "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDERPRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=3;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)


UpdatePallet_Input = (
	"{/*Input(MP;" TAG_UPDATE_DELIVERY_PALLET ";1;\\\n"
	"(int,PALLET," TAG_PALLET_IDX ",1,10." inputWidth ",0);\\\n"
	")*/}\\\n"
),
% JZ 0926 B

UpdatePallet_SQL1 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set NoPalletDelivery=[/*PALLET*/]\\\n"
	" WHERE IdOrder in ((/*IDORDER*/))\\\n"
	"  and IdProduct in ('[/*ORDERPRODUCT.IDPRODUCT*/]') \"\\\n"
),
UpdatePallet_SQL2 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set NoPalletDelivery=1 \\\n"
	"  WHERE IdOrder in ((/*IDORDER*/))\\\n"
	"   and NoPalletDelivery is NULL\"\n\n"
),

? typeExecute (
	"NCL" :
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\UpdateProductPallet.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableORDERPRODUCT;1;(string,IDPRODUCT))*/} \\\n"),
		@ " (/*IDORDER*/) ",
		@ UpdatePallet_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;
	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=3;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'\\\n"),
		@ UpdatePallet_Input,
		@ ("'\\\n"),
		@ UpdatePallet_SQL1,
		@ UpdatePallet_SQL2,
),


%=============================================================================
%
@ "// 2. modify price\n",
% Script
@ "Script ",

% ID
@ "ModifyPriceUnit ",

% Caption
@ (" '" TAG_UPDATE_UNIT_PRICE "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW2,

% Label
@ (" '" TAG_UPDATE_UNIT_PRICE "' "),	% JZ 0926 A

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDERPRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=3;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)

UpdatePrice_Input = (
	"{/*Input(MPU;" TAG_UPDATE_UNIT_PRICE ";1;\\\n"
	"(float,PRICE," TAG_PRICE_UNIT ",[/*ORDERPRODUCT.PRICE*/],10.4.580,0);\\\n"
	")*/}\\\n"
),

UpdatePrice_SQL1 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set PriceUnit=[/*PRICE*/]\\\n"
	"  WHERE IdOrder in ('[/*ORDERPRODUCT.ID*/]')\\\n"
	"    and IdProduct in ('[/*ORDERPRODUCT.IDPRODUCT*/]') \"\\\n"
),

UpdatePrice_SQL2 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set Discount=0 WHERE IdOrder in ('[/*ORDERPRODUCT.ID*/]') and Discount is NULL \"\\\n"
),

databaseType = "ACCESS" => (

	UpdatePrice_SQL3 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "ORDER_PRODUCT OP on P.Id=OP.IdProduct\\\n"
		"  set OP.IdVAT=P.IdVAT\\\n"
		" where OP.IdOrder in ('[/*ORDERPRODUCT.ID*/]')\\\n"
		"  and (OP.IdVAT is NULL or OP.IdVAT<= ' ') \"\\\n"
	),

	UpdatePrice_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER O set O.AmountHT=0 WHERE O.Id in ('[/*ORDERPRODUCT.ID*/]') \"\\\n"
	),

% JZ 1021 : ?????? UpdatePrice_SQL4 same to UpdateDiscount_SQL4

	UpdatePrice_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "ORDER_PRODUCT OP  \\\n"
		"  set O.AmountHT=O.AmountHT + round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0 \\\n"
		" where O.Id=OP.IdOrder and OP.IdOrder in ('[/*ORDERPRODUCT.ID*/]')\"\n\n"
	),
	;

	UpdatePrice_SQL3 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT \\\n"
		"  set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct) \\\n"
		" where IdOrder in ('[/*ORDERPRODUCT.ID*/]')\\\n"
		"  and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
		"\\\n"
	),

	UpdatePrice_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER \\\n"
		"  set AmountHT=(select sum(round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0) from " DB_PREFIX "ORDER_PRODUCT OP where Id=OP.IdOrder)\\\n"
		" WHERE Id in ('[/*ORDERPRODUCT.ID*/]')\"\\\n"
	),
	UpdatePrice_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER set AmountHT=0 WHERE Id in ('[/*ORDERPRODUCT.ID*/]') and AmountHT is NULL\"\n\n"
	),

),

 typeExecute = "NCL" => (
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),
		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\UpdateProductPrice.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableORDERPRODUCT;1;(string,IDPRODUCT))*/} \\\n"),
		@ "(/*IDORDER*/) ",
		@ UpdatePrice_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=5;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'\\\n"),
		@ UpdatePrice_Input,
		@ ("'\\\n"),
		@ UpdatePrice_SQL1,
		@ UpdatePrice_SQL2,
		@ UpdatePrice_SQL3,
		@ UpdatePrice_SQL4,
		@ UpdatePrice_SQL5,
),

%% 	"SQLVIEW" :



%====================================================================================
%
@ "// 3. modify Discount\n",

% Script
@ "Script ",

% ID
@ "ModifyDiscount ",

% Caption
@ (" '" TAG_UPDATE_DISCOUNT "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT_ONVIEW3,

% Label
@ (" '" TAG_UPDATE_DISCOUNT "' "),	% JZ 0926 A

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableORDERPRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "'[0,(0 0 0),(255 255 255);;Arial,,-20;(C M),(2 2 2 2)]' ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

%@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=3;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),


% Instruction... (When Count>0)

UpdateDiscount_Input = (
	"{/*Input(ModDis;" TAG_UPDATE_DISCOUNT ";2;\\\n"
	"(float,DISCOUNT," TAG_DISCOUNT ",[/*ORDERPRODUCT.DISCOUNT*/],4.1.580,1,,);\\\n"
	"(string,LABELDISCOUNT," TAG_DISCOUNT_LABEL ",[/*ORDERPRODUCT.LABELDISCOUNT*/],100." inputWidth ",1,,);\\\n"
	")*/}\\\n"
),

UpdateDiscount_SQL1 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set Discount=[/*DISCOUNT*/], LabelDiscount='[/*LABELDISCOUNT*/]'\\\n"
	"  WHERE IdOrder in ('[/*ORDERPRODUCT.ID*/]')\\\n"
	"    and IdProduct in ('[/*ORDERPRODUCT.IDPRODUCT*/]') \"\\\n"
),

UpdateDiscount_SQL2 = (
	"\"Update " DB_PREFIX "ORDER_PRODUCT set Discount=0 WHERE IdOrder in ('[/*ORDERPRODUCT.ID*/]') and Discount is NULL \"\\\n"
),

databaseType = "ACCESS" => (

	UpdateDiscount_SQL3 = (
		"\"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "ORDER_PRODUCT OP on P.Id=OP.IdProduct\\\n"
		"  set OP.IdVAT=P.IdVAT\\\n"
		" where OP.IdOrder in ('[/*ORDERPRODUCT.ID*/]')\\\n"
		"  and (OP.IdVAT is NULL or OP.IdVAT<= ' ') \"\\\n"
		"\\\n"
	),

	UpdateDiscount_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER O set O.AmountHT=0 WHERE O.Id in ('[/*ORDERPRODUCT.ID*/]') \"\\\n"
	),
	UpdateDiscount_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER O, " DB_PREFIX "ORDER_PRODUCT OP  \\\n"
		"  set O.AmountHT=O.AmountHT + round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0 \\\n"
		" where O.Id=OP.IdOrder and OP.IdOrder in ('[/*ORDERPRODUCT.ID*/]')\"\n\n"
	),
	;

	UpdateDiscount_SQL3 = (
		"\"Update " DB_PREFIX "ORDER_PRODUCT \\\n"
		"  set IdVAT=(select P.IdVAT from " DB_PREFIX "PRODUCT P where P.Id=IdProduct) \\\n"
		" where IdOrder in ('[/*ORDERPRODUCT.ID*/]')\\\n"
		"  and (IdVAT is NULL or IdVAT<= ' ') \"\\\n"
		"\\\n"
	),

	UpdateDiscount_SQL4 = (
		"\"Update " DB_PREFIX "CLIENTORDER \\\n"
		"  set AmountHT=(select sum(round(OP.Quantity*OP.PriceUnit*(100.0-OP.Discount))/100.0) from " DB_PREFIX "ORDER_PRODUCT OP where Id=OP.IdOrder)\\\n"
		" WHERE Id in ('[/*ORDERPRODUCT.ID*/]')\"\\\n"
	),
	UpdateDiscount_SQL5 = (
		"\"Update " DB_PREFIX "CLIENTORDER set AmountHT=0 WHERE Id in ('[/*ORDERPRODUCT.ID*/]') and AmountHT is NULL\"\n\n"
	),
),

%%? typeExecute (
%%	"NCL" :
 typeExecute = "NCL" => (
		@ (" '[SINGLESEL=0;COUNT=2;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);MESSAGE=0;CANCEL=0;SKIP=0;WAITCURSOR=0;]' \\\n"),

		@ ("Ncl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\Interaction\Edit\Order\UpdateProductDiscount.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
		@ (" '(/*SERVERPORT*/) (/*USERID*/) {/*Selected(tableORDERPRODUCT;1;(string,IDPRODUCT))*/} "),
		@ "(/*IDORDER*/) ",
		@ UpdateDiscount_Input,
		@ ("'\\\n"),
		@ ("Reload _ _ _\n\n"),
		;
%%	"SQLVIEW" :
		%%% on View
		@ (" '[SINGLESEL=0;RELOAD=1;TYPE=SQL;COUNT=3;MESSAGE=1;CANCEL=0;WAITCURSOR=0;;DATAFMT=(SEP=COMMA,RET=COMMA,FMT=T,QUOT=SQUOT,HEADER=FALSE,COUNT=FALSE)]' \\\n"),
		@ ("'\\\n"),
		@ UpdateDiscount_Input,
		@ ("'\\\n"),
		@ UpdateDiscount_SQL1,
		@ UpdateDiscount_SQL2,
		@ UpdateDiscount_SQL3,
		@ UpdateDiscount_SQL4,
		@ UpdateDiscount_SQL5,
),
