% Script
@ "Script ",

% ID
@ "TableProductFamily ",

% Caption
@ ("'" TAG_PRODUCT_FAMILY "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_TABLE_PRODUCT_FAMILY,

% Label
@ (" '" TAG_PRODUCT_FAMILY "' "),



% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tablePRODUCT' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

@ (PREFIX_OPENTABLE_BEGIN "TableProductFamily.view" OPENTABLE_END),	% JZ 0919

@ (TABLE_ARGUMENTS "FAMILY={/*Selected(tablePRODUCT;1;(string,FAMILY))*/};IDPRODUCT={/*Selected(tablePRODUCT;1;(string,ID))*/}]\"\n\n"),

