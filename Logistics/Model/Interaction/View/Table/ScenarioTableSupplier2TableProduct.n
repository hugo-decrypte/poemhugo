% Script
@ "Script ",

% ID
@ "TableProductBySupplier ",


% Caption
@ (" '" TAG_PRODUCT_BY_SUPPLIER "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_TABLE_PRODUCT,

% Label
@ (" '" TAG_PRODUCTS "' "),


% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableSUPPLIER' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"


@ (PREFIX_OPENTABLE_BEGIN "TableProductBySupplier.view" OPENTABLE_END),

@ (TABLE_ARGUMENTS 
"IDSUPPLIER={/*Selected(tableSUPPLIER;1;(string,ID))*/};TITLEOBJ=" TAG_OF_SUPPLIER " {/*Selected(tableSUPPLIER;1;(string,ID))*/};FAMILY='XXX']\"\n\n"),

