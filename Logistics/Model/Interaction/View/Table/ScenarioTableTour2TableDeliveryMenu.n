% Script
@ "Script ",

% ID
@ "TableDelivery ",

% Caption
@ (" '" TAG_TOUR_DELIVERY "' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_TABLE_DELIVERY,

% Label
@ (" '" TAG_DELIVERIES "' "),

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableTOUR' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),

% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"


@ (PREFIX_OPENTABLE_BEGIN "TableDelivery_Menu.view" OPENTABLE_END),

@ (TABLE_ARGUMENTS 
"NBDAY=0;OWNEROBJ=IdTour;IDOBJ={/*Selected(tableTOUR;1;(string,ID))*/};TITLEOBJ=" TAG_OF_TOUR " {/*Selected(tableTOUR;1;(string,ID))*/};OWNERSUBOBJ=IdProduct;IDSUBOBJ='XXX';IDTOUR='XXX']\"\n\n"),
