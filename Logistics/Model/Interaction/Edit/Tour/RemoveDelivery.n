['Work Directory' "Model\Common\Config\ReadUserLogin.n"],



'()' => (
	% Input buffer

	idTourBuffer	:: "",
	idTourBuffer	= (),
	

	nbSelected	= (),
	nbParameter	= (),
	
	\forall i \in [1, nbSelected] (
		idDeliverySelectedBuffer_{i} 			:: "",
		idDeliverySelectedBuffer_{i}			= (),
		
		i < nbSelected =>(
			strIdDeliverySelectedBuffer_{i} = ("'" idDeliverySelectedBuffer_{i} "',"),
			;
			strIdDeliverySelectedBuffer_{i} = ("'" idDeliverySelectedBuffer_{i} "'"),
		),
	),
	
	IDDELIVERYSELECTEDBUFFER :: "",
	IDDELIVERYSELECTEDBUFFER = [\forall i \in [1, nbSelected] strIdDeliverySelectedBuffer_{i}],


	'()' <- database,
	
RemoveDeliveryFromTour_SQL1 = (
	"Update " DB_PREFIX "DELIVERY "
	"   set IdTour=NULL "
	"  WHERE (IdTour = " idTourBuffer ")"
	"   and 'XXX' not in (" idTourBuffer ")"
	"   and Id in (" IDDELIVERYSELECTEDBUFFER ") "
),

RemoveDeliveryFromTour_SQL2 = (
	"Update " DB_PREFIX "DELIVERY"
	"   set idState='1' "
	"  WHERE (IdTour is NULL or IdTour<=' ')"
	"   and idState>'1'"
	"   and Id in (" IDDELIVERYSELECTEDBUFFER" ) "
),



databaseType = "ACCESS" => (

	RemoveDeliveryFromTour_SQL3 = (
		"Update " DB_PREFIX "TOUR T set T.Weight=0, Volume=0, NbPallet=0 "
		"  WHERE T.Id=" idTourBuffer " "
	),

	RemoveDeliveryFromTour_SQL4 = (
		"Update ((" DB_PREFIX "TOUR T inner join " DB_PREFIX "DELIVERY D on T.Id=D.IdTour)"
		"  inner join " DB_PREFIX "DELIVERY_PRODUCT DP on D.Id=DP.IdDelivery)"
		"  inner join " DB_PREFIX "PRODUCT P on P.ID=DP.IdProduct"
		" set T.Weight=T.Weight + DP.Quantity*P.Weight"
		" WHERE T.Id=" idTourBuffer " and P.Weight is not NULL "
	),

	RemoveDeliveryFromTour_SQL5 = (
		"Update ((" DB_PREFIX "TOUR T inner join " DB_PREFIX "DELIVERY D on T.Id=D.IdTour)"
		"  inner join " DB_PREFIX "DELIVERY_PRODUCT DP on D.Id=DP.IdDelivery)"
		"  inner join " DB_PREFIX "PRODUCT P on P.ID=DP.IdProduct"
		" set T.Volume=T.Volume + DP.Quantity*P.Volume"
		" WHERE T.Id=" idTourBuffer " and P.Volume is not NULL "
	),

	RemoveDeliveryFromTour_SQL6 = (
		"Update (" DB_PREFIX "TOUR T inner join " DB_PREFIX "DELIVERY D on T.Id=D.IdTour)"
		" set T.NbPallet=T.NbPallet + D.NbPallet"
		" WHERE T.Id=" idTourBuffer " and D.NbPallet is not NULL \n\n\n"
	),

	; %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

	RemoveDeliveryFromTour_SQL3 = (
		"Update " DB_PREFIX "TOUR set "
			"   Weight= (select sum(DP.Quantity*P.Weight) from ( " DB_PREFIX "DELIVERY D "
			"	  	inner join " DB_PREFIX "DELIVERY_PRODUCT DP on D.Id=DP.IdDelivery)"
			"	  	inner join " DB_PREFIX "PRODUCT P on P.ID=DP.IdProduct"
			" 		where TOUR.Id=D.IdTour and P.Weight is not NULL), "
			"   Volume= (select sum(DP.Quantity*P.Volume) from ( " DB_PREFIX "DELIVERY D "
			" 	 	inner join " DB_PREFIX "DELIVERY_PRODUCT DP on D.Id=DP.IdDelivery)"
			" 	 	inner join " DB_PREFIX "PRODUCT P on P.ID=DP.IdProduct"
			" 		where TOUR.Id=D.IdTour and P.Volume is not NULL), "
			"   NbPallet= (select sum(D.NbPallet) from " DB_PREFIX "DELIVERY D "
			" 		where TOUR.Id=D.IdTour and D.NbPallet is not NULL) "
			" WHERE Id=" idTourBuffer " "
	),

	RemoveDeliveryFromTour_SQL4 = (
		Update " DB_PREFIX "TOUR set Weight=0 WHERE Id=" idTourBuffer " and Weight is NULL "
	),
	RemoveDeliveryFromTour_SQL5 = (
		Update " DB_PREFIX "TOUR set Volume=0 WHERE Id=" idTourBuffer " and Volume is NULL "
	),
	RemoveDeliveryFromTour_SQL6 = (
		Update " DB_PREFIX "TOUR set NbPallet=0 WHERE Id=" idTourBuffer " and NbPallet is NULL "
	),
),

	(SQL : RemoveDeliveryFromTour_SQL1), 
	(SQL : RemoveDeliveryFromTour_SQL2), 
	(SQL : RemoveDeliveryFromTour_SQL3), 
	(SQL : RemoveDeliveryFromTour_SQL4), 
	(SQL : RemoveDeliveryFromTour_SQL5), 
	(SQL : RemoveDeliveryFromTour_SQL6), 

	database <- '()',
),
