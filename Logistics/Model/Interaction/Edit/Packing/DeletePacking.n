['Work Directory' "Model\Common\Config\ReadUserLogin.n"],


'()' => (
	
	nbSelected	= (),
	nbParameter	= (),
	
	\forall i \in [1, nbSelected] (
		idObjSelectedBuffer_{i} 			:: "",
		idObjSelectedBuffer_{i}			= (),
		
		i < nbSelected =>(
			strIdObjSelectedBuffer_{i} = ("'" idObjSelectedBuffer_{i} "',"),
			;
			strIdObjSelectedBuffer_{i} = ("'" idObjSelectedBuffer_{i} "'"),
		),
	),
	
	IDOBJSELECTEDBUFFER :: "",
	IDOBJSELECTEDBUFFER = [\forall i \in [1, nbSelected] strIdObjSelectedBuffer_{i}],

	'()' <- database,
	
	DeletePacking_SQL1 = (
		"Delete from " DB_PREFIX "PACKING 
		where (IdState is NULL or IdState<='0')
		and not exists (select 1 from " DB_PREFIX "PALLET pl where pl.IdPacking=Id)
		and Id IN ("IDOBJSELECTEDBUFFER")"
	),
	
	(SQL : DeletePacking_SQL1), 
	
	
	database <- '()',
),
.