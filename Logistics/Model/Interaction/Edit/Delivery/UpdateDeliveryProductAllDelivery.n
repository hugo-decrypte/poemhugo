['Work Directory' "Model\Common\Config\ReadUserLogin.n"],


'()' => (
	
	nbSelected	= (),
	nbParameter	= (),
	
	idObjBuffer		:: "",
	idObjBuffer		= (),
	
	
	
	'()' <- database,
	
	UpdateAllDeliveryProduct_SQL1=(
		"insert into " DB_PREFIX "DELIVERY_PRODUCT (IdDelivery, IdOrder, IdProduct, NoLine, IdPacking, NoPallet, DateDelivery,
			Quantity, QuantityReal, QuantityDefective,QuantityOrderRest, PriceUnit, IdVAT,Discount,LabelDiscount,NoPalletDelivery)
		select DP.IdDelivery, DP.IdOrder, DP.IdProduct, DP.NoLine+1, DP.IdPacking, DP.NoPallet, DP.DateDelivery,
		DP.QuantityReal-PLP.QuantityStock, DP.QuantityReal-PLP.QuantityStock, 0, DP.QuantityOrderRest, DP.PriceUnit, DP.IdVAT,DP.Discount,DP.LabelDiscount,DP.NoPalletDelivery 
		from " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdProduct=PLP.IdProduct
		WHERE not exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP0 where DP0.IdDelivery=DP.IdDelivery and DP0.IdProduct=DP.IdProduct and DP0.IdPacking=DP.IdPacking
				and (DP0.IdOrder<DP.IdOrder or (DP0.IdOrder=DP.IdOrder and DP0.NoLine<DP.NoLine)))
		and not exists (select 1 from " DB_PREFIX "PALLET_PRODUCT PLP0 where PLP0.IdProduct=PLP.IdProduct and PLP0.QuantityStock>0
			and (PLP0.DateExpiration<PLP.DateExpiration or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking<PLP.IdPacking) or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking=PLP.IdPacking and PLP0.NoPallet<PLP.NoPallet) ))
	   and DP.IdDelivery='"idObjBuffer"' and DP.IdPacking='STOCK' 
	   and PLP.QuantityStock>0 and PLP.QuantityStock<DP.QuantityReal"
	),


	databaseType = "ACCESS" => (
		%% pick
		UpdateAllDeliveryProduct_SQL2=(
			"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdProduct=PLP.IdProduct
				set DP.Quantity=PLP.QuantityStock, DP.QuantityReal=PLP.QuantityStock
				WHERE not exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP0 where DP0.IdDelivery=DP.IdDelivery and DP0.IdProduct=DP.IdProduct and DP0.IdPacking=DP.IdPacking and (DP0.IdOrder<DP.IdOrder or (DP0.IdOrder=DP.IdOrder and DP0.NoLine<DP.NoLine)))
				and not exists (select 1 from " DB_PREFIX "PALLET_PRODUCT PLP0 where PLP0.IdProduct=PLP.IdProduct and PLP0.QuantityStock>0 and (PLP0.DateExpiration<PLP.DateExpiration or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking<PLP.IdPacking) or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking=PLP.IdPacking and PLP0.NoPallet<PLP.NoPallet) ))
				and DP.IdDelivery ='"idObjBuffer"' and DP.IdPacking='STOCK' 
				and PLP.QuantityStock>0 and PLP.QuantityStock<DP.QuantityReal"
		),
		UpdateAllDeliveryProduct_SQL3=(
			"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdProduct=PLP.IdProduct
				set DP.IdPacking=PLP.IdPacking, DP.NoPallet=PLP.NoPallet, PLP.QuantityStock=PLP.QuantityStock-DP.QuantityReal
				WHERE not exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP0 where DP0.IdDelivery=DP.IdDelivery and DP0.IdProduct=DP.IdProduct and DP0.IdPacking=DP.IdPacking and (DP0.IdOrder<DP.IdOrder or (DP0.IdOrder=DP.IdOrder and DP0.NoLine<DP.NoLine)))
				and not exists (select 1 from " DB_PREFIX "PALLET_PRODUCT PLP0 where PLP0.IdProduct=PLP.IdProduct and PLP0.QuantityStock>0 and (PLP0.DateExpiration<PLP.DateExpiration or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking<PLP.IdPacking) or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking=PLP.IdPacking and PLP0.NoPallet<PLP.NoPallet) ))
				and PLP.QuantityStock>=DP.QuantityReal
				and DP.IdDelivery ='"idObjBuffer"' and DP.IdPacking='STOCK' "
		),
		UpdateAllDeliveryProduct_SQL4=(
			"Update " DB_PREFIX "PALLET_PRODUCT PLP set PLP.QuantityOut=0
				WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')"
		),
		UpdateAllDeliveryProduct_SQL5=(
			"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdPacking=PLP.IdPacking and DP.NoPallet=PLP.NoPallet and DP.IdProduct=PLP.IdProduct
				set PLP.QuantityOut=PLP.QuantityOut+DP.QuantityReal
				WHERE DP.IdDelivery ='"idObjBuffer"'"
		),
		UpdateAllDeliveryProduct_SQL6=(
			"Update " DB_PREFIX "PALLET_PRODUCT PLP set PLP.QuantityStock=PLP.quantityReal-PLP.QuantityOut
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')"
		),
		UpdateAllDeliveryProduct_SQL7=(
			"Update " DB_PREFIX "PALLET_PRODUCT PLP set PLP.QuantityStock=0
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')
			and PLP.QuantityStock=-0"
		),
		UpdateAllDeliveryProduct_SQL8=(
			"Update " DB_PREFIX "PRODUCT P set P.QuantityStock=0
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where P.Id=DP.IdProduct and DP.IdDelivery='"idObjBuffer"')"
		),
		UpdateAllDeliveryProduct_SQL9=(
			"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "PALLET_PRODUCT PLP on P.Id=PLP.IdProduct
			set P.QuantityStock=P.QuantityStock+PLP.QuantityStock
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')"
		),

		;

		UpdateAllDeliveryProduct_SQL2=(
			"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdProduct=PLP.IdProduct
			set DP.Quantity=PLP.QuantityStock, DP.QuantityReal=PLP.QuantityStock
			WHERE not exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP0 where DP0.IdDelivery=DP.IdDelivery and DP0.IdProduct=DP.IdProduct and DP0.IdPacking=DP.IdPacking and (DP0.IdOrder<DP.IdOrder or (DP0.IdOrder=DP.IdOrder and DP0.NoLine<DP.NoLine)))
			and not exists (select 1 from " DB_PREFIX "PALLET_PRODUCT PLP0 where PLP0.IdProduct=PLP.IdProduct and PLP0.QuantityStock>0 and (PLP0.DateExpiration<PLP.DateExpiration or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking<PLP.IdPacking) or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking=PLP.IdPacking and PLP0.NoPallet<PLP.NoPallet) ))
			and DP.IdDelivery ='"idObjBuffer"' and DP.IdPacking='STOCK' 
			and PLP.QuantityStock>0 and PLP.QuantityStock<DP.QuantityReal"
		),
		UpdateAllDeliveryProduct_SQL3=(
			"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdProduct=PLP.IdProduct
			set DP.IdPacking=PLP.IdPacking, DP.NoPallet=PLP.NoPallet, PLP.QuantityStock=PLP.QuantityStock-DP.QuantityReal
			WHERE not exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP0 where DP0.IdDelivery=DP.IdDelivery and DP0.IdProduct=DP.IdProduct and DP0.IdPacking=DP.IdPacking and (DP0.IdOrder<DP.IdOrder or (DP0.IdOrder=DP.IdOrder and DP0.NoLine<DP.NoLine)))
			and not exists (select 1 from " DB_PREFIX "PALLET_PRODUCT PLP0 where PLP0.IdProduct=PLP.IdProduct and PLP0.QuantityStock>0 and (PLP0.DateExpiration<PLP.DateExpiration or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking<PLP.IdPacking) or (PLP0.DateExpiration=PLP.DateExpiration and PLP0.IdPacking=PLP.IdPacking and PLP0.NoPallet<PLP.NoPallet) ))
			and PLP.QuantityStock>=DP.QuantityReal
			and DP.IdDelivery ='"idObjBuffer"' and DP.IdPacking='STOCK' "
		),
		UpdateAllDeliveryProduct_SQL3=(
			"Update " DB_PREFIX "PALLET_PRODUCT PLP set PLP.QuantityOut=0
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')"
		),
		UpdateAllDeliveryProduct_SQL4=(
			"Update " DB_PREFIX "DELIVERY_PRODUCT DP inner join " DB_PREFIX "PALLET_PRODUCT PLP on DP.IdPacking=PLP.IdPacking and DP.NoPallet=PLP.NoPallet and DP.IdProduct=PLP.IdProduct
			set PLP.QuantityOut=PLP.QuantityOut+DP.QuantityReal
			WHERE DP.IdDelivery ='"idObjBuffer"'"
		),
		UpdateAllDeliveryProduct_SQL5=(
			"Update " DB_PREFIX "PALLET_PRODUCT PLP set PLP.QuantityStock=PLP.quantityReal-PLP.QuantityOut
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')"
		),
		UpdateAllDeliveryProduct_SQL6=(
			"Update " DB_PREFIX "PALLET_PRODUCT PLP set PLP.QuantityStock=0
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')
			and PLP.QuantityStock=-0"
		),
		UpdateAllDeliveryProduct_SQL7=(
			"Update " DB_PREFIX "PRODUCT P set P.QuantityStock=0
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where P.Id=DP.IdProduct and DP.IdDelivery='"idObjBuffer"')"
		),
		UpdateAllDeliveryProduct_SQL8=(
			"Update " DB_PREFIX "PRODUCT P inner join " DB_PREFIX "PALLET_PRODUCT PLP on P.Id=PLP.IdProduct
			set P.QuantityStock=P.QuantityStock+PLP.QuantityStock
			WHERE exists (select 1 from " DB_PREFIX "DELIVERY_PRODUCT DP where PLP.IdPacking=DP.IdPacking and PLP.NoPallet=DP.NoPallet and DP.IdDelivery='"idObjBuffer"')"
		),
	),

	(SQL : UpdateAllDeliveryProduct_SQL1), 
	(SQL : UpdateAllDeliveryProduct_SQL2), 
	(SQL : UpdateAllDeliveryProduct_SQL3), 
	(SQL : UpdateAllDeliveryProduct_SQL4), 
	(SQL : UpdateAllDeliveryProduct_SQL5), 
	(SQL : UpdateAllDeliveryProduct_SQL6), 
	(SQL : UpdateAllDeliveryProduct_SQL7), 
	(SQL : UpdateAllDeliveryProduct_SQL8), 
	databaseType = "ACCESS" => (
		(SQL : UpdateAllDeliveryProduct_SQL9), 
	),
	
	database <- '()',
),
