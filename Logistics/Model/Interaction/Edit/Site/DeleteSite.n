'()' => (
	nbSiteSelected		= (),
	nbParameterSelected	= (),

	IdSiteSelected		:: {""},

	\forall i \in [1, nbSiteSelected](
		idSiteSelected_{i}	:: "",
		idSiteSelected_{i}	= (),
	),

	IdSiteSelected = \{ \forall i \in [1, nbSiteSelected] idSiteSelected_{i} \},


	'()' <- database,

	(SQL : SQL_DeleteSiteIdIn concatSetQuoted(IdSiteSelected) ")"),
	%(SQL : "DELETE FROM " DB_PREFIX "SITE s WHERE s.id IN (" concatSetQuoted(IdSiteSelected) ")"),


	sqlOperationLog := TAG_DELETE_SITE,
	['Work Directory' "Model\Output\WriteLog.n"],

	database <- '()',
),