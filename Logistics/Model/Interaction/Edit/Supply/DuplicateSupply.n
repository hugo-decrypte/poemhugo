['Work Directory' "Model\Common\Config\ReadUserLogin.n"],


'()' => (
	
	nbSelected	= (),
	nbParameter	= (),
	
	idObjSelectedBuffer				:: "",
	idObjSelectedBuffer				= (),
	
	dateDeliveryBuffer				:: "",
	dateLimitBuffer					:: "",

	
	dateDeliveryBuffer				= (),
	dateLimitBuffer					= (),

	'()' <- database,
	
	DuplicateSupply_SQL1 = (
		"INSERT INTO " DB_PREFIX "SUPPLY (Id, DateSupply, DateDelivery, DateLimit, IdState, Reference,
				Comments,Quantity,ProductCondition, PayCondition, Packaging, CustomsInfo, Incoterm)
		select distinct "SQL_CONCAT"'S'"SQL_CONCATWITH""SQL_FORMATDATE"("SQL_CURRENTDATE", '"SQL_FORMATDATE_Y""SQL_FORMATDATE_M"')"SQL_CONCATWITH" format(max(N)+1,'0')"SQL_CONCATEND", "SQL_FORMATDATE"("SQL_CURRENTDATE", '"SQL_FORMATDATESTR"'),
				'"dateDeliveryBuffer"', '"dateLimitBuffer"', '0', "SQL_CONCAT"'S'"SQL_CONCATWITH""SQL_FORMATDATE"("SQL_CURRENTDATE", '"SQL_FORMATDATE_Y""SQL_FORMATDATE_M"')"SQL_CONCATWITH""SQL_FORMATNUM"(max(N)+1,"SQL_FORMATSCALE0")"SQL_CONCATEND",
				'Copie de "idObjSelectedBuffer"', S.Quantity,S.ProductCondition, S.PayCondition, S.Packaging, S.CustomsInfo, S.Incoterm
		from " DB_PREFIX "SUPPLY S,
			(select (round("SQL_SUBSTRING"(max(S0.Id),8,3))) as N from " DB_PREFIX "SUPPLY S0 where "SQL_SUBSTRING"(S0.Id,1,7)= "SQL_CONCAT"'S'"SQL_CONCATWITH""SQL_FORMATDATE"("SQL_CURRENTDATE", '"SQL_FORMATDATE_Y""SQL_FORMATDATE_M"')"SQL_CONCATEND" and S0.Id>"SQL_CONCAT"'S'"SQL_CONCATWITH""SQL_FORMATDATE"("SQL_CURRENTDATE", '"SQL_FORMATDATE_Y""SQL_FORMATDATE_M"')"SQL_CONCATEND"
		UNION ALL 
			select distinct 0 as N from " DB_PREFIX "Agency 
		) IDO 
		where S.Id ='"idObjSelectedBuffer"' 
		group by S.Id, S.Quantity,S.ProductCondition, S.PayCondition, S.Packaging, S.CustomsInfo, S.Incoterm"
	),

	DuplicateSupply_SQL2 = (
		"INSERT INTO " DB_PREFIX "SUPPLY_PRODUCT (IdSupply, IdProduct, IdSupplier, Quantity, PriceUnit, Comments, Comments1) 
		select max(S.Id), SP.IdProduct,SP.IdSupplier, SP.Quantity, SP.PriceUnit, SP.Comments, SP.Comments1
		from " DB_PREFIX "SUPPLY S," DB_PREFIX "SUPPLY_PRODUCT SP
		where S.Comments='Copie de "idObjSelectedBuffer"'
		and S.Reference=S.Id
		and S.DateSupply="SQL_FORMATDATE"("SQL_CURRENTDATE",'"SQL_FORMATDATESTR"') and S.DateDelivery='"dateDeliveryBuffer"'
		and SP.IdSupply = '"idObjSelectedBuffer"'
		group by SP.IdProduct,SP.IdSupplier, SP.Quantity, SP.PriceUnit, SP.Comments, SP.Comments1"
	),
	(DuplicateSupply_SQL2 : ),
	(SQL : DuplicateSupply_SQL1), 
	(SQL : DuplicateSupply_SQL2), 
	
	
	database <- '()',
),
