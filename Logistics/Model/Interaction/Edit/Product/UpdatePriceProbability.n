['Work Directory' "Model\Common\Config\ReadUserLogin.n"],


'()' => (
	% Input buffer
	
	idClubBuffer :: "",
	idClubBuffer = (),
	
	nbSelected	= (),
	nbParameter	= (),
	
	\forall i \in [1, nbSelected] (
		idObjSelectedBuffer_{i} 			:: "",
		idObjSelectedBuffer_{i}			= (),
		
		i < nbSelected =>(
			strIdObjSelectedBuffer_{i} = ("'" idObjSelectedBuffer_{i} "',"),
			;
			strIdObjSelectedBuffer_{i} = ("'" idObjSelectedBuffer_{i} "'"),
		),
	),
	
	IDOBJSELECTEDBUFFER :: "",
	IDOBJSELECTEDBUFFER = [\forall i \in [1, nbSelected] strIdObjSelectedBuffer_{i}],
	
	priceProbabilityBuffer :: 0.0,
	priceProbabilityBuffer = (),

	
	
	'()' <- database,
	
	% update probability
	
	UpdateProbability_SQL1 = (
		"UPDATE " DB_PREFIX "PRODUCT_PRICE pp "
		"SET pp.probability="priceProbabilityBuffer[(4,12)] "*pp.minPrice "  
		"WHERE pp.id in ("IDOBJSELECTEDBUFFER") AND pp.idClub = '"idClubBuffer"'"
	),
	

	(SQL : UpdateProbability_SQL1), 

	
	database <- '()',
),
