['Work Directory' "Model\Common\Config\ReadUserLogin.n"],

%['Work Directory' "Model\Common\Config\ReadConfigLogin.n"],
%['Work Directory' "Model\Common\Config\CheckLog.n"],
%['Work Directory' "Model\Common\Config\ReadMacroView.n"],
%'()' => (
%	aliasTable	= "SITE",
%),
%['Work Directory' "Model\Common\Config\ReadField.n"],	

'()' => (
	nbSelected = (),
	nbParam    = (),
	
	\forall i \in [1, nbSelected] (
		idSelectedBuffer_{i} :: "",
		idSelectedBuffer_{i} = (),
		
		i < nbSelected =>(
			strIdSelectedBuffer_{i} = ("'" idSelectedBuffer_{i} "',"),
			;
			strIdSelectedBuffer_{i} = ("'" idSelectedBuffer_{i} "'"),
		),
	),
	
	IDSELECTED :: "",
	IDSELECTED = [\forall i \in [1, nbSelected] strIdSelectedBuffer_{i}],
	
	strState :: "",
	strState = (),
	

	
	UpdateDeliveryNote_SQL1 = (
		"UPDATE " DB_PREFIX "OPT_ORDER o, " DB_PREFIX "STATE s
		 SET o.state=s.id
		 WHERE o.id IN (" IDSELECTED ")
		 AND "SQL_CONCAT"trim(s.LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(s.ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" = '"strState"' and s.CATEGORY='DELIVERYNOTE'"
	),


	'()' <- database,

	(SQL : UpdateDeliveryNote_SQL1),

	database <- '()',
),
