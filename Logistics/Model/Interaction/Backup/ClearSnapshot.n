% bai 0411
['Work Directory' "Model\Common\Config\ReadConfigLogin.n"],
['Work Directory' "Model\Common\Config\CheckLog.n"],

'@' => (
	sqlFile <- '@',

	/*databaseType = "SQLSERVER" =>( 
		@ ( "DELETE FROM " DB_BACKUP_PREFIX "PLAN WHERE idBackup NOT IN (SELECT id FROM [" DB_BACKUP "] )\n"),

		@ ( "DELETE FROM " DB_BACKUP_PREFIX "PLAN WHERE idBackup IN (SELECT id FROM [" DB_BACKUP "] b WHERE type='" TAG_TYPE_SNAPSHOT "'  "sql_AND_CLUB_BACKUP" )\n"), % Chen 0823

		@ ( "DELETE FROM [" DB_BACKUP "] WHERE type='" TAG_TYPE_SNAPSHOT "'  "sql_AND_CLUB_BACKUP"\n"),*/

	@ (SQL_DeletePlanBackupNotInBackup "\n"), % li 0822

	@ (SQL_DeletePlanBackupInBackupTypeIs TAG_TYPE_SNAPSHOT "'  " sql_AND_CLUB_BACKUP " )\n"), % Chen 0819

	@ (SQL_DeleteBackupTypeIs TAG_TYPE_SNAPSHOT "'  " sql_AND_CLUB_BACKUP "\n"),


	'@' <- sqlFile,

	% ExecuteSql
	[['Work Directory' "Model\Interface\ExecuteSql.n"], ['Work Directory' "ncl.cfg"], _],
),

'()' => (
	'()' <- database,

	sqlOperationLog := TAG_CLEAR_SNAPSHOT,
	['Work Directory' "Model\Output\WriteLog.n"],

	database <- '()',
),
