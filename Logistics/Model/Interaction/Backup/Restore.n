	%@ ("	SELECT 	idClub,id,name,idSite,DateForbidden"),
	%@ ("	FROM 	" DB_BACKUP_PREFIX "CLIENT cl"),
	%@ ("	WHERE 	idBackup = '" idBackup "' " sql_AND_CLUB_BACKUP_CLIENT "\n"), 

	% DEPOT 
	@ (SQL_InsertIntoDepotFromBackupIs sql_AND_CLUB_BACKUP_DEPOT "'\n"), 	%li 0822

	% DEPOT_PRODUCT 
	@ (SQL_InsertIntoDepotProductFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_DEPOT_PRODUCT "\n"),

	% PRODUCT 
