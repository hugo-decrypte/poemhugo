	% VEHICLE_PRODUCT
	@ (SQL_InsertIntoVehicleProductFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_VEHICLE_PRODUCT "\n"),

	% USER 
	@ (SQL_InsertIntoUserFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_USER "\n"),

	'@' <- sqlFile,


	% ExecuteSql
	[['Work Directory' "Model\Interface\ExecuteSql.n"], ['Work Directory' "ncl.cfg"], _],
),

'()' => ( 

	'()' <- database,

	sqlOperationLog := TAG_RESTORE_SNAPSHOT,
	['Work Directory' "Model\Output\WriteLog.n"],

	database <- '()',
),
