	@ (SQL_InsertIntoResourceTimeFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_RESOURCE_TIME "\n"), 

	% RULE
	@ (SQL_InsertIntoRuleFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_RULE "\n"), 


	% TYPEVEHICLE_PRODUCT
	@ (SQL_InsertIntoTypeVehicleProductFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_TYPEVEHICLE_PRODUCT "\n"), 

	% TOUR
	@ (SQL_InsertIntoTourFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_TOUR "\n"), 


	% CLIENT
