% Zhou 0813 : _InsertInto


	% ORDER
	@ (SQL_InsertIntoProjectFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_ORDER "\n"), % Chen 0731


	% VEHICLE 
	@ (SQL_InsertIntoVehicleFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_VEHICLE "\n"), 

	% PLAN
	@ (SQL_InsertIntoPlanFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_PLAN "\n"), 

	% RESOURCE_SHIFT
	@ (SQL_InsertIntoResourceShiftFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_RESOURCE_SHIFT "\n"), % Zhou 0726 : DateShift


