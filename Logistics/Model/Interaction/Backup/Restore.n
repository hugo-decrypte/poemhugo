	% SITE 
	@ (SQL_InsertIntoSiteFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_SITE "\n"),

	% SITE_SITE 
	@ (SQL_InsertIntoSiteSiteFromBackupIs idBackup "' " sql_AND_CLUB_BACKUP_SITE_SITE "\n"),

	% TYPEVEHICLE 
