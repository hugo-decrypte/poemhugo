'()' => (
	('hh:mm:ss' TAG_TAB_1 idTourTsp_{tsp} : '()'),


	idTourTSP	= idTourTsp_{tsp},
	tourTSP		= tourId_{idTourTSP},

	vehicleTSP	= vehicleTour_{tourTSP},
	typeVehicleTSP	= typeVehicleVehicle_{vehicleTSP},

	idVehicleTSP	= idResource_{vehicleTSP},
	idxTourVehicleTSP	= idxTourVehicleTour_{tourTSP},

	source	= -tourTSP,
	sink	= -tourTSP - nbTour,

	SourceTSP	= \{ source \},
	SinkTSP		= \{ sink \},

	maxTour0Vehicle_{vehicleTSP} > 0 => (
		TAG_VEHICLE " " idVehicleTSP " : " TAG_MAX_TOUR " = " maxTour0Vehicle_{vehicleTSP} :
		idxTourVehicleTSP \in [1, maxTour0Vehicle_{vehicleTSP}],
	),


	% Tour sites
	idSite10Vehicle_{vehicleTSP} <> "" => (
		idSite1Vehicle = idSite10Vehicle_{vehicleTSP},

		idSite20Vehicle_{vehicleTSP} <> "" => (
			idSite2Vehicle = idSite20Vehicle_{vehicleTSP},
			;
			idSite2Vehicle = idSite10Vehicle_{vehicleTSP},
		),
		;

		idSite1Vehicle = idSite20Vehicle_{vehicleTSP},
		idSite2Vehicle = idSite20Vehicle_{vehicleTSP},
	),

	idSite1TSP :: "",
	idSite2TSP :: "",

	t10TSP :: defaultDateTime,
	t20TSP :: defaultDateTime,



	'()' <- database,


	( SQL: sqlReadTSP),


	( TAG_NO_TOUR_FOR " " TAG_VEHICLE " " idVehicleTSP " " TAG_TOUR " " idxTourVehicleTSP :
		() > 0,
	),

	idTourTSP		= (),

	idSite1TSP		= (),
	idSite2TSP		= (),

	t10TSP			= (),
	%t20TSP			= (),


	boundMileage0TSP	:: 0,
	boundMileage0TSP	= (),

	boundTimeService0TSP	= (),
	boundTimeRoute0TSP	= (),

	boundMakespan0TSP	= (),



	t10ResourceTSP = (t100Vehicle_{vehicleTSP} = defaultDateTime ? t1 : t100Vehicle_{vehicleTSP}),
	t20ResourceTSP = (t200Vehicle_{vehicleTSP} = defaultDateTime ? t2 : t200Vehicle_{vehicleTSP}),


	sqlReadT2TSP = (
		"SELECT t1 FROM "DB_PREFIX "OPT_TOUR
		WHERE idResource='" idVehicleTSP "' AND tourResource=" (idxTourVehicleTSP+1)),
 
	( SQL: sqlReadT2TSP),

	() > 0 => (
		t20TSP = () - 1,
		;

		t20TSP = t20ResourceTSP,
	),


	sqlReadTSP_1 = (
		"SELECT COUNT(id),SUM(nbOrder),SUM(mileage),SUM(timeService),SUM(timeRoute),SUM(makespan),SUM(quantity),SUM(volume),SUM(weight) FROM "DB_PREFIX "OPT_TOUR t
		WHERE idResource='" idVehicleTSP "' AND id<>'" idTourTSP "'"),
 
	( SQL: sqlReadTSP_1),

	nbTourVehilce_1		:: 0,
	sumNbOrderVehilce_1	:: 0,

	sumMileageVehilce_1	:: 0,
	sumTimeServiceVehilce_1	:: 0,
	sumTimeRouteVehilce_1	:: 0,
	sumMakespanVehilce_1	:: 0,

	sumQuantityVehilce_1	:: 0,
	sumVolumeVehilce_1	:: 0.0,
	sumWeightVehilce_1	:: 0.0,


	()			= 1,

	nbTourVehilce_1		= (),
	sumNbOrderVehilce_1	= (),

	sumMileageVehilce_1	= (),
	sumTimeServiceVehilce_1	= (),
	sumTimeRouteVehilce_1	= (),
	sumMakespanVehilce_1	= (),
	
	sumQuantityVehilce_1	= (),
	sumVolumeVehilce_1	= (),
	sumWeightVehilce_1	= (),

	
	%['Work Directory' "Model\Input\Order\ReadOrderTSP.n"],




	sqlReadOrder = (
		"SELECT o.id,o.idSite2,o.priority,o.idProduct,o.quantity,o.weight,o.volume,o.timeFixed,o.receipts,o.t1Service0,o.t2Service0,o.idShift,c.idShift,o.strict
		FROM " DB_PREFIX "OPT_ORDER o," DB_PREFIX "OPT_CLIENT c WHERE o.state>='" STATE_CANDIDATE
		"' AND o.idClub='" idClubLogin "' AND o.idClient=c.id AND o.idResource='" idVehicleTSP "' AND o.tourResource=" idxTourVehicleTSP " ORDER BY o.id"
	),


	( SQL: sqlReadOrder),


	OrderTSP	= [1, ()],

	SourceOrderTSP		= SourceTSP \cup OrderTSP,
	OrderSinkTSP		= OrderTSP  \cup SinkTSP,
	SourceOrderSinkTSP	= SourceTSP \cup OrderTSP \cup SinkTSP,


	\forall o \in SourceOrderSinkTSP (
		idOrder_{o} :: "",
		strictTimeOrder_{o} :: true,

		priorityOrder_{o} :: 0,


		quantityOrder_{o} >= 0,
		weightOrder_{o} >= 0.0,
		volumeOrder_{o} >= 0.0,

		receiptsOrder_{o} :: 0.0,
	),


	\forall o \in OrderTSP (
		idSite2Order_{o} 	:: "",

		idProductOrder_{o} 	:: "",

		quantity0Order_{o} 	:: 0,
		weight0Order_{o} 	:: 0.0,
		volume0Order_{o} 	:: 0.0,

		timeFixed0Order_{o}	:: 0,


		t1Service00Order_{o}	:: defaultDateTime,
		t2Service00Order_{o}	:: defaultDateTime,

		idShift0Order_{o} 	:: "",
		idShiftClientOrder_{o} 	:: "",


		idOrder_{o} 		= (),
		idSite2Order_{o} 	= (),
		priorityOrder_{o} 	= (),

		idProductOrder_{o} 	= (),

		quantity0Order_{o} 	= (),
		weight0Order_{o} 	= (),
		volume0Order_{o} 	= (),

		timeFixed0Order_{o}	= (),

		receiptsOrder_{o}	= (),


		t1Service00Order_{o}	= (),
		t2Service00Order_{o}	= (),
		idShift0Order_{o} 	= (),
		idShiftClientOrder_{o} 	= (),

		strictTimeOrder_{o} 	== (() = STATE_TRUE),


		t1Service0Order_{o} = (
			t1Service00Order_{o} < t1 || t1Service00Order_{o} = defaultDateTime ?
			t1 : t1Service00Order_{o}
		),

		t2Service0Order_{o} = (
			t2Service00Order_{o} > t2 || t2Service00Order_{o} = defaultDateTime ?
			t2 : t2Service00Order_{o}
		),

		(idOrder_{o} TAG_ORDER_TIME_WIN_NOT_IN_HORIZON idOrder_{o} " : " t1Service0Order_{o} " " t2Service0Order_{o} :
			t1Service0Order_{o} =< t2Service0Order_{o},
		),
	),

	\forall o \in SourceTSP \cup SinkTSP (
		priorityOrder_{o} = 0,

		quantityOrder_{o} = 0,
		weightOrder_{o} = 0.0,
		volumeOrder_{o} = 0.0,

		receiptsOrder_{o} = 0.0,

		!strictTimeOrder_{o},
	),


	\forall o \in OrderTSP (
		quantityOrder_{o} >= 0,
		weightOrder_{o} >= 0.0,
		volumeOrder_{o} >= 0.0,
	
		idProductOrder_{o} \in IDPRODUCT \cup \{""\},

		weightQtyOrder_{o} = quantity0Order_{o} * unitWeightProduct_{productId_{idProductOrder_{o}}},
		volumeQtyOrder_{o} = quantity0Order_{o} * unitVolumeProduct_{productId_{idProductOrder_{o}}},

		quantityOrder_{o} = \underline{quantity0Order_{o}},
		weightOrder_{o} = \underline{(weight0Order_{o} > weightQtyOrder_{o} ? weight0Order_{o} : weightQtyOrder_{o})}, % Zhou 0724
		volumeOrder_{o} = \underline{(volume0Order_{o} > volumeQtyOrder_{o} ? volume0Order_{o} : volumeQtyOrder_{o})}, % Zhou 0724


		idShiftOrder_{o} = (idShift0Order_{o} <> "" ? idShift0Order_{o} : idShiftClientOrder_{o}),
	),

	IdOrderTSP = \{ \forall o \in OrderTSP idOrder_{o} \},


	idOrder_{source} = TAG_SOURCE,
	idOrder_{sink}	 = TAG_SINK,

	\forall i \in IdOrderTSP (
		orderId_{i} \in OrderTSP,
		idOrder_{orderId_{i}} = i,
	),



	IdSiteOrder = \{ \forall o \in OrderTSP idSite2Order_{o} \},

	IDSITE = (
		IdSiteOrder \cup \{
			idSite1Vehicle, idSite2Vehicle
		\} \cup \{
			idSite1TSP, idSite2TSP
		\}
	) \setminus "",




	database <- '()',




	['Work Directory' "Model\Input\Site\ReadSiteOrder.n"],
	['Work Directory' "Model\Input\Site\ReadSiteSite.n"],




	% Tour horizon
	Horizon0TSP = [t10TSP, t20TSP],
	HorizonTSP = (ruleDailyTour ? Horizon0TSP \cap HorizonDate_{t10TSP["yyyy-mm-dd"]} : Horizon0TSP),




	% Tour max worktime / max makespan
	maxMakespanConfig = (maxMakespanDay = 0 ? timeDay : maxMakespanDay),
	maxWorktimeConfig = (maxWorktimeDay = 0 ? timeDay : maxWorktimeDay),

	maxMakespanDayTypeVehicle = (maxMakespanDay0TypeVehicle_{typeVehicleTSP} = 0 ? maxMakespanConfig : maxMakespanDay0TypeVehicle_{typeVehicleTSP}),
	maxWorktimeDayTypeVehicle = (maxWorktimeDay0TypeVehicle_{typeVehicleTSP} = 0 ? maxWorktimeConfig : maxWorktimeDay0TypeVehicle_{typeVehicleTSP}),

	maxWorktimeDayVehicle = (maxWorktimeDay0Vehicle_{vehicleTSP} = 0 ? maxWorktimeDayTypeVehicle : maxWorktimeDay0Vehicle_{vehicleTSP}),
	maxMakespanDayVehicle = (maxMakespanDay0Vehicle_{vehicleTSP} = 0 ? maxMakespanDayTypeVehicle : maxMakespanDay0Vehicle_{vehicleTSP}),




	% Bounds
	boundWorktime0TSP = boundTimeService0TSP + boundTimeRoute0TSP,


	boundWorktimeTSP = (boundWorktime0TSP = 0 ? maxWorktimeDayVehicle : boundWorktime0TSP),
	boundMakespanTSP = (boundMakespan0TSP = 0 ? maxMakespanDayVehicle : boundMakespan0TSP),

	boundMileageTSP = (boundMileage0TSP = 0 ? +\infty : boundMileage0TSP),





	% Quantity
	receiptsTSP = \sum_{o \in OrderTSP}{receiptsOrder_{o}},

	costUnitTSP = costUnitTypeVehicle_{typeVehicleTSP},



	% Capacity
	maxQuantityTypeVehicle 	= (maxQuantity0TypeVehicle_{typeVehicleTSP} = 0 ? +\infty : maxQuantity0TypeVehicle_{typeVehicleTSP}),
	maxWeightTypeVehicle 	= \overline{(maxWeight0TypeVehicle_{typeVehicleTSP} = 0.0 ? +\infty : maxWeight0TypeVehicle_{typeVehicleTSP})},
	maxVolumeTypeVehicle 	= \overline{(maxVolume0TypeVehicle_{typeVehicleTSP} = 0.0 ? +\infty : maxVolume0TypeVehicle_{typeVehicleTSP})},

	maxQuantityTSP	= (maxQuantityTour0Vehicle_{vehicleTSP} = 0 ? maxQuantityTypeVehicle	: maxQuantityTour0Vehicle_{vehicleTSP}),
	maxWeightTSP	= (maxWeightTour0Vehicle_{vehicleTSP} 	= 0.0 ? maxWeightTypeVehicle	: maxWeightTour0Vehicle_{vehicleTSP}),
	maxVolumeTSP	= (maxVolumeTour0Vehicle_{vehicleTSP} 	= 0.0 ? maxVolumeTypeVehicle	: maxVolumeTour0Vehicle_{vehicleTSP}),




	% PreSolving
	['Work Directory' "Model\Common\Solver\ParameterizeResourceTime.n"],
	['Work Directory' "Model\Common\Solver\ParameterizeObjective.n"],
	['Work Directory' "Model\Solver\ParameterizeTimeDistance.n"],



	% Schedule
	Schedule = Schedule0Resource_{vehicleTSP} \cap HorizonTSP,

	ScheduleRest = HorizonTSP \setminus Schedule,


	% Time win
	\forall o \in SourceOrderSinkTSP
		TimeWinOrder_{o} :: HorizonTSP,

	\forall o \in OrderTSP (
		timeFixedOrder_{o} :: 0,
		timeFixedOrder_{o} = \lfloor \underline{timeFixed0Order_{o} * timeRatio + 0.5} \rfloor,


		shiftOrder_{o} \in SHIFT \cup \{0\},

		shiftOrder_{o} = shiftId_{idShiftOrder_{o}},


		TimeWin0Order_{o} =
			[t1Service0Order_{o}, t2Service0Order_{o}] \cap
			\bigcup_{d \in DATE}{TimeDateShift_{shiftOrder_{o},d}},


		(idOrder_{o} TAG_ORDER_TIME_WIN_NOT_IN_HORIZON idOrder_{o} :
			TimeWin0Order_{o} <> {},
		),


		TimeWinOrder_{o} = (
			strictTimeOrder_{o} ?
			TimeWin0Order_{o} : [\inf TimeWin0Order_{o}, t20TSP]
		),
	),

	TimeWinOrder_{source}	= HorizonTSP,
	TimeWinOrder_{sink}	= HorizonTSP,



	% Site
	\forall o \in SourceOrderSinkTSP
		siteOrder_{o} \in SITE,

	\forall o \in OrderTSP
		siteOrder_{o} = siteId_{idSite2Order_{o}},

	siteOrder_{source}	= (idSite1TSP <> "" ? siteId_{idSite1TSP} : siteId_{idSite1Vehicle}),
	siteOrder_{sink}	= (idSite2TSP <> "" ? siteId_{idSite2TSP} : siteId_{idSite2Vehicle}),



	% dOrderOrder/tOrderOrder
	\forall o,i \in SourceOrderSinkTSP (
		tOrderOrder_{o,i} :: defaultTime,
		tOrderOrder_{o,i} >= 0,

		dOrderOrder_{o,i} = dSiteSite_{siteOrder_{o},siteOrder_{i}},
		tOrderOrder_{o,i} = tSiteSite_{siteOrder_{o},siteOrder_{i}},
	),

	costUnitKilometer = costKilometerTypeVehicle_{typeVehicleTSP},



	('hh:mm:ss' TAG_TAB_0 TAG_OPTIMIZE_TOUR " " identity "    " TAG_TOUR_ID " : " idTourTSP "    " TAG_ORDER_NB " : " #OrderTSP "    " TAG_OBJECTIVE " : " nameObjectiveTop "    " TAG_HORIZON " : " \inf HorizonTSP " .. " \sup HorizonTSP "\n" : ),
),

