\forall t1,t2 \in TourActiveBuffer (
	SiteTour_{t2} \subset SiteOrder,

	\forall v2 \in SiteTour_{t2} (
		areaSquareSite1Tour2Tour1_{t1,t2,v2} = \max_{v1 \in SiteTour_{t1}}{
			areaSquareSiteSiteTour_{t1,v1,v2}
		},

		SiteTour_{t1} = {} -> areaSquareSite1Tour2Tour1_{t1,t2,v2} = 0.0,
	),

	areaSquareTour2Tour1_{t1,t2} = \max_{v2 \in SiteTour_{t2}}{areaSquareSite1Tour2Tour1_{t1,t2,v2}},
	SiteTour_{t2} = {} -> areaSquareTour2Tour1_{t1,t2} = 0.0,

	Vertex2Tour2Tour1_{t1,t2} = \{
		\forall v2 \in SiteTour_{t2} (
			areaSquareSite1Tour2Tour1_{t1,t2,v2} >= areaSquareTour2Tour1_{t1,t2} ? v2 : 0
		)
	\} \setminus 0,


	/*Vertex2Tour2Tour1_{t1,t2} = Vertex2TriangleVertex2Vertex1Tour2Tour1(
		t1,t2,
		SiteTour_{t1},SiteTour_{t2},
		siteId_{idSite1TourBuffer_{t1}},siteId_{idSite2TourBuffer_{t1}},
		areaSquareTour2Tour1_{t1,t2}
	),*/
),

VERTEX2 \subset SiteOrder,
VERTEX2 = \bigcup_{t1,t2 \in TourActiveBuffer}{Vertex2Tour2Tour1_{t1,t2}},

\forall o \in ORDER (
	\forall s \in VERTEX2
		dSiteSite1TourOrder_{o,s} =
		dSiteSite1Tour_{tourOrderBuffer_{o},s},

	\forall s \in SiteOrder (
		detourSiteOrderTourOrder_{o,s} =
		detourSiteOrderTour_{tourOrderBuffer_{o},o,s},

		areaSquareSiteOrderTourOrder_{o,s} =
		areaSquareSiteOrderTour_{tourOrderBuffer_{o},o,s},
	),
),

\forall o \in ORDER
\forall t \in TourActiveBuffer (
	VertexIfTourOrder_{o,t} \subset SiteOrder,
	VertexIfTourOrder_{o,t} = Vertex2Tour2Tour1_{tourOrderBuffer_{o}, t},

	VertexTourOrder_{o,t} \subset SiteOrder,
	VertexTourOrder_{o,t} = Vertex2Tour2Tour1_{t, tourOrderBuffer_{o}},


/*	areaSquareOrderTour1_{t,o} = \max_{v1 \in VertexTourOrder_{o,t}}{
		areaSquareSiteOrderTourOrder_{o,v1}
	},
	VertexTourOrder_{o,t} = {} -> areaSquareOrderTour1_{t,o} = 0.0,

	moreVertex1IfOrderTour2_{t,o} =
		areaSquareOrderTour1_{t,o} > areaSquareTour2Tour1_{tourOrderBuffer_{o},t},

	\forall s \in VertexIfTourOrder_{o,t}
		detourIfSiteOrderTour2_{t,o,s} = (
			moreVertex1IfOrderTour2_{t,o} ?
			detourOrderSiteTour_{t,s,o}
			:
			detourSiteOrderTour_{t,o,s}
		),

*/

	areaSquareOrderTour1_{t,o} = \max_{v1 \in VertexTourOrder_{o,t}}{
		areaSquareSiteOrderTourOrder_{o,v1}
	},
	VertexTourOrder_{o,t} = {} -> areaSquareOrderTour1_{t,o} = 0.0,

	moreVertex1IfOrderTour2_{t,o} =
		areaSquareOrderTour1_{t,o} > areaSquareTour2Tour1_{tourOrderBuffer_{o},t},

	\forall s \in VertexIfTourOrder_{o,t}
		detourIfSiteOrderTour2_{t,o,s} = (
			moreVertex1IfOrderTour2_{t,o} ?
			%dOrderSite1Tour_{t,o} > dSiteSite1Tour_{t,s} ?
			detourOrderSiteTour_{t,s,o}
			:
			detourSiteOrderTour_{t,o,s}
		),



	% detourIfTourOrder
	detourIfTourOrder_{o,t} = \max_{s \in VertexIfTourOrder_{o,t}}{
		detourIfSiteOrderTour2_{t,o,s}
	},
	VertexIfTourOrder_{o,t} <> {},

	% detourOrderTour
	detourTourOrder_{o,t} = \max_{s \in VertexTourOrder_{o,t}}{
		detourSiteOrderTourOrder_{o,s}
	},
	VertexTourOrder_{o,t} <> {},
),

\forall t \in TourActiveBuffer (
	\forall o \in ORDER
		improvementIfTourOrder_{o,t} = detourTourOrder_{o,t} - detourIfTourOrder_{o,t},

	\forall s \in SiteOrder
	\forall t1 \in TourActiveBuffer
		improvementIfTourTourSite_{s,t1,t} :: 0,

	\forall o \in ORDER (
		improvementIfTourTourSite_{siteOrderBuffer_{o},tourOrderBuffer_{o},t} =
		improvementIfTourOrder_{o,t},
	),
),

\forall t \in TourActiveBuffer (
	SpanTourBuffer_{t} = [t1TourBuffer_{t}, t2TourBuffer_{t}],
),

