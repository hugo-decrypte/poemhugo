\forall o \in OrderSinkActiveBuffer
	prevOrderBuffer_{o} \in SourceActiveOrderBuffer,

\forall o \in SourceActiveOrderBuffer
	prevOrderBuffer_{nextOrderBuffer_{o}} = o,


\forall o \in SourceOrderSinkActiveBuffer
	siteOrderBuffer_{o} = siteId_{idSiteOrderBuffer_{o}},


\forall t \in TourActiveBuffer (
	SiteTour_{t} \subset SiteOrder,
	SiteTour_{t} = \{ \forall o \in OrderTourBuffer_{t} siteOrderBuffer_{o} \},
	SiteTour_{t} <> {},

	maxDistTour_{t} = \max_{s<>i \in SiteTour_{t}}{dSiteSite_{s,i}},
	#SiteTour_{t} < 2 -> 0 = maxDistTour_{t},

	\forall o \in ORDER (
		minDistOrderTour_{t,o} = \min_{s \in SiteTour_{t}}{dOrderSite_{s,o}},
	),
),



/*
% Reciprocal distance method
\forall t \in TourActiveBuffer
\forall s,i \in SiteOrder
	distSiteSiteTour_{t,s,i} = dSiteSite1Tour_{t,s} + dSiteSite_{s,i} + dSite2TourSite_{i,t},	% ????????
*/

% Greatest triangle area method
% Heron's formula
% area = \sqrt{s (s-a) (s-b) (s-c)}
% s = (a + b + c) / 2

<areaSquareTriangle>(t1,t2, v1,v2)
(
	sAreaSite = (dSiteSite1Tour_{t1,v1} + dSiteSite_{v1,v2} + dSite2TourSite_{v2,t2}) / 2,

	areaSquareTriangle =
		sAreaSite *
		(sAreaSite - dSiteSite1Tour_{t1,v1}) *
		(sAreaSite - dSiteSite_{v1,v2}) *
		(sAreaSite - dSite2TourSite_{v2,t2}),
),

