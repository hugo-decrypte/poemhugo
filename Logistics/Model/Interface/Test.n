['Work Directory' "Model\Common\Config\ReadUserLogin.n"],


'()' => (
	id = (),
	name = (),
),


'@' => (
	messageBuffer = [message : "message buffer"],


	messageBuffer <- '@',


	@ ("Test Program(" id ", " name ") successful"),


	'@' <- messageBuffer,	% Sent to solution message


	(message : !!),
),



.



