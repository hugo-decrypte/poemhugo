	%chartProduct(TAG_DIAGRAM_PRODUCT,true,""),

	('hh:mm:ss' TAG_TAB_0 TAG_DIAGRAM_PRODUCT TAG_END TAG_GLOBAL_TIME 'Global Time'[1..8] : '@'),
),
