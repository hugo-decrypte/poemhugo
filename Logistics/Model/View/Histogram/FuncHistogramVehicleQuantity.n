<histogramVehicleQuantity>(aliasHistogram,bestfit, labelX,labelY, labelLegend,colorLegend, IdVehicleSelected, title, postfix0)	% JZ 1022
(
	'@' => (
		postfix = (postfix0 = "" ? "" : idUserLogin),
		viewFile = ("HistogramVehicleQuantity" postfix ".view"),

		IdVehicleSelected <> {} => (
			sqlFrom = (
				" FROM " DB_PREFIX "RESOURCE v  WHERE "
				SQL_ViewUserVisibleClubIs "v.idClub) AND v.id IN (" concatSetQuoted(IdVehicleSelected) ")"
			),
			;

			sqlFrom = (
				" FROM " DB_PREFIX "RESOURCE v  WHERE "
				SQL_ViewUserVisibleClubIs "v.idClub) AND v.state>='" STATE_CANDIDATE "'"
			),
		),

		sqlRate = (SQL_CASEWHEN "ISNULL(v.rateQuantity)" SQL_THEN "0" SQL_ELSE "v.rateQuantity" SQL_CASEEND),
		sqlDataXY = ("SELECT DISTINCT v.id AS X, " sqlRate " AS Y, "),

		%sqlDataHistogram = (
		%	"SELECT DISTINCT v.id AS X, "
		%		SQL_CASEWHEN "ISNULL(v.rateQuantity)" SQL_THEN "0" SQL_ELSE "v.rateQuantity" SQL_CASEEND " AS Y, "
		%		SQL_CASEWHEN "Y>0" SQL_THEN "'" RGB_Y1_RATE1 "'" SQL_ELSE "'" RGB_Y1_RATE2 "'" SQL_CASEEND " AS C_1 " sqlFrom),

		['Work Directory' "Model\Common\View\HistogramBar1.n"],
	),
),
