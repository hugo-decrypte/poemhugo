%% 2025.01.29   DATE() => SQL_CURRENTDATE 

% Data: TYPERESOURCE
@ "Data ",

% ID
@ ("DATATYPERESOURCE"),	

% Caption
@ " 'TYPERESOURCE' ",

% Group
@ "DATATYPERESOURCE ",

% Source type
@ typeDataUser,

% Editable
@ " 0 ",

% Object item "[TYPE=Site/...; MAP=map_id; LOCALIZE=map_object_class_id; ...]"
@ "_ ",

% Script item "[Scripts when delete, insert or update]"
@ ("_ \\\n"),



% Fields item "[Field count; (Field 1); (Field 2); ...]"
@ ("\"[3;(string,ID,,,);(string,TODAY,,,);(string,NAME,,,);]\"\\\n"),	

@ VIEWSQL,

@ ("SELECT DISTINCT tr.id AS ID,\
		tr.name AS NAME,\
 		format(" SQL_CURRENTDATE ",'" SQL_FORMATDATE_FR "') AS TODAY\
  		FROM TYPERESOURCE tr\"\n\n"),


