% Data: TYPEPROCESS
@ "Data ",

% ID
@ ("DATATYPEPROCESS '"),	

% Caption
@ TAG_PROCESS_TYPE,



% Group
@ "' TYPEPROCESS ",

% Source type
@ typeDataUser,

% Editable
@ " 0 ",

% Object item "[TYPE=Site/...; MAP=map_id; LOCALIZE=map_object_class_id; ...]"
@ "_ ",

% Script item "[Scripts when delete, insert or update]"
@ ("_ \\\n"),

% Fields item "[Field 


% Fields item "[Field count; (Field 1); (Field 2); ...]"
@ ("\"[2;(string,ID,ID,,255,0);"), 
@ ("(string,NAME,NAME,,255,0)]\"\\\n"),	

@ VIEWSQL,

@ ("SELECT tp.id AS ID, tp.name AS NAME \
	FROM " DB_PREFIX "TYPEPROCESS tp \
	ORDER BY tp.id\"\n\n"),

