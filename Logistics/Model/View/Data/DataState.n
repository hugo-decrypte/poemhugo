@ ("Data STATE 'State' STATE "),

@ typeDataUser,

@ (" 0 _ _ \\\n"),
@ ("\"[2;(string,IDSTATE,Statut ID,,15.0.80,0);(string,LABELSTATE," TAG_LABEL ",,50.0.300,0);]\"\\\n"),

@ VIEWSQL,
@ ("select s.Id AS IDSTATE, \
	"SQL_CONCAT"trim(LABEL) "SQL_CONCATWITH" '(' "SQL_CONCATWITH" trim(ID) "SQL_CONCATWITH" ')'"SQL_CONCATEND" as LABELSTATE \
	FROM " DB_PREFIX "STATE s \\\n"),

? aliasTable (
	"DELIVERYNOTE":
		@ ("WHERE s.Category='DELIVERYNOTE' \\\n"),
	;
	"RESOURCE":
		@ ("WHERE s.Category='RESOURCE' \\\n"),
	;
	"ORDER":	% JZ 1021 CLIENTORDER -> ORDER
		@ ("WHERE s.Category='ORDER' \\\n"),
	;
	"SUPPLY":
		@ ("WHERE s.Category='SUPPLY' \\\n"),
	;
	"PACKING":
		@ ("WHERE s.Category='SUPPLY' \\\n"),
	;
	"QUOTE":
		@ ("WHERE s.Category='QUOTE' \\\n"),
	;
	"DELIVERY":
		@ ("WHERE s.Category='DELIVERY' \\\n"),
 ),
 
@ ("ORDER BY s.Id \"\n\n"),



