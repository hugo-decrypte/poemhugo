[viewDirectory "ButtonClearResult.view"] <- '@',

 % View Object	
@ ("View "),

% ID	
@ ("'" TAG_CLEAR_RESULT "' "),

% Caption	
@ ("_ "),

% Title	
@ ("'" TAG_CLEAR_RESULT "' "),

% Color(R G B)	
@ ("255 255 255 "),

% Icon	
@ ("_ "),

% Rect(X Y SX SY )	
@ ("0 0 40 40 "),

% Margin	
@ ("5 5 5 5 "),

% [Option items]
@ ("'[TRACELEVEL=0;"),
@ ("TRACEFILE=;"),
@ ("DEBUGLEVEL=0;;"),
@ ("SCROLLBAR=0;"),
@ ("NATURESCALE=0;"),
@ ("BESTFIT=1]'"),
@ "\n\n",



% Script Object	
@ ("Script "),

% ID	
@ ("ClearResult '"),

% Caption
@ (TAG_CLEAR_RESULT "' "),

% Group	
@ ("_ "),

% Integer Code [0..1000]
@ SCRIPT_BUTTON_CLEAR_RESULT,


% Label	
@ (" '" TAG_CLEAR_RESULT "' "),

% Object Group Set "{G1, G2, ...}"	
@ ("_ "),

% Object Id. Set / Object Item
@ ("_ "),

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"	
@ ("'0 0 40 40' "),

% Color "(R G B)" / "[Label format]"	
@ ("_ "),

% Icon file	
@ ("_ "),

% Alert message
%@ ("_ "),
@ ("'" TAG_ASK_CLEAR_RESULT "' "),


% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"
scriptSolverType = "PoemServer" => ( 
	@ (" '[COUNT=1;NETNCL=HTTP;SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/);TIMEOUT=" maxTimeHttpSolver ";MESSAGE=0;CANCEL=1;SKIP=0;WAITCURSOR=0;]' \\\n"),
	;
	@ "'[COUNT=1;MESSAGE=0;CANCEL=1;SKIP=0]'\\\n",
),

% Instruction... (When Count>0)	
@ ("\tNcl '(/*SERVERDIRECTORY*/)' '(/*SERVERDIRECTORY*/)Model\\Script\\ScriptClearResult.n' '(/*SERVERDIRECTORY*/)ncl.cfg' _ _ _ 1 \\\n"),
@ ("\t'(/*SERVERPORT*/) (/*USERID*/)'\\\n"), 

'@' <- [viewDirectory "ButtonClearResult.view"],
