% related
%	"User" 		: access limited to user accessibility
%	table name	: related to table
%	... 		: e.g., special view opened in view menu  
%
% idUserPostfix
%	not "" : idUserLogin as postfix

<tablePrevisionProductPrice>(id,type,aliasTable,bestfit,doubleclick,title,related,idUserPostfix)	% JZ 1013
(
	['Work Directory' "Model\Common\Config\ReadField.n"],	


	'@' => (
		
		postfix = (related = "" ? (idUserPostfix = "" ? "" : idUserLogin) : (related)),
		viewFile = ("TablePrevisionProductPrice" postfix),
		

		[viewDirectory viewFile ".view"] <- '@',


		['Work Directory' "Model\Common\View\HeaderTable.n"],


		@ ("(color,LINERGB,"	RGB_WHITE		",,13.0.0);]\" \\\n"),

		@ VIEWSQL,



		dateMonth :: "",
		? databaseType (
			"ACCESS" :
				dateMonth = ("DateAdd("SQL_DATEPART_MONTH", -M.NoMonth, "SQL_CURRENTDATE")"),
				;

			"SQLSERVER" :
				dateMonth = ("DateAdd("SQL_DATEPART_MONTH", -M.NoMonth, "SQL_CURRENTDATE")"),
				;

			"MYSQL" :
				dateMonth = ("date_Add("SQL_CURRENTDATE", INTERVAL -M.NoMonth MONTH)"), 
				;

			"ORACLE" :
				dateMonth = ("ADD_MONTHS("SQL_CURRENTDATE",-M.NoMonth)"),
		),

		@ ("SELECT  pp.ID 				as ID,\\\n"),
		@ ("\t\t pp.minPrice 			as MINPRICE,\\\n"),
		@ ("\t\t  pp.producersMinPrice 	as PRODUCERSMINPRICE, \\\n"),
		@ ("\t\t  pp.quantityMinPrice 	as QUANTITYMINPRICE, \\\n"),
		@ ("\t\t  pp.weightMinPrice 	as WEIGHTMINPRICE, \\\n"),
		@ ("\t\t  pp.volumeMinPrice 	as VOLUMEMINPRICE, \\\n"),
		@ ("\t\t  pp.maxPrice 			as MAXPRICE,\\\n"),
		@ ("\t\t  pp.producersMaxPrice 	as PRODUCERSMAXPRICE, \\\n"),
		@ ("\t\t  pp.quantityMaxPrice 	as QUANTITYMAXPRICE, \\\n"),
		@ ("\t\t  pp.weightMaxPrice 	as WEIGHTMAXPRICE, \\\n"),
		@ ("\t\t  pp.volumeMaxPrice 	as VOLUMEMAXPRICE, \\\n"),
		@ ("\t\t  pp.probability		as PROBABILITY, \\\n"),
		@ ("\t\t  '(255 255 255 )' 		as LINERGB \\\n"),
	 	@ ("\t FROM  " DB_PREFIX "PRODUCT_PRICE pp\\\n"),
		@ ("\t WHERE pp.idClub='(/*CLUBID*/)' \\\n"),
		@ ("\t ORDER BY pp.ID\"\n\n\n"),

		%['Work Directory' "Model\Interaction\View\Table\ScenarioTablePrevisionProductPrice2EditOnView.n"],
		['Work Directory' "Model\Interaction\View\Table\ScenarioTablePrevisionProductPrice2EditProductPrice.n"],

		'@' <- [viewDirectory viewFile ".view"],
	),
),
