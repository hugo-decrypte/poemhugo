%['Work Directory' "Model\Input\View\ReadOrderResourceForView.n"],
['Work Directory' "Model\\View\\Table\\FuncTableResult.n"],

'@' => (
	tableResult("RESULT",TAG_TABLE,"RESULT",true, "", TAG_SOLUTION_STATE,"", ""),
	%tableResult("RESULT",TAG_TABLE,"RESULT",true, "", TAG_TABLE_RESULT,"", ""),
	
	('hh:mm:ss' "  " TAG_TABLE_RESULT TAG_END TAG_COST_TIME 'Global Time'[1..6] "\n" : ),
),
