['Work Directory' "Model\Common\Config\ReadBoot.n"],

'()' => (
	queryFile = (),
	translatedQueryFile = (),

	TranslatedQuery = [1, ()],

	\forall i \in TranslatedQuery (
		translatedQuery_{i} :: "",
		translatedQuery_{i} = (),
	),



	sqlConfig = ('Work Directory' queryFile),


	'()' <- [sqlConfig],

	nbSqlQuery = #(sqlQueryFile, "\n\n"),

	\forall i \in [1, nbSqlQuery] (
		idSqlQuery_{i}		:: "",
		valueSqlQuery_{i}	:: "",

		idSqlQuery_{i} = ()	: "=",
		valueSqlQuery_{i} = ()	: "\n\n",
	),

	[sqlConfig] <- '()',
),

'@' => (
	translatedQueryConfig = ('Work Directory' translatedQueryFile),


	[translatedQueryConfig] <- '@',

	\forall i \in TranslatedQuery (
		@ (idSqlQuery_{i} "=" translatedQuery_{i} "\n\n"),
	),

	'@' <- [translatedQueryConfig],
),

