%"httpProgram=Model/Common/Interface/GetAddressTable.n&CONFIG=ncl.cfg&DIRECTORY=./&REPLY=NULL"


['Work Directory' "Model\Common\Config\ReadBoot.n"],


'()' => (

	'()' <- database,


	sqlGetItem = (
		"SELECT id,designation,designationTech FROM "
		DB_PREFIX"PRODUCT WHERE idClub='" idClubLogin "' AND selected='" STATE_TRUE "' ORDER BY id"),

	(SQL: sqlGetItem ),


	ITEM = [1, ()],

	\forall i \in ITEM (
		idItem_{i}		:: "",
		nameItem_{i}		:: "",
		nameTechItem_{i}	:: "",

		idItem_{i}		= (),
		nameItem_{i}		= (),
		nameTechItem_{i}	= (),
	),


	database <- '()',
),

'@' => (
	messageBuffer = [message : "message buffer"],


	messageBuffer <- '@',




	@ (3 "\n"),
	@ ("\"France\"\n"),
	@ ("\"Germany\"\n"),
	@ ("\"Italy\"\n"),


	@ (6 "\n"),
	@ ('01/01/2027' "  " '31/01/2027' "\n"),
	@ ('01/03/2027' "  " '31/03/2027' "\n"),
	@ ('01/05/2027' "  " '31/05/2027' "\n"),
	@ ('01/07/2027' "  " '31/07/2027' "\n"),
	@ ('01/09/2027' "  " '30/09/2027' "\n"),
	@ ('01/11/2027' "  " '30/11/2027' "\n"),


	%@ ("\"" TAG_PROMPT_PRICE_PREDICTION  "\"\n"),
	%@ ("\"" TAG_PROMPT_DEMAND_PREDICTION "\"\n"),


	@ (#ITEM "\n"),

	\forall i \in ITEM (
		@ (	"\"" idItem_{i}		"\"\n"
			"\"" nameItem_{i}	"\"\n"
			"\"" nameTechItem_{i}	"\"\n"
		),
	),



	'@' <- messageBuffer,	% Sent to solution message


	( message : '.'),
),

