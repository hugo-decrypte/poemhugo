['Work Directory' "Model\Common\Config\ReadBoot.n"],

%input buffer: 89 000 {001} {}

'()' => (
	maxTour = 6,
	maxNode = 30,



	IdVehicleBuf	:: {""},
	TourVehicleBuf	:: {},

	IdVehicleBuf	= (),
	TourVehicleBuf	= (),

	'()' <- database,


	IdVehicleBuf = {} => (
		(SQL: "SELECT DISTINCT p.idResource FROM OPT_RESOURCE_TASK p"),
		%(SQL: "SELECT DISTINCT p.idResource FROM "DB_PREFIX "RESOURCE_TASK p"),

		IdVehicle = \{ \forall i \in [1,()] () \},
		;

		IdVehicle = IdVehicleBuf,
	),


	\forall v \in [1, #IdVehicle] (
		selectVehicle_{v} = (
			"SELECT t.id,p.idTypeRisk,t.length,t.width,t.height,t.maxWeight,t.categoryTunnel,t.nbTrailer FROM "
			DB_PREFIX "OPT_RESOURCE_TASK rt," DB_PREFIX "OPT_RESOURCE r," DB_PREFIX "OPT_ORDER o," DB_PREFIX "OPT_TYPERESOURCE t," DB_PREFIX "OPT_PRODUCT p
			WHERE o.id=rt.idProject AND r.id=rt.idResource AND p.id=o.idProduct AND r.id='" IdVehicle[v] "'
			ORDER BY t.id,p.id"
		),

		(SQL: selectVehicle_{v}),

		() > 0,

		idTypeResourceVehicle_{v}	:: "",
		idTypeRiskVehicle_{v}		:: "",	% JZ 0711
		lengthVehicle_{v}		:: "",
		widthVehicle_{v}		:: "",
		heightVehicle_{v}		:: "",
		maxWeightVehicle_{v}		:: "",
		categoryTunnelVehicle_{v}	:: "",
		nbTrailerVehicle_{v}		:: 0,

		idTypeResourceVehicle_{v}	= (),
		idTypeRiskVehicle_{v}		= (),	% JZ 0711
		lengthVehicle_{v}		= (),
		widthVehicle_{v}		= (),
		heightVehicle_{v}		= (),
		maxWeightVehicle_{v}		= (),
		categoryTunnelVehicle_{v}	= (),
		nbTrailerVehicle_{v}		= (),



		(SQL:	"SELECT DISTINCT p.tourResource FROM OPT_RESOURCE_TASK p
			WHERE p.idResource='" IdVehicle[v] "'"),

		nbTourVehicle_{v} =< maxTour,
		nbTourVehicle_{v} = (),
		Tour0Vehicle_{v} = \{ \forall i \in [1,nbTourVehicle_{v}] () \},

		TourVehicleBuf = {} => (
			TourVehicle_{v} = Tour0Vehicle_{v}, 
			;
			TourVehicle_{v} = Tour0Vehicle_{v} \cap TourVehicleBuf, 
		),

		TourVehicle_{v} \subset [1,maxTour],
		\forall t \in TourVehicle_{v} (
			(SQL:	"SELECT p.idProject,p.idSite1,s.latitude,s.longitude FROM OPT_RESOURCE_TASK p,"DB_PREFIX "SITE s
				WHERE p.idResource='" IdVehicle[v] "' AND p.tourResource=" t " AND p.idSite1=s.id
				ORDER BY p.idResource,p.tourResource,p.idx"),
		
			NodeTourVehicle_{v,t} \subset [1,maxNode],
			NodeTourVehicle_{v,t} = [1,()],

			\forall i \in NodeTourVehicle_{v,t} (
				idProjectNodeTourVehicle_{v,t,i}	:: "",
				idSiteNodeTourVehicle_{v,t,i}		:: "",
				latitudeNodeTourVehicle_{v,t,i}		:: 0.0,
				longitudeNodeTourVehicle_{v,t,i}	:: 0.0,

				idProjectNodeTourVehicle_{v,t,i}	= (),
				idSiteNodeTourVehicle_{v,t,i}		= (),
				latitudeNodeTourVehicle_{v,t,i}		= (),
				longitudeNodeTourVehicle_{v,t,i}	= (),
			),
		),
	),


	database <- '()',
),

'@' => (
	messageBuffer = [message : "message buffer"],


	messageBuffer <- '@',

	@ (#IdVehicle "\n"),

	\forall v \in [1, #IdVehicle] (
		% Vehicle Type & Risk Type
		@ (idTypeResourceVehicle_{v}	"\t" 
		   idTypeRiskVehicle_{v} 	"\t"
		   lengthVehicle_{v}		"\t"
		   widthVehicle_{v}		"\t"
		   heightVehicle_{v}		"\t"
		   maxWeightVehicle_{v}		"\t"
		   categoryTunnelVehicle_{v}	"\t"
		   nbTrailerVehicle_{v}		"\n"),
% JZ 0711


		@ (IdVehicle[v] "\t" #TourVehicle_{v} "\n"),

		\forall t \in TourVehicle_{v} (
			@ (t	"\t"	#NodeTourVehicle_{v,t} "\n"),

			\forall i \in NodeTourVehicle_{v,t} (
				@ (	\underline{latitudeNodeTourVehicle_{v,t,i}}	"  "
					\underline{longitudeNodeTourVehicle_{v,t,i}}	"  \n"
				),
			),
		),
	),

	'@' <- messageBuffer,	% Sent to solution message


	( message : '.'),
),




.




