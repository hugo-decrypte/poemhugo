['Work Directory' "Model\Common\Config\ReadUserLogin.n"],

'()' => (
	% Reading password info
	passwordPrev 		:: "",
	passwordNew 		:: "",
	passwordNew 		:: "",

	( TAG_PASSWORD_ERROR :
		passwordPrev 	= (),
		passwordNew 	= (),
		passwordNew 	= (),
	),


	% Password matching
	( TAG_PASSWORD_ERROR :
		passwordPrev = passwordUser_{userId_{idUserLogin}}
	),


	'()' <- database,

	( TAG_SQL_ERROR :
		(SQL :	"UPDATE " SQL_TABLE_USER " SET " SQL_FIELD_PASSWORD "='" passwordNew "' WHERE id='" idUserLogin "'"),
	),

	database <- '()',


	( TAG_PASSWORD_MODIFIED : !! ),
),
