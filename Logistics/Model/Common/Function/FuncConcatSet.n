<concatSetQuoted>(Str)
(
	Str :: {""},
	#Str =< maxConcatSet,

	Str <> {} => (
		\forall i \in [1,#Str]
			concat_{i} :: "",

		concat_{1} = ("'" \inf Str),
		\forall i \in [2,#Str]
			concat_{i} = (concat_{i-1} ("','" Str[i])),

		concatSetQuoted = (concat_{#Str} "'"),
		;

		concatSetQuoted = TAG_QUOTED_EMPTY_STRING,
	),
),

.

<concatSetNotQuoted>(Str)
(
	Str :: {""},
	#Str =< maxConcatSet,

	Str <> {} => (
		\forall i \in [1,#Str]
			concat_{i} :: "",

		concat_{1} = \inf Str,
		\forall i \in [2,#Str]
			concat_{i} = (concat_{i-1} ("," Str[i])),

		concatSetNotQuoted = concat_{#Str},
		;

		concatSetNotQuoted = TAG_EMPTY_STRING
	),
),


