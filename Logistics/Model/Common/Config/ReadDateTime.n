'()' => (

	% Week and Day
	nbDay	= 7,
	Day	= [1,nbDay],


	% 0 = '2000-01-01' is saterday
	\forall d \in DATE
		dayDate_{d} = (d+5) \mod nbDay + 1,

	\forall dy \in Day
		DateDay_{dy} = \{ \forall dt \in DATE (dayDate_{dt}= dy ? dt : defaultDate-1) \} \setminus (defaultDate-1),
 

	% HorizonDate
	dateInactive = \inf DATE - 1,

	\forall d \in DATE \cup \{ dateInactive \}
		HorizonDate_{d} :: HORIZON,

	HorizonDate_{dateInactive} = {},
	\forall d \in DATE
		HorizonDate_{d} = [midnight00,midnight24] >> (d*timeDay),
),
