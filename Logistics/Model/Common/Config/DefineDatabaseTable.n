%% checkTime = > extendedTime
%% postTime = > endTime
CreateProcess=(
	"CREATE TABLE " DB_PREFIX "PROCESS ("
		"idClub			VARCHAR(10),"
		"category		VARCHAR(10),"
		"id			VARCHAR(30) NOT NULL,"
		"name			VARCHAR(200),"
		"idTypeProcess		VARCHAR(20),"
		"idxParent		DECIMAL(10,0),"
