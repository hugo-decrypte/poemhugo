CreateField=(
	"CREATE TABLE " DB_PREFIX "FIELD1 ("
		"idClub		VARCHAR(10), "
		"idTable	VARCHAR(50) NOT NULL, "
		"aliasTable	VARCHAR(50) NOT NULL, "
		"nameTable	VARCHAR(50), "
		"idxTable 	DECIMAL(4,0),"

		"typeField	VARCHAR(10),"
		"idField	VARCHAR(50),"
		"aliasField	VARCHAR(50),"
		"nameField	VARCHAR(50),"
		"alignmentField	VARCHAR(10),"
		"colorField	VARCHAR(15),"
		"formatField	VARCHAR(15),"
		"idxField	DECIMAL(4,0),\n"

		"CONSTRAINT PK_FIELD PRIMARY KEY (alias) "
	") ;"
),
