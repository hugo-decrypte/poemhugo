CreateResource=("
CREATE TABLE " SQL_TABLE_RESOURCE " (
	id			VARCHAR(30) NOT NULL,
	name			VARCHAR(60),
	idAgency		VARCHAR(10),
	idCategoryResource	VARCHAR(20),
	idTypeResource		VARCHAR(20),
	idGroupResource		VARCHAR(20),
	idSite			VARCHAR(20),
	idShift			VARCHAR(20),
	critical		VARCHAR(2) DEFAULT 0,
	mobility		DECIMAL(10,0),
	t1			VARCHAR(26),
	t2			VARCHAR(26),
	quantity0		DECIMAL(7,0),
	minQuantity		DECIMAL(7,0),
	maxQuantity		DECIMAL(7,0),
	minWeight		DECIMAL(7,0),
	maxWeight		DECIMAL(7,0),
	minVolume		DECIMAL(7,0),
	maxVolume		DECIMAL(7,0),
	initTime		DECIMAL(7,0),
	initCost		DECIMAL(7,0),
	unitCost		DECIMAL(7,0),
	length			DECIMAL(7,0),
	width			DECIMAL(7,0),
	height			DECIMAL(7,0),
	gain			DECIMAL(18,2),
	penalty			DECIMAL(7,0),
	cost			DECIMAL(18,2),
	rate			DECIMAL(18,2),
	makespan		VARCHAR(20),
	state			VARCHAR(2),
	idClub			VARCHAR(10),
	sizeIcon		DECIMAL(10,0),
	idIcon			VARCHAR(20),
	color			VARCHAR(15),
	colorLine		VARCHAR(15),
	colorFill		VARCHAR(15),
	colorArrow		VARCHAR(15),
	widthLine		DECIMAL(10,0),
	widthArrow		DECIMAL(10,0),
	idSiteSequence		VARCHAR(20),
	coupledTask		VARCHAR(2),
	sameTypeSequence	VARCHAR(2),
	CONSTRAINT PK_RESOURCE PRIMARY KEY (id),
	CONSTRAINT FK_RESOURCE_Category FOREIGN KEY (idCategoryResource) references " DB_PREFIX "CATEGORYRESOURCE (id) on UPDATE CASCADE,
	CONSTRAINT FK_RESOURCE_Type 	FOREIGN KEY (idTypeResource) references " DB_PREFIX "TYPERESOURCE (id) on UPDATE CASCADE,
	CONSTRAINT FK_RESOURCE_Group	FOREIGN KEY (idGroupResource) references " DB_PREFIX "GROUPRESOURCE (id) on UPDATE CASCADE,
	CONSTRAINT FK_RESOURCE_Agency 	FOREIGN KEY (idAgency) references " DB_PREFIX "AGENCY (id) on UPDATE CASCADE
) ;
"),
