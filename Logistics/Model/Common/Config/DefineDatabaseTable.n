\forall i \in [1,30] (
	MenuConfig_{i} :: "",
),
\forall i \in [1,9] (
	MenuConfig_{i} = (
		"selected0"i"	VARCHAR(2),"
		"name0"i"	VARCHAR(50),"
	),
),
\forall i \in [10,30] (
	MenuConfig_{i} = (
		"selected"i"	VARCHAR(2),"
		"name"i"	VARCHAR(50),"
	),
),

