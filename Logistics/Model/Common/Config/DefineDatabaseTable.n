CreateContract=(
	"CREATE TABLE " DB_PREFIX "CONTRACT ("
		"idResource		VARCHAR(30) NOT NULL,"
		"dateStart		VARCHAR(15) NOT NULL,"
		"dateEnd		VARCHAR(15),"
		"type			VARCHAR(10),"
		"lastname		VARCHAR(50),"
		"firstname		VARCHAR(50),"
		"idAgency		VARCHAR(10),"
		"idCategoryResource	VARCHAR(20),"
		"idTypeResource		VARCHAR(20),"
		"timeDay		DECIMAL(4,0),"
		"timeWeek		DECIMAL(4,0),"
		"reservedWeek		DECIMAL(4,0),"
		"reservedYear		DECIMAL(4,0),"
		"nbDayYear		DECIMAL(4,0),"
		"advance		DECIMAL(8,2),"
		"comments		VARCHAR(150),"
		"nationality		VARCHAR(30),"
		"identityCard		VARCHAR(30),"
		"birthday		VARCHAR(30),"
		"birthplace		VARCHAR(100),"
		"socialSecurity		VARCHAR(30),"
		"address		VARCHAR(100),"
		"postcode		VARCHAR(10),"
		"city			VARCHAR(60),"
		"phone			VARCHAR(20),"
		"mobile			VARCHAR(20),"
		"idShift		VARCHAR(30),"
		"title			VARCHAR(30),"
		"qualification		VARCHAR(30),"
		"reference		VARCHAR(10),"
		"paymentMethod		VARCHAR(100),"
		"doctorCode		VARCHAR(20),"
		"securityNumber		VARCHAR(30),"
		"professionCard		VARCHAR(30),"
		"socialSecurity2	VARCHAR(30),"
		"idClub			VARCHAR(10),"
		"CONSTRAINT PK_CONTRACT PRIMARY KEY (idResource,dateStart),"
		"CONSTRAINT FK_CONTR_Res FOREIGN KEY (idResource) references " SQL_TABLE_RESOURCE " (id) on UPDATE CASCADE,"
		"CONSTRAINT FK_CONTR_CategRes FOREIGN KEY (idCategoryResource) references " DB_PREFIX "CATEGORYRESOURCE (id) ON UPDATE NO ACTION,"
		"CONSTRAINT FK_CONTR_TypeRes FOREIGN KEY (idTypeResource) references " DB_PREFIX "TYPERESOURCE (id) on UPDATE NO ACTION"
	") ;"
),
PrimaryKeyContract=(
	"ALTER TABLE " DB_PREFIX "CONTRACT ADD CONSTRAINT PK_CONTRACT PRIMARY KEY (idResource,dateStart) ;"
),
ForeignKeyContract_Resource=(
	"ALTER TABLE " DB_PREFIX "CONTRACT ADD CONSTRAINT FK_CONTR_Res FOREIGN KEY (idResource) references " SQL_TABLE_RESOURCE " (id) on UPDATE CASCADE ;"
),
%%'FK_CONTR_CategRes' sur la table 'CONTRACT' peut provoquer des cycles ou des acc s en cascade multiples. 
%%Sp cifiez ON DELETE NO ACTION ou ON UPDATE NO ACTION, ou modifiez d'autres contraintes FOREIGN KEY.
ForeignKeyContract_CategRes=(
	"ALTER TABLE " DB_PREFIX "CONTRACT ADD CONSTRAINT FK_CONTR_CategRes FOREIGN KEY (idCategoryResource) references " DB_PREFIX "CATEGORYRESOURCE (id) ON UPDATE NO ACTION;"
),
ForeignKeyContract_TypeRes=(
	"ALTER TABLE " DB_PREFIX "CONTRACT ADD CONSTRAINT FK_CONTR_TypeRes FOREIGN KEY (idTypeResource) references " DB_PREFIX "TYPERESOURCE (id) on UPDATE NO ACTION ;"
),


%% hourResource = > timeResource
CreateEvent=(
	"CREATE TABLE " DB_PREFIX "EVENT ("
		"idClub		VARCHAR(10),"
		"idResource	VARCHAR(30) NOT NULL,"
		"dateResource	VARCHAR(15) NOT NULL,"
		"timeResource	VARCHAR(15) NOT NULL, "
		"idEvent	VARCHAR(10),"
		"idProject	VARCHAR(30),"
		"idJob		VARCHAR(30),"
		"idTask		VARCHAR(30),"
		"idTypeProcess	VARCHAR(20),"
		"idTypeTrip	VARCHAR(20),"
		"workTime	DECIMAL(4,0),"
		"nightTime	DECIMAL(4,0),"
		"breakTime	DECIMAL(4,0),"
		"routeTime	DECIMAL(10,0),"
		"drivingTime	DECIMAL(10,0),"
		"KM		DECIMAL(8,0),"
		"latitude	VARCHAR(30),"		% JZ
		"longitude	VARCHAR(30),"		% JZ
		"barcode	VARCHAR(30),"
		"qrcode		VARCHAR(30),"
		"comments	VARCHAR(200),"
		"state		VARCHAR(30),"
		"dateEvent	VARCHAR(30) NOT NULL,"
		"CONSTRAINT PK_EVENT PRIMARY KEY (idResource,dateEvent),"
		"CONSTRAINT FK_EVENT_Res FOREIGN KEY (idResource) references " SQL_TABLE_RESOURCE " (id) on UPDATE CASCADE,"
		"CONSTRAINT FK_EVENT_TypeProc FOREIGN KEY (idTypeProcess) references " DB_PREFIX "TYPEPROCESS (id) on UPDATE CASCADE,"
		"CONSTRAINT FK_EVENT_TypeTrip FOREIGN KEY (idTypeTrip) references " DB_PREFIX "TYPETRIP (id) on UPDATE CASCADE"
	") ;"
),
PrimaryKeyEvent=(
	"ALTER TABLE " DB_PREFIX "EVENT ADD CONSTRAINT PK_EVENT PRIMARY KEY (idResource,dateEvent) ;"
),
ForeignKeyEvent_Resource=(
	"ALTER TABLE " DB_PREFIX "EVENT ADD CONSTRAINT FK_EVENT_Res FOREIGN KEY (idResource) references " SQL_TABLE_RESOURCE " (id) on UPDATE CASCADE ;"
),
ForeignKeyEvent_TypeProc=(
	"ALTER TABLE " DB_PREFIX "EVENT ADD CONSTRAINT FK_EVENT_TypeProc FOREIGN KEY (idTypeProcess) references " DB_PREFIX "TYPEPROCESS (id) on UPDATE CASCADE ;"
),
ForeignKeyEvent_TypeTrip=(
	"ALTER TABLE " DB_PREFIX "EVENT ADD CONSTRAINT FK_EVENT_TypeTrip FOREIGN KEY (idTypeTrip) references " DB_PREFIX "TYPETRIP (id) on UPDATE CASCADE ;"
),

