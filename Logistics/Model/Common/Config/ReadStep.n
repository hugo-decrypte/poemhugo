			%(SQL : "DELETE DISTINCTROW p.* FROM " DB_PREFIX "SUBPLAN p LEFT JOIN " DB_PREFIX "OPT_PROJECT o ON p.idProject=o.id 
			%					WHERE o.state='" STATE_CANDIDATE "'" sqlAndClubProject0 SQL_AND_CLUB_o),
