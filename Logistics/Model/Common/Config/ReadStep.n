'()' => (
	'()' <- database,

	(SQL : "SELECT 	"SQL_TOP_PERCENT" step,state FROM " DB_PREFIX "STEP
		WHERE 	step>0 " SQL_AND_CLUB "
		ORDER BY step"),

	%(SQL : SQL_SelectState SQL_AND_CLUB " ORDER BY step"), % bai 0731

	nbStep = (),
	STEP = [1,nbStep],

	\forall i \in STEP(
		idStep_{i}	:: 0,
		stateStep_{i}	:: "",

		idStep_{i}	= (),
		stateStep_{i}	= (),
	),

/*
	STEP = {} => (
		? databaseType (
		"ACCESS":
			(SQL : "DELETE DISTINCTROW j.* FROM " DB_PREFIX "JOB j LEFT JOIN " DB_PREFIX "OPT_PROJECT o ON j.idProject=o.id 
								WHERE o.state='" STATE_CANDIDATE "'" sqlAndClubProject0 SQL_AND_CLUB_o),
			(SQL : "DELETE DISTINCTROW t.* FROM " DB_PREFIX "TASK t LEFT JOIN " DB_PREFIX "OPT_PROJECT o ON t.idProject=o.id 
								WHERE o.state='" STATE_CANDIDATE "'" sqlAndClubProject0 SQL_AND_CLUB_o),
			(SQL : "DELETE DISTINCTROW p.* FROM " DB_PREFIX "RESOURCE_TASK p LEFT JOIN " DB_PREFIX "OPT_PROJECT o ON p.idProject=o.id 
