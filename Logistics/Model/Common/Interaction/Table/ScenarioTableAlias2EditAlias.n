% Script
@ "Script ",

% ID
@ "EditAlias ",

% Caption
@ ("'Editer Alias' "),

% Group
@ "_ ",

% Integer Code [0..1000]
@ SCRIPT_EDIT,

% Label
@ (" '" TAG_EDIT "' "),	

% Object Group Set "{G1, G2, ...}"
@ "_ ",

% Object Id. Set / Object Item
@ "'tableALIAS' ", 

% Rect "(X Y SX SY)" / "[RECT=(X Y SX SY);POSITION=Left/Right/Top/Bottom]"
@ "'( 0 0 0 0 )' ",

% Color "(R G B)" / "[Label format]"
@ "_ ",

% Icon file
@ "_ ",

% Alert message
@ ("_ "),

% Count / Script-item "[COUNT=Instruction count; TYPE=SQL/NCL/SIMULATE; TIMER=Timer-frequence; TIMESCALE=Simulation's time-scale; PATHCLASS=Path-data-id; ]", "[FILE=Script file; ID=Script id]"

@ (PREFIX_POEMDATA_OPEN "ALIAS&id in ({/*selected(tableALIAS;1;(string,ID))*/})&field in ({/*selected(tableALIAS;1;(string,FIELD))*/})&category in ({/*selected(tableALIAS;1;(string,CATEGORY))*/})\"\\\n"),

@ POEMDATA_RELOAD,




