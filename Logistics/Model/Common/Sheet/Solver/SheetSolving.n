['Work Directory' "Model\Common\Config\ReadUserLogin.n"],
['Work Directory' "Model\Common\Config\ReadConfigLogin.n"], 

['Work Directory' "Model\Common\Sheet\Input\ReadFormula.n"],
['Work Directory' "Model\Common\Sheet\Input\ReadSheet.n"],



'()' => (
	threasholdUnknown = 1,


	CELL = [1, ()],
	3 = (),

	\forall c \in CELL (
		idSheetCell_{c}	= (),
		lineCell_{c}	= (),
		idFieldCell_{c}	= (),

		( TAG_SELECTION_ERROR " : (" lineCell_{c} "," idFieldCell_{c} ")":
			lineCell_{c} 	\in LINE,
			idFieldCell_{c} \in IDCOLUMN,
		),

		columnCell_{c}	= columnId_{idFieldCell_{c}},


		formulaCell_{c} = formulaId_{idFormulaColumnLine_{lineCell_{c},columnCell_{c}}},

		programCell_{c} = (
			formulaCell_{c} <> 0 ?
			(programFormula_{formulaCell_{c}} ",\n") : ""
		),
	),


	\forall l \in LINE
	\forall c \in ColumnLine_{l} (
		% Declaration
		f_{l,c}	:: 0.0,
		i_{l,c}	:: 0,
		S_{l,c}	:: {},

		
		% Initialization
		selectedLineColumn_{l,c} == \bigvee_{c2 \in CELL}{l = lineCell_{c2} && c = columnCell_{c2}},
		programmedLineColumn_{l,c} == formulatedColumnLine_{l,c} && selectedLineColumn_{l,c},
	),



	% Declaring macro variables
	\forall l \in LINE (
		\forall c \in ColumnLine_{l}
			m_{l,c} :: "",

		\forall c \in ColumnFloatLine_{l} (
			&m_{l,c} :: 0.0,
			m_{l,c} = ("f_{" l "," c "}"),

			! programmedLineColumn_{l,c} => f_{l,c} = &x_{l,c},
		),

		\forall c \in ColumnIntLine_{l} (
			&m_{l,c} :: 0,
			m_{l,c} = ("i_{" l "," c "}"),

			! programmedLineColumn_{l,c} => i_{l,c} = &x_{l,c},
		),

		\forall c \in ColumnSetLine_{l} (
			&m_{l,c} :: {},
			m_{l,c} = ("S_{" l "," c "}"),

			! programmedLineColumn_{l,c} => S_{l,c} = &x_{l,c},
		),
	),



	% Formula selection
	formula = [ \forall c \in CELL programCell_{c} ],

	( TAG_NO_FORMULA_SELECTED :
		formula <> "",
	),

	presolving = ("[\"" 'Work Directory' "Model\Common\Sheet\Solver\SheetPresolving.n" "\"],\n"),
	output	   = ("[\"" 'Work Directory' "Model\Common\Sheet\Output\UpdateSheet.n" "\"], "),	% BUG



	% Programming the formulas in NCL
	macroFormula = (formula["x_{" >> "&m_{"])["ma&m_{" >> "max_{"],

	program = (presolving macroFormula output),

	ResultWithSolution = \{
		'all solutions found',
		'optimal solution proved',
		'approximate solution found',
		'stopped with solution'
	\},



	% Running the NCL program
	msg := [[program : _], ["ncl.cfg"], 'Trace Level'],




	% Error message for user
	msg \not\in ResultWithSolution => (
		% Formula syntax error
		msg[1..#TAG_SYNTAX_ERROR_BUFFER] = TAG_SYNTAX_ERROR_BUFFER =>
			(TAG_SYNTAX_ERROR_AT msg[#TAG_SYNTAX_ERROR_BUFFER+1 .. #msg] : false),

		msg[1..#TAG_KEYWORD_ERROR_BUFFER] = TAG_KEYWORD_ERROR_BUFFER =>
			(TAG_KEYWORD_ERROR_AT msg[#TAG_KEYWORD_ERROR_BUFFER+1 .. #msg] : false),


		msg[1..#TAG_CELL_ERROR] = TAG_CELL_ERROR =>
			(TAG_SUBSCRIPT_ERROR_AT "x" msg[#TAG_CELL_ERROR+2 .. #msg] : false),

		msg[1..#TAG_SUBSCRIPT_ERROR_BUFFER] = TAG_SUBSCRIPT_ERROR_BUFFER =>
			(TAG_SUBSCRIPT_ERROR_AT "x" msg[#TAG_SUBSCRIPT_ERROR_BUFFER+2 .. #msg] : false),


		msg[1..#TAG_ARGUMENT_ERROR_BUFFER] = TAG_ARGUMENT_ERROR_BUFFER =>
			(TAG_ARGUMENT_ERROR_AT msg[#TAG_ARGUMENT_ERROR_BUFFER+1 .. #msg] : false),


		% Formula typing erro
		msg[1..#TAG_TYPE_ERROR] = TAG_TYPE_ERROR =>
			(TAG_FORMULA_FAILURE msg[#TAG_TYPE_ERROR+1 .. #msg] : false),
		
		% Formula calculation failure
		msg[1..#TAG_FAILURE] = TAG_FAILURE =>
			(TAG_FORMULA_FAILURE msg[#TAG_FAILURE+1 .. #msg]["&m" >> "x"] : false),


		% Other error (normally not possible)
		(msg : false)
	),
),
