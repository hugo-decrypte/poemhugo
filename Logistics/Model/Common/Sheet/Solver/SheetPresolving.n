%x21 = &m_{2,2} + \sum_{i \in &m_{3,18}}{&m_{i,6}} + &m_{2,6} * \sqrt{&m_{3,6}}, x22 = &m_{3,5} - &m_{2,12} - &m_{2,17}, &m_{2,19} = x21 / x22 + &m_{2,12} - &m_{6,8}, x22 <> 0,


%&m_{1,19} = \lfloor \max_{i \in &m_{2,18}}{&m_{i,6}} * \log{&m_{16,9}} / &m_{15,16} - &m_{33,17} \rfloor + &m_{13,14},


'()' => (
	\forall l \in LINE (
		ColumnProgrammedLine_{l} = \{
			\forall c \in ColumnLine_{l}
			(programmedLineColumn_{l,c} ? c : 0)
		\} \setminus 0,


		% Typing input
		\forall c \in ColumnFloatLine_{l} \setminus ColumnProgrammedLine_{l} (
			( TAG_TYPING_ERROR x_{l,c} " (= " f_{l,c} ") " TAG_TYPED_TO aliasTypeSheet_{typeColumnLine_{l,c}} :
				floatNot0ColumnLine_{l,c}	-> f_{l,c} <> 0.0,
				floatGeq0ColumnLine_{l,c}	-> f_{l,c} >= 0.0,
				floatGt0ColumnLine_{l,c}	-> f_{l,c} > 0.0,
			),
		),
		\forall c \in ColumnIntLine_{l} \setminus ColumnProgrammedLine_{l} (
			( TAG_TYPING_ERROR x_{l,c} " (= " f_{l,c} ") " TAG_TYPED_TO aliasTypeSheet_{typeColumnLine_{l,c}} :
				f_{l,c} = i_{l,c},

				intNot0ColumnLine_{l,c}		-> i_{l,c} <> 0,
				intGeq0ColumnLine_{l,c}		-> i_{l,c} >= 0,
				intGt0ColumnLine_{l,c}		-> i_{l,c} > 0,
			),
		),

		\forall c \in ColumnSetLine_{l} \setminus ColumnProgrammedLine_{l} (
			( TAG_TYPING_ERROR x_{l,c} " (= " S_{l,c} ") " TAG_TYPED_TO aliasTypeSheet_{typeColumnLine_{l,c}} :
				setNotEmptyColumnLine_{l,c}	-> S_{l,c} <> {},
			),
		),
	),

	LineColumnProgrammed = \{
		\forall l \in LINE (ColumnProgrammedLine_{l} <> {} ? l : 0)
	\} \setminus 0,
),


% Unknown
\forall l \in LineColumnProgrammed (
	ColumnProgrammedFloatLine_{l}	= ColumnProgrammedLine_{l} \cap ColumnFloatLine_{l},
	ColumnProgrammedIntLine_{l}	= ColumnProgrammedLine_{l} \cap ColumnIntLine_{l},
	ColumnProgrammedSetLine_{l}	= ColumnProgrammedLine_{l} \cap ColumnSetLine_{l},

	% Typing
	\forall c \in ColumnProgrammedIntLine_{l} (
		TAG_TYPING_ERROR x_{l,c} " (= " f_{l,c} ") " TAG_TYPED_TO aliasTypeSheet_{typeColumnLine_{l,c}} :

		f_{l,c} = i_{l,c},
	),
),

.

&m_{1,20} = \lfloor \sum_{i \in &m_{1,18}}{&m_{i+12,11}} * \sqrt{&m_{16,11}} / &m_{43,17} - &m_{16,16} \rfloor + &m_{12,14},

