			IIF(s.idFormula10 IS NULL OR s.idFormula10='" TAG_EMPTY_STRING "',s.name10,s.idFormula10) AS Name10, s.type10 AS Type10, IIF(s.name10 IS NULL OR s.name10='" TAG_EMPTY_STRING "','',s.value10) AS Value10, s.idFormula10 AS IDFORMULA10, \
			'" RGB_WHITE "' AS LINERGB */

	@("SELECT DISTINCT s.idLine AS IDLINE, \
			IIF(s.nameFormula01 IS NULL OR s.nameFormula01='" TAG_EMPTY_STRING "',s.name01,s.nameFormula01) AS Name01, s.type01 AS Type01, IIF(s.name01 IS NULL OR s.name01='" TAG_EMPTY_STRING "','',s.value01) AS Value01, s.idFormula01 AS IDFORMULA01, \
			IIF(s.nameFormula02 IS NULL OR s.nameFormula02='" TAG_EMPTY_STRING "',s.name02,s.nameFormula02) AS Name02, s.type02 AS Type02, IIF(s.name02 IS NULL OR s.name02='" TAG_EMPTY_STRING "','',s.value02) AS Value02, s.idFormula02 AS IDFORMULA02, \
			IIF(s.nameFormula03 IS NULL OR s.nameFormula03='" TAG_EMPTY_STRING "',s.name03,s.nameFormula03) AS Name03, s.type03 AS Type03, IIF(s.name03 IS NULL OR s.name03='" TAG_EMPTY_STRING "','',s.value03) AS Value03, s.idFormula03 AS IDFORMULA03, \
			IIF(s.nameFormula04 IS NULL OR s.nameFormula04='" TAG_EMPTY_STRING "',s.name04,s.nameFormula04) AS Name04, s.type04 AS Type04, IIF(s.name04 IS NULL OR s.name04='" TAG_EMPTY_STRING "','',s.value04) AS Value04, s.idFormula04 AS IDFORMULA04, \
			IIF(s.nameFormula05 IS NULL OR s.nameFormula05='" TAG_EMPTY_STRING "',s.name05,s.nameFormula05) AS Name05, s.type05 AS Type05, IIF(s.name05 IS NULL OR s.name05='" TAG_EMPTY_STRING "','',s.value05) AS Value05, s.idFormula05 AS IDFORMULA05, \
			IIF(s.nameFormula06 IS NULL OR s.nameFormula06='" TAG_EMPTY_STRING "',s.name06,s.nameFormula06) AS Name06, s.type06 AS Type06, IIF(s.name06 IS NULL OR s.name06='" TAG_EMPTY_STRING "','',s.value06) AS Value06, s.idFormula06 AS IDFORMULA06, \
			IIF(s.nameFormula07 IS NULL OR s.nameFormula07='" TAG_EMPTY_STRING "',s.name07,s.nameFormula07) AS Name07, s.type07 AS Type07, IIF(s.name07 IS NULL OR s.name07='" TAG_EMPTY_STRING "','',s.value07) AS Value07, s.idFormula07 AS IDFORMULA07, \
			IIF(s.nameFormula08 IS NULL OR s.nameFormula08='" TAG_EMPTY_STRING "',s.name08,s.nameFormula08) AS Name08, s.type08 AS Type08, IIF(s.name08 IS NULL OR s.name08='" TAG_EMPTY_STRING "','',s.value08) AS Value08, s.idFormula08 AS IDFORMULA08, \
			IIF(s.nameFormula09 IS NULL OR s.nameFormula09='" TAG_EMPTY_STRING "',s.name09,s.nameFormula09) AS Name09, s.type09 AS Type09, IIF(s.name09 IS NULL OR s.name09='" TAG_EMPTY_STRING "','',s.value09) AS Value09, s.idFormula09 AS IDFORMULA09, \
			IIF(s.nameFormula10 IS NULL OR s.nameFormula10='" TAG_EMPTY_STRING "',s.name10,s.nameFormula10) AS Name10, s.type10 AS Type10, IIF(s.name10 IS NULL OR s.name10='" TAG_EMPTY_STRING "','',s.value10) AS Value10, s.idFormula10 AS IDFORMULA10, \
			'" RGB_WHITE "' AS LINERGB \
		FROM " DB_PREFIX "SHEET s \
		WHERE s.idClub IN " IDCLUBVIEW " AND s.category=" SHEET_TECHNIQUE "\n\n"),

