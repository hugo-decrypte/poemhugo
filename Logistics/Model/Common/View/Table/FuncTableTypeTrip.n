<tableTypeTrip>(id,type,aliasTable,bestfit, doubleclick,title,idUserPostfix)
(
	['Work Directory' "Model\Common\Config\ReadField.n"],

	'@' => (
		postfix = (idUserPostfix = "" ? "" : idUserLogin),
		viewFile = ("TableTypeTrip" postfix),

		
		[viewDirectory viewFile ".view"] <- '@',


		['Work Directory' "Model\Common\View\HeaderTable.n"],
		


		@ ("(color,LINERGB,,,13.0.0);]\" \\\n"),

		@ VIEWSQL,

	    	@ ("SELECT t.id 					AS ID, \
			t.name 						AS NAME,\
			t.idx						AS IDX,\
			"SQL_AliasCategoryIs "'TRIP' AND al.field='category' AND al.id=t.category)	AS CATEGORY,\
			t.title 					AS TITLE,\
			t.transportSubsidy				AS NAMETRANSPORTSUBSIDY, \
			t.nbTrip					AS NBTRIP,\
			t.nbLunch					AS NBLUNCH,\
			t.nbNight					AS NBNIGHT,\
			t.costLunch					AS COSTLUNCH,\
			t.costNight 					AS COSTNIGHT,\
			t.comments 					AS COMMENTS,\
			" SQL_TypeStateName " AS NAMESTATE,\
			" SQL_TypeStateColor " AS LINERGB \
	 		FROM " DB_PREFIX "TYPETRIP t \
	 		ORDER BY t.state DESC,t.id\"\n\n\n"),

			%" SQL_AliasCategoryIs "'BOOL' AND al.id=t.principal) AS PRINCIPAL,\



		['Work Directory' "Model\Interaction\View\Table\ScenarioTableTypeTrip2EditTypeTrip.n"],
		


		'@' <- [viewDirectory viewFile ".view"], 
	),
), 



