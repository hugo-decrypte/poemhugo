% View Object
@ ("View "),

% ID	
@ ("ViewTable" aliasTable),

% Caption	
@ (" '" title "' "),

% Title
@ ("'" title "' "),

% Color(R G B)	
@ " 255 255 255 ",

% Icon	
@ ("_ "),

% Rect(X Y SX SY )	
@ ("0 0 0 0 "),

% Margin	
@ ("5 5 5 5 "),

% [Option items]
@ ("'[TRACELEVEL=(/*TRACELEVEL*/);"),
%@ ("'[TRACELEVEL=0;"),
@ ("TRACEFILE=;"),
@ ("TOOLBAR=0;"),
@ ("FLIPVERTICALLY=0;"),
@ ("FLIPHORIZONTALLY=0;"),

%@ ("NATURESCALE=0;"),
%@ ("BESTFIT=1;"),

bestfit => (
	@ ("NATURESCALE=0;"),
	@ ("BESTFIT=1;"),
	;

	@ ("NATURESCALE=1;"),
	@ ("BESTFIT=0;"),
),

@ ("SCROLLBAR=1;"),
@ ("SHOWNAME=1;"),
@ ("ZOOMOBJECT=;"),
@ ("CURRENTPAGE=1;"),
@ ("CLOSEEVENT=0;"),
@ ("BKGROUNDCOLOR="tableTitleFillColor";"),
@ ("SCREENCOLOR="tableTitleFillColor";"),
@ ("PATHLINEWIDTH=9;"),
@ ("PATHLINECOLOR=(0 0 0);"),
@ ("PATHARROWWIDTH=15;"),
@ ("PATHARROWCOLOR=(255 0 0);"),
@ ("POEMSERVER=;"),
@ ("MAPLOGFILE=;"), 
@ ("MATRIXCRITERION=Distance;"),
@ ("MATRIXCOMPUTERADIUS=0.5;"),
@ ("SPEEDKMHOUR=50;"),
@ ("STRAIGHTDISTANCERATIO=1.4;"),
@ ("SITEINTRADISTANCE=;"),
@ ("MATRIXMAXCOMPUTEWIDTH=;"),
@ ("NEIGHBOURHOOD=;"),
@ ("MATRIXFILENAME=;"),
@ ("MATRIXDIRECTORY=;"),
@ ("GLOBALVARIABLE=0]'\n\n"),



@ ("Table table" aliasTable " _ _ 0 0 2000 500 \\\n"),



@ "\"[]\" - \\\n",

%@ ("\"[HORIZONTALLINEWIDTH=1;VERTICALLINEWIDTH=1;HORIZONTALLINECOLOR=" tableHeaderLineColor ";VERTICALLINECOLOR=" tableHeaderLineColor ";FILLCOLOR=" tableTitleFillColor ";]\" \\\n"),
%@ "- ",		@ "\\\n",


% Title
@ ("\"[TITLE=" title ";FONTCOLOR=" tableTitleFontColor ";FONTSIZE=" tableTitleFontSize ";FONTNAME="tableTitleFont";LINESEPARATOR=\\n;HEIGHT=30;BORDER=0;]\"\\\n"),


% JZ 1013

% [Horizontal header options]:
@ ("\"[FONTCOLOR=" tableHeaderFontColor ";FONTSIZE=" tableXFontSize ";FONTNAME="tableTextFont";]\" \\\n"),

% [Vertical header options]:
@ ("\"[FONTCOLOR=" tableHeaderFontColor ";FONTSIZE=" tableYFontSize ";FONTNAME="tableTextFont";]\" \\\n"),



% [Horizontal header options]:
%@ ("\"[BORDERCOLOR=" tableHeaderFillColor ";FILLCOLOR=" tableHeaderFillColor ";LINEWIDTH=1;LINECOLOR=" tableLineColor ";FONTCOLOR=" tableHeaderFontColor ";FONTSIZE=" tableXFontSize ";FONTNAME="tableTextFont";]\" \\\n"),
% [Vertical header options]:
%@ ("\"[BORDERCOLOR=" tableHeaderFillColor ";FILLCOLOR=" tableHeaderFillColor ";LINEWIDTH=1;LINECOLOR=" tableLineColor ";FONTCOLOR=" tableHeaderFontColor ";FONTSIZE=" tableYFontSize ";FONTNAME="tableTextFont";]\" \\\n"),


% [Table cell options]:
@ ("\"[MARGIN=" tableMargin ";FONTCOLOR=" tableFontColor ";FONTSIZE=" tableFontSize ";FONTNAME="tableTextFont";] \\\n"),



FieldSelected <> {},

@ "COLUMNFILL={",
\forall i \in FieldSelected (
	@ rgbField_{i},
	i < \sup FieldSelected => @ ",",
),
@ "};\\\n",


@ "ALIGNTEXT={",
\forall i \in FieldSelected (
	@ alignmentField_{i},
	i < \sup FieldSelected => @ ",",
),
@ "}]\"\\\n",






% [Data source options]:
@ ("\"[DATAOBJ=" aliasTable ";FILLCOLOR=LINERGB]\"\n\n"),

@ ("Data "aliasTable" '" title "' " aliasTable " "),

@ typeDataUser,



% FIND
@ (" 0 \'[FIND={"),

\forall i \in FieldSelected (
	@ aliasField_{i},

	i < \sup FieldSelected => @ ",",
),

@ "}]\' ",


% DOUBLECLICK
@ ("  [DOUBLECLICK=" doubleclick "] \\\n"),



% Fileds item "[Field count; (Field 1); (Field 2); ...]"
@ ("\"[" #FieldSelected ";"),

\forall i \in FieldSelected
	@ ("(" typeField_{i} "," aliasField_{i} "," nameField_{i} "," formatField_{i} ");"),



