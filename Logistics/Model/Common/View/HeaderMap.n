% Data: ICON
@ "Data ",

% ID	
@ "MAP_ICON '",

% Caption	
@ TAG_ICON,

% Group	
@ "' MAP_ICON ",

% Source type (Data/DB/File/Clicked/Selected)
@ typeDataUser,

% Editable (0/1) or [EDITABILITY=0/1; MODIFIABILITY={Columns indexes}; ]	
@ " 0 ",

% Object item "[TYPE=Site/...; MAP=map_id; LOCALIZE=map_object_class_id; ...]"	
@ "\"[TYPE=ICON;GLOBAL=1]\" ",

% Script item "[Scripts when delete, insert or update]"	
@ "_ \\\n",

% Fields item "[Field count; (Field 1); (Field 2); ...]"	
@ "\"[2;(string,ID,ID,,100,0);(File,ICON,ICON,,200,0)]\"\\\n",

% Data 
@ VIEWSQL,


% Source item "[Data sourse description]"
@ ("SELECT id,hexadecimal AS ICON FROM ICON\"\n\n\n"),


