mapChinese == mapPath = "Map\\Shanghai5000",


@ "View ",

% ID
@ ("'" title "' "), % Zhou 0620

% Caption
@ ("'" title "' "),

% Title
@ ("'" title "' "),

% Red Green Blue
mapChinese => (
	@ RGB_WHITE,

	% Icon
	@ (" _ "),

	% X1 Y1 X2 Y2
	@ ("0 0 0 0 "),

	% Margin Left/Margin Top/Margin Right/Margin Bottom
	@ mapMargin,

	% [Option items]
	@ ("'[TRACELEVEL=0;TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=1;FLIPHORIZONTALLY=0;MapCopyright=Shanghai;NATURESCALE=1;BESTFIT=1;SCROLLBAR=1;PERCENTAGEBAR=0;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(128 128 128);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);\\\n"),
	@ ("POEMSERVER=(SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/),UID=,PWD=,TIMEOUT=1000ms);DSN=(DSN=,UID=,PWD=,);MATRIX_COMPUTE=(CRITERIA=Dist,COMPUTERADIUS=0.5,SPEED=50KM/H,DISTRATIO=1.4,INTRADIST=,MAXCOMPUTEWIDTH=,);MATRIX_TABLE=(TABLE=" DB_PREFIX "SITE_SITE,OWNER=,SITE0=idSite1,SITE1=idSite2,CRITERIA=CRITERIA,DIST=distance,TIME=time,IDZONE=IDZONE);\\\n"),
	%@ ("POEMSERVER=(SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/),UID=,PWD=,TIMEOUT=1000ms);DSN=(DSN=" databaseName ",UID=,PWD=,);MATRIX_COMPUTE=(CRITERIA=Dist,COMPUTERADIUS=0.5,SPEED=50KM/H,DISTRATIO=1.4,INTRADIST=,MAXCOMPUTEWIDTH=,);MATRIX_TABLE=(TABLE=" DB_PREFIX "SITE_SITE,OWNER=,SITE0=idSite1,SITE1=idSite2,CRITERIA=CRITERIA,DIST=distance,TIME=time,IDZONE=IDZONE);\\\n"),
	@ ("MAPLOGFILE=;MATRIXCRITERION=Distance;MATRIXCOMPUTERADIUS=0.5;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=;MATRIXMAXCOMPUTEWIDTH=;NEIGHBOURHOOD=;MATRIXFILENAME=;MATRIXDIRECTORY=;"),  % wu 29/10/2021  ;]\'"),
	;



	@ RGB_WHITE,

	% Icon
	@ (" _ "),

	% X1 Y1 X2 Y2
	@ ("_ _ _ _ "),

	% Margin Left/Margin Top/Margin Right/Margin Bottom
	@ mapMargin,


	% [Option items] wu 18/10/2023
	@ ("'[ITINERARYMODE=" modeItinerary ";"),
	@ ("TRACELEVEL=0;TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=1;FLIPHORIZONTALLY=0;NATURESCALE=1;BESTFIT=1;SCROLLBAR=1;SHOWNAME=1;ZOOMOBJECT=;CURRENTPAGE=1;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);\\\n"),
	

        %@ ("'[ITINERARYMODE=1;TRACELEVEL=0;TRACEFILE=;TOOLBAR=0;FLIPVERTICALLY=1;FLIPHORIZONTALLY=0;NATURESCALE=1;BESTFIT=1;SCROLLBAR=1;SHOWNAME=0;ZOOMOBJECT=;CURRENTPAGE=1;BKGROUNDCOLOR=(255 255 255);SCREENCOLOR=(255 255 255);PATHLINEWIDTH=9;PATHLINECOLOR=(0 0 0);PATHARROWWIDTH=15;PATHARROWCOLOR=(255 0 0);\\\n"),
	@ ("POEMSERVER=(SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/),UID=,PWD=,TIMEOUT=1000ms);DSN=(DSN=,UID=,PWD=,);\\\n"),
	%@ ("POEMSERVER=(SERVER=(/*SERVERIP*/);PORT=(/*SERVERPORT*/),UID=,PWD=,TIMEOUT=1000ms);DSN=(DSN=" databaseName ",UID=,PWD=,);\\\n"),
        @ ("MATRIX_COMPUTE=(CRITERIA=Dist,COMPUTERADIUS=5,SPEED=50KM/H,DISTRATIO=1.4,INTRADIST=3,MAXCOMPUTEWIDTH=300,);\\\n"),  
	@ ("MATRIXTABLE=(TABLE=OPT_SITE_SITE,CLUBID=idClub,SITE0=idSite1,SITE1=idSite2,DIST=distance,TIME=time,CLUBVAL={/*CLUBID*/},CRITERIA=,IDZONE=TYPE,ZONEVAL=0);\\\n"),
	@ ("MAPLOGFILE=;SPEEDKMHOUR=50;STRAIGHTDISTANCERATIO=1.4;SITEINTRADISTANCE=3;NEIGHBOURHOOD=;PERCENTAGEBAR=0;NAVIGATIONICON=1;SHOWSITE=1;SHOWPATH=1;SHOWNAME=1;\\\n"), 
	@ ("ROUTESHEET=(DEFAULT=1,DSN=);TABLESITE=(DEFAULT=1,TABLE=OPT_SITE,DSN=);ITINERARY_MODE=0;AUTOUPDATESITE=1;AUTORUNDLG=0;"), 
	%@ ("ROUTESHEET=(DEFAULT=1,DSN=);TABLESITE=(DEFAULT=1,TABLE=OPT_SITE,DSN=TMS32);ITINERARY_MODE=0;AUTOUPDATESITE=1;AUTORUNDLG=0;"), 

),



related = "Simulation" => (
	@ ("AUTORUN=]'\n\n"),
	%@ ("AUTORUN=SimulationVehicle]'\n\n"),
	;
	@ ("]'\n\n"),
),



% Data: MAP
@ "Map ",

% ID
@ "VRP ",

% Caption
@ "_ ",

% Group
@ "_ ",


% Scale
mapChinese => (
	@ "[SCALE=1000000;LONGILATITUDE=1;VIRTUAL=1;TEXT_RTF8=0] ",
	;
	@ "[SCALE=1;LONGILATITUDE=0;VIRTUAL=1;TEXT_RTF8=0] ",
),


% Map Source
@ ("\"[DIRECTORY=(/*CLIENTDIRECTORY*/)" mapPath "]\" "),

%@ ("" xMin1 " " yMin1 " " (xMax1 - xMin1) " " (yMax1 - yMin1) " "),
@ ("_ _ _ _ "),


% Map Classes(nbObject classes)
mapChinese => (
	@ 6, @ " \\\n",
	@ ("\"[ADMIN;[TYPE=AdminCurve,LABEL=Limite admin];[IDCOLUMN=, CAPTIONCOLUMN=];[SHOW=1,FONTSIZE=-6,FONTNAME="TAG_FONT",COLOR=(0 0 0),BK=(255 255 255)];[SHOW=1, SELECT=0, TIPINFO=0, FIND=1, DRAW=-1];3,3,3,2,2,1,1;(255 200 200),(255 200 200),(255 200 200),(255 200 200),(255 200 200),(255 200 200),(255 200 200);,,,,,,;;]\" \\\n"),
	@ ("\"[Pathline;[TYPE=RouteCurve, LABEL=Route];[C_ID=EDGEID, C_CAPTION=BYNAMEP];[FONTNAME="TAG_FONT", FONTSIZE=-12, COLOR=(0 0 0), ITALIC=0, UNDERLINE=0, BOLD=0];[SHOW=1, SELECT=1, TIPINFO=1, FIND=1, DRAW=1,MODIFIABLE=1];5,4,4,4,4,3,3,3,3,3;(255 0 0),(255 0 0),(128 64 64),(192 192 192),(192 192 192),(192 192 192),(192 192 192),(192 192 192),(192 192 192),(192 192 192);(255 255 0),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255);NR,1|800|1|Highway,2|400|2|National,3|200|3|Rapid,4|100|4|Department,5|50|5|Principal,6|30|6|Second,7|20|7|General,8|15|8|Bretel,9|10|9|Small,A|5|10|Pedestrian;LENGTH,1000;DF,4,3|1|Double sens,2|3|Sens inverse,3|2|Sens unique,0|4|Interdit;FJCID;TJCID]\" \\\n"),
	@ ("\"[Park;[TYPE=Park, LABEL=Park];[C_ID=ADAID, C_CAPTION=NAMEP];[FONTNAME="TAG_FONT", FONTSIZE=-12, COLOR=(0 0 0), ITALIC=0, UNDERLINE=0, BOLD=0];[SHOW=1, SELECT=1, TIPINFO=1, FIND=1, DRAW=1,MODIFIABLE=1,ZOOMCOUNT=500];1;(0 255 0);(100 255 100);;;]\" \\\n"),
	@ ("\"[River;[TYPE=WaterZone,LABEL=,STRINCMP=1];[IDCOLUMN=, CAPTIONCOLUMN=];[SHOW=1,FONTSIZE=-6,FONTNAME="TAG_FONT",COLOR=(0 0 0),BK=(255 255 255)];[SHOW=1, SELECT=1, TIPINFO=1, FIND=1, DRAW=-1];1;(100 255 255);(200 255 255);;]\" \\\n"),
	@ ("\"[Poi;[TYPE=Facility,LABEL=,STRINCMP=1];[IDCOLUMN=POIID, CAPTIONCOLUMN=NAMEP];[SHOW=1,FONTSIZE=-12,FONTNAME="TAG_FONT",COLOR=(0 0 0),BK=(255 255 255)];[SHOW=1, SELECT=1, TIPINFO=1, FIND=1, DRAW=-1];5;(96 96 96);(96 96 96);;]\" \\\n"),
	@ ("\"[Railway;[TYPE=Railway,LABEL=,STRINCMP=1];[IDCOLUMN=, CAPTIONCOLUMN=NAMEP];[SHOW=1,FONTSIZE=9,FONTNAME="TAG_FONT",COLOR=(0 0 0),BK=(255 255 255)];[SHOW=1, SELECT=1, TIPINFO=1, FIND=1, DRAW=-1];5;(0 32 128);(50 20 20);;]\" \n\n"),
	;

	@ 9, @ " \\\n",
	


	@ ("\"[ZONE_OCCUPATION_SOL;[TYPE=GroundOccupation,LABEL=Occpation sol];[IDCOLUMN=, CAPTIONCOLUMN=NATURE];[SHOW=1,FONTNAME=Arial, FONTSIZE=-6, COLOR=(0 0 0), ITALIC=0, UNDERLINE=0, BOLD=0];[SHOW=1, SELECT=0, TIPINFO=0, FIND=0, DRAW=-1];1,1,1;(118 178 248),(128 198 148),(218 218 218);(118 178 248),(128 198 148),(218 218 218);NATURE,Eau|2000|1,Forêt|2000|2,Bâti|2000|3;]\" \\\n"),
	@ ("\"[COTE_FRONTIERE;[TYPE=Frontier,LABEL=Frontier];[C_ID=ID_RTE500, CAPTIONCOLUMN=];[SHOW=1,FONTSIZE=-6,FONTNAME=Arial,COLOR=(0 0 0),BK=(255 255 255)];[SHOW=1, SELECT=0, TIPINFO=0, FIND=0, DRAW=-1];3;(255 200 200);]\" \\\n"),
	@ ("\"[LIMITE_ADMINISTRATIVE;[TYPE=AdminCurve,LABEL=Limite admin];[C_ID=ID_RTE500, CAPTIONCOLUMN=];[SHOW=1,FONTSIZE=-6,FONTNAME=Arial,COLOR=(0 0 0),BK=(255 255 255)];[SHOW=1, SELECT=0, TIPINFO=0, FIND=0, DRAW=-1];3,3,3,2,2,1,1;(255 200 200),(255 200 200),(255 200 200),(255 200 200),(255 200 200),(255 200 200),(255 200 200);,,,,,,;NATURE,Frontière internationale|2000|1,Limite côtière|2000|2,Limite de région|500|3,Limite de département|300|4,Limite d'arrondissement|300|5,Limite de canton|200|6,Limite de commune|20|7;]\" \\\n"),
	@ ("\"[NOEUD_COMMUNE;[TYPE=Locality,LABEL=Noeud commune,CONTOUR=COMMUNE,STATIC=1,CONTOURID=1];[C_ID=ID_RTE500, C_CAPTION=NOM_COMM, C_INSEE=INSEE_COMM];[FONTNAME=Arial, FONTSIZE=11, COLOR=(0 0 0), ITALIC=0, UNDERLINE=0, BOLD=0];[SHOW=1, SELECT=1, TIPINFO=0, FIND=1, DRAW=-1];8,7,6,5,4,4;(64 0 64),(64 0 64),(64 0 64),(64 0 64),(64 0 64),(92 92 92);(255 0 0),(255 255 255),(255 255 255),(255 255 255),(255 255 255),(255 255 255);STATUT,Capitale d'état|2000|1,Préfecture|1000|2,Préfecture de région|600|3,Sous-préfecture|300|4,Chef-lieu de canton|100|5,Commune simple|80|6;]\" \\\n"),
