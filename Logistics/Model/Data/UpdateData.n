		IdTypeResourceResource_{r}	:: {""},
		IdShiftResource_{r}		:: {""},

		idResource_{r}			= (),
		IdTypeResourceResource_{r}	= (),
		IdShiftResource_{r}		= (),


		idTypeResourceResource_{r}	= \inf IdTypeResourceResource_{r},
		idShiftResource_{r}		= \inf IdShiftResource_{r},

		IdTypeResourceResource_{r} = {} => idTypeResourceResource_{r} = "",
		IdShiftResource_{r} = {} => idShiftResource_{r} = "",
